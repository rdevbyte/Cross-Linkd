{
  "name": "crosslinkd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CrossLinkd — a premium faith-based discovery platform for Christian-owned businesses, churches, ministries, professionals, and events.",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "typecheck": "astro check",
    "e2e": "node e2e-layout.mjs",
    "test:creation": "node e2e-listing-creation.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "sitemap": "tsx scripts/sitemap.ts",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "db:wipe-listings": "node scripts/wipe-listings.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.10",
    "@neondatabase/serverless": "^0.10.0",
    "animejs": "^4.5.0",
    "astro": "^7.3.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.2",
    "gsap": "^3.12.5",
    "jose": "^6.2.0",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.15",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0",
    "esbuild": ">=0.25.0",
    "vite": ">=7.3.1"
  }
}
