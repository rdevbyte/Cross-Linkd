# ---- Database (Neon recommended) ----
# Pooled connection string used by the app at runtime.
DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/crosslinkd
# Unpooled (direct) connection used by migrations and admin CLI scripts.
DIRECT_URL=postgres://user:password@host.region.aws.neon.tech/crosslinkd

# ---- Auth ----
# Session signing secret (openssl rand -hex 32). REQUIRED in production.
AUTH_SECRET=
# One-time first-admin bootstrap key. Set it only while bootstrapping, then remove.
ADMIN_SETUP_KEY=

# ---- App ----
PUBLIC_SITE_URL=https://your-domain.example.com

# ---- Email (magic links, verification, password reset, feedback suggestions) ----
# Without RESEND_API_KEY, emails are printed to the server logs instead of sent.
RESEND_API_KEY=
MAIL_FROM="CrossLinkd <onboarding@resend.dev>"
# Destination for emailed feedback suggestions; /contact messages are saved in /admin/reports, not emailed.
CONTACT_INBOX=

# ---- Cron protection (Vercel Cron sends this bearer token) ----
CRON_SECRET=

# Optional: show illustrative sample events/testimonials in local previews.
# Bundled sample business listings have been removed; this flag never adds listings.
SHOW_SAMPLE_CONTENT=
