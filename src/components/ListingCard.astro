---
import FavoriteButton from './FavoriteButton';
import StatusBadge from './StatusBadge.astro';
import TypeGlyph from './TypeGlyph.astro';
import type { SampleListing } from '@/data/listings';
import { typeBySlug } from '@/data/listing-types';
import { compact, timeAgo } from '@/lib/format';
import { recentlyUpdatedState, recentCardShimmerState } from '@/lib/recentlyUpdated.mjs';

interface Props { listing: SampleListing; distanceMiles?: number; sponsored?: boolean }
const { listing: l, distanceMiles, sponsored = false } = Astro.props;
// Decorative card trace: namespaced SVG ids + a deterministic per-card animation phase
const artUid = String(l.id).replace(/[^a-zA-Z0-9_-]/g, '') || 'card';
const glowDelay = (-((Array.from(String(l.id)).reduce((a, c) => a + c.charCodeAt(0), 0) * 7) % 75) / 10).toFixed(1);
const badgeLabels: Record<string, string> = {
  claimed: 'Owner claimed',
  christian_owned: 'Self-identified Christian-owned',
};
const initial = l.name.trim().charAt(0).toUpperCase();
const typeIcon = typeBySlug(l.typeSlug)?.icon ?? 'store';
const MAX_TAGS = 3;
const extraTags = Math.max(0, l.hashtags.length - MAX_TAGS);
const serviceLabels = (l.services ?? [])
  .map((service) => String(service).trim())
  .filter(Boolean)
  .filter((service, index, values) => values.findIndex((other) => other.toLocaleLowerCase('en-US') === service.toLocaleLowerCase('en-US')) === index);
const MAX_SERVICES = 3;
const extraServices = Math.max(0, serviceLabels.length - MAX_SERVICES);
const serviceArea = l.serviceArea?.trim();
const updatedAtMs = l.updatedAt ? Date.parse(l.updatedAt) : Number.NaN;
const updatedAtLabel = Number.isFinite(updatedAtMs)
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(updatedAtMs))
  : undefined;
const recentUpdate = recentlyUpdatedState(l.recentlyUpdatedAt);
const cardShimmer = recentCardShimmerState({
  createdAt: l.createdAt,
  publishedAt: l.publishedAt,
  updatedAt: l.updatedAt,
  recentlyUpdatedAt: l.recentlyUpdatedAt,
});
const analyticsListingId = /^db-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(l.id) ? l.id.slice(3) : undefined;
const shimmerDelay = (Array.from(l.id).reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7) % 500) / 1000;
---
<article
  class:list={["card card-hover card-traced relative flex flex-col overflow-hidden", recentUpdate && "recently-updated-card", cardShimmer && "recent-card-shimmer"]}
  style={`--hue:${l.imageHue};${cardShimmer ? `--card-shimmer-delay:${shimmerDelay.toFixed(3)}s;` : ''}`}
  data-listing-card={analyticsListingId ? 'true' : undefined}
  data-listing-id={analyticsListingId}
  data-recently-updated={recentUpdate ? 'true' : undefined}
  data-recent-update-expires={recentUpdate?.expiresAt}
  data-card-shimmer-expires={cardShimmer?.expiresAt}
>
  <svg class="card-trace" viewBox="0 0 340 220" preserveAspectRatio="none" aria-hidden="true" focusable="false" style={`--glow-delay:${glowDelay}s`}>
    <defs>
      <radialGradient id={`traceg-${artUid}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" style="stop-color:var(--logo-gold)" stop-opacity="1" />
        <stop offset="55%" style="stop-color:var(--logo-gold)" stop-opacity="0.34" />
        <stop offset="100%" style="stop-color:var(--logo-gold)" stop-opacity="0" />
      </radialGradient>
      <mask id={`tracem-${artUid}`}>
        <rect x="1.5" y="1.5" width="337" height="217" rx="13" fill="none" stroke="#ffffff" stroke-width="6" vector-effect="non-scaling-stroke" />
      </mask>
    </defs>
    <rect class="card-trace-outline" x="1" y="1" width="338" height="218" rx="13" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    <g mask={`url(#tracem-${artUid})`}>
      <circle class="card-trace-light" r="85" fill={`url(#traceg-${artUid})`} />
    </g>
  </svg>
  <script>
    // Fit the trace to the real card box: with no viewBox, SVG user units are
    // CSS pixels, so the ring, glow band, and orbit path all follow the card's
    // exact edges and corner radius — one cohesive border, no second outline.
    const RING_W = 1.5;
    const n2 = (v: number) => (Math.round(v * 100) / 100).toString();

    // Measure the layout box, never getBoundingClientRect(): while a card is
    // mid-FLIP (search layout toggle) its transform scales the client rect to the
    // *previous* layout, and a ring fitted to that stays wrong until the next resize.
    function fitTrace(svg: SVGSVGElement, size?: { width: number; height: number }) {
      const card = svg.closest('article');
      const w = size?.width ?? (card ? card.clientWidth : svg.clientWidth);
      const h = size?.height ?? (card ? card.clientHeight : svg.clientHeight);
      if (w < 24 || h < 24) return;
      svg.removeAttribute('viewBox');
      svg.removeAttribute('preserveAspectRatio');
      const cssRadius = card ? parseFloat(getComputedStyle(card).borderTopLeftRadius) || 0 : 12;
      // The SVG canvas starts just inside the card's 1px border, so the ring's
      // outer edge (centerline + RING_W/2) lands exactly on the card corner.
      const outerEdgeR = Math.max(cssRadius - 1, 0);
      const ringInset = RING_W / 2;
      const ringR = Math.max(outerEdgeR - ringInset, 0);
      const x = ringInset, y = ringInset;
      const W = Math.max(w - RING_W, 1), H = Math.max(h - RING_W, 1);
      const outline = svg.querySelector<SVGRectElement>('.card-trace-outline');
      const band = svg.querySelector<SVGRectElement>('mask rect');
      for (const rect of [outline, band]) {
        if (!rect) continue;
        rect.setAttribute('x', n2(x));
        rect.setAttribute('y', n2(y));
        rect.setAttribute('width', n2(W));
        rect.setAttribute('height', n2(H));
        rect.setAttribute('rx', n2(ringR));
        rect.removeAttribute('vector-effect');
      }
      const light = svg.querySelector<SVGCircleElement>('.card-trace-light');
      if (light) {
        // Orbit along the ring's exact centerline (inline style beats the CSS default).
        light.style.setProperty(
          'offset-path',
          `path('M ${n2(x + ringR)} ${n2(y)} H ${n2(W - ringR)} A ${n2(ringR)} ${n2(ringR)} 0 0 1 ${n2(W)} ${n2(y + ringR)} V ${n2(H - ringR)} A ${n2(ringR)} ${n2(ringR)} 0 0 1 ${n2(W - ringR)} ${n2(H)} H ${n2(x + ringR)} A ${n2(ringR)} ${n2(ringR)} 0 0 1 ${n2(x)} ${n2(H - ringR)} V ${n2(y + ringR)} A ${n2(ringR)} ${n2(ringR)} 0 0 1 ${n2(x + ringR)} ${n2(y)} Z')`,
        );
      }
    }

    const traceRO = new ResizeObserver((entries) => {
      for (const entry of entries) fitTrace(entry.target as SVGSVGElement, entry.contentRect);
    });
    document.querySelectorAll<SVGSVGElement>('.card-trace').forEach((svg) => {
      fitTrace(svg);
      traceRO.observe(svg);
    });
  </script>
  <a href={`/directory/${l.slug}`} class="card-media-link block" aria-label={`View ${l.name}`} tabindex="-1" data-listing-card-link>
    <div class="card-media relative">
      {l.coverUrl && <img src={l.coverUrl} alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover" />}
      <div class="absolute inset-0 flex items-center justify-center">
        {l.logoUrl ? <img src={l.logoUrl} alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="card-monogram object-cover" /> : <span class="card-monogram" aria-hidden="true">{initial}</span>}
      </div>
      <span class="card-glyph"><TypeGlyph name={typeIcon} size={22} /></span>
    </div>
  </a>
  <div class="card-fav absolute right-3 top-3 z-[4]"><FavoriteButton id={l.id} client:visible /></div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="card-head flex items-start gap-3">
      {l.logoUrl ? <img src={l.logoUrl} alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="card-avatar object-cover" /> : <span class="card-avatar" aria-hidden="true">{initial}</span>}
      <div class="min-w-0 flex-1">
        {(sponsored || l.featured) && (
          <span class={`chip mb-1 !py-0 !text-[11px] ${sponsored ? '' : 'chip-featured'}`}>{sponsored ? 'Sponsored' : 'Highlighted'}</span>
        )}
        <a href={`/directory/${l.slug}`} class="card-title block" data-listing-card-link>{l.name}</a>
        <p class="line-clamp-2 mt-0.5 text-sm" style="color:var(--text-soft)">{l.tagline}</p>
      </div>
    </div>
    <p class="text-[13px]" style="color:var(--text-mute)">
      {l.reviewCount > 0 ? (
        <span title={`${l.reviewCount} reviews`}><strong class="font-semibold" style="color:var(--text)">★ {l.rating.toFixed(1)}</strong> ({compact(l.reviewCount)}) • </span>
      ) : (
        <span>No reviews yet • </span>
      )}
      {l.isOnlineOnly ? 'Online-only' : `${l.city}, ${l.region}`}
      {typeof distanceMiles === 'number' && distanceMiles < 9999 ? ` • ${distanceMiles.toFixed(1)} mi` : ''}
      {l.priceRange ? ` • ${l.priceRange}` : ''}
      {typeof l.addedDaysAgo === 'number' && Number.isFinite(l.addedDaysAgo) ? ` • added ${timeAgo(l.addedDaysAgo)}` : ''}
    </p>
    {updatedAtLabel && <p class="text-xs" style="color:var(--text-mute)"><time datetime={l.updatedAt} title="Public listing record last updated">Profile record updated {updatedAtLabel}</time></p>}
    {serviceLabels.length > 0 && (
      <div role="group" aria-label={`Services listed by ${l.name}`} class="flex flex-wrap gap-1.5">
        {serviceLabels.slice(0, MAX_SERVICES).map((service) => <span class="chip max-w-full truncate !text-xs" title={service}>{service}</span>)}
        {extraServices > 0 && <a href={`/directory/${l.slug}#services`} class="chip !text-xs" aria-label={`View ${extraServices} more listed services for ${l.name}`}>+{extraServices} more</a>}
      </div>
    )}
    {serviceArea && <p class="line-clamp-1 text-xs" style="color:var(--text-soft)" title={`Service area: ${serviceArea}`}><strong style="color:var(--text)">Service area:</strong> {serviceArea}</p>}
    <div class="flex flex-wrap items-center gap-1.5">
      {recentUpdate && <span data-recent-update-badge role="note" aria-label={`Recently Updated. This listing was recently updated by its owner. ${recentUpdate.label}.`} title="This listing was recently updated by its owner." class="recent-update-badge"><span aria-hidden="true" class="recent-update-dot"></span><strong>Recently Updated</strong><time datetime={recentUpdate.timestamp}>{recentUpdate.label}</time></span>}
      <StatusBadge name="Owner-submitted" definition="The business provided the listing information." />
      {l.badges.filter((b) => badgeLabels[b]).map((b) => (
        <StatusBadge name={badgeLabels[b]} />
      ))}
    </div>
    {l.hashtags.length > 0 && (
      <div class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-1 text-[12px]">
        {l.hashtags.slice(0, MAX_TAGS).map((t) => (
          <a href={`/search?q=${encodeURIComponent('#' + t)}`} class="hover:underline" style="color:var(--teal)">#{t}</a>
        ))}
        {extraTags > 0 && (
          <a href={`/directory/${l.slug}`} class="hover:underline" style="color:var(--text-mute)">+{extraTags} more</a>
        )}
      </div>
    )}
  </div>
</article>
<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
