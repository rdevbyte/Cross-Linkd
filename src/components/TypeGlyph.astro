---
/**
 * Decorative category glyph for listing cards and headers, keyed by
 * LISTING_TYPES[].icon. Stroke icons on the 24px grid; unknown names fall back
 * to the generic "store" mark. Always aria-hidden — the type is named in text.
 */
interface Props { name?: string; size?: number; class?: string }
const { name = 'store', size = 20, class: className = '' } = Astro.props;
const ALIAS: Record<string, string> = {
  hands: 'heart', guitar: 'music', send: 'globe', signal: 'globe', users: 'people', tent: 'home',
};
const icon = ALIAS[name] ?? name;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icon === 'church' && <><path d="M12 2v6M9 5h6"/><path d="M4 22V12l8-5 8 5v10"/><path d="M10 22v-5a2 2 0 0 1 4 0v5"/></>}
  {icon === 'heart' && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>}
  {icon === 'briefcase' && <><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/></>}
  {icon === 'cap' && <><path d="M2 10l10-5 10 5-10 5-10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/></>}
  {icon === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></>}
  {icon === 'book' && <><path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0 0 4h14"/><path d="M8 7h8"/></>}
  {icon === 'mic' && <><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4M8 22h8"/></>}
  {icon === 'music' && <><path d="M9 18V6l12-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></>}
  {icon === 'chat' && <path d="M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12Z"/>}
  {icon === 'hammer' && <><path d="M15 12 6.5 20.5a2.1 2.1 0 0 1-3-3L12 9"/><path d="m14 7 3-3 4 4-3 3Z"/><path d="M12 9l3 3"/></>}
  {icon === 'globe' && <><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></>}
  {icon === 'people' && <><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-4-6"/></>}
  {icon === 'home' && <><path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></>}
  {!['church','heart','briefcase','cap','calendar','book','mic','music','chat','hammer','globe','people','home'].includes(icon) && <><path d="M3 9.5 4.5 4h15L21 9.5"/><path d="M3 9.5a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12v8h14v-8M10 20v-5h4v5"/></>}
</svg>
