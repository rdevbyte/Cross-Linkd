---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const cols = [
  {
    title: 'Directory',
    links: [
      ['Search Businesses', '/search'],
      ['Browse by Category', '/browse/industries'],
      ['Browse by State', '/browse/locations'],
      ['Events', '/events'],
      ['Favorites', '/favorites'],
    ],
  },
  {
    title: 'For Business Owners',
    links: [
      ['List Your Business', '/add-listing'],
      ['Claim a Listing', '/claim-listing'],
      ['How It Works', '/how-it-works'],
      ['Owner Dashboard', '/dashboard'],
    ],
  },
  {
    title: 'Trust & Policies',
    links: [
      ['Verification & Badges', '/verification'],
      ['How Businesses Qualify', '/verification#qualify'],
      ['Review & Moderation Policy', '/reviews-policy'],
      ['Submission Policy', '/submission-policy'],
      ['Editorial Policy', '/editorial-policy'],
      ['Appeals', '/appeals'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['About Us', '/about'],
      ['Contact', '/contact'],
      ['Help Center', '/help'],
      ['Resource Center', '/articles'],
      ['Terms of Service', '/terms'],
      ['Privacy Policy', '/privacy'],
    ],
  },
];
---
<footer class="mt-20 border-t" style="border-color:var(--border);background:var(--bg-soft)">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.3fr_repeat(4,1fr)]">
      <div>
        <Logo />
        <p class="mt-4 max-w-xs text-sm leading-relaxed" style="color:var(--text-soft)">
          A hand-reviewed national directory of Christian-owned businesses, churches, and ministries across the United States.
        </p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h3 class="text-sm font-bold uppercase tracking-wide" style="color:var(--text-mute)">{c.title}</h3>
          <ul class="mt-3 space-y-2">
            {c.links.map(([label, href]) => (
              <li><a href={href} class="text-sm hover:underline" style="color:var(--text-soft)">{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t pt-6 sm:flex-row sm:items-center" style="border-color:var(--border)">
      <p class="text-xs" style="color:var(--text-mute)">© {year} CrossLinkd LLC. Directory inclusion is not an endorsement of any denomination, doctrine, or business.</p>
      <div class="flex gap-2">
        <a href="/verification" class="chip hover:border-[var(--teal)]">✓ How we verify</a>
        <a href="/privacy" class="chip hover:border-[var(--teal)]">Privacy</a>
      </div>
    </div>
  </div>
</footer>
