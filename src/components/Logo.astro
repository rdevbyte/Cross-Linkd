---
// CrossLinkd brand mark — merged from the two source logos:
// the navy C-link + gold square-link chain with a white cross
// cutout at the interlock, and node dots from the contour concept.
// mark.png / mark-dark.png are cropped to the artwork (241×148, ratio 1.63).
interface Props { size?: number; showWordmark?: boolean; }
const { size = 36, showWordmark = true } = Astro.props;
const MARK_RATIO = 241 / 148;
const width = Math.round(size * MARK_RATIO);
---
<a href="/" class="group flex min-w-0 max-w-full items-center gap-2.5" aria-label="CrossLinkd home">
  <img
    src="/brand/mark.png"
    alt=""
    width={width}
    height={size}
    class="logo-mark light-only shrink-0 transition-transform duration-200 group-hover:scale-105"
    style={`height:${size}px;width:auto`}
    aria-hidden="true"
  />
  <img
    src="/brand/mark-dark.png"
    alt=""
    width={width}
    height={size}
    class="logo-mark dark-only shrink-0 transition-transform duration-200 group-hover:scale-105"
    style={`height:${size}px;width:auto`}
    aria-hidden="true"
  />
  {showWordmark && (
    <span class="min-w-0 leading-tight">
      <span class="logo-wordmark block text-[17px] font-bold tracking-tight sm:text-[18px]"><span style="color:var(--navy)">Cross</span><span style="color:var(--logo-gold)">Linkd</span></span>
      <span class="logo-tagline hidden whitespace-nowrap text-[12px] font-medium leading-snug xl:block" style="color:var(--text-mute)">Community-listed Christian businesses</span>
    </span>
  )}
</a>
