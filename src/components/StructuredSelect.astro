---
/**
 * Structured dropdown — searchable, expandable, keyboard-accessible single select.
 * Used by "Listing type" and "Denomination" so both filters share identical
 * categorization, hierarchy, alphabetical order, visuals, and selection behavior.
 * Progressive enhancement: without JS the native <select> fallback is shown.
 */
interface Item { value: string; label: string }
interface Group { label: string; items: Item[] }
interface Props {
  name: string;
  label: string;
  helper?: string;
  placeholder: string;
  groups: Group[];
  selected?: string;
  selectedLabel?: string;
  searchPlaceholder?: string;
}
const { name, label, helper, placeholder, groups, selected = '', selectedLabel = '', searchPlaceholder = 'Search…' } = Astro.props;
const gid = (g: Group) => `${name}-g-${g.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
let optIdx = 0;
---
<div class="sdd" data-sdd data-name={name}>
  <h2 id={`${name}-label`} class="text-sm font-bold">{label}</h2>
  {helper && <p class="mt-0.5 text-[11px]" style="color:var(--text-mute)">{helper}</p>}

  <!-- No-JS fallback: native grouped select -->
  <select name={name} class="input sdd-native mt-2" aria-label={`${label}, grouped and alphabetized`}>
    <option value="" selected={!selected}>{placeholder}</option>
    {groups.map((g) => (
      <optgroup label={g.label}>
        {g.items.map((it) => (
          <option value={it.value} selected={selected === it.value}>{it.label}</option>
        ))}
      </optgroup>
    ))}
  </select>

  <!-- Enhanced control (JS adds .sdd-enhanced to the root) -->
  <div class="sdd-control">
    <input type="hidden" name={name} value={selected} />
    <button
      type="button"
      class="sdd-button input mt-2"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-controls={`${name}-listbox`}
      aria-labelledby={`${name}-label ${name}-value`}
    >
      <span class="sdd-value" id={`${name}-value`} data-sdd-value data-placeholder={placeholder} class:list={[{ 'sdd-set': !!selected }]}>{selectedLabel || placeholder}</span>
      <svg class="sdd-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.2 7.4 10 12.2l4.8-4.8 1.2 1.2-6 6-6-6 1.2-1.2Z" /></svg>
    </button>
    <div class="sdd-panel" hidden>
      <div class="sdd-search">
        <input type="text" class="input" placeholder={searchPlaceholder} aria-label={`Search ${label.toLowerCase()} options`} autocomplete="off" spellcheck="false" />
        <button type="button" class="sdd-clear" aria-label="Clear search" hidden>×</button>
      </div>
      <ul class="sdd-list" role="listbox" id={`${name}-listbox`} aria-labelledby={`${name}-label`}>
        <li role="option" id={`${name}-opt-any`} class="sdd-option sdd-any" data-value="" data-label={placeholder} aria-selected={selected === ''}>{placeholder}</li>
        {groups.map((g) => (
          <>
            <li role="presentation" class="sdd-ghead">
              <button type="button" class="sdd-toggle" aria-expanded="true" aria-controls={gid(g)}>
                <span class="sdd-gname">{g.label}</span>
                <span class="sdd-gmeta">
                  <span class="sdd-gcount">{g.items.length}</span>
                  <svg class="sdd-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.2 7.4 10 12.2l4.8-4.8 1.2 1.2-6 6-6-6 1.2-1.2Z" /></svg>
                </span>
              </button>
            </li>
            <li role="group" class="sdd-group" aria-label={g.label} id={gid(g)}>
              {g.items.map((it) => (
                <div role="option" id={`${name}-opt-${optIdx++}`} class="sdd-option" tabindex="-1" data-value={it.value} data-label={it.label} aria-selected={selected === it.value}>{it.label}</div>
              ))}
            </li>
          </>
        ))}
        <li role="presentation" class="sdd-empty" hidden>No matches — try a different term.</li>
      </ul>
    </div>
    <p class="sr-only" role="status" data-sdd-live></p>
  </div>
</div>

<script>
  function initSdd(root: HTMLElement) {
    if (root.dataset.sddReady) return;
    root.dataset.sddReady = '1';
    root.classList.add('sdd-enhanced');
    // Enhanced control takes over: disable the native fallback so it doesn't
    // double-submit its (display:none inputs still submit) value alongside.
    const native = root.querySelector<HTMLSelectElement>('select.sdd-native');
    if (native) native.disabled = true;

    const button = root.querySelector<HTMLButtonElement>('.sdd-button');
    const panel = root.querySelector<HTMLElement>('.sdd-panel');
    const hidden = root.querySelector<HTMLInputElement>('input[type="hidden"]');
    const valueEl = root.querySelector<HTMLElement>('[data-sdd-value]');
    const search = root.querySelector<HTMLInputElement>('.sdd-search input');
    const clearBtn = root.querySelector<HTMLButtonElement>('.sdd-clear');
    const listbox = root.querySelector<HTMLElement>('.sdd-list');
    const emptyRow = root.querySelector<HTMLElement>('.sdd-empty');
    const live = root.querySelector<HTMLElement>('[data-sdd-live]');
    if (!button || !panel || !hidden || !valueEl || !search || !listbox) return;

    let active = -1;
    const allOptions = () => Array.from(root.querySelectorAll<HTMLElement>('.sdd-option'));
    const visible = () => allOptions().filter((o) => !o.hidden && !o.closest('.sdd-collapsed') && o.offsetParent !== null);

    function clearActive() {
      active = -1;
      listbox?.removeAttribute('aria-activedescendant');
      root.querySelectorAll('.sdd-active').forEach((o) => o.classList.remove('sdd-active'));
    }
    function setActive(i: number) {
      const vis = visible();
      if (!vis.length) { clearActive(); return; }
      active = ((i % vis.length) + vis.length) % vis.length;
      vis.forEach((o, idx) => o.classList.toggle('sdd-active', idx === active));
      listbox?.setAttribute('aria-activedescendant', vis[active].id);
      vis[active].scrollIntoView({ block: 'nearest' });
    }
    function setCollapsed(ul: HTMLElement, collapsed: boolean) {
      ul.classList.toggle('sdd-collapsed', collapsed);
      const head = root.querySelector(`[aria-controls="${ul.id}"]`);
      head?.setAttribute('aria-expanded', String(!collapsed));
    }
    function applyFilter() {
      const q = (search?.value ?? '').trim().toLowerCase();
      if (clearBtn) clearBtn.hidden = !q;
      const anyOpt = root.querySelector<HTMLElement>('.sdd-option.sdd-any');
      if (anyOpt) anyOpt.hidden = !!q; // searching shows matches only
      let total = 0;
      root.querySelectorAll<HTMLElement>('.sdd-group').forEach((ul) => {
        let n = 0;
        ul.querySelectorAll<HTMLElement>('.sdd-option').forEach((o) => {
          const hit = !q || (o.textContent ?? '').toLowerCase().includes(q);
          o.hidden = !hit;
          if (hit) n++;
        });
        ul.hidden = n === 0;
        if (q && n > 0) setCollapsed(ul, false); // searching expands matching sections
        total += n;
      });
      root.querySelectorAll<HTMLElement>('.sdd-ghead').forEach((h) => {
        const btn = h.querySelector('.sdd-toggle');
        const id = btn?.getAttribute('aria-controls');
        const ul = id ? root.querySelector<HTMLElement>(`#${CSS.escape(id)}`) : null;
        h.hidden = !!ul && (ul.hidden || ul.classList.contains('sdd-collapsed'));
      });
      if (emptyRow) emptyRow.hidden = total > 0;
      clearActive();
    }
    function setOpen(open: boolean) {
      panel!.hidden = !open;
      button!.setAttribute('aria-expanded', String(open));
      if (open) {
        if (search) search.value = '';
        if (clearBtn) clearBtn.hidden = true;
        applyFilter();
        setTimeout(() => search?.focus(), 0);
      } else {
        clearActive();
        button!.focus();
      }
    }
    function choose(opt: HTMLElement) {
      allOptions().forEach((o) => o.setAttribute('aria-selected', String(o === opt)));
      hidden!.value = opt.dataset.value ?? '';
      const lbl = opt.dataset.label ?? opt.textContent?.trim() ?? '';
      valueEl!.textContent = lbl || valueEl!.dataset.placeholder || '';
      valueEl!.classList.toggle('sdd-set', !!opt.dataset.value);
      if (live) live.textContent = opt.dataset.value ? `Selected: ${lbl}` : `Selection cleared — ${valueEl!.dataset.placeholder ?? ''}`;
      setOpen(false);
    }

    button.addEventListener('click', () => setOpen(panel!.hidden));
    panel.addEventListener('keydown', (e) => {
      const vis = visible();
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active <= 0 ? 0 : active - 1); }
      else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
      else if (e.key === 'End') { e.preventDefault(); setActive(vis.length - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); if (active >= 0 && vis[active]) choose(vis[active]); }
      else if (e.key === 'Escape') { e.preventDefault(); setOpen(false); }
    });
    search?.addEventListener('input', applyFilter);
    clearBtn?.addEventListener('click', () => { search!.value = ''; applyFilter(); search?.focus(); });
    listbox.addEventListener('click', (e) => {
      const o = (e.target as HTMLElement).closest<HTMLElement>('.sdd-option');
      if (o && !o.hidden) choose(o);
    });
    root.querySelectorAll<HTMLButtonElement>('.sdd-toggle').forEach((t) =>
      t.addEventListener('click', () => {
        const id = t.getAttribute('aria-controls');
        const ul = id ? root.querySelector<HTMLElement>(`#${CSS.escape(id)}`) : null;
        if (ul) setCollapsed(ul, !ul.classList.contains('sdd-collapsed'));
      }),
    );
    document.addEventListener('click', (e) => {
      if (!panel!.hidden && !root.contains(e.target as Node)) { panel!.hidden = true; button!.setAttribute('aria-expanded', 'false'); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel!.hidden) setOpen(false);
    });
  }
  document.querySelectorAll<HTMLElement>('[data-sdd]').forEach(initSdd);
</script>
