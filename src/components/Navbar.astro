---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle';

const { user } = Astro.props as { user?: { displayName: string; role: string } | null };

// Primary navigation — evenly spaced, centered between logo and actions.
const links = [
  { href: '/search', label: 'Browse Businesses' },
  { href: '/browse/industries', label: 'Categories' },
  { href: '/browse/locations', label: 'States' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/verification', label: 'Verification' },
  { href: '/contact', label: 'Contact' },
];
const menuSecondary = [
  { href: '/events', label: 'Events' },
  { href: '/articles', label: 'Resource Center' },
  { href: '/claim-listing', label: 'Claim a listing' },
  { href: '/favorites', label: 'Favorites' },
];
---
<header class="sticky top-0 z-40 border-b" style="background:var(--bg);border-color:var(--border)">
  <!-- Balanced three-zone grid: logo / centered nav / actions -->
  <div class="mx-auto grid h-16 max-w-[1400px] grid-cols-[auto_1fr_auto] items-center gap-2 px-4 sm:gap-3 sm:px-6">
    <div class="justify-self-start">
      <Logo />
    </div>

    <nav class="hidden min-w-0 justify-center gap-0.5 lg:flex xl:gap-1" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="whitespace-nowrap rounded-lg px-2 py-2 text-[13px] font-medium transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--text)] xl:px-3 xl:text-sm"
          style="color:var(--text-soft)"
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center justify-end gap-1.5 sm:gap-2">
      <a href="/search" class="btn btn-ghost hidden !h-9 !w-9 !px-0 xl:inline-flex" aria-label="Search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="/add-listing" class="btn btn-primary hidden !h-9 !px-4 !py-0 !text-[13px] sm:inline-flex xl:!text-sm">List Your Business</a>
      {user ? (
        <a href="/dashboard" class="btn btn-secondary !h-9 !px-3 !py-0 !text-[13px]" title={`Signed in as ${user.displayName}`}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20c1.6-3.2 4.4-5 7.5-5s5.9 1.8 7.5 5"/></svg>
          <span class="max-w-[90px] truncate">{user.displayName}</span>
        </a>
      ) : (
        <a href="/auth/signin" class="btn btn-secondary hidden !h-9 !px-4 !py-0 !text-[13px] sm:inline-flex xl:!text-sm">Sign in</a>
      )}
      <ThemeToggle client:load />
      <details class="relative lg:hidden">
        <summary class="btn btn-ghost !h-9 !w-9 !px-0 cursor-pointer list-none" aria-label="Open menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="card absolute right-0 top-12 w-64 p-2">
          <p class="px-3 pb-1 pt-2 text-[11px] font-bold uppercase tracking-wide" style="color:var(--text-mute)">Directory</p>
          {links.map((l) => (
            <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium hover:bg-[var(--surface-2)]">{l.label}</a>
          ))}
          <hr class="my-1.5" style="border-color:var(--border)" />
          <p class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wide" style="color:var(--text-mute)">More</p>
          {menuSecondary.map((l) => (
            <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium hover:bg-[var(--surface-2)]">{l.label}</a>
          ))}
          <hr class="my-1.5" style="border-color:var(--border)" />
          <a href="/add-listing" class="btn btn-primary mt-1 w-full !py-2.5 !text-sm">List Your Business</a>
          {!user && <a href="/auth/signin" class="btn btn-secondary mt-1.5 w-full !py-2.5 !text-sm">Sign in</a>}
        </div>
      </details>
    </div>
  </div>
</header>
