---
interface Props {
  title: string;
  sub?: string;
  href?: string;
  linkLabel?: string;
}
const { title, sub, href, linkLabel } = Astro.props;
---
<section class="mx-auto mt-12 max-w-7xl px-4">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-2xl font-semibold">{title}</h2>
      {sub && <p class="mt-1 max-w-3xl text-sm leading-relaxed" style="color:var(--text-soft)">{sub}</p>}
    </div>
    {href && linkLabel && <a href={href} class="text-sm font-semibold underline">{linkLabel}</a>}
  </div>
  <slot />
</section>
