---
import '@/styles/global.css';
import ThemeHead from '@/components/ThemeHead.astro';
import VerseBanner from '@/components/VerseBanner.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { buildSeo, safeJsonLd, type SeoInput } from '@/lib/seo';

interface Props { seo: SeoInput; user?: { displayName: string; role: string } | null; wide?: boolean; mobileActions?: boolean }
const { seo, user = null, mobileActions = false } = Astro.props;
const s = buildSeo(seo);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.title}</title>
    <meta name="description" content={s.description} />
    {s.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={s.url} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:title" content={s.title} />
    <meta property="og:description" content={s.description} />
    <meta property="og:url" content={s.url} />
    <meta property="og:type" content={s.type ?? 'website'} />
    <meta property="og:image" content={s.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={s.title} />
    <meta name="twitter:description" content={s.description} />
    <meta name="twitter:image" content={s.image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    {(Array.isArray(s.schema) ? s.schema : s.schema ? [s.schema] : []).map((schema) => (
      <script type="application/ld+json" set:html={safeJsonLd(schema)} />
    ))}
    <ThemeHead />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-bold">Skip to content</a>
    <VerseBanner />
    <Navbar user={user} />
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
    {mobileActions && (
      <nav class="mobile-action-bar md:hidden" hidden aria-label="Quick actions">
        <a href="/search" class="btn btn-secondary">Browse businesses</a>
        <a href="/add-listing" class="btn btn-primary">List your business free</a>
      </nav>
    )}
    <script>
      import { initPageAnimations } from '@/components/HeroAnimations';
      import '@/scripts/listingAnalytics';
      initPageAnimations();
      const bar = document.querySelector('.mobile-action-bar');
      const hero = document.querySelector('[data-mobile-hero]');
      if (bar && hero && 'IntersectionObserver' in window) {
        const showBar = (show: boolean) => {
          bar.toggleAttribute('hidden', !show);
          document.body.classList.toggle('has-mobile-actions', show);
        };
        const observer = new IntersectionObserver(
          ([entry]) => showBar(!entry.isIntersecting),
          { threshold: 0.2 },
        );
        observer.observe(hero);
      }
    </script>
    <style>
      .mobile-action-bar {
        position: fixed;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 30;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
        background: var(--bg);
        border-top: 1px solid var(--border);
      }
      .mobile-action-bar .btn {
        min-height: 44px;
        padding-left: 0.7rem;
        padding-right: 0.7rem;
        text-align: center;
        line-height: 1.2;
      }
      @media (max-width: 767px) {
        body.has-mobile-actions { padding-bottom: 8rem; }
      }
    </style>
  </body>
</html>
