---
import BaseLayout from './BaseLayout.astro';
import type { SeoInput } from '@/lib/seo';

interface Props {
  seo: SeoInput;
  user: { displayName: string; role: string } | null;
  admin?: boolean;
  active?: string;
}
const { seo, user, admin = false, active = '' } = Astro.props;
const ownerLinks = [
  ['Overview', '/dashboard', 'overview'],
  ['My listings', '/dashboard/listings', 'listings'],
  ['Reviews', '/dashboard/reviews', 'reviews'],
  ['Listing status', '/dashboard/verification', 'verification'],
  ['Analytics', '/dashboard/analytics', 'analytics'],
  ['Events', '/dashboard/events', 'events'],
  ['Account', '/account', 'account'],
];
const adminLinks = [
  ['Overview', '/admin', 'overview'],
  ['Listings', '/admin/listings', 'listings'],
  ['Listing notes', '/admin/verifications', 'verifications'],
  ['Claims', '/admin/claims', 'claims'],
  ['Reviews', '/admin/reviews', 'reviews'],
  ['Reports', '/admin/reports', 'reports'],
  ['Taxonomy', '/admin/taxonomy', 'taxonomy'],
  ['Users', '/admin/users', 'users'],
  ['Analytics', '/admin/analytics', 'analytics'],
];
const links = admin ? adminLinks : ownerLinks;
---
<BaseLayout seo={seo} user={user}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <div class="grid gap-6 lg:grid-cols-[230px_1fr]">
      <aside class="card h-fit p-3 lg:sticky lg:top-20" aria-label={admin ? 'Admin navigation' : 'Dashboard navigation'}>
        <div class="border-b px-3 pb-3 pt-1" style="border-color:var(--border)">
          <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--text-mute)">{admin ? 'Admin' : 'Owner dashboard'}</p>
          <p class="truncate text-sm font-bold">{user?.displayName ?? 'Account'}</p>
        </div>
        <nav class="mt-2 space-y-1">
          {links.map(([label, href, key]) => (
            <a href={href} aria-current={active === key ? 'page' : undefined}
              class={`block rounded-xl px-3 py-2 text-sm font-medium transition-colors ${active === key ? 'bg-[rgba(216,149,34,.16)] font-bold' : 'hover:bg-[var(--surface-2)]'}`}>
              {label}
            </a>
          ))}
        </nav>
        <form method="POST" action="/api/auth/signout" class="mt-3 border-t pt-3" style="border-color:var(--border)">
          <button class="w-full rounded-xl px-3 py-2 text-left text-sm font-medium hover:bg-[var(--surface-2)]" style="color:var(--text-soft)">Sign out →</button>
        </form>
      </aside>
      <div class="min-w-0"><slot /></div>
    </div>
  </div>
</BaseLayout>
