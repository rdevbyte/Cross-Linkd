---
import BaseLayout from './BaseLayout.astro';
import type { SeoInput } from '@/lib/seo';
import { isStaff } from '@/lib/guards';

interface Props {
  seo: SeoInput;
  user: { displayName: string; role: string } | null;
  admin?: boolean;
  active?: string;
}
const { seo, user, admin = false, active = '' } = Astro.props;
const canViewAdmin = isStaff(user);
type SidebarLink = { label: string; href: string; key: string };
const ownerLinks: SidebarLink[] = [
  { label: 'Overview', href: '/dashboard', key: 'overview' },
  { label: 'My listings', href: '/dashboard/listings', key: 'listings' },
  { label: 'Reviews', href: '/dashboard/reviews', key: 'reviews' },
  { label: 'Listing status', href: '/dashboard/verification', key: 'verification' },
  { label: 'Analytics', href: '/dashboard/analytics', key: 'analytics' },
  { label: 'Events', href: '/dashboard/events', key: 'events' },
  { label: 'Account', href: '/account', key: 'account' },
  ...(canViewAdmin ? [{ label: 'Messages & reports', href: '/admin/reports', key: 'reports' }] : []),
];
const adminLinks: SidebarLink[] = [
  { label: 'Overview', href: '/admin', key: 'overview' },
  { label: 'Listings', href: '/admin/listings', key: 'listings' },
  { label: 'Listing notes', href: '/admin/verifications', key: 'verifications' },
  { label: 'Claims', href: '/admin/claims', key: 'claims' },
  { label: 'Reviews', href: '/admin/reviews', key: 'reviews' },
  { label: 'Messages & reports', href: '/admin/reports', key: 'reports' },
  { label: 'Taxonomy', href: '/admin/taxonomy', key: 'taxonomy' },
  { label: 'Users', href: '/admin/users', key: 'users' },
  { label: 'Analytics', href: '/admin/analytics', key: 'analytics' },
];
const links = admin ? adminLinks : ownerLinks;
---
<BaseLayout seo={seo} user={user}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <div class="grid gap-6 lg:grid-cols-[230px_1fr]">
      <aside class="card h-fit p-3 lg:sticky lg:top-20" aria-label={admin ? 'Admin navigation' : 'Dashboard navigation'}>
        <div class="border-b px-3 pb-3 pt-1" style="border-color:var(--border)">
          <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--text-mute)">{admin ? 'Admin' : 'Owner dashboard'}</p>
          <p class="truncate text-sm font-bold">{user?.displayName ?? 'Account'}</p>
        </div>
        <nav class="mt-2" aria-label={admin ? 'Admin pages' : 'Dashboard pages'}>
          <ul class="dashboard-nav-list">
            {links.map((link) => (
              <li>
                <a href={link.href} aria-current={active === link.key ? 'page' : undefined} class="dashboard-nav-link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <form method="POST" action="/api/auth/signout" class="mt-3 border-t pt-3" style="border-color:var(--border)">
          <button class="w-full rounded-xl px-3 py-2 text-left text-sm font-medium hover:bg-[var(--surface-2)]" style="color:var(--text-soft)">Sign out →</button>
        </form>
      </aside>
      <div class="min-w-0"><slot /></div>
    </div>
  </div>
</BaseLayout>
<style>
  .dashboard-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dashboard-nav-link {
    display: block;
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .dashboard-nav-link:hover {
    background: var(--surface-2);
  }
  .dashboard-nav-link[aria-current='page'] {
    background: rgba(216, 149, 34, 0.16);
    font-weight: 700;
  }
</style>
