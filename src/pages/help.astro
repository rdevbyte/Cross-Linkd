---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
const faqs = [
  ['How do I add my business or ministry?', 'Open “List Your Business,” fill in your details, and submit. A published listing is owner-submitted. CrossLinkd may review it for completeness. That is not a verification of faith, ownership, or licenses. Basic listings are free.'],
  ['How do hashtags work?', 'Type # while searching to get suggestions like #Baptist or #ChristianOwned. A hashtag is a label the listing uses. It is not a CrossLinkd verification.'],
  ['Does CrossLinkd verify listings?', 'No. CrossLinkd does not independently verify faith, ownership, licenses, certifications, credentials, or service quality. See Listing Statuses for the words we do use.'],
  ['How do I claim an existing listing?', 'Open the profile and click “Claim this listing,” or visit the claim page. You show control of a contact channel. A successful claim is Owner claimed, not verified.'],
  ['Does CrossLinkd charge for anything?', 'No. Listings and claiming are free right now, and you will not be asked for payment details to list. CrossLinkd does not sell verification, because it does not offer it.'],
  ['How do I report a listing or review?', 'Use the contact form to report a listing or review. Appeals are saved from the appeals page for a person to read. An appeal is not a verification, and a reply time is not promised.'],
];
---
<BaseLayout user={user} seo={{ title: 'Help Center — CrossLinkd', description: 'Answers about adding listings, claiming profiles, Listing Statuses, and hashtags.', path: '/help' }}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Help center</h1>
    <p class="section-sub">Quick answers. Still stuck? <a href="/contact" class="underline">Contact us</a> · <a href="/feedback" class="underline">Suggest an improvement</a>.</p>
    <div class="mt-6 space-y-3">
      {faqs.map(([q, a]) => (
        <details class="card p-5"><summary class="cursor-pointer font-bold">{q}</summary><p class="mt-2 text-sm" style="color:var(--text-soft)">{a}</p></details>
      ))}
    </div>
  </div>
</BaseLayout>
