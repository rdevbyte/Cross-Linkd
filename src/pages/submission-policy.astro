---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LONG_DISCLAIMER, REPORT_DISCLOSURE } from '@/lib/trustCopy';
const user = Astro.locals.user;
const seo = {
  title: 'Business Submission Policy | CrossLinkd',
  description: 'Submission guidelines for CrossLinkd listings. Details are not independently verified, and inclusion is not an endorsement.',
  path: '/submission-policy',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Business submission policy</h1>
    <p class="section-sub">What can be listed, what information is self-reported, and how to flag a concern.</p>
    <p class="card mt-5 p-5 text-sm leading-relaxed" style="color:var(--text-soft)">{LONG_DISCLAIMER}</p>

    <div class="prose-custom mt-8 space-y-6 text-[15px] leading-relaxed" style="color:var(--text-soft)">
      <div>
        <h2 class="text-xl font-semibold" style="color:var(--text)">Who may submit a listing</h2>
        <p class="mt-2">Listings may be submitted by business owners, authorized representatives, or community members. Where the source is recorded, the profile is labeled Owner-submitted or Community-submitted. If no source label appears, the source was not recorded.</p>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Businesses whose owners identify them as Christian-owned. That identification is self-reported and not independently confirmed.</li>
          <li>Churches, ministries, nonprofits, schools, and organizations with a public name and contact option.</li>
          <li>Individual professionals. Any credential or license mentioned is supplied by the submitter, not independently checked by CrossLinkd.</li>
          <li>Online businesses and organizations. Details are not independently verified.</li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-semibold" style="color:var(--text)">Content requirements</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Use the organization's public name and accurate information to the best of your knowledge.</li>
          <li>Required form fields must be present to submit. A field being present does not mean its contents were checked.</li>
          <li>Descriptions should explain the organization, not repeat search keywords.</li>
          <li>Do not submit spam, impersonation, illegal content, or material that violates the <a href="/guidelines" class="underline">community guidelines</a>.</li>
          <li>Reviews follow the <a href="/reviews-policy" class="underline">review policy</a>; owners may not review their own business.</li>
        </ul>
      </div>

      <div>
        <h2 id="removal" class="text-xl font-semibold" style="color:var(--text)">Corrections and reports</h2>
        <p class="mt-2">{REPORT_DISCLOSURE} Submitting a report does not guarantee a response or content change. Copyright notices use the <a href="/copyright" class="underline">copyright page</a>.</p>
        <p class="mt-2">Owners can request access to manage or update an existing listing. Management access does not verify the business or its claims. To ask about a moderation decision, use the <a href="/appeals" class="underline">appeals page</a>.</p>
      </div>

      <div>
        <h2 class="text-xl font-semibold" style="color:var(--text)">Publication</h2>
        <p class="mt-2">Some submissions may be held for content moderation before publication. A published listing is visible in the directory; publication does not mean the profile details were independently verified or endorsed.</p>
      </div>
    </div>
  </div>
</BaseLayout>
