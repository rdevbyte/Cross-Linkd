---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import { ARTICLES, articleBySlug } from '@/data/articles';
import { listingBySlug } from '@/data/listings';
import { articleSchema, breadcrumbSchema } from '@/lib/seo';

const { slug } = Astro.params;
const article = slug ? articleBySlug(slug) : undefined;
if (!article) return Astro.redirect('/articles', 302);

const user = Astro.locals.user;
const siteUrl = Astro.url.origin;
const pageUrl = `${siteUrl}/articles/${article.slug}`;
const relatedListings = article.relatedListingSlugs
  .map((s) => listingBySlug(s))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));

const seo = {
  title: `${article.title} | CrossLinkd`,
  description: article.excerpt,
  path: `/articles/${article.slug}`,
  type: 'article' as const,
  schema: [
    articleSchema({ title: article.title, description: article.excerpt, url: pageUrl, publishedDaysAgo: article.publishedDaysAgo, updatedDaysAgo: article.updatedDaysAgo }),
    breadcrumbSchema([
      { name: 'Home', url: siteUrl },
      { name: 'Resource Center', url: `${siteUrl}/articles` },
      { name: article.title, url: pageUrl },
    ]),
  ],
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav class="text-[13px]" style="color:var(--text-mute)" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a> / <a href="/articles" class="hover:underline">Resource Center</a> / <span style="color:var(--text)">{article.category}</span>
    </nav>

    <p class="mt-4 text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">{article.category}</p>
    <h1 class="mt-1 text-3xl font-extrabold leading-tight">{article.title}</h1>
    <p class="mt-2 text-[15px]" style="color:var(--text-soft)">{article.excerpt}</p>
    <p class="mt-3 text-xs" style="color:var(--text-mute)">
      Published {new Date(Date.now() - article.publishedDaysAgo * 86400000).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      {article.updatedDaysAgo ? ` · updated ${new Date(Date.now() - article.updatedDaysAgo * 86400000).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}` : ''}
      · by the CrossLinkd team
    </p>

    <div class="prose-custom mt-8 space-y-8">
      {article.sections.map((section) => (
        <section>
          <h2 class="text-xl font-extrabold">{section.heading}</h2>
          {section.body.map((p) => <p class="mt-2 text-[15px] leading-relaxed" style="color:var(--text-soft)" set:html={p.replace(/\n/g, '<br />')} />)}
        </section>
      ))}
    </div>

    {relatedListings.length > 0 && (
      <section class="mt-12" aria-label="Listings mentioned in this article">
        <h2 class="text-xl font-extrabold">Listings in this guide</h2>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">Live profiles we checked while writing this article.</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {relatedListings.map((l) => <ListingCard listing={l} />)}
        </div>
      </section>
    )}

    <div class="mt-10 flex flex-wrap gap-3">
      {article.relatedCategory && <a href={article.relatedCategory.href} class="btn btn-secondary !py-2 !text-sm">{article.relatedCategory.label} →</a>}
      {article.relatedCity && <a href={article.relatedCity.href} class="btn btn-secondary !py-2 !text-sm">{article.relatedCity.label} →</a>}
      <a href="/add-listing" class="btn btn-primary !py-2 !text-sm">List Your Business</a>
    </div>
  </div>
</BaseLayout>
