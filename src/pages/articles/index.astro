---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ARTICLES } from '@/data/articles';
const user = Astro.locals.user;
const seo = {
  title: 'Resource Center — Guides for Finding Christian-Owned Businesses | CrossLinkd',
  description: 'Practical guides: hiring Christian-owned contractors, choosing accountants, understanding ownership labels, and owner interviews — all connected to real listings.',
  path: '/articles',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Resource center</h1>
    <p class="section-sub">Short, practical guides for finding and evaluating Christian-owned businesses. Every guide links to real listings — we publish advice, not ads. See our <a href="/editorial-policy" class="underline">editorial policy</a>.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2" data-animate="grid">
      {ARTICLES.map((a) => (
        <a href={`/articles/${a.slug}`} class="card card-hover overflow-hidden">
          <div class="h-24" style={`background:hsl(${a.hue},26%,80%)`}></div>
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">{a.category}</p>
            <h2 class="mt-1 font-extrabold leading-snug">{a.title}</h2>
            <p class="mt-1.5 text-sm" style="color:var(--text-soft)">{a.excerpt}</p>
            <p class="mt-3 text-xs" style="color:var(--text-mute)">
              {a.publishedDaysAgo < 7 ? 'This week' : a.publishedDaysAgo < 30 ? `${Math.round(a.publishedDaysAgo / 7)} weeks ago` : `${Math.round(a.publishedDaysAgo / 30)} month${a.publishedDaysAgo >= 60 ? 's' : ''} ago`}{a.updatedDaysAgo ? ' · updated recently' : ''} · links to {a.relatedListingSlugs.length} listing{a.relatedListingSlugs.length === 1 ? '' : 's'}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
