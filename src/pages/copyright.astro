---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
---
<BaseLayout user={user} seo={{ title: 'Copyright — CrossLinkd', description: 'Copyright and DMCA reporting.', path: '/copyright' }}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Copyright</h1>
    <div class="mt-6 space-y-4 text-[15px] leading-relaxed" style="color:var(--text-soft)">
      <p>To report copyright infringement, send the work, the infringing URL, your contact details, and a good-faith statement via our <a href="/contact?topic=report" class="underline">contact form</a> (topic: Report). Valid notices are actioned promptly; counter-notices follow the same process. Impersonation reports use the same channel.</p>
    </div>
  </div>
</BaseLayout>
