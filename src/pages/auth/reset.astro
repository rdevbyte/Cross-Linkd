---
import BaseLayout from '@/layouts/BaseLayout.astro';
const sent = Astro.url.searchParams.get('sent') === '1';
const token = Astro.url.searchParams.get('token') ?? '';
const error = Astro.url.searchParams.get('error') ?? '';
---
<BaseLayout seo={{ title: 'Reset Password — CrossLinkd', description: 'Reset your password.', path: '/auth/reset', noindex: true }}>
  <div class="mx-auto max-w-md px-4 py-14">
    <div class="card p-8">
      <h1 class="text-2xl font-bold">{token ? 'Choose a new password' : 'Reset password'}</h1>
      {error && <p class="mt-3 rounded-xl p-3 text-sm" style="background:rgba(196,74,58,.12)" role="alert">{error}</p>}
      {sent ? (
        <p class="mt-3 rounded-xl p-3 text-sm" style="background:rgba(46,146,131,.12)">If an account exists for that email, a reset link is on its way.</p>
      ) : token ? (
        <form method="POST" action="/api/auth/reset" class="mt-5 space-y-4">
          <input type="hidden" name="intent" value="confirm" />
          <input type="hidden" name="token" value={token} />
          <label class="block text-sm font-medium">New password<input name="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" class="input mt-1.5" /></label>
          <button class="btn btn-primary w-full !py-3" type="submit">Set new password</button>
          <p class="text-xs" style="color:var(--text-soft)">Setting a new password signs you out everywhere else.</p>
        </form>
      ) : (
        <form method="POST" action="/api/auth/reset" class="mt-5 space-y-4">
          <label class="block text-sm font-medium">Email<input name="email" type="email" required class="input mt-1.5" /></label>
          <button class="btn btn-primary w-full !py-3" type="submit">Send reset link</button>
        </form>
      )}
    </div>
  </div>
</BaseLayout>
