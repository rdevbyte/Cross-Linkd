---
import BaseLayout from '@/layouts/BaseLayout.astro';
const sent = Astro.url.searchParams.get('sent') === '1';
---
<BaseLayout seo={{ title: 'Reset Password — CrossLinkd', description: 'Reset your password.', path: '/auth/reset', noindex: true }}>
  <div class="mx-auto max-w-md px-4 py-14">
    <div class="card p-8">
      <h1 class="text-2xl font-extrabold">Reset password</h1>
      {sent ? (
        <p class="mt-3 rounded-xl p-3 text-sm" style="background:rgba(46,146,131,.12)">If an account exists for that email, a reset link is on its way.</p>
      ) : (
        <form method="POST" action="/api/auth/reset" class="mt-5 space-y-4">
          <label class="block text-sm font-medium">Email<input name="email" type="email" required class="input mt-1.5" /></label>
          <button class="btn btn-primary w-full !py-3" type="submit">Send reset link</button>
        </form>
      )}
    </div>
  </div>
</BaseLayout>
