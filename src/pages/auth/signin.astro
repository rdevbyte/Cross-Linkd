---
import BaseLayout from '@/layouts/BaseLayout.astro';
const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice') ?? '';
const notices: Record<string, string> = {
  'signin-required': 'Please sign in to continue.',
  'password-reset': 'Password updated — sign in with your new password.',
};
const sentMagic = Astro.url.searchParams.get('sent') === 'magic';
const next = Astro.url.searchParams.get('next') ?? '/dashboard';
---
<BaseLayout seo={{ title: 'Sign In — CrossLinkd', description: 'Sign in to manage listings, save favorites, and follow ministries.', path: '/auth/signin', noindex: true }}>
  <div class="mx-auto max-w-md px-4 py-14">
    <div class="card p-8">
      <h1 class="text-2xl font-extrabold">Welcome back</h1>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Sign in to manage listings and favorites.</p>
      {error && <p class="mt-4 rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-600" role="alert">{error}</p>}
      {notice && notices[notice] && <p class="mt-4 rounded-xl p-3 text-sm font-medium" style="background:var(--accent-soft);color:var(--text)" role="status">{notices[notice]}</p>}
      {sentMagic && <p class="mt-4 rounded-xl p-3 text-sm font-medium" style="background:var(--accent-soft);color:var(--text)" role="status">Check your inbox — we sent a sign-in link. It expires in 15 minutes.</p>}
      <form method="POST" action="/api/auth/signin" class="mt-5 space-y-4">
        <input type="hidden" name="next" value={next} />
        <label class="block text-sm font-medium">Email<input name="email" type="email" required class="input mt-1.5" placeholder="you@example.com" autocomplete="email" /></label>
        <label class="block text-sm font-medium">Password<input name="password" type="password" required class="input mt-1.5" autocomplete="current-password" /></label>
        <button class="btn btn-primary w-full !py-3" type="submit">Sign in</button>
      </form>
      <form method="POST" action="/api/auth/magic-link" class="mt-3">
        <p class="text-center text-[13px]" style="color:var(--text-mute)">— or —</p>
        <button class="btn btn-secondary mt-2 w-full" type="submit">Email me a magic link</button>
      </form>
      <p class="mt-4 text-center text-sm" style="color:var(--text-soft)">New here? <a href="/auth/signup" class="font-bold underline">Create an account</a></p>
      <p class="mt-1 text-center text-[13px]"><a href="/auth/reset" class="underline" style="color:var(--text-mute)">Forgot password?</a></p>
    </div>
  </div>
</BaseLayout>
