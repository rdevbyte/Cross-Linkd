---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error') ?? '';
const seo = {
  title: 'Suggest an improvement | CrossLinkd',
  description: 'Send a product suggestion. A saved suggestion is not a promise to build it, and it is not a verification.',
  path: '/feedback',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Suggest an improvement</h1>
    <p class="section-sub">Tell us what would make the directory easier to use. A suggestion is not a feature promise.</p>

    {sent ? (
      <div class="card mt-6 p-6" style="border-left:4px solid var(--teal)" role="status">
        <p class="font-bold">Suggestion saved</p>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">A person can read it when the inbox is checked. We do not promise a reply time.</p>
      </div>
    ) : (
      <form method="POST" action="/api/contact" class="card mt-6 space-y-4 p-6">
        <input type="hidden" name="topic" value="Suggest an improvement" />
        <input type="hidden" name="return" value="/feedback" />
        <p class="hp-field" aria-hidden="true"><label>Leave this blank<input type="text" name="hp_company" tabindex="-1" autocomplete="off" /></label></p>
        {error && <p class="rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-700" role="alert">{error}</p>}
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="text-sm font-medium">Name<input name="name" required class="input mt-1.5" value={user?.displayName ?? ''} autocomplete="name" /></label>
          <label class="text-sm font-medium">Email<input name="email" type="email" required class="input mt-1.5" value={user?.email ?? ''} autocomplete="email" /></label>
        </div>
        <label class="block text-sm font-medium">Suggestion
          <textarea name="message" required minlength="10" rows="6" class="input mt-1.5" placeholder="What should be easier, and where did you run into it?"></textarea>
        </label>
        <button class="btn btn-primary w-full !py-3" type="submit">Save suggestion</button>
      </form>
    )}
  </div>
</BaseLayout>
