---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { professionBySlug, industryBySlug } from '@/data/industries';
import { getPublicListings } from '@/lib/publicListings';

const corpus = await getPublicListings();

const { slug } = Astro.params;
const prof = slug ? professionBySlug(slug) : undefined;
if (!prof) return Astro.redirect('/browse/professions', 302);
const user = Astro.locals.user;
const industry = industryBySlug(prof.industrySlug);
const matches = corpus.filter((l) => l.professions.includes(prof.slug));
---
<BaseLayout user={user} seo={{ title: `${prof.name} — CrossLinkd`, description: `Find Christian ${prof.name.toLowerCase()}s. ${prof.services?.join(', ') ?? ''}`.slice(0, 160), path: `/professions/${prof.slug}` }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <nav class="text-[13px]" style="color:var(--text-mute)"><a href="/browse/professions" class="hover:underline">Professions</a> / <span style="color:var(--text)">{prof.name}</span></nav>
    <h1 class="mt-2 text-3xl font-extrabold">Christian {prof.name}s</h1>
    <p class="section-sub">{industry?.name}{prof.requiresLicense ? ' • Licensed field — credentials can be displayed and verified.' : ''}</p>
    {prof.services && <div class="mt-4 flex flex-wrap gap-2">{prof.services.map((s) => <a href={`/search?q=${encodeURIComponent(s)}`} class="chip hover:border-[var(--accent)]">{s}</a>)}</div>}
    <h2 class="mt-8 text-xl font-extrabold">Listings ({matches.length})</h2>
    {matches.length === 0 ? (
      <div class="mt-4"><EmptyState title="No listings yet" body="Be the first professional here." actionHref="/add-listing" actionLabel="List Your Business" /></div>
    ) : (
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{matches.map((l) => <ListingCard listing={l} />)}</div>
    )}
  </div>
</BaseLayout>
