---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
---
<BaseLayout user={user} seo={{ title: 'Page not found — CrossLinkd', description: 'That page is not on CrossLinkd.', path: '/404', noindex: true }}>
  <div class="mx-auto max-w-xl px-4 py-16 text-center">
    <p class="text-sm font-bold" style="color:var(--text-mute)">404</p>
    <h1 class="mt-2 text-3xl font-bold">That page is not here</h1>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed" style="color:var(--text-soft)">This is not a hidden listing or a verification page. If a link is broken, search published listings or go back home.</p>
    <div class="mt-6 flex justify-center">
      <a href="/" class="btn btn-primary">Home</a>
    </div>
  </div>
</BaseLayout>
