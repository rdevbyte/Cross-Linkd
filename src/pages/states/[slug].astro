---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import { getPublicListings } from '@/lib/publicListings';
import { FOCUS_CITIES, stateBySlug } from '@/data/locations';
import { breadcrumbSchema } from '@/lib/seo';

const { slug } = Astro.params;
const state = slug ? stateBySlug(slug) : undefined;
if (!state) return Astro.redirect('/browse/locations', 302);

const user = Astro.locals.user;
const siteUrl = Astro.url.origin;
const allPublic = await getPublicListings();
const stateListings = allPublic.filter((l) => l.region === state.abbr && !l.isOnlineOnly);
const verified = stateListings.filter((l) => l.verified).length;
const cities = FOCUS_CITIES.filter((c) => c.region === state.abbr);

const seo = {
  title: `Christian-Owned Businesses in ${state.name} (${state.abbr}) | CrossLinkd`,
  description: `${stateListings.length} reviewed Christian-owned businesses, churches, and ministries across ${cities.map((c) => c.city).join(' and ')}, ${state.name}. ${verified} verified with dates on every profile.`,
  path: `/states/${state.slug}`,
  schema: breadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Browse by State', url: `${siteUrl}/browse/locations` },
    { name: state.name, url: `${siteUrl}/states/${state.slug}` },
  ]),
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <nav class="text-[13px]" style="color:var(--text-mute)" aria-label="Breadcrumb">
      <a href="/browse/locations" class="hover:underline">Browse by State</a> / <span style="color:var(--text)">{state.name}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-extrabold">Christian-owned businesses in {state.name}</h1>
    <p class="section-sub">
      {stateListings.length} reviewed listings · {verified} verified · {cities.map((c) => c.city).join(', ')}.
      We list only what we have personally checked.
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {cities.map((c) => (
        <a href={`/locations/${c.slug}`} class="chip !px-4 !py-2 !text-[13px] hover:border-[var(--accent)]">{c.city}, {c.region} ({allPublic.filter((l) => l.city === c.city).length})</a>
      ))}
      <a href={`/search?near=${encodeURIComponent(state.name)}`} class="chip !px-4 !py-2 !text-[13px] hover:border-[var(--accent)]">Search all of {state.name}</a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
      {stateListings.sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false)).map((l) => <ListingCard listing={l} />)}
    </div>
  </div>
</BaseLayout>
