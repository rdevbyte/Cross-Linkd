---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import { getPublicListings } from '@/lib/publicListings';
import { FOCUS_CITIES, stateBySlug } from '@/data/locations';
import { breadcrumbSchema } from '@/lib/seo';

const { slug } = Astro.params;
const state = slug ? stateBySlug(slug) : undefined;
if (!state) return Astro.redirect('/browse/locations', 302);

const user = Astro.locals.user;
const siteUrl = Astro.url.origin;
const allPublic = await getPublicListings();
const stateListings = allPublic.filter((l) => l.region === state.abbr && !l.isOnlineOnly);
const citiesWithListings = FOCUS_CITIES.filter((c) => c.region === state.abbr && allPublic.some((l) => l.city === c.city && !l.isOnlineOnly));

const seo = {
  title: `Owner-submitted listings in ${state.name} | CrossLinkd`,
  description: stateListings.length > 0
    ? `${stateListings.length} owner-submitted listing${stateListings.length === 1 ? '' : 's'} in ${state.name}. CrossLinkd has not independently verified them.`
    : `No published listings in ${state.name} yet.`,
  path: `/states/${state.slug}`,
  noindex: stateListings.length === 0,
  schema: breadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Browse by location', url: `${siteUrl}/browse/locations` },
    { name: state.name, url: `${siteUrl}/states/${state.slug}` },
  ]),
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li><a href="/browse/locations">Browse by location</a></li>
        <li aria-current="page">{state.name}</li>
      </ol>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">Listings in {state.name}</h1>
    <p class="section-sub">
      {stateListings.length} owner-submitted listing{stateListings.length === 1 ? '' : 's'}. CrossLinkd has not independently verified faith, ownership, licenses, or service quality.
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {citiesWithListings.map((c) => (
        <a href={`/locations/${c.slug}`} class="chip !px-4 !py-2 !text-[13px] hover:border-[var(--accent)]">{c.city}, {c.region} ({allPublic.filter((l) => l.city === c.city && !l.isOnlineOnly).length})</a>
      ))}
      <a href={`/search?near=${encodeURIComponent(state.name)}`} class="chip !px-4 !py-2 !text-[13px] hover:border-[var(--accent)]">Search all of {state.name}</a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
      {stateListings.sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false)).map((l) => <ListingCard listing={l} />)}
    </div>
  </div>
</BaseLayout>
