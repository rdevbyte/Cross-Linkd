---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/how-it-works.css';
import StatusBadge from '@/components/StatusBadge.astro';
import { ATTESTATION, COMMUNITY_LISTED, LISTING_STATUSES, REPORT_DISCLOSURE, SHORT_DISCLAIMER } from '@/lib/trustCopy';

const user = Astro.locals.user;
const slugId = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const steps = [
  ['Submit or discover a listing', 'Profiles may be submitted by owners or community members. Visitors can browse what is published.'],
  ['Some submissions may be moderated', 'A submission may be held under the directory content rules before publication. This is not an independent check of business details.'],
  ['Read the source label when available', 'A profile may be labeled Owner-submitted or Community-submitted when its source is recorded. No source label means the source was not recorded.'],
  ['Owners can request profile access', 'Management access lets an owner or authorized representative update a listing. It does not verify the business or its claims.'],
  ['Flag content or request a correction', REPORT_DISCLOSURE],
];

const ownerSteps = [
  ['Submit a basic listing', 'Owners and authorized representatives can add a profile. The basic listing is free.'],
  ['Provide accurate information', 'Required fields and your accuracy attestation are submission requirements, not independent fact checks.'],
  ['See the profile published', 'Publication makes the listing visible. It is not an endorsement or an independent verification.'],
  ['Request management access', 'Use the management request to update an existing profile. Access does not verify business ownership or profile claims.'],
  ['Keep details current', 'Update hours, service area, contact details, and other profile information when they change.'],
  ['Flag a correction or concern', REPORT_DISCLOSURE],
];

const statusItems = [COMMUNITY_LISTED, ...LISTING_STATUSES].map((status) => ({
  ...status,
  id: `status-${slugId(status.name)}`,
}));
const statusDefinition = (name: string) => statusItems.find((status) => status.name === name)?.definition ?? '';

const listingChanges = [
  { title: 'Pending moderation', body: 'A submission may be held before publication under content rules. This is not a fact-check.' },
  { title: 'Published', body: 'The profile is visible in the directory. Publication is not an endorsement.' },
  { title: 'Owner-managed', body: statusDefinition('Owner-managed') },
  { title: 'Community reported', body: statusDefinition('Community reported') },
  { title: 'Needs update', body: statusDefinition('Needs update') },
  { title: 'Inactive', body: statusDefinition('Inactive') },
];

const reports = [
  'Flag inaccurate or outdated information',
  'Report a duplicate',
  'Report spam or inappropriate content',
  'Request a correction',
  'Request removal',
];

const profileExampleItems = [
  { label: 'Category', value: 'Shown when the submitter chooses one.' },
  { label: 'Location', value: 'Shown when the submitter provides a place, or marked Online.' },
  { label: 'Submission source', value: 'Not recorded in this example.' },
  { label: 'Owner management', badge: { name: 'Owner-managed', definition: 'The listing is connected to an account that can update it. This does not verify the business or its details.' } },
  { label: 'Reviews or community feedback', value: 'No reviews shown.' },
];

const profileElements = [
  { title: 'Name and category', body: 'Provided by the listing submitter.' },
  { title: 'Source label', body: 'Shown only when the submission source is recorded; it does not verify listing details.' },
  { title: 'Management label', body: 'Indicates profile-update access, not verified business ownership.' },
  { title: 'Community feedback', body: 'Submitted by users and not an independent check of the business.' },
  { title: 'Report option', body: 'Lets users flag content for review; it does not confirm the issue.' },
];

const requirements = [
  {
    title: 'Required information',
    body: [
      ['Listing type', 'Choose the type for the profile.'],
      ['Name', 'Provide the name of the business or organization.'],
      ['Accuracy attestation', `“${ATTESTATION}”`],
    ],
  },
  {
    title: 'Information that is not required',
    intro: 'CrossLinkd does not request:',
    body: [
      ['Identity documents', 'Not requested.'],
      ['Licenses', 'Not requested.'],
      ['Private religious records', 'Not requested.'],
    ],
  },
  {
    title: 'Public information',
    description: 'Only contact fields you mark as public appear on the profile.',
  },
  {
    title: 'Optional faith statements',
    description: 'A faith statement is optional and provided by the submitter.',
  },
  {
    title: 'What happens after submission',
    description: 'Some submissions may be held for content moderation before publication. Publication does not verify the information or endorse the organization.',
  },
  {
    title: 'Updating or removing a listing',
    description: 'Owners can request access to manage or update an existing profile, or use the contact form to request a correction or removal.',
  },
];

const faqs = [
  { question: 'What “Christian-owned” means on CrossLinkd', answer: 'It means the submitter identified the business as Christian-owned. CrossLinkd does not independently verify that claim.' },
  { question: 'What information is self-reported', answer: 'Profile text, location, hours, faith statements, credentials, and other details come from the submitter. They are not independently verified.' },
  { question: 'Does CrossLinkd fact-check listings?', answer: 'No. Listing details are not independently verified, and inclusion is not an endorsement.' },
  { question: 'What listing statuses mean', answer: 'Source labels identify who submitted a profile when that information is recorded. Management and directory-status labels do not certify a business or its claims.' },
  { question: 'Where listings come from', answer: 'Owners and community members may submit or suggest listings. When the source is recorded, profiles are labeled Owner-submitted or Community-submitted; otherwise the source is not recorded.' },
  { question: 'How can a community member suggest a listing?', answer: 'Use the “Suggest a listing” topic on the contact form and include the organization name, website, and location if known. A suggestion does not guarantee publication or a reply.' },
  { question: 'Whether a church recommendation is an endorsement', answer: 'A church or community recommendation means someone submitted or shared information. It is not a CrossLinkd endorsement and does not establish that the church independently verified the business.' },
  { question: 'Why listings may be removed', answer: 'Duplicates, spam, impersonation, incomplete information, or policy violations may be removed. Removal is a directory decision, not a verification of other listings.' },
  { question: 'How owners can update information', answer: 'Owners can request access to manage or update an existing profile. Anyone can use the contact form to flag inaccurate or outdated details for review.' },
  { question: 'How users can report an issue', answer: REPORT_DISCLOSURE },
];

const seo = {
  title: 'How CrossLinkd works',
  description: 'Browse listings submitted by owners or community members, or create a profile. Details are not independently verified; inclusion is not an endorsement.',
  path: '/how-it-works',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
};
---
<BaseLayout user={user} seo={seo}>
  <div class="hiw-page mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <header class="hiw-intro">
      <p class="hiw-kicker">A GUIDE TO THE DIRECTORY</p>
      <h1 id="hiw-heading" class="mt-2 text-3xl font-bold leading-tight sm:text-5xl">How CrossLinkd works</h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed sm:text-lg" style="color:var(--text-soft)">
        Browse listings submitted by owners or community members, or create a profile for your business.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed" style="color:var(--text-soft)">{SHORT_DISCLAIMER}</p>
    </header>

    <article class="card hiw-outline" aria-labelledby="hiw-heading">
      <section class="hiw-outline-section" aria-labelledby="process-heading">
        <span class="hiw-section-index" aria-hidden="true">01</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="process-heading">The Path, in Five Steps</h2>
            <p>Listings may be submitted by owners or community members. Details are not independently verified, and inclusion is not an endorsement.</p>
          </header>
          <ol class="hiw-outline-list">
            {steps.map(([title, body], index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">1.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="profile-heading">
        <span class="hiw-section-index" aria-hidden="true">02</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="profile-heading">What a Profile Shows</h2>
          </header>
          <ol class="hiw-outline-list">
            <li class="hiw-outline-entry">
              <span class="hiw-entry-index" aria-hidden="true">2.1</span>
              <div class="hiw-entry-content">
                <h3>Profile status details</h3>
                <p>Status labels describe a recorded submission source, profile-management access, or directory state. They do not establish business quality, licensing, pricing, outcomes, Christian ownership, or theological agreement.</p>
              </div>
            </li>
            <li class="hiw-outline-entry">
              <span class="hiw-entry-index" aria-hidden="true">2.2</span>
              <div class="hiw-entry-content">
                <h3>Example profile</h3>
                <div class="hiw-example">
                  <p class="hiw-example-label">ILLUSTRATION · NOT A PUBLISHED LISTING</p>
                  <ul class="hiw-detail-list">
                    {profileExampleItems.map((item) => (
                      <li class="hiw-detail-row">
                        <span class="hiw-detail-label">{item.label}</span>
                        <span class="hiw-detail-value">
                          {item.badge ? <StatusBadge name={item.badge.name} definition={item.badge.definition} /> : item.value}
                        </span>
                      </li>
                    ))}
                    <li class="hiw-detail-row">
                      <span class="hiw-detail-label">Contact options</span>
                      <span class="hiw-detail-value">
                        <span class="hiw-contact-demo">
                          <button type="button" class="btn btn-secondary min-h-11" disabled aria-disabled="true">Contact</button>
                          <a href="/contact?topic=inaccurate" class="btn btn-primary min-h-11">Flag listing</a>
                        </span>
                        <span class="hiw-detail-note">Contact is disabled here because this is not a published listing. A real profile shows the contact method the owner chose to make public.</span>
                      </span>
                    </li>
                  </ul>
                  <p class="hiw-example-footnote">This illustration has no owner, no reviews, and no credentials.</p>
                </div>
              </div>
            </li>
            <li class="hiw-outline-entry">
              <span class="hiw-entry-index" aria-hidden="true">2.3</span>
              <div class="hiw-entry-content">
                <h3>Profile elements explained</h3>
                <ul class="hiw-explanation-list">
                  {profileElements.map((item) => (
                    <li class="hiw-explanation-row">
                      <span class="hiw-bullet" aria-hidden="true"></span>
                      <p><strong>{item.title}.</strong> {item.body}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section id="statuses" class="hiw-outline-section" aria-labelledby="statuses-heading">
        <span class="hiw-section-index" aria-hidden="true">03</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="statuses-heading">Listing Statuses</h2>
            <p>Each label is text plus an icon. Color is not the only cue. None of the labels indicates independent verification by CrossLinkd or endorsement of the organization.</p>
          </header>
          <ol class="hiw-outline-list">
            {statusItems.map((status, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">3.{index + 1}</span>
                <div class="hiw-entry-content hiw-status-entry">
                  <h3><StatusBadge name={status.name} /></h3>
                  <p>{status.definition}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="owners-heading">
        <span class="hiw-section-index" aria-hidden="true">04</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="owners-heading">For Business Owners</h2>
            <p>Basic listings are currently free. No credit card required.</p>
          </header>
          <ol class="hiw-outline-list">
            {ownerSteps.map(([title, body], index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">4.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="requirements-heading">
        <span class="hiw-section-index" aria-hidden="true">05</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="requirements-heading">Listing Requirements and Visibility</h2>
            <p>What you need to submit, what remains optional, and what appears on a public profile.</p>
          </header>
          <ol class="hiw-outline-list">
            {requirements.map((item, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">5.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{item.title}</h3>
                  {item.intro && <p class="hiw-entry-intro">{item.intro}</p>}
                  {item.body && (
                    <ul class="hiw-requirement-list">
                      {item.body.map(([label, description]) => (
                        <li><strong>{label}.</strong> {description}</li>
                      ))}
                    </ul>
                  )}
                  {item.description && <p>{item.description}</p>}
                  {index === 5 && <p class="hiw-entry-link"><a href="/contact?topic=removal">Request removal</a></p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="lifecycle-heading">
        <span class="hiw-section-index" aria-hidden="true">06</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="lifecycle-heading">How a Listing Changes</h2>
            <p>These are directory states, not quality grades.</p>
          </header>
          <ol class="hiw-outline-list">
            {listingChanges.map((item, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">6.{index + 1}</span>
                <div class="hiw-entry-content hiw-status-entry">
                  <h3><StatusBadge name={item.title} /></h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="reports-heading">
        <span class="hiw-section-index" aria-hidden="true">07</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="reports-heading">Report or Request a Change</h2>
            <p>{REPORT_DISCLOSURE}</p>
          </header>
          <ol class="hiw-outline-list">
            {reports.map((report, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">7.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{report}</h3>
                </div>
              </li>
            ))}
          </ol>
          <div class="hiw-report-footer">
            <a class="hiw-action-link" href="/contact">Open the contact form <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="hiw-outline-section hiw-last-section" aria-labelledby="transparency-heading">
        <span class="hiw-section-index" aria-hidden="true">08</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="transparency-heading">Trust and Transparency</h2>
            <p>Clear answers about what the directory does, what it does not do, and how to interpret a listing.</p>
          </header>
          <ol class="hiw-outline-list">
            {faqs.map((faq, index) => (
              <li class="hiw-outline-entry hiw-faq-entry">
                <span class="hiw-entry-index" aria-hidden="true">8.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{faq.question}</h3>
                  <p>{faq.answer}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
