---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/how-it-works.css';
import StatusBadge from '@/components/StatusBadge.astro';
import { ATTESTATION, COMMUNITY_LISTED, LISTING_STATUSES, SHORT_DISCLAIMER } from '@/lib/trustCopy';

const user = Astro.locals.user;
const slugId = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const steps = [
  ['Submit or discover a listing', 'Owners and community members can submit a profile. Visitors can search what is already published.'],
  ['Profile reviewed for completeness', 'CrossLinkd may check for missing fields and obvious inconsistencies. That is not a check of licenses, credentials, faith, or quality.'],
  ['Listing published', 'A published profile is owner-submitted. Publishing is not an endorsement, and an incomplete submission is not published.'],
  ['Owner claims or confirms the profile', 'Owner claimed means someone showed control of a contact channel. Recently confirmed by owner means the owner said the details are current.'],
  ['Listing maintained or reported by the community', 'Owners can update a profile. Readers can report a concern. A report is not an investigation.'],
];

const ownerSteps = [
  ['Submit a basic listing', 'Name, type, and contact details. The basic listing is free. No credit card required.'],
  ['Provide accurate information', 'You are responsible for the text, including any faith or credential statement.'],
  ['Receive a completeness review', 'Missing fields may be flagged. This does not confirm Christian ownership, a license, or service quality.'],
  ['Claim or confirm the listing', 'Show control of a contact channel. That status is Owner claimed, not a verification.'],
  ['Add more information', 'Hours, service area, and a faith statement are optional. They stay self-reported.'],
  ['Keep the profile current', 'Edit claimed listings from the dashboard when details change.'],
  ['Respond to corrections or reports', 'Readers can flag a problem. You can correct the profile or reply through the contact form.'],
];

const statusItems = [COMMUNITY_LISTED, ...LISTING_STATUSES].map((status) => ({
  ...status,
  id: `status-${slugId(status.name)}`,
}));
const statusDefinition = (name: string) => statusItems.find((status) => status.name === name)?.definition ?? '';

const listingChanges = [
  { title: 'Pending review', body: 'A completeness check may still be open. It is not a public verification badge. A listing can appear as owner-submitted before that check.' },
  { title: 'Published', body: 'The profile is visible in search. Publication is not an endorsement.' },
  { title: 'Owner claimed', body: statusDefinition('Owner claimed') },
  { title: 'Recently confirmed by owner', body: statusDefinition('Recently confirmed by owner') },
  { title: 'Needs update', body: statusDefinition('Needs update') },
  { title: 'Inactive', body: statusDefinition('Inactive') },
  { title: 'Community reported', body: statusDefinition('Community reported') },
];

const reports = [
  'Report inaccurate information',
  'Report a duplicate',
  'Report spam or impersonation',
  'Request a correction',
  'Request removal',
];

const profileExampleItems = [
  { label: 'Category', value: 'Shown when the owner chooses one.' },
  { label: 'Location', value: 'Shown when the owner provides a place, or marked Online.' },
  { label: 'Owner-submitted status', badge: { name: 'Owner-submitted', definition: 'The business provided the listing information.' } },
  { label: 'Owner claimed status', badge: { name: 'Owner claimed', definition: 'Someone demonstrated control of the listing or business contact channel.' } },
  { label: 'Website confirmed status', badge: { name: 'Website confirmed', definition: 'The owner demonstrated control of the listed website or email address.' } },
  { label: 'Last confirmed by owner', value: 'Not shown on this example.' },
  { label: 'Reviews or community feedback', value: 'No reviews yet.' },
];

const profileElements = [
  { title: 'Name and category', body: 'Written by the person who submitted the listing.' },
  { title: 'Status labels', body: 'Readable without hovering. A label is not a quality score.' },
  { title: 'Confirmation date', body: 'Appears only after an owner reconfirms. This example has none.' },
  { title: 'Feedback', body: 'Shown only after a person submits it. Nothing is invented here.' },
  { title: 'Report option', body: 'A report is community reported. It is not proof of an investigation.' },
];

const requirements = [
  {
    title: 'Required information',
    body: [
      ['Listing type', 'Choose the type for the profile.'],
      ['Name', 'Provide the name of the business or organization.'],
      ['Accuracy attestation', `“${ATTESTATION}”`],
    ],
  },
  {
    title: 'Information that is not required',
    intro: 'CrossLinkd does not request:',
    body: [
      ['Identity documents', 'Not requested.'],
      ['Licenses', 'Not requested.'],
      ['Private religious records', 'Not requested.'],
    ],
  },
  {
    title: 'Public information',
    description: 'Only contact fields you mark as public appear on the profile.',
  },
  {
    title: 'Optional faith statements',
    description: 'A faith statement is optional and self-reported.',
  },
  {
    title: 'What happens after submission',
    description: 'A complete form may publish as owner-submitted. An incomplete submission is not published. Publication is not an endorsement.',
  },
  {
    title: 'Updating or removing a claimed listing',
    description: 'Edit a claimed listing from the dashboard when details change, or request removal.',
  },
];

const faqs = [
  { question: 'What “Christian-owned” means on CrossLinkd', answer: 'It means the person who submitted the listing identified it as Christian-owned. CrossLinkd does not confirm faith, ownership, or practice.' },
  { question: 'What information is self-reported', answer: 'Name, category, location, hours, faith statements, and any credentials written in the profile are provided by the submitter. Treat them as owner-submitted.' },
  { question: 'What CrossLinkd reviews', answer: 'A completeness review looks for missing fields and obvious inconsistencies. It is not a background check.' },
  { question: 'What CrossLinkd does not verify', answer: 'CrossLinkd does not independently verify Christian ownership, religious beliefs, licenses, credentials, certifications, service quality, or business legitimacy.' },
  { question: 'What listing statuses mean', answer: 'They describe how a profile was added or updated. None of them is a certification, a church ruling, or a guarantee of quality.' },
  { question: 'Where listings come from', answer: 'Business owners, churches, ministries, and sometimes community members submit them. Community-listed means the profile is in the directory, not that it was investigated.' },
  { question: 'Whether a church recommendation is an endorsement', answer: 'A church or community recommendation indicates that someone submitted or shared the listing. It does not necessarily mean the church endorses the business, its services, its owners, or every belief associated with it.' },
  { question: 'Why listings may be removed', answer: 'Duplicates, incomplete information, spam, impersonation, or a submission-policy violation can be removed. Removal is a directory decision. It is not a finding that some other listing was verified.' },
  { question: 'How owners can correct information', answer: 'Claim the listing and edit it, or request a correction from the contact form. A correction does not create a verification.' },
  { question: 'How users can report inaccurate information', answer: 'Use a report option in the Report or Request a Change section. A report asks for a look at the listing; it does not mean the business has already been investigated.' },
];

const seo = {
  title: 'How CrossLinkd works',
  description: 'Discover community-listed businesses and organizations, or create a free listing. CrossLinkd does not independently verify faith, ownership, licenses, or service quality.',
  path: '/how-it-works',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
};
---
<BaseLayout user={user} seo={seo}>
  <div class="hiw-page mx-auto max-w-6xl px-4 py-8 sm:py-12">
    <header class="hiw-intro">
      <p class="hiw-kicker">A GUIDE TO THE DIRECTORY</p>
      <h1 id="hiw-heading" class="mt-2 text-3xl font-bold leading-tight sm:text-5xl">How CrossLinkd works</h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed sm:text-lg" style="color:var(--text-soft)">
        Discover community-listed businesses and organizations, or create a free listing for your own business.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed" style="color:var(--text-soft)">{SHORT_DISCLAIMER}</p>
    </header>

    <article class="card hiw-outline" aria-labelledby="hiw-heading">
      <section class="hiw-outline-section" aria-labelledby="process-heading">
        <span class="hiw-section-index" aria-hidden="true">01</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="process-heading">The Path, in Five Steps</h2>
            <p>A completeness review checks whether the form is filled in. It does not verify credentials.</p>
          </header>
          <ol class="hiw-outline-list">
            {steps.map(([title, body], index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">1.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="profile-heading">
        <span class="hiw-section-index" aria-hidden="true">02</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="profile-heading">What a Profile Shows</h2>
          </header>
          <ol class="hiw-outline-list">
            <li class="hiw-outline-entry">
              <span class="hiw-entry-index" aria-hidden="true">2.1</span>
              <div class="hiw-entry-content">
                <h3>Profile status details</h3>
                <p>Status details describe how a profile was submitted or updated. They do not guarantee business quality, licensing, pricing, outcomes, Christian ownership, or theological agreement.</p>
              </div>
            </li>
            <li class="hiw-outline-entry">
              <span class="hiw-entry-index" aria-hidden="true">2.2</span>
              <div class="hiw-entry-content">
                <h3>Example profile</h3>
                <div class="hiw-example">
                  <p class="hiw-example-label">ILLUSTRATION · NOT A PUBLISHED LISTING</p>
                  <ul class="hiw-detail-list">
                    {profileExampleItems.map((item) => (
                      <li class="hiw-detail-row">
                        <span class="hiw-detail-label">{item.label}</span>
                        <span class="hiw-detail-value">
                          {item.badge ? <StatusBadge name={item.badge.name} definition={item.badge.definition} /> : item.value}
                        </span>
                      </li>
                    ))}
                    <li class="hiw-detail-row">
                      <span class="hiw-detail-label">Contact options</span>
                      <span class="hiw-detail-value">
                        <span class="hiw-contact-demo">
                          <button type="button" class="btn btn-secondary min-h-11" disabled aria-disabled="true">Contact</button>
                          <a href="/contact?topic=inaccurate" class="btn btn-primary min-h-11">Report listing</a>
                        </span>
                        <span class="hiw-detail-note">Contact is disabled here because this is not a published listing. A real profile shows the contact method the owner chose to make public.</span>
                      </span>
                    </li>
                  </ul>
                  <p class="hiw-example-footnote">This illustration has no owner, no reviews, and no credentials.</p>
                </div>
              </div>
            </li>
            <li class="hiw-outline-entry">
              <span class="hiw-entry-index" aria-hidden="true">2.3</span>
              <div class="hiw-entry-content">
                <h3>Profile elements explained</h3>
                <ul class="hiw-explanation-list">
                  {profileElements.map((item) => (
                    <li class="hiw-explanation-row">
                      <span class="hiw-bullet" aria-hidden="true"></span>
                      <p><strong>{item.title}.</strong> {item.body}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section id="statuses" class="hiw-outline-section" aria-labelledby="statuses-heading">
        <span class="hiw-section-index" aria-hidden="true">03</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="statuses-heading">Listing Statuses</h2>
            <p>Each label is text plus an icon. Color is not the only cue. None of these means CrossLinkd certified the organization.</p>
          </header>
          <ol class="hiw-outline-list">
            {statusItems.map((status, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">3.{index + 1}</span>
                <div class="hiw-entry-content hiw-status-entry">
                  <h3><StatusBadge name={status.name} /></h3>
                  <p>{status.definition}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="owners-heading">
        <span class="hiw-section-index" aria-hidden="true">04</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="owners-heading">For Business Owners</h2>
            <p>Free forever for the basic listing. No credit card required.</p>
          </header>
          <ol class="hiw-outline-list">
            {ownerSteps.map(([title, body], index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">4.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="requirements-heading">
        <span class="hiw-section-index" aria-hidden="true">05</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="requirements-heading">Listing Requirements and Visibility</h2>
            <p>What you need to submit, what remains optional, and what appears on a public profile.</p>
          </header>
          <ol class="hiw-outline-list">
            {requirements.map((item, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">5.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{item.title}</h3>
                  {item.intro && <p class="hiw-entry-intro">{item.intro}</p>}
                  {item.body && (
                    <ul class="hiw-requirement-list">
                      {item.body.map(([label, description]) => (
                        <li><strong>{label}.</strong> {description}</li>
                      ))}
                    </ul>
                  )}
                  {item.description && <p>{item.description}</p>}
                  {index === 5 && <p class="hiw-entry-link"><a href="/contact?topic=removal">Request removal</a></p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="lifecycle-heading">
        <span class="hiw-section-index" aria-hidden="true">06</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="lifecycle-heading">How a Listing Changes</h2>
            <p>These are directory states, not quality grades.</p>
          </header>
          <ol class="hiw-outline-list">
            {listingChanges.map((item, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">6.{index + 1}</span>
                <div class="hiw-entry-content hiw-status-entry">
                  <h3><StatusBadge name={item.title} /></h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="hiw-outline-section" aria-labelledby="reports-heading">
        <span class="hiw-section-index" aria-hidden="true">07</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="reports-heading">Report or Request a Change</h2>
            <p>Choose the reason that best describes the issue. A report asks for a review of a directory listing; it is not proof of an investigation.</p>
          </header>
          <ol class="hiw-outline-list">
            {reports.map((report, index) => (
              <li class="hiw-outline-entry">
                <span class="hiw-entry-index" aria-hidden="true">7.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{report}</h3>
                </div>
              </li>
            ))}
          </ol>
          <div class="hiw-report-footer">
            <a class="hiw-action-link" href="/contact">Open the contact form <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="hiw-outline-section hiw-last-section" aria-labelledby="transparency-heading">
        <span class="hiw-section-index" aria-hidden="true">08</span>
        <div class="hiw-section-content">
          <header class="hiw-section-head">
            <h2 id="transparency-heading">Trust and Transparency</h2>
            <p>Clear answers about what the directory does, what it does not do, and how to interpret a listing.</p>
          </header>
          <ol class="hiw-outline-list">
            {faqs.map((faq, index) => (
              <li class="hiw-outline-entry hiw-faq-entry">
                <span class="hiw-entry-index" aria-hidden="true">8.{index + 1}</span>
                <div class="hiw-entry-content">
                  <h3>{faq.question}</h3>
                  <p>{faq.answer}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
