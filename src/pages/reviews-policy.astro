---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { REPORT_DISCLOSURE } from '@/lib/trustCopy';
const user = Astro.locals.user;
const seo = {
  title: 'Review & Moderation Policy | CrossLinkd',
  description: 'How community-submitted reviews work and how to flag inaccurate, outdated, spam, or inappropriate content.',
  path: '/reviews-policy',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Review &amp; moderation policy</h1>
    <p class="section-sub">Reviews are community-submitted feedback, not CrossLinkd verification or an endorsement.</p>

    <div class="mt-8 space-y-4 text-[15px]" style="color:var(--text-soft)">
      <div class="card p-5">
        <h2 class="font-semibold" style="color:var(--text)">Who can review</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Anyone may submit a review about a customer experience. CrossLinkd does not independently verify the reviewer's identity or experience.</li>
          <li>Owners cannot review their own business, and featured status does nothing to reviews.</li>
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="font-semibold" style="color:var(--text)">What reviews must be about</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Your actual experience: service quality, professionalism, responsiveness, and — where relevant — how faith shaped the work.</li>
          <li>Ratings and review text are user opinions; they are not independent assessments by CrossLinkd.</li>
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="font-semibold" style="color:var(--text)">What gets removed</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Spam, ads, and reviews of a different business.</li>
          <li>Personal attacks, private information, and accusations of serious misconduct without evidence — those go to moderation with evidence first.</li>
          <li>Theological disputes. This is a directory, not a debate forum; disagreements about doctrine belong in dialogue, not star ratings.</li>
          <li>Conflicts of interest (competitors, employees, family) when we can identify them.</li>
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="font-semibold" style="color:var(--text)">Owner responses &amp; moderation process</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Owners can respond once per review; responses follow the same rules and are moderated identically.</li>
          <li>Users can flag review content through the contact form. A flag does not guarantee a response or a change. Moderation decisions can be appealed through the <a href="/appeals" class="underline">appeals page</a>.</li>
          <li>We never edit a review's text. We publish it, remove it, or ask the reviewer to revise.</li>
        </ul>
      </div>
    </div>

    <div class="card mt-8 p-6">
      <p class="font-bold">Flag a review from any profile.</p>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">{REPORT_DISCLOSURE}</p>
    </div>
  </div>
</BaseLayout>
