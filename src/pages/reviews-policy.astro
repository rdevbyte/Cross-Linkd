---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
const seo = {
  title: 'Review & Moderation Policy | CrossLinkd',
  description: 'How reviews work on CrossLinkd: who can review, what gets removed, how owners respond, and how moderation decisions can be appealed.',
  path: '/reviews-policy',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Review &amp; moderation policy</h1>
    <p class="section-sub">Reviews are the community's quality control. Here is exactly how they are handled.</p>

    <div class="mt-8 space-y-4 text-[15px]" style="color:var(--text-soft)">
      <div class="card p-5">
        <h2 class="font-extrabold" style="color:var(--text)">Who can review</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Anyone with a genuine customer experience. We mark reviews from users we can tie to real contact or visits as "✓ Verified visit".</li>
          <li>Owners cannot review their own business, and featured status does nothing to reviews.</li>
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="font-extrabold" style="color:var(--text)">What reviews must be about</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Your actual experience: service quality, professionalism, responsiveness, and — where relevant — how faith shaped the work.</li>
          <li>We separate these dimensions so ratings are useful, not vibes.</li>
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="font-extrabold" style="color:var(--text)">What gets removed</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Spam, ads, and reviews of a different business.</li>
          <li>Personal attacks, private information, and accusations of serious misconduct without evidence — those go to moderation with evidence first.</li>
          <li>Theological disputes. This is a directory, not a debate forum; disagreements about doctrine belong in dialogue, not star ratings.</li>
          <li>Conflicts of interest (competitors, employees, family) when we can identify them.</li>
        </ul>
      </div>
      <div class="card p-5">
        <h2 class="font-extrabold" style="color:var(--text)">Owner responses &amp; moderation process</h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>Owners can respond once per review; responses follow the same rules and are moderated identically.</li>
          <li>A human moderator reads every flagged review. Decisions are explained and can be appealed to a separate reviewer through the <a href="/appeals" class="underline">appeals process</a>.</li>
          <li>We never edit a review's text. We publish it, remove it, or ask the reviewer to revise.</li>
        </ul>
      </div>
    </div>

    <div class="card mt-8 p-6">
      <p class="font-bold">Flag a review from any profile.</p>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Every review has a report link, and every report is read by a person.</p>
    </div>
  </div>
</BaseLayout>
