---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireUserPage } from '@/lib/guards';
const user = Astro.locals.user;
const submitted = Astro.url.searchParams.get('submitted') === '1';
const checks = [
  ['Email verification', 'Verified', true],
  ['Phone verification', 'Verified', true],
  ['Domain verification', 'Pending — add TXT record cl-verify=8f3k2', false],
  ['✓ Claimed listing', 'Verified', true],
  ['Christian-Owned badge', 'In review — evidence received', false],
  ['Professional credential', 'Not started', false],
];
const __userGate = requireUserPage(Astro);
if (__userGate) return __userGate;

---
<DashboardLayout user={user} active="verification" seo={{ title: 'Verification — Dashboard', description: 'Track verification status.', path: '/dashboard/verification', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Verification</h1>
  <div class="card p-3 text-[13px] mt-3" style="border-left:4px solid var(--accent)" role="note"><strong>Preview data.</strong> This section shows illustrative sample content while the platform is in preview; live data replaces it as activity grows.</div>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Transparent by design — every badge links to its requirements on the <a href="/trust" class="underline">Trust page</a>.</p>
  {submitted && <p class="card mt-4 border-l-4 p-3 text-sm font-medium" style="border-left-color:var(--teal)">Evidence submitted. A verification reviewer will respond within 2 business days.</p>}
  <div class="card mt-4 divide-y" style="--tw-divide-opacity:1">
    {checks.map(([label, status, done]) => (
      <div class="flex flex-wrap items-center justify-between gap-2 p-4">
        <p class="font-medium">{label}</p>
        <span class={`badge-verify ${done ? '' : ''}`} style={done ? 'background:rgba(46,146,131,.14);color:var(--teal)' : 'background:rgba(216,149,34,.14);color:var(--text)'}>{status}</span>
      </div>
    ))}
  </div>
  <form method="POST" action="/api/verifications" class="card mt-4 space-y-4 p-6" enctype="multipart/form-data">
    <h2 class="font-extrabold">Submit verification evidence</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-medium">Badge requested
        <select name="type" class="input mt-1.5"><option value="domain">Domain</option><option value="christian_owned">Christian-Owned</option><option value="church">Church</option><option value="ministry">Ministry</option><option value="professional_credential">Professional credential</option></select>
      </label>
      <label class="text-sm font-medium">Supporting document<input name="document" type="file" class="input mt-1.5" /></label>
    </div>
    <label class="block text-sm font-medium">Notes for the reviewer<textarea name="notes" rows="3" class="input mt-1.5" placeholder="Links, license numbers, context…"></textarea></label>
    <button class="btn btn-primary" type="submit">Submit for review</button>
  </form>
</DashboardLayout>
