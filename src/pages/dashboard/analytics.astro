---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireUserPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { listings } from '@/db/schema';
import { and, eq, isNull } from 'drizzle-orm';

const __userGate = requireUserPage(Astro);
if (__userGate) return __userGate;
const user = Astro.locals.user!;

let publishedCount = 0;
let totalViews = 0;
let totalReviews = 0;
let totalRecommendations = 0;

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const rows = await db
        .select()
        .from(listings)
        .where(and(eq(listings.ownerId, user.id), eq(listings.status, 'published'), isNull(listings.deletedAt)));

      publishedCount = rows.length;
      totalViews = rows.reduce((acc, r) => acc + (r.viewCount ?? 0), 0);
      totalReviews = rows.reduce((acc, r) => acc + (r.reviewCount ?? 0), 0);
      totalRecommendations = rows.reduce((acc, r) => acc + (r.recommendationCount ?? 0), 0);
    } catch (err) {
      console.error('[dashboard/analytics] query error:', err);
    }
  }
}
const hasActivity = totalViews > 0 || totalReviews > 0 || totalRecommendations > 0;
---
<DashboardLayout user={user} active="analytics" seo={{ title: 'Analytics — Dashboard', description: 'Listing analytics.', path: '/dashboard/analytics', noindex: true }}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">Analytics</h1>
      <p class="text-sm" style="color:var(--text-soft)">Performance metrics across your published listings.</p>
    </div>
    {publishedCount > 0 && <a href="/api/listings/export" class="btn btn-secondary !py-2 !text-sm">Export data (CSV)</a>}
  </div>

  {!hasActivity ? (
    <div class="card mt-6 p-8 text-center sm:p-12">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
      </div>
      <h2 class="mt-4 text-lg font-semibold">No analytics recorded yet</h2>
      <p class="mt-2 max-w-md mx-auto text-sm leading-relaxed" style="color:var(--text-soft)">
        Metrics like profile views, search visits, and recommendations will update here once your listings are published and visitors interact with them.
      </p>
      {publishedCount === 0 && (
        <a href="/dashboard/listings" class="btn btn-primary mt-5 !py-2 !text-sm">Submit a listing to get started</a>
      )}
    </div>
  ) : (
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="card p-6">
        <p class="text-xs uppercase font-bold tracking-wide" style="color:var(--text-mute)">Profile Views</p>
        <p class="mt-2 text-3xl font-bold">{totalViews.toLocaleString()}</p>
        <p class="mt-1 text-xs" style="color:var(--text-soft)">Visits to your directory profiles</p>
      </div>
      <div class="card p-6">
        <p class="text-xs uppercase font-bold tracking-wide" style="color:var(--text-mute)">Customer Reviews</p>
        <p class="mt-2 text-3xl font-bold">{totalReviews.toLocaleString()}</p>
        <p class="mt-1 text-xs" style="color:var(--text-soft)">Submitted and approved reviews</p>
      </div>
      <div class="card p-6">
        <p class="text-xs uppercase font-bold tracking-wide" style="color:var(--text-mute)">Recommendations</p>
        <p class="mt-2 text-3xl font-bold">{totalRecommendations.toLocaleString()}</p>
        <p class="mt-1 text-xs" style="color:var(--text-soft)">Direct member endorsements</p>
      </div>
    </div>
  )}
</DashboardLayout>
