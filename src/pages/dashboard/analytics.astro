---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireUserPage } from '@/lib/guards';
const user = Astro.locals.user;
const bars = [42, 68, 55, 80, 62, 95, 74, 88, 58, 70, 92, 100];
const terms = [['christian bakery dallas', 842], ['wedding cakes near me', 617], ['bakery #baptist', 402], ['gluten free bakery', 288], ['church event catering', 191]];
const __userGate = requireUserPage(Astro);
if (__userGate) return __userGate;

---
<DashboardLayout user={user} active="analytics" seo={{ title: 'Analytics — Dashboard', description: 'Listing analytics.', path: '/dashboard/analytics', noindex: true }}>
  <div class="flex items-center justify-between"><h1 class="text-2xl font-extrabold">Analytics</h1>
  <div class="card p-3 text-[13px] mt-3" style="border-left:4px solid var(--accent)" role="note"><strong>Preview data.</strong> This section shows illustrative sample content while the platform is in preview; live data replaces it as activity grows.</div><a href="/api/listings/export" class="btn btn-secondary !py-2 !text-sm">Export data (CSV)</a></div>
  <div class="card mt-4 p-6">
    <h2 class="font-extrabold">Profile views — last 12 weeks</h2>
    <div class="mt-4 flex h-40 items-end gap-1.5" role="img" aria-label="Bar chart of weekly profile views, trending upward">
      {bars.map((b) => <div class="flex-1 rounded-t-lg" style={`height:${b}%;background:var(--accent)`}></div>)}
    </div>
  </div>
  <div class="mt-4 grid gap-4 md:grid-cols-2">
    <div class="card p-6">
      <h2 class="font-extrabold">Top search terms</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {terms.map(([t, n]) => (
          <li class="flex items-center justify-between gap-3"><span class="truncate">{t}</span><span class="font-bold">{n}</span></li>
        ))}
      </ul>
    </div>
    <div class="card p-6">
      <h2 class="font-extrabold">Funnel (30d)</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {[['Search impressions', '21,340'], ['Profile views', '4,812'], ['Website clicks', '941'], ['Calls & inquiries', '386'], ['New reviews', '18']].map(([l, v]) => (
          <li class="flex items-center justify-between"><span style="color:var(--text-soft)">{l}</span><span class="font-bold">{v}</span></li>
        ))}
      </ul>
      <p class="mt-3 text-[13px]" style="color:var(--text-mute)">Heatmaps and competitor benchmarks are in development.</p>
    </div>
  </div>
</DashboardLayout>
