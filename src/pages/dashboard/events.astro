---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireUserPage } from '@/lib/guards';

const user = Astro.locals.user;
const created = Astro.url.searchParams.get('created') === '1';
const __userGate = requireUserPage(Astro);
if (__userGate) return __userGate;

const mine: Array<{ title: string; date: string; city: string; cost: string; slug: string }> = [];
---
<DashboardLayout user={user} active="events" seo={{ title: 'Events — Dashboard', description: 'Manage events.', path: '/dashboard/events', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Events & announcements</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Publish community gatherings, service projects, conferences, and seminars.</p>
  
  {created && <p class="card mt-4 border-l-4 p-3 text-sm font-medium" style="border-left-color:var(--teal)">Event created and submitted for review.</p>}
  
  {mine.length === 0 ? (
    <div class="card mt-4 p-8 text-center sm:p-10">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <h2 class="mt-4 text-base font-bold">No events posted yet</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Use the form below to create and announce events for your organization.</p>
    </div>
  ) : (
    <div class="mt-4 space-y-3">
      {mine.map((e) => (
        <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
          <div><p class="font-bold">{e.title}</p><p class="text-[13px]" style="color:var(--text-mute)">{e.date} • {e.city} • {e.cost}</p></div>
          <a href={`/events/${e.slug}`} class="btn btn-secondary !py-1.5 !text-sm">View public page</a>
        </div>
      ))}
    </div>
  )}

  <form method="POST" action="/api/events" class="card mt-6 space-y-4 p-6">
    <h2 class="font-extrabold">Create an event</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-medium">Event name *<input name="title" required class="input mt-1.5" placeholder="Enter event name" /></label>
      <label class="text-sm font-medium">Category
        <select name="category" class="input mt-1.5">{['Worship', 'Bible Study', 'Conference', 'Concert', 'Retreat', 'Volunteer', 'Networking', 'Youth', 'Outreach'].map((c) => <option>{c}</option>)}</select>
      </label>
    </div>
    <label class="block text-sm font-medium">Description<textarea name="description" rows="3" class="input mt-1.5" placeholder="Describe the event, schedule, and details..."></textarea></label>
    <div class="grid gap-4 sm:grid-cols-4">
      <label class="text-sm font-medium">Date *<input name="date" type="date" required class="input mt-1.5" /></label>
      <label class="text-sm font-medium">Time<input name="time" type="time" class="input mt-1.5" /></label>
      <label class="text-sm font-medium">Format
        <select name="format" class="input mt-1.5"><option value="in_person">In person</option><option value="online">Online</option><option value="hybrid">Hybrid</option></select>
      </label>
      <label class="text-sm font-medium">Cost<input name="cost" class="input mt-1.5" placeholder="e.g. Free or $15" /></label>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="text-sm font-medium">Venue<input name="venue" class="input mt-1.5" placeholder="Venue or location name" /></label>
      <label class="text-sm font-medium">City<input name="city" class="input mt-1.5" placeholder="Enter city" /></label>
      <label class="text-sm font-medium">Registration URL<input name="registrationUrl" type="url" class="input mt-1.5" placeholder="https://yourwebsite.com/register" /></label>
    </div>
    <button class="btn btn-primary" type="submit">Publish event</button>
  </form>
</DashboardLayout>
