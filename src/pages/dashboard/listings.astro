---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { and, eq, desc } from 'drizzle-orm';
import { getDb, hasDatabase } from '@/db/client';
import { listings, listingLocations } from '@/db/schema';
import { STATUS_LABEL } from '@/lib/submissions';
import { requireUserPage } from '@/lib/guards';

const gate = requireUserPage(Astro);
if (gate) return gate;
const user = Astro.locals.user!;

const dbReady = hasDatabase();
let rows: Array<{
  id: string; slug: string; name: string; typeSlug: string; status: string;
  city: string | null; region: string | null; updatedAt: Date; reviewNote: string | null;
  data: Record<string, unknown>;
}> = [];
if (dbReady) {
  const db = getDb()!;
  const mine = await db
    .select({ listing: listings, loc: listingLocations })
    .from(listings)
    .leftJoin(listingLocations, and(eq(listingLocations.listingId, listings.id), eq(listingLocations.isPrimary, true)))
    .where(and(eq(listings.ownerId, user.id), eq(listings.status, 'draft')))
    .orderBy(desc(listings.updatedAt));
  const rest = await db
    .select({ listing: listings, loc: listingLocations })
    .from(listings)
    .leftJoin(listingLocations, and(eq(listingLocations.listingId, listings.id), eq(listingLocations.isPrimary, true)))
    .where(and(eq(listings.ownerId, user.id), eq(listings.status, 'pending_review')))
    .orderBy(desc(listings.updatedAt));
  const review = await db
    .select({ listing: listings, loc: listingLocations })
    .from(listings)
    .leftJoin(listingLocations, and(eq(listingLocations.listingId, listings.id), eq(listingLocations.isPrimary, true)))
    .where(and(eq(listings.ownerId, user.id), eq(listings.status, 'changes_requested')))
    .orderBy(desc(listings.updatedAt));
  const rejected = await db
    .select({ listing: listings, loc: listingLocations })
    .from(listings)
    .leftJoin(listingLocations, and(eq(listingLocations.listingId, listings.id), eq(listingLocations.isPrimary, true)))
    .where(and(eq(listings.ownerId, user.id), eq(listings.status, 'rejected')))
    .orderBy(desc(listings.updatedAt));
  const published = await db
    .select({ listing: listings, loc: listingLocations })
    .from(listings)
    .leftJoin(listingLocations, and(eq(listingLocations.listingId, listings.id), eq(listingLocations.isPrimary, true)))
    .where(and(eq(listings.ownerId, user.id), eq(listings.status, 'published')))
    .orderBy(desc(listings.publishedAt));
  rows = [...mine, ...rest, ...review, ...rejected, ...published].map(({ listing: l, loc }) => ({
    id: l.id,
    slug: l.slug,
    name: l.name,
    typeSlug: l.typeSlug,
    status: l.status,
    city: loc?.city ?? null,
    region: loc?.region ?? null,
    updatedAt: l.updatedAt,
    reviewNote: l.reviewNote ?? null,
    data: {
      name: l.name,
      typeSlug: l.typeSlug,
      tagline: l.tagline ?? '',
      description: l.description ?? '',
      website: l.website ?? '',
      phone: l.phone ?? '',
      email: l.email ?? '',
      city: loc?.city ?? '',
      region: loc?.region ?? '',
      postalCode: loc?.postalCode ?? '',
      isOnlineOnly: l.isOnlineOnly,
      priceRange: l.priceRange ?? '',
    },
  }));
}

const notice = Astro.url.searchParams.get('notice') ?? '';
const notices: Record<string, { title: string; body: string; tone: string }> = {
  'verify-email': { title: 'Verify your email', body: 'We sent a verification link to your inbox. Verify to build trust with reviewers.', tone: 'var(--accent)' },
  'email-verified': { title: 'Email verified — thank you!', body: 'Your email address is confirmed.', tone: 'var(--teal)' },
  'listing-saved': { title: 'Draft saved', body: 'Your changes were saved.', tone: 'var(--teal)' },
  'listing-submitted': { title: 'Submitted for review', body: 'Our review team typically responds within 2–3 business days. You will see the decision here.', tone: 'var(--teal)' },
  'verification-failed': { title: 'Verification link invalid', body: 'The link was used, expired, or malformed. Request a new email from your settings.', tone: 'var(--accent)' },
};
const banner = notices[notice];
---
<DashboardLayout user={user} active="listings" seo={{ title: 'My listings — CrossLinkd', description: 'Manage your business submissions.', path: '/dashboard/listings', noindex: true }}>
  <h1 class="text-2xl font-extrabold">My listings</h1>
  <p class="section-sub">Draft, submit, and track your business listings. Public listings are marked Approved.</p>

  {banner && (
    <div class="card mt-4 border-l-4 p-4" style={`border-left-color:${banner.tone}`} role="status">
      <p class="text-sm font-bold">{banner.title}</p>
      <p class="mt-0.5 text-sm" style="color:var(--text-soft)">{banner.body}</p>
    </div>
  )}

  {!dbReady && (
    <div class="card mt-4 border-l-4 p-4" style="border-left-color:var(--accent)">
      <p class="text-sm font-bold">Preview mode</p>
      <p class="mt-0.5 text-sm" style="color:var(--text-soft)">Submissions need the production database. Sign in on a deployment with <code>DATABASE_URL</code> configured.</p>
    </div>
  )}

  <div id="form-banner" class="card mt-4 hidden border-l-4 p-4" role="alert" style="border-left-color:var(--accent)">
    <p id="form-banner-text" class="text-sm font-bold"></p>
  </div>

  <!-- New / edit listing -->
  <details class="card mt-5 p-5" id="listing-form-card">
    <summary class="cursor-pointer select-none">
      <span class="font-extrabold" id="form-title">Submit a business</span>
      <span class="text-sm" style="color:var(--text-mute)"> — takes about 5 minutes. A person reviews every submission.</span>
    </summary>
    <form id="listing-form" class="mt-4 space-y-4" data-listing-id="">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-semibold">Business name *
          <input name="name" required minlength="2" maxlength="240" class="input mt-1 w-full" placeholder="Grace & Grain Bakery" />
        </label>
        <label class="block text-sm font-semibold">Listing type *
          <select name="typeSlug" required class="input mt-1 w-full">
            <option value="business">Business</option>
            <option value="church">Church</option>
            <option value="ministry">Ministry</option>
            <option value="nonprofit">Nonprofit</option>
            <option value="professional">Professional</option>
          </select>
        </label>
      </div>
      <label class="block text-sm font-semibold">Tagline
        <input name="tagline" maxlength="280" class="input mt-1 w-full" placeholder="One sentence people will remember." />
      </label>
      <label class="block text-sm font-semibold">Description * <span class="font-normal" style="color:var(--text-mute)">(30+ characters to submit)</span>
        <textarea name="description" rows="4" minlength="30" maxlength="8000" class="input mt-1 w-full" placeholder="What you do, who you serve, what makes your business distinct."></textarea>
      </label>
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block text-sm font-semibold">City *
          <input name="city" maxlength="120" class="input mt-1 w-full" placeholder="Dallas" />
        </label>
        <label class="block text-sm font-semibold">State *
          <input name="region" maxlength="120" class="input mt-1 w-full" placeholder="TX" />
        </label>
        <label class="block text-sm font-semibold">ZIP
          <input name="postalCode" maxlength="24" class="input mt-1 w-full" />
        </label>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-semibold">Contact email *
          <input name="email" type="email" class="input mt-1 w-full" placeholder="you@business.com" />
        </label>
        <label class="block text-sm font-semibold">Phone
          <input name="phone" maxlength="60" class="input mt-1 w-full" />
        </label>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-semibold">Website
          <input name="website" type="url" class="input mt-1 w-full" placeholder="https://" />
        </label>
        <label class="block text-sm font-semibold">Price range
          <select name="priceRange" class="input mt-1 w-full">
            <option value="">—</option><option>$</option><option>$$</option><option>$$$</option><option>$$$$</option>
          </select>
        </label>
      </div>
      <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="isOnlineOnly" class="h-4 w-4 accent-[var(--accent)]" /> Online only — serves nationwide</label>
      <p class="text-xs" style="color:var(--text-mute)">By submitting you confirm the information is accurate and that you are authorized to list this business.</p>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-intent="submit" class="btn btn-primary">Submit for review</button>
        <button type="button" data-intent="draft" class="btn btn-secondary">Save draft</button>
        <span id="form-status" class="self-center text-sm" style="color:var(--text-mute)" role="status"></span>
      </div>
    </form>
  </details>

  <!-- Listings table -->
  <div class="card mt-5 overflow-x-auto">
    {rows.length === 0 ? (
      <div class="p-8 text-center">
        <p class="font-bold">No listings yet</p>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">Submit your first business above — drafts are private until you submit them.</p>
      </div>
    ) : (
      <table class="w-full min-w-[680px] text-sm">
        <thead><tr class="text-left text-xs uppercase" style="color:var(--text-mute)">
          <th class="p-3">Business</th><th class="p-3">Location</th><th class="p-3">Status</th><th class="p-3">Updated</th><th class="p-3 text-right">Actions</th>
        </tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t align-top" style="border-color:var(--border)" data-row-id={r.id}>
              <td class="p-3">
                <p class="font-medium">{r.name}</p>
                <p class="text-xs" style="color:var(--text-mute)">{r.typeSlug}</p>
                {r.reviewNote && r.status !== 'published' && (
                  <p class="mt-1 max-w-sm rounded-lg p-2 text-xs" style="background:var(--accent-soft);color:var(--text)">
                    <strong>Reviewer:</strong> {r.reviewNote}
                  </p>
                )}
              </td>
              <td class="p-3">{r.city || '—'}{r.region ? `, ${r.region}` : ''}</td>
              <td class="p-3"><span class="chip !text-[11px]" style={r.status === 'published' ? 'color:var(--teal)' : r.status === 'rejected' ? 'color:var(--accent)' : ''}>{STATUS_LABEL[r.status] ?? r.status}</span></td>
              <td class="p-3 text-xs" style="color:var(--text-mute)">{r.updatedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
              <td class="p-3">
                <div class="flex flex-wrap justify-end gap-1.5" data-actions data-listing={JSON.stringify(r.data)} data-id={r.id} data-name={r.name} data-status={r.status}>
                  <button type="button" class="btn btn-ghost !px-2.5 !py-1 !text-xs" data-act="edit">Edit</button>
                  {(r.status === 'draft') && <button type="button" class="btn btn-primary !px-2.5 !py-1 !text-xs" data-act="submit">Submit</button>}
                  {(r.status === 'rejected' || r.status === 'changes_requested') && <button type="button" class="btn btn-primary !px-2.5 !py-1 !text-xs" data-act="resubmit">Revise &amp; resubmit</button>}
                  {r.status !== 'published' && <button type="button" class="btn btn-ghost !px-2.5 !py-1 !text-xs" data-act="delete" style="color:var(--accent)">Delete</button>}
                  {r.status === 'published' && <a href={`/directory/${r.slug}`} class="btn btn-ghost !px-2.5 !py-1 !text-xs">View public</a>}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <script>
    const form = document.getElementById('listing-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    const banner = document.getElementById('form-banner');
    const bannerText = document.getElementById('form-banner-text');
    const formTitle = document.getElementById('form-title');
    const formCard = document.getElementById('listing-form-card');

    function showBanner(ok: boolean, msg: string) {
      if (!banner || !bannerText) return;
      banner.style.borderLeftColor = ok ? 'var(--teal)' : 'var(--accent)';
      bannerText.textContent = msg;
      banner.classList.remove('hidden');
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function fillForm(data: Record<string, unknown>, id: string, name: string) {
      if (!form) return;
      form.dataset.listingId = id;
      for (const [k, v] of Object.entries(data)) {
        const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        if (!el) continue;
        if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = Boolean(v);
        else el.value = String(v ?? '');
      }
      if (formTitle) formTitle.textContent = `Edit “${name}”`;
      if (formCard) (formCard as unknown as HTMLDetailsElement).open = true;
      formCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function send(url: string, method: string, body: unknown) {
      const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
      const json = await res.json().catch(() => ({ ok: false, error: 'Unexpected server response.' }));
      return { ok: res.ok && json.ok, json } as { ok: boolean; json: { ok: boolean; error?: string } };
    }

    const collect = () => {
      if (!form) return {};
      const fd = new FormData(form);
      const out: Record<string, unknown> = {};
      fd.forEach((v, k) => { out[k] = v; });
      out.isOnlineOnly = (form.elements.namedItem('isOnlineOnly') as HTMLInputElement)?.checked ?? false;
      return out;
    };

    async function handleRowAction(act: string, id: string, data: Record<string, unknown>, name: string) {
      if (act === 'edit') { fillForm(data, id, name); return; }
      if (act === 'delete') {
        if (!confirm(`Delete “${name}”? This cannot be undone.`)) return;
        const { ok, json } = await send(`/api/listings/${id}`, 'DELETE', null);
        if (ok) location.reload();
        else showBanner(false, json.error ?? 'Delete failed.');
        return;
      }
      // submit / resubmit from a row: load into form first so the owner can review
      fillForm(data, id, name);
      showBanner(true, act === 'resubmit' ? 'Review the details below, address the reviewer note, then press “Revise & resubmit”.' : 'Review the details below, then press “Submit for review”.');
    }

    document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest('[data-actions]') as HTMLElement | null;
        if (!wrap) return;
        let data: Record<string, unknown> = {};
        try { data = JSON.parse(wrap.dataset.listing ?? '{}'); } catch { /* ignore */ }
        handleRowAction(btn.dataset.act ?? '', wrap.dataset.id ?? '', data, wrap.dataset.name ?? '');
      });
    });

    form?.querySelectorAll<HTMLButtonElement>('button[data-intent]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!form || !statusEl) return;
        const intent = btn.dataset.intent as 'draft' | 'submit';
        const id = form.dataset.listingId || '';
        const body = { action: intent === 'draft' ? (id ? 'save' : 'draft') : (id ? 'resubmit' : 'submit'), listing: collect() };
        if (intent !== 'draft') {
          if (!String(body.listing ? (body.listing as Record<string, unknown>).description ?? '' : '').trim()) {
            showBanner(false, 'A description is required to submit.');
            return;
          }
        }
        btn.disabled = true;
        statusEl.textContent = intent === 'draft' ? 'Saving…' : 'Submitting…';
        try {
          const { ok, json } = await send(id ? `/api/listings/${id}` : '/api/submissions', id ? 'PATCH' : 'POST', body);
          if (ok) {
            sessionStorage.setItem('cl:flash', intent === 'draft' ? 'listing-saved' : 'listing-submitted');
            location.reload();
          } else {
            showBanner(false, json.error ?? 'Something went wrong.');
            statusEl.textContent = '';
          }
        } catch {
          showBanner(false, 'Network error — try again.');
          statusEl.textContent = '';
        } finally {
          btn.disabled = false;
        }
      });
    });

    const flash = sessionStorage.getItem('cl:flash');
    if (flash) {
      sessionStorage.removeItem('cl:flash');
      const b = document.querySelector(`[role="status"]`);
      if (!b) showBanner(true, flash === 'listing-saved' ? 'Draft saved.' : 'Submitted for review.');
    }
  </script>
</DashboardLayout>
