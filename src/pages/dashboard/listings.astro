---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { and, eq, desc, isNull, inArray } from 'drizzle-orm';
import { getDb, hasDatabase } from '@/db/client';
import { listings, listingLocations, listingDenominations, denominations } from '@/db/schema';
import { STATUS_LABEL, STATUS_CHIP } from '@/lib/submissions';
import { requireUserPage } from '@/lib/guards';
import { DENOMINATIONS } from '@/data/denominations';
import { INDUSTRIES } from '@/data/industries';

const gate = requireUserPage(Astro);
if (gate) return gate;
const user = Astro.locals.user!;

const dbReady = hasDatabase();
let rows: Array<{
  id: string; slug: string; name: string; typeSlug: string; status: string;
  reviewNote?: string | null;
  city: string | null; region: string | null; updatedAt: Date;
  data: Record<string, unknown>;
}> = [];

if (dbReady) {
  try {
    const db = getDb();
    if (db) {
      const mine = await db
        .select({ listing: listings, loc: listingLocations })
        .from(listings)
        .leftJoin(listingLocations, and(eq(listingLocations.listingId, listings.id), eq(listingLocations.isPrimary, true)))
        .where(and(eq(listings.ownerId, user.id), isNull(listings.deletedAt)))
        .orderBy(desc(listings.updatedAt));

      const ids = mine.map((m) => m.listing.id);
      const denomsByListing = new Map<string, string[]>();
      if (ids.length) {
        const denomRows = await db
          .select({ listingId: listingDenominations.listingId, slug: denominations.slug })
          .from(listingDenominations)
          .innerJoin(denominations, eq(listingDenominations.denominationId, denominations.id))
          .where(inArray(listingDenominations.listingId, ids));
        for (const d of denomRows) {
          const list = denomsByListing.get(d.listingId) ?? [];
          list.push(d.slug);
          denomsByListing.set(d.listingId, list);
        }
      }

      rows = mine.map(({ listing: l, loc }) => {
        const listDenoms = (Array.isArray(l.denominationsList) && l.denominationsList.length > 0)
          ? (l.denominationsList as string[])
          : (denomsByListing.get(l.id) ?? []);
        return {
          id: l.id,
          slug: l.slug,
          name: l.name,
          typeSlug: l.typeSlug,
          status: l.status,
          reviewNote: l.reviewNote,
          city: loc?.city ?? null,
          region: loc?.region ?? null,
          updatedAt: l.updatedAt,
          data: {
            name: l.name,
            typeSlug: l.typeSlug,
            industrySlug: l.industrySlug ?? '',
            categorySlug: l.categorySlug ?? '',
            customCategory: l.customCategory ?? '',
            tagline: l.tagline ?? '',
            description: l.description ?? '',
            website: l.website ?? '',
            phone: l.phone ?? '',
            email: l.email ?? '',
            showEmail: l.showEmail,
            showPhone: l.showPhone,
            showWebsite: l.showWebsite,
            showAddress: l.showAddress,
            showDenomination: l.showDenomination,
            customDenomination: l.customDenomination ?? '',
            denominations: listDenoms,
            city: loc?.city ?? '',
            region: loc?.region ?? '',
            postalCode: loc?.postalCode ?? '',
            isOnlineOnly: l.isOnlineOnly,
            priceRange: l.priceRange ?? '',
          },
        };
      });
    }
  } catch (err) {
    console.error('[dashboard/listings] failed to fetch listings from db:', err);
  }
}

const notice = Astro.url.searchParams.get('notice') ?? '';
const notices: Record<string, { title: string; body: string; tone: string }> = {
  'verify-email': { title: 'Confirm your email', body: 'We sent an account confirmation link to your inbox. This does not verify a business.', tone: 'var(--accent)' },
  'email-verified': { title: 'Email confirmed — thank you!', body: 'Your account email address is confirmed. This does not verify a business.', tone: 'var(--teal)' },
  'listing-published': { title: 'Listing published!', body: 'Your profile is now live as an owner-submitted listing. Publishing is not a verification.', tone: 'var(--teal)' },
  'listing-saved': { title: 'Changes saved', body: 'Your listing updates have been saved.', tone: 'var(--teal)' },
};
const banner = notices[notice];

const popularDenominations = [
  { slug: 'non-denominational', name: 'Non-Denominational' },
  { slug: 'baptist', name: 'Baptist' },
  { slug: 'lutheran', name: 'Lutheran' },
  { slug: 'reformed-presbyterian', name: 'Presbyterian & Reformed' },
  { slug: 'methodist-wesleyan', name: 'Methodist & Wesleyan' },
  { slug: 'pentecostal-charismatic', name: 'Pentecostal & Charismatic' },
  { slug: 'anglican-episcopal', name: 'Anglican & Episcopal' },
  { slug: 'catholic', name: 'Catholic' },
  { slug: 'eastern-orthodox', name: 'Eastern Orthodox' },
  { slug: 'evangelical', name: 'Evangelical Free' },
  { slug: 'anabaptist', name: 'Anabaptist & Mennonite' },
  { slug: 'restorationist', name: 'Churches of Christ' },
  { slug: 'interdenominational', name: 'Interdenominational' },
  { slug: 'other', name: 'Other (specify custom denomination)' },
];

const allOtherDenominations = [...DENOMINATIONS]
  .filter((d) => !popularDenominations.some((p) => p.slug === d.slug))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<DashboardLayout user={user} active="listings" seo={{ title: 'My listings — CrossLinkd', description: 'Manage your business listings.', path: '/dashboard/listings', noindex: true }}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">My listings</h1>
      <p class="section-sub">Create, edit, and manage your business listings. Active listings are published live in the directory.</p>
    </div>
  </div>

  {banner && (
    <div class="card mt-4 border-l-4 p-4" style={`border-left-color:${banner.tone}`} role="status">
      <p class="text-sm font-bold">{banner.title}</p>
      <p class="mt-0.5 text-sm" style="color:var(--text-soft)">{banner.body}</p>
    </div>
  )}

  {!dbReady && (
    <div class="card mt-4 border-l-4 p-4" style="border-left-color:var(--accent)">
      <p class="text-sm font-bold">Preview mode</p>
      <p class="mt-0.5 text-sm" style="color:var(--text-soft)">Submissions need the database configured. Sign in on a deployment with <code>DATABASE_URL</code> configured.</p>
    </div>
  )}

  <div id="form-banner" class="card mt-4 hidden border-l-4 p-4" role="alert" style="border-left-color:var(--accent)">
    <p id="form-banner-text" class="text-sm font-bold"></p>
  </div>

  <!-- New / edit listing card -->
  <details class="card mt-5 p-5 sm:p-6" id="listing-form-card">
    <summary class="cursor-pointer select-none">
      <span class="font-bold" id="form-title">+ Create a new listing</span>
      <span class="text-sm" style="color:var(--text-mute)"> — your business profile goes live immediately.</span>
    </summary>
    <form id="listing-form" class="mt-5 space-y-5" data-listing-id="">
      <!-- Section 1: Overview -->
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium">Business name *
          <input name="name" required minlength="2" maxlength="240" class="input mt-1 w-full" placeholder="Enter your business name" />
        </label>
        <label class="block text-sm font-medium">Listing type *
          <select name="typeSlug" required class="input mt-1 w-full">
            <option value="business">Business</option>
            <option value="church">Church</option>
            <option value="ministry">Ministry</option>
            <option value="nonprofit">Nonprofit</option>
            <option value="professional">Professional</option>
          </select>
        </label>
      </div>

      <label class="block text-sm font-medium">Tagline
        <input name="tagline" maxlength="280" class="input mt-1 w-full" placeholder="Brief summary of what your business does" />
      </label>

      <label class="block text-sm font-medium">Description * <span class="font-normal" style="color:var(--text-mute)">(30+ characters to publish)</span>
        <textarea name="description" rows="4" minlength="30" maxlength="8000" class="input mt-1 w-full" placeholder="Describe what your business offers, who you serve, and what makes your business distinct"></textarea>
      </label>

      <!-- Section 2: Expandable Hierarchical Industry & Category Selector -->
      <div class="rounded-2xl p-4 border" style="border-color:var(--border);background:var(--surface-2)">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-sm font-semibold">Industry &amp; business category *</h3>
            <p class="text-xs" style="color:var(--text-mute)">Choose a broad industry, then select the specific category for your business.</p>
          </div>
          <span id="dash-category-badge" class="chip !text-[11px] font-bold">Category required</span>
        </div>

        <input type="hidden" name="industrySlug" id="dash-input-industry-slug" value="" />
        <input type="hidden" name="categorySlug" id="dash-input-category-slug" value="" />

        <!-- Selected Category Display Banner -->
        <div id="dash-category-selected-card" class="hidden mt-3 p-3 rounded-xl border border-[var(--teal)] bg-[rgba(46,146,131,0.08)]">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs uppercase font-bold tracking-wide" style="color:var(--teal)">Selected Category</span>
              <p class="font-bold text-sm mt-0.5" id="dash-category-selected-text"></p>
            </div>
            <button type="button" class="btn btn-secondary !py-1 !px-3 !text-xs font-semibold" id="dash-change-category-btn">Change category</button>
          </div>
        </div>

        <!-- Custom Category Input when 'Other' category is chosen -->
        <div id="dash-custom-category-wrap" class="hidden mt-3 rounded-xl p-3 border border-[var(--border)] bg-[var(--surface)]">
          <label class="block text-xs font-medium">Custom category name *
            <input name="customCategory" id="dash-input-custom-category" class="input mt-1 w-full" placeholder="e.g. Specialty Gluten-Free Bakery, Stained Glass Restoration, etc." maxlength="180" />
          </label>
        </div>

        <!-- Accordion Selection Container -->
        <div id="dash-category-accordion-wrapper" class="mt-3">
          <div class="relative mb-2">
            <input
              type="search"
              id="dash-category-search-input"
              class="input w-full !pl-8 text-xs"
              placeholder="Search categories (e.g. Bakery, Plumbing, Roofing, Dental)..."
              autocomplete="off"
            />
            <svg class="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>

          <div class="space-y-1.5 max-h-[300px] overflow-y-auto pr-1 rounded-xl" id="dash-industry-accordion-list">
            {INDUSTRIES.map((ind) => (
              <div class="dash-industry-item rounded-xl border border-[var(--border)] bg-[var(--surface)] overflow-hidden" data-industry-slug={ind.slug}>
                <button
                  type="button"
                  class="dash-industry-header-btn w-full flex items-center justify-between p-2.5 text-left font-bold text-xs hover:bg-[var(--surface-2)] transition-colors focus:outline-none"
                  aria-expanded="false"
                  aria-controls={`dash-ind-cats-${ind.slug}`}
                >
                  <span class="flex items-center gap-1.5">
                    <span class="dash-industry-name">{ind.name}</span>
                    <span class="text-[10px] font-normal" style="color:var(--text-mute)">({ind.categories.length})</span>
                  </span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>

                <div id={`dash-ind-cats-${ind.slug}`} class="dash-industry-body hidden p-2.5 border-t border-[var(--border)] bg-[var(--surface-2)]" role="region">
                  <div class="grid gap-1.5 sm:grid-cols-2">
                    {ind.categories.map((cat) => (
                      <button
                        type="button"
                        class="dash-subcat-option-btn p-1.5 rounded-lg text-left text-xs font-medium border border-[var(--border)] bg-[var(--surface)] hover:border-[var(--accent)] hover:bg-[var(--surface-2)] transition-all flex items-center justify-between"
                        data-industry-slug={ind.slug}
                        data-industry-name={ind.name}
                        data-category-slug={cat.slug}
                        data-category-name={cat.name}
                      >
                        <span class="dash-subcat-name">{cat.name}</span>
                        <span class="select-indicator text-xs font-bold opacity-0 transition-opacity" style="color:var(--teal)">✓</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Section 3: Faith & Multi-Denomination Selector (Max 2) -->
      <div class="rounded-2xl p-4 border" style="border-color:var(--border);background:var(--surface-2)">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-sm font-semibold">Faith affiliation &amp; denomination</h3>
            <p class="text-xs" style="color:var(--text-mute)">Select up to two denominations that best represent this organization.</p>
          </div>
          <span id="dash-denom-counter" class="chip !text-[11px]">0 of 2 selected</span>
        </div>

        <!-- Active Selection Chips Display -->
        <div id="dash-denom-chips-container" class="mt-2.5 flex flex-wrap items-center gap-1.5 min-h-[36px] p-2 rounded-xl border border-dashed border-[var(--border)] bg-[var(--surface)]">
          <span id="dash-denom-empty-hint" class="text-xs" style="color:var(--text-mute)">No denominations selected yet. Choose up to two below.</span>
        </div>

        <div id="dash-denom-hidden-inputs"></div>

        <div class="mt-2.5">
          <div class="flex flex-wrap gap-1" id="dash-popular-denoms">
            {popularDenominations.map((d) => (
              <button
                type="button"
                class="dash-denom-toggle-btn chip !py-1 !px-2.5 !text-xs font-medium cursor-pointer transition-colors"
                data-slug={d.slug}
                data-name={d.name}
              >
                {d.name}
              </button>
            ))}
          </div>

          <div class="mt-2.5">
            <label class="block text-xs font-medium mb-1" style="color:var(--text-mute)">More historical &amp; regional denominations:
              <select id="dash-more-denoms-select" class="input mt-1 w-full text-xs">
                <option value="">Choose additional denomination…</option>
                {allOtherDenominations.map((d) => (
                  <option value={d.slug}>{d.name}</option>
                ))}
              </select>
            </label>
          </div>
        </div>

        <!-- Custom Denomination Input when 'Other' is chosen -->
        <div id="dash-custom-denom-wrap" class="hidden mt-3 rounded-xl p-3 border border-[var(--border)] bg-[var(--surface)]">
          <label class="block text-xs font-medium">Custom denomination or movement name *
            <input
              name="customDenomination"
              id="dash-custom-denom-input"
              class="input mt-1 w-full"
              placeholder="e.g. Calvary Chapel, Vineyard Movement, Independent Baptist..."
              maxlength="180"
            />
          </label>
        </div>

        <label class="mt-3 flex items-center gap-2 text-xs font-medium cursor-pointer">
          <input type="checkbox" name="showDenomination" value="1" checked class="h-4 w-4 accent-[var(--accent)]" />
          Display faith affiliation publicly on listing
        </label>
      </div>

      <!-- Section 4: Location -->
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block text-sm font-medium">City *
          <input name="city" maxlength="120" class="input mt-1 w-full" placeholder="Enter city" />
        </label>
        <label class="block text-sm font-medium">State / Region *
          <input name="region" maxlength="120" class="input mt-1 w-full" placeholder="Enter state or region" />
        </label>
        <label class="block text-sm font-medium">ZIP / Postal code
          <input name="postalCode" maxlength="24" class="input mt-1 w-full" placeholder="Postal code" />
        </label>
      </div>

      <label class="flex items-center gap-2 text-xs font-medium cursor-pointer">
        <input type="checkbox" name="showAddress" value="1" class="h-4 w-4 accent-[var(--accent)]" />
        Display full address publicly on listing
      </label>

      <label class="flex items-center gap-2 text-sm font-medium">
        <input type="checkbox" name="isOnlineOnly" class="h-4 w-4 accent-[var(--accent)]" />
        Online only — serves nationwide (no physical storefront)
      </label>

      <!-- Section 5: Contact & Privacy Controls -->
      <div class="rounded-2xl p-4 border" style="border-color:var(--border)">
        <h3 class="text-sm font-semibold">Contact information &amp; privacy controls</h3>
        <p class="text-xs" style="color:var(--text-mute)">Private contact details are kept secure for account purposes and never exposed publicly.</p>

        <!-- Contact Email -->
        <div class="mt-3 space-y-1">
          <label class="block text-sm font-medium">Contact email *
            <input name="email" type="email" class="input mt-1 w-full" placeholder="contact@yourbusiness.com" value={user.email} />
          </label>
          <p class="text-[11px]" style="color:var(--text-soft)">
            Account email: <strong>{user.email}</strong>. Pre-filled for your convenience; feel free to change it to your organization's inquiry address.
          </p>
          <label class="flex items-center gap-2 text-xs font-medium cursor-pointer pt-1">
            <input type="checkbox" name="showEmail" value="1" class="h-4 w-4 accent-[var(--accent)]" />
            Display email address publicly on listing
          </label>
          <p class="text-[11px]" style="color:var(--text-mute)">When unchecked, customers can still contact you via our safe on-site form without seeing your email address.</p>
        </div>

        <!-- Phone -->
        <div class="mt-4 space-y-1">
          <label class="block text-sm font-medium">Phone number
            <input name="phone" maxlength="60" class="input mt-1 w-full" placeholder="Enter phone number" />
          </label>
          <label class="flex items-center gap-2 text-xs font-medium cursor-pointer">
            <input type="checkbox" name="showPhone" value="1" class="h-4 w-4 accent-[var(--accent)]" />
            Display phone number publicly on listing
          </label>
        </div>

        <!-- Website -->
        <div class="mt-4 space-y-1">
          <label class="block text-sm font-medium">Website
            <input name="website" type="url" class="input mt-1 w-full" placeholder="https://yourbusiness.com" />
          </label>
          <label class="flex items-center gap-2 text-xs font-medium cursor-pointer">
            <input type="checkbox" name="showWebsite" value="1" class="h-4 w-4 accent-[var(--accent)]" />
            Display website link publicly on listing
          </label>
        </div>

        <!-- Price Range -->
        <div class="mt-4">
          <label class="block text-sm font-medium">Price range
            <select name="priceRange" class="input mt-1 w-full">
              <option value="">Select price range (optional)</option>
              <option value="$">$ (Inexpensive)</option>
              <option value="$$">$$ (Moderate)</option>
              <option value="$$$">$$$ (Upscale)</option>
              <option value="$$$$">$$$$ (Premium)</option>
            </select>
          </label>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 pt-2">
        <button type="button" data-intent="submit" class="btn btn-primary" id="form-submit-btn">Publish listing</button>
        <button type="button" data-intent="draft" class="btn btn-secondary">Save draft</button>
        <button type="button" id="form-cancel-btn" class="btn btn-ghost hidden">Cancel edit</button>
        <span id="form-status" class="self-center text-sm" style="color:var(--text-mute)" role="status"></span>
      </div>
    </form>
  </details>

  <!-- Listings table -->
  <div class="card mt-5 overflow-x-auto" id="listings-table-card">
    <table class="w-full min-w-[680px] text-sm">
      <thead>
        <tr class="text-left text-xs uppercase" style="color:var(--text-mute)">
          <th class="p-3">Business</th>
          <th class="p-3">Location</th>
          <th class="p-3">Status</th>
          <th class="p-3">Updated</th>
          <th class="p-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? (
          <tr id="empty-table-row">
            <td colspan="5" class="p-8 text-center">
              <p class="font-bold">No listings yet</p>
              <p class="mt-1 text-sm" style="color:var(--text-soft)">Create your first business listing above — it goes live immediately.</p>
            </td>
          </tr>
        ) : (
          rows.map((r) => (
            <tr class="border-t align-top" style="border-color:var(--border)" data-row-id={r.id}>
              <td class="p-3">
                <p class="font-medium">{r.name}</p>
                <p class="text-xs" style="color:var(--text-mute)">{r.typeSlug}</p>
                {r.reviewNote && (
                  <p class="mt-1 text-xs text-amber-600 font-medium">Reviewer note: {r.reviewNote}</p>
                )}
              </td>
              <td class="p-3">{r.city || '—'}{r.region ? `, ${r.region}` : ''}</td>
              <td class="p-3">
                <span class={`chip !text-[11px] ${STATUS_CHIP[r.status] ?? ''}`} style={r.status === 'published' ? 'color:var(--teal)' : ''}>
                  {STATUS_LABEL[r.status] ?? r.status}
                </span>
              </td>
              <td class="p-3 text-xs" style="color:var(--text-mute)">
                {r.updatedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </td>
              <td class="p-3">
                <div class="flex flex-wrap justify-end gap-1.5" data-actions data-listing={JSON.stringify(r.data)} data-id={r.id} data-name={r.name} data-status={r.status}>
                  <button type="button" class="btn btn-ghost !px-2.5 !py-1 !text-xs" data-act="edit">Edit</button>
                  {r.status === 'draft' && (
                    <button type="button" class="btn btn-primary !px-2.5 !py-1 !text-xs" data-act="submit">Submit</button>
                  )}
                  {r.status === 'changes_requested' && (
                    <button type="button" class="btn btn-primary !px-2.5 !py-1 !text-xs" data-act="resubmit">Resubmit</button>
                  )}
                  {r.status === 'published' && (
                    <a href={`/directory/${r.slug}`} class="btn btn-secondary !px-2.5 !py-1 !text-xs" target="_blank">View live</a>
                  )}
                  <button type="button" class="btn btn-ghost !px-2.5 !py-1 !text-xs" data-act="delete" style="color:var(--accent)">Delete</button>
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  <script>
    const form = document.getElementById('listing-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    const banner = document.getElementById('form-banner');
    const bannerText = document.getElementById('form-banner-text');
    const formTitle = document.getElementById('form-title');
    const formSubmitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
    const formCancelBtn = document.getElementById('form-cancel-btn') as HTMLButtonElement | null;
    const formCard = document.getElementById('listing-form-card') as HTMLDetailsElement | null;

    // -------------------------------------------------------------------------
    // Accordion Category State
    // -------------------------------------------------------------------------
    const accordionWrapper = document.getElementById('dash-category-accordion-wrapper');
    const searchInput = document.getElementById('dash-category-search-input') as HTMLInputElement | null;
    const selectedCard = document.getElementById('dash-category-selected-card');
    const selectedText = document.getElementById('dash-category-selected-text');
    const changeBtn = document.getElementById('dash-change-category-btn');
    const inputIndustrySlug = document.getElementById('dash-input-industry-slug') as HTMLInputElement | null;
    const inputCategorySlug = document.getElementById('dash-input-category-slug') as HTMLInputElement | null;
    const customCategoryWrap = document.getElementById('dash-custom-category-wrap');
    const inputCustomCategory = document.getElementById('dash-input-custom-category') as HTMLInputElement | null;
    const categoryBadge = document.getElementById('dash-category-badge');

    // Industry Accordion Toggles
    document.querySelectorAll<HTMLButtonElement>('.dash-industry-header-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const bodyId = btn.getAttribute('aria-controls');
        const body = bodyId ? document.getElementById(bodyId) : null;
        const chevron = btn.querySelector('.chevron');

        btn.setAttribute('aria-expanded', String(!isExpanded));
        if (body) body.classList.toggle('hidden', isExpanded);
        if (chevron) chevron.classList.toggle('rotate-180', !isExpanded);
      });
    });

    function setCategorySelection(indSlug: string, indName: string, catSlug: string, catName: string) {
      if (inputIndustrySlug) inputIndustrySlug.value = indSlug;
      if (inputCategorySlug) inputCategorySlug.value = catSlug;

      if (selectedText) selectedText.textContent = `${indName} › ${catName}`;
      selectedCard?.classList.remove('hidden');
      accordionWrapper?.classList.add('hidden');

      const isOther = catSlug.startsWith('other') || indSlug === 'other-industries';
      if (customCategoryWrap && inputCustomCategory) {
        if (isOther) {
          customCategoryWrap.classList.remove('hidden');
          inputCustomCategory.required = true;
        } else {
          customCategoryWrap.classList.add('hidden');
          inputCustomCategory.required = false;
          inputCustomCategory.value = '';
        }
      }

      if (categoryBadge) {
        categoryBadge.textContent = 'Selected ✓';
        categoryBadge.style.color = 'var(--teal)';
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.dash-subcat-option-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const indSlug = btn.dataset.industrySlug || '';
        const indName = btn.dataset.industryName || '';
        const catSlug = btn.dataset.categorySlug || '';
        const catName = btn.dataset.categoryName || '';
        setCategorySelection(indSlug, indName, catSlug, catName);
      });
    });

    changeBtn?.addEventListener('click', () => {
      selectedCard?.classList.add('hidden');
      accordionWrapper?.classList.remove('hidden');
      if (searchInput) searchInput.focus();
    });

    // Real-time Category Search
    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      document.querySelectorAll<HTMLElement>('.dash-industry-item').forEach((item) => {
        const indBtn = item.querySelector<HTMLButtonElement>('.dash-industry-header-btn');
        const body = item.querySelector<HTMLElement>('.dash-industry-body');
        const chevron = item.querySelector('.chevron');
        const subcatBtns = item.querySelectorAll<HTMLButtonElement>('.dash-subcat-option-btn');
        let hasMatch = false;

        subcatBtns.forEach((subBtn) => {
          const name = (subBtn.dataset.categoryName || '').toLowerCase();
          const match = !q || name.includes(q);
          subBtn.classList.toggle('hidden', !match);
          if (match) hasMatch = true;
        });

        if (!q) {
          item.classList.remove('hidden');
          indBtn?.setAttribute('aria-expanded', 'false');
          body?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        } else if (hasMatch) {
          item.classList.remove('hidden');
          indBtn?.setAttribute('aria-expanded', 'true');
          body?.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        } else {
          item.classList.add('hidden');
        }
      });
    });

    // -------------------------------------------------------------------------
    // Multi-Denomination Selector State (Max 2)
    // -------------------------------------------------------------------------
    const selectedDenoms = new Map<string, string>();
    const chipsContainer = document.getElementById('dash-denom-chips-container');
    const emptyHint = document.getElementById('dash-denom-empty-hint');
    const counterBadge = document.getElementById('dash-denom-counter');
    const customDenomWrap = document.getElementById('dash-custom-denom-wrap');
    const customDenomInput = document.getElementById('dash-custom-denom-input') as HTMLInputElement | null;
    const moreSelect = document.getElementById('dash-more-denoms-select') as HTMLSelectElement | null;

    function renderDenominations() {
      if (chipsContainer) {
        chipsContainer.querySelectorAll('.dash-denom-chip').forEach((c) => c.remove());
        if (selectedDenoms.size === 0) {
          emptyHint?.classList.remove('hidden');
        } else {
          emptyHint?.classList.add('hidden');
          selectedDenoms.forEach((name, slug) => {
            const chip = document.createElement('span');
            chip.className = 'dash-denom-chip inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold border border-[var(--teal)] bg-[rgba(46,146,131,0.12)] text-[var(--teal)]';
            chip.innerHTML = `<span>${name}</span><button type="button" class="remove-chip hover:opacity-75 focus:outline-none" aria-label="Remove ${name}" data-slug="${slug}">✕</button>`;
            chip.querySelector('.remove-chip')?.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleDenomination(slug, name);
            });
            chipsContainer.appendChild(chip);
          });
        }
      }

      if (counterBadge) {
        const count = selectedDenoms.size;
        counterBadge.textContent = `${count} of 2 selected`;
        if (count === 2) {
          counterBadge.style.color = 'var(--teal)';
          counterBadge.textContent = '2 of 2 selected (maximum)';
        } else {
          counterBadge.style.color = '';
        }
      }

      document.querySelectorAll<HTMLButtonElement>('.dash-denom-toggle-btn').forEach((btn) => {
        const slug = btn.dataset.slug || '';
        const isSelected = selectedDenoms.has(slug);
        btn.classList.toggle('chip-active', isSelected);
        btn.classList.toggle('font-bold', isSelected);
      });

      if (customDenomWrap && customDenomInput) {
        if (selectedDenoms.has('other')) {
          customDenomWrap.classList.remove('hidden');
          customDenomInput.required = true;
        } else {
          customDenomWrap.classList.add('hidden');
          customDenomInput.required = false;
        }
      }
    }

    function toggleDenomination(slug: string, name: string) {
      if (selectedDenoms.has(slug)) {
        selectedDenoms.delete(slug);
      } else {
        if (selectedDenoms.size >= 2) {
          alert('You can select up to two denominations. Remove one to choose another.');
          return;
        }
        selectedDenoms.set(slug, name);
      }
      renderDenominations();
    }

    document.querySelectorAll<HTMLButtonElement>('.dash-denom-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug || '';
        const name = btn.dataset.name || '';
        toggleDenomination(slug, name);
      });
    });

    moreSelect?.addEventListener('change', () => {
      const slug = moreSelect.value;
      if (!slug) return;
      const option = moreSelect.options[moreSelect.selectedIndex];
      const name = option ? option.text : slug;
      toggleDenomination(slug, name);
      moreSelect.value = '';
    });

    function showBanner(ok: boolean, msg: string) {
      if (!banner || !bannerText) return;
      banner.style.borderLeftColor = ok ? 'var(--teal)' : 'var(--accent)';
      bannerText.textContent = msg;
      banner.classList.remove('hidden');
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function resetForm() {
      if (!form) return;
      form.reset();
      form.dataset.listingId = '';
      if (formTitle) formTitle.textContent = '+ Create a new listing';
      if (formSubmitBtn) formSubmitBtn.textContent = 'Publish listing';
      formCancelBtn?.classList.add('hidden');

      // Reset category
      if (inputIndustrySlug) inputIndustrySlug.value = '';
      if (inputCategorySlug) inputCategorySlug.value = '';
      if (inputCustomCategory) inputCustomCategory.value = '';
      selectedCard?.classList.add('hidden');
      accordionWrapper?.classList.remove('hidden');
      customCategoryWrap?.classList.add('hidden');
      if (categoryBadge) {
        categoryBadge.textContent = 'Category required';
        categoryBadge.style.color = '';
      }

      // Reset denominations
      selectedDenoms.clear();
      renderDenominations();
    }

    function fillForm(data: Record<string, unknown>, id: string, name: string) {
      if (!form) return;
      form.dataset.listingId = id;
      for (const [k, v] of Object.entries(data)) {
        if (k === 'denominations') continue;
        const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        if (!el) continue;
        if (el instanceof HTMLInputElement && el.type === 'checkbox') {
          el.checked = Boolean(v);
        } else {
          el.value = String(v ?? '');
        }
      }

      // Restore category
      const indSlug = String(data.industrySlug || '');
      const catSlug = String(data.categorySlug || '');
      const customCat = String(data.customCategory || '');
      if (catSlug) {
        const catBtn = document.querySelector<HTMLButtonElement>(`.dash-subcat-option-btn[data-category-slug="${catSlug}"]`);
        const indName = catBtn?.dataset.industryName || indSlug;
        const catName = catBtn?.dataset.categoryName || catSlug;
        setCategorySelection(indSlug, indName, catSlug, catName);
        if (inputCustomCategory && customCat) {
          inputCustomCategory.value = customCat;
        }
      } else {
        selectedCard?.classList.add('hidden');
        accordionWrapper?.classList.remove('hidden');
      }

      // Restore denominations (up to 2)
      selectedDenoms.clear();
      const rawDenoms = Array.isArray(data.denominations) ? data.denominations : (data.denominations ? [data.denominations] : []);
      for (const d of rawDenoms.slice(0, 2)) {
        const slug = String(d);
        if (!slug) continue;
        const toggleBtn = document.querySelector<HTMLButtonElement>(`.dash-denom-toggle-btn[data-slug="${slug}"]`);
        const option = moreSelect?.querySelector<HTMLOptionElement>(`option[value="${slug}"]`);
        const dName = toggleBtn?.dataset.name || option?.text || slug;
        selectedDenoms.set(slug, dName);
      }
      renderDenominations();

      if (formTitle) formTitle.textContent = `Edit “${name}”`;
      if (formSubmitBtn) formSubmitBtn.textContent = 'Save changes';
      formCancelBtn?.classList.remove('hidden');
      if (formCard) formCard.open = true;
      formCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    formCancelBtn?.addEventListener('click', () => {
      resetForm();
      if (formCard) formCard.open = false;
    });

    async function send(url: string, method: string, body: unknown) {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      const json = await res.json().catch(() => ({ ok: false, error: 'Unexpected server response.' }));
      return { ok: res.ok && json.ok, json } as { ok: boolean; json: { ok: boolean; error?: string } };
    }

    const collect = () => {
      if (!form) return {};
      const fd = new FormData(form);
      const out: Record<string, unknown> = {};
      fd.forEach((v, k) => { out[k] = v; });
      out.isOnlineOnly = (form.elements.namedItem('isOnlineOnly') as HTMLInputElement)?.checked ?? false;
      out.showEmail = (form.elements.namedItem('showEmail') as HTMLInputElement)?.checked ?? false;
      out.showPhone = (form.elements.namedItem('showPhone') as HTMLInputElement)?.checked ?? false;
      out.showWebsite = (form.elements.namedItem('showWebsite') as HTMLInputElement)?.checked ?? false;
      out.showAddress = (form.elements.namedItem('showAddress') as HTMLInputElement)?.checked ?? false;
      out.showDenomination = (form.elements.namedItem('showDenomination') as HTMLInputElement)?.checked ?? true;
      out.industrySlug = inputIndustrySlug?.value || '';
      out.categorySlug = inputCategorySlug?.value || '';
      out.customCategory = inputCustomCategory?.value || '';
      out.denominations = Array.from(selectedDenoms.keys());
      return out;
    };

    async function handleRowAction(act: string, id: string, data: Record<string, unknown>, name: string) {
      if (act === 'edit' || act === 'submit' || act === 'resubmit') {
        fillForm(data, id, name);
        if (act === 'submit' && formSubmitBtn) {
          formSubmitBtn.textContent = 'Submit for review';
        }
        if (act === 'resubmit' && formSubmitBtn) {
          formSubmitBtn.textContent = 'Resubmit for review';
        }
        return;
      }
      if (act === 'delete') {
        if (!confirm(`Delete “${name}”? This cannot be undone.`)) return;
        const { ok, json } = await send(`/api/listings/${id}`, 'DELETE', null);
        if (ok) location.reload();
        else showBanner(false, json.error ?? 'Delete failed.');
      }
    }

    document.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest('[data-actions]') as HTMLElement | null;
        if (!wrap) return;
        let data: Record<string, unknown> = {};
        try { data = JSON.parse(wrap.dataset.listing ?? '{}'); } catch { /* ignore */ }
        handleRowAction(btn.dataset.act ?? '', wrap.dataset.id ?? '', data, wrap.dataset.name ?? '');
      });
    });

    form?.querySelectorAll<HTMLButtonElement>('button[data-intent]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!form || !statusEl) return;
        const intent = btn.dataset.intent as 'draft' | 'submit' | 'publish';
        const id = form.dataset.listingId || '';
        const body = { action: intent === 'draft' ? 'draft' : 'submit', listing: collect() };

        if (intent !== 'draft') {
          const descVal = String(body.listing ? (body.listing as Record<string, unknown>).description ?? '' : '').trim();
          if (descVal.length < 30) {
            showBanner(false, 'A description of at least 30 characters is required to publish.');
            return;
          }
        }

        btn.disabled = true;
        statusEl.textContent = intent === 'draft' ? 'Saving draft…' : (id ? 'Saving changes…' : 'Publishing listing…');

        const lData = (body.listing as Record<string, unknown>) || {};
        const listingName = String(lData.name || '').trim();
        const typeSlug = String(lData.typeSlug || 'business');
        const city = String(lData.city || '');
        const region = String(lData.region || '');
        const statusLabel = intent === 'draft' ? 'Draft' : 'Pending Review';

        let tempRow: HTMLTableRowElement | null = null;
        const tbody = document.querySelector('#listings-table-card tbody');
        const emptyRow = document.getElementById('empty-table-row');
        if (!id && listingName && tbody) {
          if (emptyRow) emptyRow.style.display = 'none';
          tempRow = document.createElement('tr');
          tempRow.className = 'border-t align-top';
          tempRow.style.borderColor = 'var(--border)';
          tempRow.setAttribute('data-temp-row', 'true');
          tempRow.innerHTML = `
            <td class="p-3">
              <p class="font-medium">${listingName}</p>
              <p class="text-xs" style="color:var(--text-mute)">${typeSlug}</p>
            </td>
            <td class="p-3">${city || '—'}${region ? ', ' + region : ''}</td>
            <td class="p-3">
              <span class="chip !text-[11px]">${statusLabel}</span>
            </td>
            <td class="p-3 text-xs" style="color:var(--text-mute)">Just now</td>
            <td class="p-3">
              <div class="flex flex-wrap justify-end gap-1.5" data-actions data-name="${listingName}">
                <button type="button" class="btn btn-ghost !px-2.5 !py-1 !text-xs" data-act="edit">Edit</button>
                <button type="button" class="btn btn-primary !px-2.5 !py-1 !text-xs" data-act="submit">Submit</button>
              </div>
            </td>
          `;
          tbody.prepend(tempRow);
        } else if (id && tbody) {
          const row = tbody.querySelector(`[data-row-id="${id}"]`);
          const chip = row?.querySelector('.chip');
          if (chip) chip.textContent = statusLabel;
        }

        try {
          const { ok, json } = await send(id ? `/api/listings/${id}` : '/api/submissions', id ? 'PATCH' : 'POST', body);
          if (ok) {
            sessionStorage.setItem('cl:flash', intent === 'draft' ? 'listing-saved' : 'listing-published');
            location.reload();
          } else {
            if (tempRow) tempRow.remove();
            if (emptyRow && tbody && tbody.querySelectorAll('tr:not(#empty-table-row)').length === 0) {
              emptyRow.style.display = '';
            }
            showBanner(false, json.error ?? 'Something went wrong.');
            statusEl.textContent = '';
          }
        } catch {
          if (tempRow) tempRow.remove();
          if (emptyRow && tbody && tbody.querySelectorAll('tr:not(#empty-table-row)').length === 0) {
            emptyRow.style.display = '';
          }
          showBanner(false, 'Network error — try again.');
          statusEl.textContent = '';
        } finally {
          btn.disabled = false;
        }
      });
    });

    const flash = sessionStorage.getItem('cl:flash');
    if (flash) {
      sessionStorage.removeItem('cl:flash');
      const b = document.querySelector(`[role="status"]`);
      if (!b) showBanner(true, flash === 'listing-saved' ? 'Draft saved.' : 'Listing published! Your business profile is live.');
    }
  </script>
</DashboardLayout>
