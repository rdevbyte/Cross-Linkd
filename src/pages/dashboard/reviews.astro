---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireUserPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { reviews, listings } from '@/db/schema';
import { and, eq, isNull, desc } from 'drizzle-orm';

const __userGate = requireUserPage(Astro);
if (__userGate) return __userGate;
const user = Astro.locals.user!;

let userReviews: Array<{
  id: string;
  name: string;
  listingName: string;
  rating: number;
  body: string;
  when: string;
  responded: boolean;
  responsePending: boolean;
  responseRejected: boolean;
  ownerResponse: string | null;
}> = [];

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const rows = await db
        .select({
          id: reviews.id,
          rating: reviews.rating,
          body: reviews.body,
          createdAt: reviews.createdAt,
          ownerResponse: reviews.ownerResponse,
          ownerRespondedAt: reviews.ownerRespondedAt,
          listingName: listings.name,
        })
        .from(reviews)
        .innerJoin(listings, eq(reviews.listingId, listings.id))
        .where(and(eq(listings.ownerId, user.id), eq(reviews.status, 'published'), isNull(reviews.deletedAt)))
        .orderBy(desc(reviews.createdAt));

      userReviews = rows.map((r) => ({
        id: r.id,
        name: 'Community reviewer',
        listingName: r.listingName,
        rating: r.rating,
        body: r.body ?? '',
        when: new Date(r.createdAt).toLocaleDateString(),
        responded: Boolean(r.ownerResponse && r.ownerRespondedAt),
        responsePending: Boolean(r.ownerResponse && !r.ownerRespondedAt),
        responseRejected: Boolean(!r.ownerResponse && r.ownerRespondedAt),
        ownerResponse: r.ownerResponse,
      }));
    } catch (err) {
      console.error('[dashboard/reviews] query failed:', err);
    }
  }
}
---
<DashboardLayout user={user} active="reviews" seo={{ title: 'Reviews — Dashboard', description: 'Respond to reviews.', path: '/dashboard/reviews', noindex: true }}>
  <h1 class="text-2xl font-bold">Reviews & recommendations</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Customer reviews for your listings. Owner responses are moderated before publication, with one response allowed per review.</p>

  {Astro.url.searchParams.has('submitted') && (
    <p class="card mt-4 border-l-4 p-4 text-sm" role="status" style="border-left-color:var(--teal)">Your response was submitted for moderation. It will appear publicly if approved.</p>
  )}
  {Astro.url.searchParams.has('error') && (
    <p class="card mt-4 border-l-4 p-4 text-sm" role="alert" style="border-left-color:var(--accent)">
      {Astro.url.searchParams.get('error') === 'already-responded'
        ? 'A response has already been submitted for this review. The one-response limit applies.'
        : Astro.url.searchParams.get('error') === 'response-length'
          ? 'Responses must be between 2 and 2,000 characters.'
          : Astro.url.searchParams.get('error') === 'not-available'
            ? 'This review is no longer available for response.'
            : 'We could not save your response. Please try again.'}
    </p>
  )}

  {userReviews.length === 0 ? (
    <div class="card mt-6 p-8 text-center sm:p-12">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h2 class="mt-4 text-lg font-semibold">No reviews received yet</h2>
      <p class="mt-2 max-w-md mx-auto text-sm leading-relaxed" style="color:var(--text-soft)">
        When customers review your published listings, their feedback will appear here so you can post a response.
      </p>
    </div>
  ) : (
    <div class="mt-4 space-y-3">
      {userReviews.map((r) => (
        <div class="card p-5">
          <div class="flex items-center justify-between">
            <p class="font-bold">{r.name} <span class="font-normal" style="color:var(--text-mute)">on {r.listingName}</span></p>
            <span class="text-sm">★ {r.rating}.0 • {r.when}</span>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">{r.body}</p>
          {r.responded ? (
            <p class="mt-2 rounded-xl p-3 text-sm" style="background:var(--surface-2)"><strong>Your approved response:</strong> {r.ownerResponse}</p>
          ) : r.responsePending ? (
            <p class="mt-2 rounded-xl p-3 text-sm" role="status" style="background:var(--surface-2)">Your response is awaiting moderation.</p>
          ) : r.responseRejected ? (
            <p class="mt-2 rounded-xl p-3 text-sm" role="status" style="background:var(--surface-2)">Your response was not approved. The one-response limit still applies.</p>
          ) : (
            <form method="POST" action="/api/reviews/respond" class="mt-2 flex gap-2">
              <input type="hidden" name="reviewId" value={r.id} />
              <input name="response" required minlength="2" maxlength="2000" class="input" placeholder="Write a response…" aria-label="Response" />
              <button class="btn btn-primary !py-2 !text-sm" type="submit">Submit for moderation</button>
            </form>
          )}
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
