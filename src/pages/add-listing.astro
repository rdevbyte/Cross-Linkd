                    </div>
                  </div>
                  <p id="online-state-text" class="control-help" aria-live="polite">This listing is for in-person services.</p>
                </fieldset>
              </article>
            </div>

            <div id="careers-url-field" class="control-card careers-card mt-4" hidden>
              <label for="input-careers-url" class="control-label">Where can people view open positions? <span class="field-marker field-marker-optional">Optional</span>
                <input id="input-careers-url" name="careersUrl" type="text" inputmode="url" autocomplete="url" maxlength="2000" class="input mt-1.5" placeholder="https://example.com/careers" aria-describedby="careers-url-help careers-url-error" />
              </label>
              <p id="careers-url-help" class="control-help">Add a careers page or job-listing link. This is optional, even if hiring is set to Yes.</p>
              <p id="careers-url-error" class="mt-1.5 text-xs font-semibold text-red-600" role="alert" hidden>Enter a valid http:// or https:// URL.</p>
            </div>

            <!-- Physical Location -->
            <div id="location-fields" class="mt-4 space-y-3">
              <p id="location-requirement-help" class="field-help"><span class="field-marker field-marker-required">Required for in-person listings</span> Enter a city or state/region; either one is enough. ZIP/postal code is optional.</p>
              <div class="grid gap-4 sm:grid-cols-3">
                <label class="field-label">City <span class="field-marker field-marker-optional">Optional if region entered</span>
                  <input name="city" id="input-city" maxlength="120" class="input mt-1.5" placeholder="Enter city" />
                </label>
                <label class="field-label">State / region <span class="field-marker field-marker-optional">Optional if city entered</span>
                  <input name="region" id="input-region" maxlength="120" class="input mt-1.5" placeholder="Enter state or region" />
                </label>
                <label class="field-label">ZIP / Postal code <span class="field-marker field-marker-optional">Optional</span>
                  <input name="postalCode" maxlength="24" class="input mt-1.5" placeholder="Enter postal code" />
                </label>
              </div>

              <div class="setting-list">
                <label class="setting-row">
                  <input type="checkbox" name="showAddress" value="1" class="peer sr-only" />
                  <span class="setting-copy">
                    <span class="setting-title">Display postal code / full address publicly on listing <span class="field-marker field-marker-optional">Optional</span></span>
                    <span class="setting-help">When off, only your general city and state are displayed; specific postal codes remain private.</span>
                  </span>
                  <span class="setting-badge setting-badge-off">Off</span>
                  <span class="setting-badge setting-badge-on">On</span>
                  <span class="public-switch" aria-hidden="true"></span>
                </label>
              </div>
            </div>
            <p id="location-disabled-note" class="hidden mt-3 rounded-xl border p-3 text-xs font-semibold" style="border-color:var(--border); background:var(--surface-2); color:var(--text-soft)">Location fields are hidden for online-only listings — you serve customers nationwide.</p>

            <div class="public-panel mt-5">
              <h3 class="text-sm font-semibold">What the public sees <span class="field-marker field-marker-optional">Sharing choices are optional</span></h3>
              <p class="field-help">Each detail stays private until you switch its toggle on.</p>
              <div class="public-list mt-3">
                <article class="public-card">
                  <label class="public-label">Website URL <span class="field-marker field-marker-optional">Optional</span>
                    <input name="website" type="url" class="input mt-1.5" placeholder="https://yourbusiness.com" />
                  </label>
                  <label class="public-toggle setting-row">
                    <input type="checkbox" name="showWebsite" value="1" class="peer sr-only" />
                    <span class="setting-copy">
                      <span class="setting-title public-toggle-copy">Display website publicly on listing <span class="field-marker field-marker-optional">Optional</span></span>
                      <span class="setting-help public-help">When on, a direct "Website" link appears on your public profile.</span>
                    </span>
                    <span class="setting-badge setting-badge-off">Off</span>
                    <span class="setting-badge setting-badge-on">On</span>
                    <span class="public-switch" aria-hidden="true"></span>
                  </label>
                </article>
                <article class="public-card">
                  <label class="public-label">Phone number <span class="field-marker field-marker-optional">Optional</span>
                    <input name="phone" maxlength="60" class="input mt-1.5" placeholder="Enter phone number" />
                  </label>
                  <label class="public-toggle setting-row">
                    <input type="checkbox" name="showPhone" value="1" class="peer sr-only" />
                    <span class="setting-copy">
                      <span class="setting-title public-toggle-copy">Display phone number publicly on listing <span class="field-marker field-marker-optional">Optional</span></span>
                      <span class="setting-help public-help">When off, the number is kept for listing administration only. Storing it does not confirm the number.</span>
                    </span>
                    <span class="setting-badge setting-badge-off">Off</span>
                    <span class="setting-badge setting-badge-on">On</span>
                    <span class="public-switch" aria-hidden="true"></span>
                  </label>
                </article>
                <article class="public-card">
                  <label class="public-label">Contact email{!user && <> <span class="req" aria-hidden="true">*</span><span class="sr-only"> required for guest listings</span> <span class="field-marker field-marker-required">Required for guest listings</span></>}{user && <> <span class="field-marker field-marker-optional">Optional</span></>}
                    <input
                      name="email"
                      type="email"
                      class="input mt-1.5"
                      placeholder="contact@yourbusiness.com"
                      value={user?.email ?? ''}
                      required={!user}
                      aria-required={user ? undefined : 'true'}
                      aria-describedby="email-help"
                    />
                  </label>
                  <p id="email-help" class="field-help">
                    {user
                      ? <>Account email <strong>{user.email}</strong> is pre-filled; change it to your organization's inquiry address if you prefer.</>
                      : <>You’re creating a listing as a guest, so a contact email is required before publishing. <a href="/auth/signup" class="font-bold underline">Create a free account</a> to edit and manage this listing later.</>}
                  </p>
                  <label class="public-toggle setting-row">
                    <input type="checkbox" name="showEmail" value="1" class="peer sr-only" />
                    <span class="setting-copy">
                      <span class="setting-title public-toggle-copy">Display email address publicly on listing <span class="field-marker field-marker-optional">Optional</span></span>
                      <span class="setting-help public-help">When off, your email stays private; people can still reach you through the on-site inquiry form.</span>
                    </span>
                    <span class="setting-badge setting-badge-off">Off</span>
                    <span class="setting-badge setting-badge-on">On</span>
                    <span class="public-switch" aria-hidden="true"></span>
                  </label>
                </article>
              </div>
            </div>
          </section>

          <!-- Section 4: Review and publish -->
          <section id="section-review" aria-labelledby="section-review-heading" class="form-section card">
            <div class="section-head">
              <span class="section-num" aria-hidden="true">04</span>
              <div class="section-head-copy">
                <h2 id="section-review-heading" class="section-title">Review and publish</h2>
                <p class="section-lede">Confirm the required statements, then publish. Publishing creates an owner-submitted listing. It does not verify faith, ownership, licenses, credentials, or service quality.</p>
              </div>
            </div>

            <article class="review-card mt-5" aria-labelledby="review-required-heading">
              <div class="review-card-head">
                <h3 id="review-required-heading" class="text-sm font-semibold">Required before publishing</h3>
                <span class="req-pill">Required</span>
              </div>
              <ul id="review-checklist" class="review-checklist">
                <li data-check="type" data-state="needed"><a href="#section-basics">Organization type</a><span class="check-state">Needed</span></li>
                <li data-check="name" data-state="needed"><a href="#input-name">Listing name</a><span class="check-state">Needed</span></li>
                <li data-check="faith" data-state="needed"><a href="#section-faith">Faith identity</a><span class="check-state">Needed</span></li>
                <li data-check="attestation" data-state="needed"><a href="#input-attestation">Accuracy confirmation</a><span class="check-state">Needed</span></li>
                <li data-check="terms" data-state="needed"><a href="#input-terms">Terms agreement</a><span class="check-state">Needed</span></li>
              </ul>
              <label class="review-check" for="input-attestation">
                <input type="checkbox" name="attestation" id="input-attestation" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--accent)]" />
                <span>{ATTESTATION} <span class="field-marker field-marker-required">Required</span></span>
              </label>
              <label class="review-check" for="input-terms">
                <input type="checkbox" name="terms" id="input-terms" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--accent)]" />
                <span>I am authorized to list this organization, and I agree to the <a href="/terms" class="underline">Terms of Service</a> and <a href="/guidelines" class="underline">Community Guidelines</a>. <span class="field-marker field-marker-required">Required</span></span>
              </label>
            </article>

            <details class="disclose mt-4" data-open-if>
              <summary>
                <span class="text-sm font-bold">Discovery tags</span>
                <span class="disclose-hint">Optional</span>
              </summary>
              <label class="field-label mt-3 block">Hashtags <span class="field-marker field-marker-optional">Optional</span>
                <input name="hashtags" class="input mt-1.5" placeholder="e.g. ChristianOwned, FamilyOwned, VeteranOwned" />
                <span class="field-help">Comma-separated. These help search. They are not a verification.</span>
              </label>
            </details>

            <article class="review-card review-publish mt-4" aria-labelledby="review-publish-heading">
              <div class="review-card-head">
                <h3 id="review-publish-heading" class="text-sm font-semibold">Publish this listing</h3>
                <span class="req-pill">Final step</span>
              </div>
              <p id="publish-help" class="text-sm leading-relaxed" style="color:var(--text-soft)">Publishing submits this form. If the required fields are valid, the listing goes live as owner-submitted. It does not start a verification, charge a fee, or endorse the organization. You can still save a draft instead.</p>
              <p id="review-missing" class="review-missing" hidden></p>
              <div class="review-actions">
                <button type="submit" id="review-publish-btn" class="btn btn-primary" data-label="Publish" aria-describedby="publish-help">Publish</button>
                <button type="button" id="review-draft-btn" class="btn btn-secondary">Save draft</button>
              </div>
              <p id="review-status" class="form-status hidden" aria-hidden="true"></p>
            </article>
          </section>
        </form>
      </div>
    )}

  </div>

  <script define:vars={{ industries, typeCategoryMap: TYPE_CATEGORY_MAP, typeCategoryFilter: TYPE_CATEGORY_FILTER, denominations: denominationOptions }}>
    // ---------------------------------------------------------------------
    // State
    // ---------------------------------------------------------------------
    const form = document.getElementById('add-listing-form');
    const typeCards = document.querySelectorAll('.type-card');
    const inputTypeSlug = document.getElementById('input-type-slug');
    const listingTypeError = document.getElementById('listing-type-error');
    const nameInput = document.getElementById('input-name');
    const descriptionInput = document.getElementById('input-description');
    const descriptionCounter = document.getElementById('description-counter');
    const statementInput = document.getElementById('input-statement');

    const categoryHelp = document.getElementById('category-filter-help');
    const categoryStatus = document.getElementById('category-filter-status');
    const categoryWarning = document.getElementById('category-type-warning');
    const inputIndustrySlug = document.getElementById('input-industry-slug');
    const inputCategorySlug = document.getElementById('input-category-slug');
    const chipsWrap = document.getElementById('category-chips-primary');
    const chipText = document.getElementById('category-chip-text');
    const chipClear = document.getElementById('category-chip-clear');
    const customWrap = document.getElementById('custom-category-wrap');
    const inputCustomCategory = document.getElementById('input-custom-category');
    const manualCategoryPicker = document.getElementById('manual-category-picker');
    const professionOptions = document.getElementById('profession-options');
    const serviceOptions = document.getElementById('service-options');
    const customProfessionsInput = document.getElementById('input-custom-professions');
    const customServicesInput = document.getElementById('input-custom-services');
    const selectedServiceNames = new Set();
    const selectedServiceSources = new Map();

    const searchInput = document.getElementById('category-search-input');
    const searchResults = document.getElementById('category-search-results');
    const denomSearchInput = document.getElementById('denom-search-input');
    const denomSearchResults = document.getElementById('denom-search-results');
    const categoryTypeContext = document.getElementById('category-type-context');

    const onlineToggle = document.getElementById('input-online');
    const locationFields = document.getElementById('location-fields');
    const locationNote = document.getElementById('location-disabled-note');
    const cityInput = document.getElementById('input-city');
    const regionInput = document.getElementById('input-region');
    const postalInput = document.querySelector('input[name="postalCode"]');

    const previewName = document.getElementById('preview-name');
    const previewType = document.getElementById('preview-type');
    const previewCategory = document.getElementById('preview-category');
    const previewLocation = document.getElementById('preview-location');
    const previewPanel = document.getElementById('preview-panel');

    // The live preview sits in the rail: open beside the form on wide screens,
    // collapsed above it on small ones (the summary still toggles it).
    if (previewPanel && 'matchMedia' in window) {
      const wide = window.matchMedia('(min-width: 1024px)');
      if (!wide.matches) previewPanel.open = false;
      wide.addEventListener?.('change', (event) => { if (event.matches) previewPanel.open = true; });
    }

    const flatCategories = [];
    industries.forEach((ind) => {
      (ind.categories || []).forEach((cat) => {
        flatCategories.push({ catSlug: cat.slug, catName: cat.name, indSlug: ind.slug, indName: ind.name, aliases: cat.aliases, keywords: cat.keywords, professions: cat.professions });
      });
    });

    const typeCardsArr = Array.from(typeCards);
    let selectedType = '';
    let filteredFlatCategories = flatCategories;
    if (form) form.dataset.taxonomyCategoryAllowlist = JSON.stringify(flatCategories.map((item) => `${item.indSlug}/${item.catSlug}`));
    let warningTimer = null;

    const TYPE_HELPERS = {
      business: 'Showing business categories',
      church: 'Showing faith-based categories for Churches — religious organizations, community outreach, counseling.',
      ministry: 'Showing faith-based categories for Ministries — outreach, missions, discipleship, and media.',
      nonprofit: 'Showing categories for faith-based charities and community organizations.',
      school: 'Showing education categories for Christian schools, colleges, seminaries, and co-ops.',
      event: 'Showing event-friendly categories for conferences, retreats, concerts, camps, and gatherings.',
      other: 'Showing all categories — choose the industry and category that fits best.',
    };

    const STATE_ABBREV = {
      alabama: 'AL', alaska: 'AK', arizona: 'AZ', arkansas: 'AR', california: 'CA', colorado: 'CO',
      connecticut: 'CT', delaware: 'DE', 'district of columbia': 'DC', florida: 'FL', georgia: 'GA',
      hawaii: 'HI', idaho: 'ID', illinois: 'IL', indiana: 'IN', iowa: 'IA', kansas: 'KS',
      kentucky: 'KY', louisiana: 'LA', maine: 'ME', maryland: 'MD', massachusetts: 'MA', michigan: 'MI',
      minnesota: 'MN', mississippi: 'MS', missouri: 'MO', montana: 'MT', nebraska: 'NE', nevada: 'NV',
      'new hampshire': 'NH', 'new jersey': 'NJ', 'new mexico': 'NM', 'new york': 'NY', 'north carolina': 'NC',
      'north dakota': 'ND', ohio: 'OH', oklahoma: 'OK', oregon: 'OR', pennsylvania: 'PA', 'rhode island': 'RI',
      'south carolina': 'SC', 'south dakota': 'SD', tennessee: 'TN', texas: 'TX', utah: 'UT', vermont: 'VT',
      virginia: 'VA', washington: 'WA', 'west virginia': 'WV', wisconsin: 'WI', wyoming: 'WY',
    };

    // ---------------------------------------------------------------------
    // Type → category filtering helpers
    // ---------------------------------------------------------------------
    function getAllowedIndustriesForType(typeSlug) {
      if (!typeSlug) return [];
      const allowed = typeCategoryMap[typeSlug] || [];
      return industries.filter((ind) => allowed.includes(ind.slug));
    }

    function getCategoryFilterForType(typeSlug) {
      if (!typeSlug) return null;
      return typeCategoryFilter[typeSlug] || null;
    }

    function showTypeWarning() {
      if (!categoryWarning) return;
      categoryWarning.classList.remove('hidden');
      if (warningTimer) clearTimeout(warningTimer);
      warningTimer = setTimeout(() => {
        categoryWarning.classList.add('hidden');
      }, 6000);
    }

    function clearCategorySelection(showWarning) {
      if (inputIndustrySlug) inputIndustrySlug.value = '';
      if (inputCategorySlug) inputCategorySlug.value = '';
      if (chipsWrap) chipsWrap.classList.add('hidden');
      if (chipText) chipText.textContent = '';
      if (customWrap) customWrap.classList.add('hidden');
      if (inputCustomCategory) {
        inputCustomCategory.value = '';
        inputCustomCategory.required = false;
      }
      selectedServiceNames.clear();
      selectedServiceSources.clear();
      if (inputIndustrySlug) inputIndustrySlug.dataset.selectionSource = 'manual';
      if (inputCategorySlug) inputCategorySlug.dataset.selectionSource = 'manual';
      form?.dispatchEvent(new Event('taxonomy-recommendation-selection-cleared'));
      if (professionOptions) professionOptions.innerHTML = '<p class="field-help">Select a category above to see its professions.</p>';
      if (serviceOptions) serviceOptions.innerHTML = '<p class="field-help">Choose a profession above to see its service examples.</p>';
      if (customProfessionsInput) customProfessionsInput.value = '';
      if (customServicesInput) customServicesInput.value = '';
      if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }
      if (showWarning) {
        manualCategoryPicker?.classList.remove('hidden');
        showTypeWarning();
      }
      updatePreview();
      updateCompletion();
    }

    function renderProfessionAndServiceOptions(catSlug) {
      if (!professionOptions || !serviceOptions) return;
      const category = flatCategories.find((item) => item.catSlug === catSlug);
      professionOptions.innerHTML = '';
      serviceOptions.innerHTML = '';
      selectedServiceNames.clear();
      selectedServiceSources.clear();
      if (!category || !category.professions?.length) {
        professionOptions.innerHTML = '<p class="field-help">No predefined professions are available. Add a custom profession below.</p>';
        serviceOptions.innerHTML = '<p class="field-help">Add a custom service below.</p>';
        return;
      }
      category.professions.forEach((profession) => {
        const label = document.createElement('label');
        label.className = 'flex items-start gap-2 rounded-xl border p-3 text-sm';
        label.style.borderColor = 'var(--border)';
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox'; checkbox.name = 'professions'; checkbox.value = profession.slug;
        checkbox.className = 'mt-1';
        checkbox.dataset.selectionSource = 'manual';
        const title = document.createElement('span');
        title.textContent = profession.name;
        label.append(checkbox, title);
        professionOptions.appendChild(label);
        checkbox.addEventListener('change', () => {
          if (checkbox.dataset.settingSuggestion !== 'true') checkbox.dataset.selectionSource = 'manual';
          renderSelectedServiceOptions();
        });
      });
      function renderSelectedServiceOptions() {
        const selected = Array.from(professionOptions.querySelectorAll('input[name="professions"]:checked')).map((input) => input.value);
        const options = category.professions.filter((profession) => selected.includes(profession.slug)).flatMap((profession) => profession.services.map((name) => ({ name, profession: profession.name })));
        const deduped = Array.from(new Map(options.map((option) => [option.name.toLowerCase(), option])).values());
        serviceOptions.innerHTML = '';
        if (!deduped.length) {
          serviceOptions.innerHTML = '<p class="field-help">Choose a profession above to see its service examples.</p>';
          return;
        }
        deduped.forEach((option) => {
          const label = document.createElement('label');
          label.className = 'flex items-start gap-2 rounded-xl border p-3 text-sm';
          label.style.borderColor = 'var(--border)';
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox'; checkbox.name = 'services'; checkbox.value = option.name; checkbox.className = 'mt-1';
          checkbox.checked = selectedServiceNames.has(option.name);
          checkbox.dataset.selectionSource = selectedServiceSources.get(option.name) ?? 'manual';
          checkbox.addEventListener('change', () => {
            const source = checkbox.dataset.settingSuggestion === 'true' ? 'suggested' : 'manual';
            if (checkbox.checked) { selectedServiceNames.add(option.name); selectedServiceSources.set(option.name, source); }
            else { selectedServiceNames.delete(option.name); selectedServiceSources.delete(option.name); }
            checkbox.dataset.selectionSource = source;
          });
          const title = document.createElement('span'); title.textContent = option.name;
          label.append(checkbox, title); serviceOptions.appendChild(label);
        });
      }
    }

    function applyCategorySelection(indSlug, indName, catSlug, catName, source = 'manual') {
      if (inputIndustrySlug) { inputIndustrySlug.value = indSlug; inputIndustrySlug.dataset.selectionSource = source; }
      if (inputCategorySlug) { inputCategorySlug.value = catSlug; inputCategorySlug.dataset.selectionSource = source; }
      const sourceBadge = document.getElementById('category-selection-source');
      if (sourceBadge) { sourceBadge.textContent = source === 'suggested' ? 'Suggested' : 'Manual'; sourceBadge.classList.remove('hidden'); }
      renderProfessionAndServiceOptions(catSlug);
      if (chipText) chipText.textContent = `${indName} › ${catName}`;
      if (chipsWrap) chipsWrap.classList.remove('hidden');

      const isOther = catSlug.startsWith('other') || indSlug === 'other-industries';
      if (customWrap && inputCustomCategory) {
        if (isOther) {
          customWrap.classList.remove('hidden');
          inputCustomCategory.required = true;
        } else {
          customWrap.classList.add('hidden');
          inputCustomCategory.required = false;
          inputCustomCategory.value = '';
        }
      }
      updatePreview();
      updateCompletion();
    }

    form?.addEventListener('taxonomy-recommendation-apply', (event) => {
      const custom = /** @type {CustomEvent<{ recommendation: { industrySlug: string; categorySlug: string; professionSlug: string; serviceNames: string[]; isFallback?: boolean }; result?: { applied: boolean; message?: string } }>} */ (event);
      const recommendation = custom.detail.recommendation;
      const currentIndustry = inputIndustrySlug?.value || '';
      const currentCategory = inputCategorySlug?.value || '';
      const currentSource = inputCategorySlug?.dataset.selectionSource || 'manual';
      const manualProfessions = Array.from(document.querySelectorAll<HTMLInputElement>('#profession-options input[name="professions"]:checked')).some((input) => input.dataset.selectionSource !== 'suggested');
      const manualServices = Array.from(document.querySelectorAll<HTMLInputElement>('#service-options input[name="services"]:checked')).some((input) => input.dataset.selectionSource !== 'suggested');
      const customProfessionField = form?.elements.namedItem('customProfessions');
      const customServiceField = form?.elements.namedItem('customServices');
      const customProfessionText = customProfessionField instanceof HTMLTextAreaElement ? customProfessionField.value.trim() : '';
      const customServiceText = customServiceField instanceof HTMLTextAreaElement ? customServiceField.value.trim() : '';
      const samePath = currentIndustry === recommendation.industrySlug && currentCategory === recommendation.categorySlug;
      if (!inputTypeSlug?.value) { custom.detail.result = { applied: false, message: 'Choose your listing type first. Suggestions will then match its available categories.' }; return; }
      const customCategoryText = inputCustomCategory?.value?.trim() || '';
      if (!samePath && (Boolean(currentCategory && currentSource === 'manual') || manualProfessions || manualServices || customCategoryText || customProfessionText || customServiceText)) {
        custom.detail.result = { applied: false, message: 'Your manual industry, category, profession, or service selection is preserved. Clear or change it yourself before applying a different path.' };
        return;
      }
      const category = flatCategories.find((item) => item.indSlug === recommendation.industrySlug && item.catSlug === recommendation.categorySlug);
      const profession = category?.professions.find((item) => item.slug === recommendation.professionSlug);
      if (!category || !profession) { custom.detail.result = { applied: false, message: 'That taxonomy path is no longer available.' }; return; }
      if (!samePath) applyCategorySelection(category.indSlug, category.indName, category.catSlug, category.catName, 'suggested');
      const professionInput = Array.from(document.querySelectorAll<HTMLInputElement>('#profession-options input[name="professions"]')).find((input) => input.value === profession.slug);
      if (professionInput && !professionInput.checked) {
        professionInput.dataset.settingSuggestion = 'true';
        professionInput.dataset.selectionSource = 'suggested';
        professionInput.checked = true;
        professionInput.dispatchEvent(new Event('change', { bubbles: true }));
        professionInput.dataset.settingSuggestion = 'false';
      }
      for (const serviceName of recommendation.serviceNames) {
        const serviceInput = Array.from(document.querySelectorAll<HTMLInputElement>('#service-options input[name="services"]')).find((input) => input.value === serviceName);
        if (serviceInput && !serviceInput.checked) {
          serviceInput.dataset.settingSuggestion = 'true';
          serviceInput.checked = true;
          serviceInput.dispatchEvent(new Event('change', { bubbles: true }));
          serviceInput.dataset.settingSuggestion = 'false';
        }
      }
      custom.detail.result = { applied: true, message: 'Suggestion selected. Any manual values already chosen were preserved.' };
    });

    // Recompute the type-filtered category pool (single source for the search
    // picker + helper/status/context copy). No <select> is involved.
    function rebuildCategoryPoolForType(typeSlug) {
      const previousCatSlug = inputCategorySlug ? inputCategorySlug.value : '';
      const allowedIndustries = getAllowedIndustriesForType(typeSlug);
      const catFilter = getCategoryFilterForType(typeSlug);
      const allowedSet = new Set();
      const rebuiltFlat = [];

      allowedIndustries.forEach((ind) => {
        const filterCats = catFilter && catFilter[ind.slug] ? catFilter[ind.slug] : null;
        const cats = filterCats ? ind.categories.filter((c) => filterCats.includes(c.slug)) : ind.categories.slice();
        cats.forEach((cat) => {
          allowedSet.add(cat.slug);
          rebuiltFlat.push({ catSlug: cat.slug, catName: cat.name, indSlug: ind.slug, indName: ind.name, aliases: cat.aliases, keywords: cat.keywords, professions: cat.professions });
        });
      });

      const validType = Boolean(typeSlug) && Object.prototype.hasOwnProperty.call(typeCategoryMap, typeSlug);
      filteredFlatCategories = rebuiltFlat;
      if (form) form.dataset.taxonomyCategoryAllowlist = JSON.stringify(rebuiltFlat.map((item) => `${item.indSlug}/${item.catSlug}`));

      if (validType) {
        if (categoryHelp) categoryHelp.textContent = TYPE_HELPERS[typeSlug] || 'Showing categories for this organization type.';
        if (categoryStatus) {
          categoryStatus.textContent = `${allowedSet.size} categories available for this type`;
          categoryStatus.classList.remove('hidden');
        }
        if (categoryTypeContext) {
          const typeCard = document.querySelector(`.type-card[data-type="${typeSlug}"]`);
          const typeLabel = typeCard ? (typeCard.dataset.label || typeCard.querySelector('.type-name')?.textContent || '') : '';
          categoryTypeContext.textContent = typeLabel ? `For: ${typeLabel}` : 'For your listing type';
          categoryTypeContext.classList.remove('hidden');
        }
      } else {
        if (categoryHelp) categoryHelp.textContent = 'Please select an organization type first.';
        if (categoryStatus) {
          categoryStatus.textContent = '';
          categoryStatus.classList.add('hidden');
        }
        if (categoryTypeContext) categoryTypeContext.classList.add('hidden');
      }

      const stillValid = Boolean(previousCatSlug) && allowedSet.has(previousCatSlug);
      if (!stillValid) clearCategorySelection(Boolean(previousCatSlug));
      else if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }

      updatePreview();
      updateCompletion();
    }

    // ---------------------------------------------------------------------
    // Type cards
    // ---------------------------------------------------------------------
    typeCardsArr.forEach((card) => {
      card.addEventListener('click', () => {
        const nextType = card.getAttribute('data-type') || '';
        const prevType = selectedType;
        if (!nextType || nextType === prevType) return;
        selectedType = nextType;
        if (inputTypeSlug) inputTypeSlug.value = nextType;
        if (listingTypeError) listingTypeError.classList.add('hidden');
        typeCardsArr.forEach((c) => {
          const active = c === card;
          c.setAttribute('aria-pressed', String(active));
          c.setAttribute('data-selected', String(active));
        });
        rebuildCategoryPoolForType(nextType);
        form?.dispatchEvent(new Event('taxonomy-recommendations-refresh'));
      });
    });

    // ---------------------------------------------------------------------
    // Category chip clear (the picker itself is a typeahead — see below)
    // ---------------------------------------------------------------------
    chipClear?.addEventListener('click', () => {
      clearCategorySelection(false);
      manualCategoryPicker?.classList.remove('hidden');
      searchInput?.focus({ preventScroll: true });
    });

    // ---------------------------------------------------------------------
    // Category search — the single category picker, type-filtered
    // ---------------------------------------------------------------------
    function appendCustomCategoryShortcut(source) {
      const fallback = source.find((item) => item.catSlug.startsWith('other-'))
        || source.find((item) => item.indSlug === 'other-industries');
      if (!fallback || !searchResults || !searchInput) return false;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'flex w-full flex-col items-start gap-0.5 border-t px-3 py-2.5 text-left text-xs hover:bg-[var(--surface-2)]';
      button.style.borderColor = 'var(--border)';
      button.dataset.customCategoryShortcut = 'true';
      const title = document.createElement('span');
      title.className = 'font-semibold';
      title.textContent = 'Can’t find it? Enter a custom category';
      const hint = document.createElement('span');
      hint.className = 'text-[11px]';
      hint.style.color = 'var(--text-mute)';
      hint.textContent = 'Choose an “Other” category, then type the exact name.';
      button.append(title, hint);
      button.addEventListener('click', () => {
        applyCategorySelection(fallback.indSlug, fallback.indName, fallback.catSlug, fallback.catName);
        searchInput.value = '';
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      });
      searchResults.appendChild(button);
      return true;
    }

    function renderCategoryResults(q) {
      if (!searchInput || !searchResults) return;
      searchResults.innerHTML = '';
      if (!q) {
        searchResults.classList.add('hidden');
        return;
      }
      // Use the type-filtered list once a type is selected; fall back to the
      // full list only when no type filtering is active.
      const source = selectedType ? filteredFlatCategories : flatCategories;
      const matches = source
        .filter(
          (c) =>
            c.catName.toLowerCase().includes(q) ||
            c.indName.toLowerCase().includes(q) ||
            c.catSlug.includes(q) ||
            (c.aliases ?? []).some((term) => term.toLowerCase().includes(q)) ||
            (c.keywords ?? []).some((term) => term.toLowerCase().includes(q)) ||
            (c.professions ?? []).some((profession) => profession.name.toLowerCase().includes(q) || profession.slug.includes(q) || profession.aliases?.some((term) => term.toLowerCase().includes(q)) || profession.services?.some((term) => term.toLowerCase().includes(q))),
        )
        .slice(0, 8);
      matches.forEach((m) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center justify-between px-3 py-2 text-left text-xs hover:bg-[var(--surface-2)]';
        btn.style.borderBottom = '1px solid var(--border)';
        btn.setAttribute('data-slug', m.catSlug);
        btn.setAttribute('data-industry-slug', m.indSlug);
        const label = document.createElement('span');
        label.textContent = m.catName;
        const ind = document.createElement('span');
        ind.textContent = m.indName;
        ind.style.color = 'var(--text-mute)';
        btn.appendChild(label);
        btn.appendChild(ind);
        btn.addEventListener('click', () => {
          applyCategorySelection(m.indSlug, m.indName, m.catSlug, m.catName);
          searchInput.value = '';
          searchResults.innerHTML = '';
          searchResults.classList.add('hidden');
        });
        searchResults.appendChild(btn);
      });
      const hasFallback = appendCustomCategoryShortcut(source);
      if (!matches.length && !hasFallback) {
        const emptyState = document.createElement('p');
        emptyState.className = 'px-3 py-2 text-xs';
        emptyState.style.color = 'var(--text-mute)';
        emptyState.textContent = 'No matching categories. Try a shorter or different search.';
        searchResults.appendChild(emptyState);
      }
      searchResults.classList.remove('hidden');
    }

    function setupCategorySearch() {
      if (!searchInput || !searchResults) return;
      searchInput.addEventListener('input', () => {
        renderCategoryResults(searchInput.value.toLowerCase().trim());
      });
      searchInput.addEventListener('focus', () => {
        renderCategoryResults(searchInput.value.toLowerCase().trim());
      });
      document.addEventListener('click', (e) => {
        if (searchResults.classList.contains('hidden')) return;
        if (searchInput.contains(e.target) || searchResults.contains(e.target)) return;
        searchResults.classList.add('hidden');
      });
    }
    setupCategorySearch();

    // ---------------------------------------------------------------------
    // Multi-Denomination Selector Controller (Up to 2)
    // ---------------------------------------------------------------------
    const selectedDenoms = new Map(); // slug -> name
    const chipsContainer = document.getElementById('denom-chips-container');
    const emptyHint = document.getElementById('denom-empty-hint');
    const counterBadge = document.getElementById('denom-counter');
    const hiddenInputsWrap = document.getElementById('denom-hidden-inputs');
    const customDenomWrap = document.getElementById('custom-denom-wrap');
    const customDenomInput = document.getElementById('custom-denom-input');

    function renderDenominations() {
      if (chipsContainer) {
        chipsContainer.querySelectorAll('.denom-chip').forEach((c) => c.remove());
        if (selectedDenoms.size === 0) {
          emptyHint?.classList.remove('hidden');
        } else {
          emptyHint?.classList.add('hidden');
          selectedDenoms.forEach((name, slug) => {
            const chip = document.createElement('span');
            chip.className = 'denom-chip inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border border-[var(--teal)] bg-[rgba(46,146,131,0.12)] text-[var(--teal)]';
            chip.innerHTML = `<span></span><button type="button" class="remove-chip hover:opacity-75 focus:outline-none" aria-label="Remove denomination" data-slug=""></button>`;
            chip.querySelector('span').textContent = name;
            const rm = chip.querySelector('.remove-chip');
            rm.setAttribute('aria-label', `Remove ${name}`);
            rm.setAttribute('data-slug', slug);
            rm.textContent = '✕';
            rm.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleDenomination(slug, name);
            });
            chipsContainer.appendChild(chip);
          });
        }
      }

      if (hiddenInputsWrap) {
        hiddenInputsWrap.innerHTML = '';
        selectedDenoms.forEach((_, slug) => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'denominations';
          input.value = slug;
          hiddenInputsWrap.appendChild(input);
        });
      }

      if (counterBadge) {
        const count = selectedDenoms.size;
        if (count === 2) {
          counterBadge.style.color = 'var(--teal)';
          counterBadge.textContent = '2 of 2 selected (maximum)';
        } else {
          counterBadge.style.color = '';
          counterBadge.textContent = `${count} of 2 selected`;
        }
      }

      // Keep the typeahead results in sync with the current selection.
      buildDenomResults();

      if (customDenomWrap && customDenomInput) {
        if (selectedDenoms.has('other')) {
          customDenomWrap.classList.remove('hidden');
          customDenomInput.required = true;
        } else {
          customDenomWrap.classList.add('hidden');
          customDenomInput.required = false;
        }
      }
      updateCompletion();
    }

    function toggleDenomination(slug, name) {
      if (selectedDenoms.has(slug)) {
        selectedDenoms.delete(slug);
      } else {
        if (selectedDenoms.size >= 2) {
          alert('You can select up to two denominations. Remove one to choose another.');
          return;
        }
        selectedDenoms.set(slug, name);
      }
      renderDenominations();
    }

    function hasFaithIdentity() {
      const hasDenomination = Array.from(selectedDenoms.keys()).some((slug) => slug !== 'other');
      const hasCustomDenomination = Boolean(customDenomInput && customDenomInput.value.trim());
      const hasStatement = Boolean(statementInput && statementInput.value.trim());
      return hasDenomination || hasCustomDenomination || hasStatement;
    }

    function updateFaithValidation(showError = reviewAttempted) {
      const error = document.getElementById('faith-identity-error');
      const search = denomSearchInput;
      const statement = statementInput;
      const valid = hasFaithIdentity();
      if (error) error.hidden = valid || !showError;
      for (const field of [search, statement]) {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) continue;
        if (valid) field.removeAttribute('aria-invalid');
        else if (showError) field.setAttribute('aria-invalid', 'true');
      }
      return valid;
    }

    // ---------------------------------------------------------------------
    // Denomination typeahead — same searchable interaction as the category
    // field: type to filter the catalog, click a result to add/remove.
    // ---------------------------------------------------------------------
    function buildDenomResults() {
      if (!denomSearchInput || !denomSearchResults) return;
      const q = denomSearchInput.value.toLowerCase().trim();
      const matches = (denominations || [])
        .filter((d) => !q || d.name.toLowerCase().includes(q) || d.slug.includes(q))
        .slice(0, 12);
      denomSearchResults.innerHTML = '';
      if (!matches.length) {
        denomSearchResults.classList.add('hidden');
        return;
      }
      matches.forEach((d) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center justify-between px-3 py-2 text-left text-xs hover:bg-[var(--surface-2)]';
        btn.style.borderBottom = '1px solid var(--border)';
        btn.setAttribute('data-slug', d.slug);
        const isSelected = selectedDenoms.has(d.slug);
        if (isSelected) {
          btn.style.background = 'var(--accent-soft)';
        }
        const label = document.createElement('span');
        label.textContent = d.name;
        label.style.fontWeight = isSelected ? '700' : '500';
        const mark = document.createElement('span');
        mark.textContent = isSelected ? '✓ Selected' : 'Add';
        mark.style.color = isSelected ? 'var(--accent)' : 'var(--text-mute)';
        btn.appendChild(label);
        btn.appendChild(mark);
        btn.addEventListener('click', () => {
          toggleDenomination(d.slug, d.name);
          denomSearchInput.value = '';
          denomSearchResults.innerHTML = '';
          denomSearchResults.classList.add('hidden');
        });
        denomSearchResults.appendChild(btn);
      });
    }

    function setupDenominationSearch() {
      if (!denomSearchInput || !denomSearchResults) return;
      denomSearchInput.addEventListener('focus', () => {
        buildDenomResults();
        denomSearchResults.classList.remove('hidden');
      });
      denomSearchInput.addEventListener('input', () => {
        buildDenomResults();
        denomSearchResults.classList.remove('hidden');
      });
      document.addEventListener('click', (e) => {
        if (denomSearchResults.classList.contains('hidden')) return;
        if (denomSearchInput.contains(e.target) || denomSearchResults.contains(e.target)) return;
        denomSearchResults.classList.add('hidden');
      });
    }
    setupDenominationSearch();

    // ---------------------------------------------------------------------
    // Online-only toggle
    // ---------------------------------------------------------------------
    const onlineWrap = document.getElementById('online-toggle-wrap');
    const onlineStateText = document.getElementById('online-state-text');
    function onlineToggleState(checked) {
      const on = Boolean(checked);
      return {
        mode: on ? 'on' : 'off',
        activeId: on ? 'online-on-label' : 'online-off-label',
        inactiveId: on ? 'online-off-label' : 'online-on-label',
        message: on
          ? 'This listing is for online services only.'
          : 'This listing is for in-person services.',
        formValue: on ? '1' : '',
      };
    }
    function paintOnlineChoice(label, active, mode) {
      label.classList.toggle('is-active', active);
      label.classList.toggle('is-inactive', !active);
      label.dataset.active = active ? 'true' : 'false';
      label.dataset.mode = mode;
    }
    function syncOnlineMode() {
      const state = onlineToggleState(Boolean(onlineToggle && onlineToggle.checked));
      if (onlineWrap) onlineWrap.dataset.online = state.mode;
      for (const label of [document.getElementById('online-off-label'), document.getElementById('online-on-label')]) {
        if (!label) continue;
        paintOnlineChoice(label, label.id === state.activeId, state.mode);
      }
      if (onlineStateText) onlineStateText.textContent = state.message;
    }
    function applyOnlineToggle() {
      const on = Boolean(onlineToggle && onlineToggle.checked);
      locationFields?.classList.toggle('hidden', on);
      locationNote?.classList.toggle('hidden', !on);
      syncOnlineMode();
      updatePreview();
      updateCompletion();
    }
    if (onlineToggle) {
      document.querySelectorAll('#online-toggle-wrap input[name="isOnlineOnly"]').forEach((input) => {
        input.addEventListener('change', applyOnlineToggle);
        input.addEventListener('input', applyOnlineToggle);
      });
      syncOnlineMode();
    }
    if (form) {
      form.addEventListener('formdata', (event) => {
        if (event.formData.get('isOnlineOnly') !== '1') event.formData.delete('isOnlineOnly');
      });
    }

    const hiringYes = document.getElementById('input-hiring-yes');
    const careersWrap = document.getElementById('careers-url-field');
    const careersInput = document.getElementById('input-careers-url');
    const careersError = document.getElementById('careers-url-error');

    function careersUrlError(value) {
      const trimmed = String(value ?? '').trim();
      if (!trimmed) return '';
      try {
        const url = new URL(trimmed);
        if ((url.protocol !== 'http:' && url.protocol !== 'https:') || !url.hostname) {
          return 'Enter a valid http:// or https:// URL.';
        }
        return '';
      } catch {
        return 'Enter a valid http:// or https:// URL.';
      }
    }

    function showCareersError(message) {
      if (!careersError || !careersInput) return;
      if (message) {
        careersError.textContent = message;
        careersError.hidden = false;
        careersInput.setAttribute('aria-invalid', 'true');
      } else {
        careersError.hidden = true;
        careersInput.removeAttribute('aria-invalid');
      }
    }

    function hiringOn() {
      return Boolean(hiringYes && hiringYes.checked);
    }

    function syncHiring() {
      if (careersWrap) careersWrap.hidden = !hiringOn();
    }

    document.querySelectorAll('input[name="isHiring"]').forEach((input) => {
      input.addEventListener('change', () => {
        syncHiring();
        if (!hiringOn()) showCareersError('');
      });
    });
    syncHiring();
    if (careersInput) {
      careersInput.addEventListener('input', () => {
        if (!careersUrlError(careersInput.value)) showCareersError('');
      });
      careersInput.addEventListener('blur', () => {
        if (hiringOn()) showCareersError(careersUrlError(careersInput.value));
      });
    }

    // ---------------------------------------------------------------------
    // Live preview
    // ---------------------------------------------------------------------
    function formatCity(value) {
      return value.replace(/\S+/g, (w) => w.charAt(0).toUpperCase() + w.slice(1));
    }

    function abbrevRegion(value) {
      const raw = (value || '').trim();
      if (!raw) return '';
      if (raw.length === 2) return raw.toUpperCase();
      return STATE_ABBREV[raw.toLowerCase()] || raw;
    }

    function updatePreview() {
      const nameVal = nameInput ? nameInput.value.trim() : '';
      if (previewName) {
        if (nameVal) {
          previewName.textContent = nameVal;
          previewName.style.color = 'var(--text)';
        } else {
          previewName.textContent = 'Your listing name';
          previewName.style.color = 'var(--text-mute)';
        }
      }
      if (previewType) {
        const card = typeCardsArr.find((c) => (c.getAttribute('data-type') || '') === selectedType);
        const label = card ? (card.dataset.label || card.querySelector('.type-name')?.textContent || '') : '';
        if (label) {
          previewType.textContent = label;
          previewType.style.color = 'var(--text-soft)';
        } else {
          previewType.textContent = 'No type selected yet';
          previewType.style.color = 'var(--text-mute)';
        }
      }
      if (previewCategory) {
        if (inputCategorySlug && inputCategorySlug.value && chipText) {
          previewCategory.textContent = chipText.textContent;
        } else {
          previewCategory.textContent = 'No category selected';
        }
      }
      if (previewLocation) {
        if (onlineToggle && onlineToggle.checked) {
          previewLocation.textContent = 'Online-only • Serves nationwide';
        } else {
          const city = cityInput ? formatCity(cityInput.value.trim()) : '';
          const region = regionInput ? abbrevRegion(regionInput.value) : '';
          if (city || region) {
            previewLocation.textContent = [city, region].filter(Boolean).join(', ');
          } else {
            previewLocation.textContent = 'Location not set';
          }
        }
      }
    }

    // ---------------------------------------------------------------------
    // Section completion, review checklist, and required-field validation
    // ---------------------------------------------------------------------
    function updateCompletion() {
      const basicsComplete = selectedType !== '' && (nameInput ? nameInput.value.trim().length >= 2 : false);
      const online = Boolean(onlineToggle && onlineToggle.checked);
      const city = cityInput ? cityInput.value.trim() : '';
      const region = regionInput ? regionInput.value.trim() : '';
      const contactComplete = online || Boolean(city || region);
      const faithComplete = hasFaithIdentity();
      const attestation = document.getElementById('input-attestation');
      const terms = document.getElementById('input-terms');
      const publishReady = attestation instanceof HTMLInputElement && attestation.checked
        && terms instanceof HTMLInputElement && terms.checked;

      const stepState = { basics: basicsComplete, faith: faithComplete, contact: contactComplete, review: publishReady };
      Object.entries(stepState).forEach(([step, complete]) => {
        const link = document.querySelector(`.form-jump a[data-step="${step}"]`);
        if (link) link.setAttribute('data-complete', complete ? 'true' : 'false');
      });
      updateReviewChecklist();
    }

    // Step pills: mark the section currently in view
    if ('IntersectionObserver' in window) {
      const jumpLinks = Array.from(document.querySelectorAll('.form-jump a[href^="#section-"]'));
      const sections = jumpLinks
        .map((a) => document.querySelector(a.getAttribute('href') || ''))
        .filter(Boolean);
      const setCurrent = (id) => {
        jumpLinks.forEach((a) => {
          if (a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'step');
          else a.removeAttribute('aria-current');
        });
      };
      const visible = new Map();
      if (sections[0]) setCurrent(sections[0].id);
      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0));
        let best = null;
        let bestRatio = 0;
        visible.forEach((ratio, id) => { if (ratio > bestRatio) { best = id; bestRatio = ratio; } });
        if (best) setCurrent(best);
      }, { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] });
      sections.forEach((section) => sectionObserver.observe(section));
    }

    let reviewAttempted = false;
    function updateReviewChecklist() {
      const attestation = document.getElementById('input-attestation');
      const terms = document.getElementById('input-terms');
      const faithComplete = updateFaithValidation();
      const checks = {
        type: selectedType !== '',
        name: Boolean(nameInput && nameInput.value.trim().length >= 2),
        faith: faithComplete,
        attestation: Boolean(attestation && attestation.checked),
        terms: Boolean(terms && terms.checked),
      };
      const labels = {
        type: 'organization type',
        name: 'listing name',
        faith: 'faith identity (a denomination or a statement of faith)',
        attestation: 'accuracy confirmation',
        terms: 'terms agreement',
      };
      const missing = [];
      Object.keys(checks).forEach((key) => {
        const item = document.querySelector('#review-checklist [data-check="' + key + '"]');
        if (!item) return;
        const ready = checks[key];
        item.dataset.state = ready ? 'ready' : 'needed';
        const state = item.querySelector('.check-state');
        if (state) state.textContent = ready ? 'Ready' : 'Needed';
        if (!ready) missing.push(labels[key]);
      });
      const missingEl = document.getElementById('review-missing');
      if (!missingEl) return;
      if (reviewAttempted && missing.length) {
        missingEl.hidden = false;
        missingEl.textContent = 'Still needed before publishing: ' + missing.join(', ') + '.';
      } else {
        missingEl.hidden = true;
        missingEl.textContent = '';
      }
    }

    // ---------------------------------------------------------------------
    // Live input bindings
    // ---------------------------------------------------------------------
    function updateDescriptionCounter() {
      if (!(descriptionInput instanceof HTMLTextAreaElement) || !descriptionCounter) return;
      const count = descriptionInput.value.length;
      descriptionCounter.textContent = `${count} / 500 characters`;
      descriptionCounter.style.color = count >= 450 ? 'var(--accent)' : 'var(--text-mute)';
    }
    descriptionInput?.addEventListener('input', updateDescriptionCounter);
    updateDescriptionCounter();

    [nameInput, statementInput, cityInput, regionInput, postalInput].forEach((el) => {

      if (!el) return;
      el.addEventListener('input', () => {
        updatePreview();
        updateCompletion();
      });
    });

    // ---------------------------------------------------------------------
    // Submission. Listing type is the only client-gated field; category
    // selection is optional (server accepts listings without one). The form
    // keeps its native POST as the no-JS fallback; with JS the same payload is
    // sent as JSON so a server-side rejection (rate limit, guest rules, spam
    // check, duplicate, outage) is shown inline and the entries survive.
    // ---------------------------------------------------------------------
    const formStatus = document.getElementById('form-status');
    const reviewStatus = document.getElementById('review-status');
    const reviewPublishBtn = document.getElementById('review-publish-btn');
    const reviewDraftBtn = document.getElementById('review-draft-btn');
    // Mirrors publishBlockReason() in src/lib/formGuards.mjs (server stays authoritative).
    const LOCATION_RULE = 'Add a city or state, or mark the listing as online-only.';
    const FAITH_RULE = 'Choose at least one denomination or add a statement of faith before publishing.';
    function showFormStatus(message, kind) {
      [formStatus, reviewStatus].forEach((el) => {
        if (!el) return;
        el.textContent = message;
        el.classList.remove('hidden', 'is-error', 'is-ok');
        el.classList.add(kind === 'error' ? 'is-error' : 'is-ok');
      });
    }
    function setPublishBusy(busy) {
      if (reviewPublishBtn) {
        reviewPublishBtn.disabled = busy;
        if (busy) {
          reviewPublishBtn.setAttribute('aria-busy', 'true');
          reviewPublishBtn.textContent = 'Publishing…';
        } else {
          reviewPublishBtn.removeAttribute('aria-busy');
          reviewPublishBtn.textContent = reviewPublishBtn.dataset.label || 'Publish';
        }
      }
      if (reviewDraftBtn) reviewDraftBtn.disabled = busy;
    }
    function setDraftBusy(busy) {
      if (!reviewDraftBtn) return;
      reviewDraftBtn.disabled = busy;
      if (busy) {
        reviewDraftBtn.setAttribute('aria-busy', 'true');
        reviewDraftBtn.textContent = 'Saving…';
      } else {
        reviewDraftBtn.removeAttribute('aria-busy');
        reviewDraftBtn.textContent = 'Save draft';
      }
    }
    // One payload builder for publish and draft — shaped like listingInputSchema.
    function collectListing() {
      const fd = new FormData(form);
      const str = (key) => String(fd.get(key) ?? '').trim();
      const on = (key) => fd.get(key) === '1';
      const year = str('yearFounded');
      const industrySlug = str('industrySlug');
      let hours = {};
      try {
        const parsedHours = JSON.parse(str('hoursJson'));
        if (parsedHours && typeof parsedHours === 'object' && !Array.isArray(parsedHours)) hours = parsedHours;
      } catch { /* Empty or unavailable optional hours remain an empty schedule. */ }
      return {
        name: str('name'),
        typeSlug: str('typeSlug'),
        tagline: str('tagline'),
        description: str('description'),
        website: str('website'),
        phone: str('phone'),
        email: str('email'),
        showEmail: on('showEmail'),
        showPhone: on('showPhone'),
        showWebsite: on('showWebsite'),
        showAddress: on('showAddress'),
        showDenomination: on('showDenomination'),
        city: str('city'),
        region: str('region'),
        postalCode: str('postalCode'),
        industrySlug,
        categorySlug: str('categorySlug'),
        customCategory: str('customCategory'),
        customDenomination: str('customDenomination'),
        statementOfFaith: str('statementOfFaith'),
        priceRange: str('priceRange'),
        yearFounded: year ? Number(year) : undefined,
        employeeCount: str('employeeCount'),
        ownershipType: str('ownershipType'),
        serviceArea: str('serviceArea'),
        hours,
        contactPreference: str('contactPreference'),
        isOnlineOnly: on('isOnlineOnly'),
        isHiring: on('isHiring'),
        careersUrl: str('careersUrl'),
        industries: industrySlug ? [industrySlug] : [],
        professions: Array.from(document.querySelectorAll('#profession-options input[name="professions"]:checked')).map((input) => input.value),
        customProfessions: String(document.getElementById('input-custom-professions')?.value || '').split(/[\n;,]+/).map((value) => value.trim()).filter(Boolean),
        services: [...Array.from(document.querySelectorAll('#service-options input[name="services"]:checked')).map((input) => input.value), ...String(document.getElementById('input-custom-services')?.value || '').split(/[\n;,]+/).map((value) => value.trim()).filter(Boolean)],
        denominations: Array.from(new Set(fd.getAll('denominations').map((v) => String(v).trim()).filter(Boolean))),
        hashtags: str('hashtags').split(',').map((s) => s.trim().replace(/^#/, '')).filter(Boolean),
      };
    }
    // Publish-only fields the server gate reads alongside the listing.
    function publishGateFields() {
      const fd = new FormData(form);
      return {
        attestation: Boolean(fd.get('attestation')),
        terms: Boolean(fd.get('terms')),
        hp_company: String(fd.get('hp_company') ?? '').trim(),
      };
    }
    document.querySelectorAll('details[data-open-if]').forEach((panel) => {
      const filled = Array.from(panel.querySelectorAll('input, select, textarea')).some((el) => !(el instanceof HTMLInputElement && el.type === 'hidden') && 'value' in el && String(el.value).trim() !== '');
      if (filled) panel.open = true;
    });
    function publishFailed(message) {
      setPublishBusy(false);
      reviewAttempted = true;
      updateReviewChecklist();
      showFormStatus(message, 'error');
    }
    async function publishListing(listing) {
      setPublishBusy(true);
      showFormStatus('Publishing your listing…', 'ok');
      let res;
      try {
        res = await fetch('/api/listings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(listing),
        });
      } catch {
        publishFailed('Could not reach the server. Check your connection and try again — your entries are still here.');
        return;
      }
      const data = await res.json().catch(() => ({}));
      if (res.ok && data && data.ok) {
        const params = new URLSearchParams({ success: '1' });
        if (data.slug) params.set('slug', data.slug);
        if (data.status) params.set('status', data.status);
        window.location.assign('/add-listing?' + params.toString());
        return;
      }
      publishFailed((data && data.error) || 'Could not publish the listing. Please try again.');
    }
    if (form) {
      form.addEventListener('invalid', (event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
          field.setAttribute('aria-invalid', 'true');
          const panel = field.closest('details');
          if (panel) panel.open = true;
        }
        reviewAttempted = true;
        updateReviewChecklist();
        showFormStatus('Check the highlighted fields. Required items are marked.', 'error');
      }, true);
      form.addEventListener('input', (event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
          if (field.validity.valid) field.removeAttribute('aria-invalid');
        }
        updateCompletion();
      });
      form.addEventListener('change', () => updateCompletion());
      form.addEventListener('submit', (e) => {
        if (!selectedType) {
          e.preventDefault();
          reviewAttempted = true;
          updateReviewChecklist();
          if (listingTypeError) listingTypeError.classList.remove('hidden');
          typeCardsArr[0]?.focus();
          showFormStatus('Select an organization type before publishing.', 'error');
          return;
        }
        const careersMessage = careersUrlError(careersInput ? careersInput.value : '');
        if (careersMessage) {
          e.preventDefault();
          reviewAttempted = true;
          updateReviewChecklist();
          if (hiringYes && !hiringYes.checked) {
            hiringYes.checked = true;
            syncHiring();
          }
          showCareersError(careersMessage);
          careersInput?.focus();
          showFormStatus(careersMessage, 'error');
          return;
        }
        const listing = collectListing();
        if (!listing.isOnlineOnly && !listing.city && !listing.region) {
          e.preventDefault();
          reviewAttempted = true;
          updateReviewChecklist();
          showFormStatus(LOCATION_RULE, 'error');
          cityInput?.focus();
          return;
        }
        if (!hasFaithIdentity()) {
          e.preventDefault();
          reviewAttempted = true;
          const faithSection = document.getElementById('section-faith');
          if (faithSection instanceof HTMLDetailsElement) faithSection.open = true;
          updateFaithValidation(true);
          updateReviewChecklist();
          showFormStatus(FAITH_RULE, 'error');
          denomSearchInput?.focus();
          return;
        }
        if (reviewPublishBtn && reviewPublishBtn.disabled) {
          e.preventDefault();
          return;
        }
        e.preventDefault();
        publishListing({ ...listing, ...publishGateFields() });
      });
    }

    // ---------------------------------------------------------------------
    // Save draft
    // ---------------------------------------------------------------------
    if (reviewDraftBtn && form) {
      reviewDraftBtn.addEventListener('click', async () => {
        const listing = collectListing();
        if (!listing.name || listing.name.trim().length < 2) {
          showFormStatus('Please enter a listing name before saving a draft.', 'error');
          nameInput?.focus();
          return;
        }
        setDraftBusy(true);
        showFormStatus('Saving draft…', 'ok');
        try {
          const res = await fetch('/api/submissions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'draft', listing }),
          });
          if (res.ok) {
            showFormStatus('Draft saved.', 'ok');
          } else if (res.status === 401) {
            showFormStatus('Please sign in to save a draft.', 'error');
          } else {
            const j = await res.json().catch(() => ({}));
            showFormStatus(j.error || 'Could not save the draft. Please try again.', 'error');
          }
        } catch {
          showFormStatus('Could not save the draft. Please try again.', 'error');
        } finally {
          setDraftBusy(false);
        }
      });
    }
    // Initial state pass.
    updatePreview();
    updateCompletion();
  </script>
