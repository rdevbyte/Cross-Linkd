---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HoursEditor from '@/components/HoursEditor.astro';
import { INDUSTRIES } from '@/data/industries';
import { DENOMINATIONS } from '@/data/denominations';
import { ATTESTATION } from '@/lib/trustCopy';
import { typeBySlug } from '@/data/listing-types';
import TypeGlyph from '@/components/TypeGlyph.astro';

const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success') === '1';
const slug = Astro.url.searchParams.get('slug');
// Guest submissions enter moderation; signed-in owners publish immediately.
const pendingReview = Astro.url.searchParams.get('status') === 'pending_review';
const thisYear = new Date().getFullYear();

const popularDenominations = [
  { slug: 'non-denominational', name: 'Non-Denominational' },
  { slug: 'baptist', name: 'Baptist' },
  { slug: 'lutheran', name: 'Lutheran' },
  { slug: 'reformed-presbyterian', name: 'Presbyterian & Reformed' },
  { slug: 'methodist-wesleyan', name: 'Methodist & Wesleyan' },
  { slug: 'pentecostal-charismatic', name: 'Pentecostal & Charismatic' },
  { slug: 'anglican-episcopal', name: 'Anglican & Episcopal' },
  { slug: 'catholic', name: 'Catholic' },
  { slug: 'eastern-orthodox', name: 'Eastern Orthodox' },
  { slug: 'evangelical', name: 'Evangelical Free' },
  { slug: 'anabaptist', name: 'Anabaptist & Mennonite' },
  { slug: 'restorationist', name: 'Churches of Christ' },
  { slug: 'interdenominational', name: 'Interdenominational' },
  { slug: 'other', name: 'Other (specify custom denomination)' },
];

const allOtherDenominations = [...DENOMINATIONS]
  .filter((d) => !popularDenominations.some((p) => p.slug === d.slug))
  .sort((a, b) => a.name.localeCompare(b.name));

// Full denomination catalog for the searchable typeahead.
const denominationOptions = [
  ...popularDenominations.map((d) => ({ slug: d.slug, name: d.name })),
  ...allOtherDenominations.map((d) => ({ slug: d.slug, name: d.name })),
];

// Primary listing types shown as cards in Section 1.
const PRIMARY_TYPES = [
  { slug: 'business', label: 'Business', description: 'Christian-owned company, shop, or service provider' },
  { slug: 'church', label: 'Church', description: 'Local congregation — services, small groups, pastoral care' },
  { slug: 'ministry', label: 'Ministry', description: 'Parachurch outreach, missions, discipleship, media' },
  { slug: 'nonprofit', label: 'Nonprofit', description: 'Faith-based charity or community organization' },
  { slug: 'school', label: 'School', description: 'Christian school, college, seminary, or homeschool co-op' },
  { slug: 'event', label: 'Event', description: 'Conference, retreat, concert, camp, or gathering' },
  { slug: 'other', label: 'Other', description: 'Association, network, or other faith-aligned org' },
];

// Type → allowed industries. The `other` type exposes every industry.
const TYPE_CATEGORY_MAP = {
  business: INDUSTRIES.map((industry) => industry.slug),
  church: ['religious-organizations'],
  ministry: ['religious-organizations'],
  nonprofit: ['nonprofit-civic', 'other-industries'],
  school: ['education'],
  event: ['arts-media-entertainment', 'travel-hospitality', 'sports-recreation', 'events-entertainment', 'other-industries'],
  other: INDUSTRIES.map((industry) => industry.slug),
};

// Optional per-industry category allow-lists within an allowed industry.
const TYPE_CATEGORY_FILTER = {
  church: {
    'religious-organizations': ['churches', 'ministry', 'other-religious'],
  },
  ministry: {
    'religious-organizations': ['churches', 'ministry', 'other-religious'],
  },
  nonprofit: {
    'nonprofit-civic': ['charity', 'community-outreach', 'youth-family', 'other-nonprofit'],
  },
  event: {
    'arts-media-entertainment': ['music', 'photography', 'videography'],
    'travel-hospitality': ['venues', 'event-services'],
    'sports-recreation': ['outdoor-recreation', 'coaching'],
    'events-entertainment': ['venues', 'event-services', 'event-production', 'live-entertainment', 'party-rentals', 'other-events-entertainment'],
    'other-industries': ['other-business'],
  },
};

// Compact taxonomy payload for category search and the profession/service selector.
const industries = INDUSTRIES.map((ind) => ({
  slug: ind.slug,
  name: ind.name,
  categories: ind.categories.map((c) => ({ slug: c.slug, name: c.name, aliases: c.aliases ?? [], keywords: c.keywords ?? [], professions: c.professions.map((p) => ({ slug: p.slug, name: p.name, aliases: p.aliases ?? [], services: p.services ?? [] })) })),
}));

// Organization-basics selects (labels match the server-side validation enums).
const SIZE_OPTIONS = ['Solo (just me)', '2–10', '11–50', '51–200', '201–500', '500+'];
const OWNERSHIP_OPTIONS = [
  'Privately owned',
  'Family-owned',
  'Partnership',
  'Corporation',
  'Cooperative',
  'Nonprofit / ministry-run',
  'Government / public',
];
const CONTACT_PREF_OPTIONS = ['Email', 'Phone call', 'Text message', 'Any is fine'];
---
<BaseLayout user={user} seo={{ title: 'List Your Business — Free Directory Listing | CrossLinkd', description: 'Submit an owner-submitted listing for your business, church, ministry, or practice. CrossLinkd does not independently verify faith, ownership, licenses, or service quality.', path: '/add-listing' }}>
  <div class="listing-page mx-auto max-w-6xl px-4 py-8 pb-12" data-motion="static">
    <header class="listing-head">
      <h1 class="text-3xl font-bold tracking-tight">List your business</h1>
      <p class="section-sub">Free to list. Your profile is owner-submitted. Publishing it does not verify faith, ownership, licenses, or service quality. Fields marked <strong>Required</strong> must be completed to publish; fields marked <strong>Optional</strong> can be skipped. Some requirements depend on your listing type.</p>
      <details class="disclose info-strip mt-4">
        <summary>
          <span class="info-strip-title">
            <svg class="info-strip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
            What a listing does — and does not — confirm
          </span>
        </summary>
        <p class="mt-2 text-sm leading-relaxed" style="color:var(--text-soft)">CrossLinkd is a community directory. Business owners submit information about their business and may identify it as Christian-owned. CrossLinkd reviews submissions for completeness and obvious inconsistencies but does not independently verify faith, ownership, licenses, certifications, credentials, or service quality. Please perform your own due diligence before hiring or supporting a listed organization.</p>
        <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm leading-relaxed sm:grid-cols-2" style="color:var(--text-soft)">
          <div><dt class="inline font-semibold" style="color:var(--text)">Required.</dt> <dd class="inline">Organization type, listing name, faith identity (a denomination or statement), location for in-person listings, a guest contact email, and the accuracy and terms confirmations. No identity documents, licenses, or private religious records.</dd></div>
          <div><dt class="inline font-semibold" style="color:var(--text)">Public.</dt> <dd class="inline">Only the contact fields you turn on appear on the profile. Faith identity is self-reported and is not verified.</dd></div>
          <div><dt class="inline font-semibold" style="color:var(--text)">Review.</dt> <dd class="inline">A complete form may publish as owner-submitted. Missing required fields are not published. A completeness check is not a license or faith check.</dd></div>
          <div><dt class="inline font-semibold" style="color:var(--text)">Afterward.</dt> <dd class="inline">Claim the listing to edit it. <a href="/contact?topic=correction" class="underline">Request a correction</a> or <a href="/contact?topic=removal" class="underline">removal</a>. A listing is not an endorsement.</dd></div>
        </dl>
      </details>
    </header>

    {success ? (
      <div class="card mt-6 border-l-4 p-6" style="border-left-color:var(--teal)" role="status">
        <h2 class="text-lg font-semibold">{pendingReview ? 'Your listing was submitted for review' : 'Your listing is now live'}</h2>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">
          {pendingReview
            ? 'Guest submissions are checked by a person before they appear in the directory. Create an account to manage the listing and see its status.'
            : 'It is published as an owner-submitted listing. That is not a verification of faith, ownership, licenses, credentials, or service quality.'}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {slug && !pendingReview && <a href={`/directory/${slug}`} class="btn btn-primary">View public listing</a>}
          {user ? <a href="/dashboard/listings" class="btn btn-secondary">Manage your listings</a> : <a href="/auth/signup" class="btn btn-secondary">Create account to manage listing</a>}
        </div>
      </div>
    ) : (
      <div class="builder mt-6">
        <!-- Rail: step navigation + live preview. Stacks above the form on small
             screens; sticks beside it from 1024px up. -->
        <aside class="builder-rail" aria-label="Form navigation and preview">
          <nav class="form-jump" aria-label="Form sections">
            <a href="#section-basics" data-step="basics">Basics &amp; category</a>
            <a href="#section-services" data-step="services">Services</a>
            <a href="#section-faith" data-step="faith">Faith identity</a>
            <a href="#section-contact" data-step="contact">Contact</a>
            <a href="#section-review" data-step="review">Publish</a>
          </nav>
          <details class="disclose rail-preview" id="preview-panel" open>
            <summary>
              <span class="rail-title">Live preview</span>
              <span class="rail-hint">Updates as you type</span>
            </summary>
            <div id="live-preview" class="review-preview">
              <div class="flex items-start gap-3">
                <div class="preview-logo" aria-hidden="true">Logo</div>
                <div class="min-w-0">
                  <p id="preview-name" class="truncate font-bold" style="color:var(--text-mute)">Your listing name</p>
                  <p id="preview-type" class="mt-0.5 text-xs font-semibold" style="color:var(--text-mute)">No type selected yet</p>
                  <p id="preview-category" class="mt-0.5 text-xs" style="color:var(--text-soft)">No category selected</p>
                  <p id="preview-location" class="mt-0.5 text-xs" style="color:var(--text-mute)">Location not set</p>
                </div>
              </div>
            </div>
            <p class="rail-help">Preview only. A published profile is labeled Owner-submitted. That is not a verification.</p>
          </details>
          <p class="rail-help rail-note">Free forever for the basic listing. No credit card required.</p>
        </aside>

        <form method="POST" action="/api/listings" class="builder-form" id="add-listing-form" data-motion="static" data-taxonomy-recommendation-form>
          <p class="hp-field" aria-hidden="true"><label>Leave this blank<input type="text" name="hp_company" tabindex="-1" autocomplete="off" /></label></p>
          {error && <p class="form-status is-error" role="alert">{error}</p>}
          <p id="form-status" class="form-status hidden" role="status" aria-live="polite"></p>

          <!-- Section 1: Organization Basics -->
          <section id="section-basics" aria-labelledby="section-basics-heading" class="form-section card">
            <div class="section-head">
              <span class="section-num" aria-hidden="true">01</span>
              <div class="section-head-copy">
                <h2 id="section-basics-heading" class="section-title">Organization basics</h2>
                <p class="section-lede">Listing type — what you're offering or listing. Choose it first: it shapes which industry categories you can pick next.</p>
              </div>
            </div>

            <fieldset class="mt-5 min-w-0 border-0 p-0">
              <legend class="field-label">What best describes you? <span class="req" aria-hidden="true">*</span><span class="sr-only"> required</span> <span class="field-marker field-marker-required">Required</span></legend>
              <p class="field-help">Select the type that best fits — this filters categories to only relevant options.</p>
              <div class="type-grid mt-3">
                {PRIMARY_TYPES.map((t) => (
                  <button
                    type="button"
                    class="type-card"
                    data-type={t.slug}
                    data-label={t.label}
                    data-selected="false"
                    aria-pressed="false"
                  >
                    <span class="type-icon" aria-hidden="true"><TypeGlyph name={typeBySlug(t.slug)?.icon ?? 'store'} size={20} /></span>
                    <span class="type-copy">
                      <span class="type-name">{t.label}</span>
                      <span class="type-desc">{t.description}</span>
                    </span>
                    <span class="type-check" aria-hidden="true">✓</span>
                  </button>
                ))}
              </div>
              <input type="hidden" name="typeSlug" id="input-type-slug" value="" />
              <p id="listing-type-error" class="mt-1.5 hidden text-xs font-semibold text-red-600" role="alert">Please select an organization type.</p>
            </fieldset>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <label class="field-label" for="input-name">Listing name <span class="req" aria-hidden="true">*</span><span class="sr-only"> required</span> <span class="field-marker field-marker-required">Required</span>
                <input name="name" id="input-name" required minlength="2" maxlength="240" class="input mt-1.5" placeholder="Grace Community Church" aria-required="true" />
              </label>
              <label class="field-label">Tagline <span class="field-marker field-marker-optional">Optional</span>
                <input name="tagline" maxlength="280" class="input mt-1.5" placeholder="Brief summary of what your business does" />
              </label>
            </div>

            <label class="field-label mt-4 block" for="input-description">Business description <span class="field-marker field-marker-optional">Optional</span>
              <textarea name="description" id="input-description" rows="4" maxlength="500" class="input mt-1.5" placeholder="Describe what your business offers, who you serve, and what makes it distinct..." aria-describedby="description-help description-counter"></textarea>
            </label>
            <div class="mt-1 flex items-start justify-between gap-3">
              <span id="description-help" class="field-help">Shown on your public profile. Keep it concise.</span>
              <span id="description-counter" class="min-w-[8rem] shrink-0 whitespace-nowrap text-right text-xs font-medium" aria-live="polite" aria-atomic="true">0 / 500 characters</span>
            </div>


      <details class="disclose mt-5" data-taxonomy-recommendation-panel aria-labelledby="taxonomy-recommendation-heading">
        <summary>
          <span id="taxonomy-recommendation-heading" class="text-sm font-bold">Optional category suggestions</span>
          <span class="disclose-hint">Suggestions only</span>
        </summary>
        <p class="mt-2 text-xs" style="color:var(--text-mute)">Local suggestions use listing details only; website contents are not fetched. Nothing changes unless you choose a suggestion.</p>
        <div class="mt-3 min-h-12" data-taxonomy-recommendation-results aria-live="polite"><p class="text-xs" style="color:var(--text-mute)">Start typing listing details to see relevant taxonomy paths.</p></div>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button type="button" class="btn btn-secondary !min-h-9 !px-3 !py-1.5 !text-xs" data-taxonomy-none aria-describedby="category-manual-status">None of these fit</button>
        </div>
        <p class="mt-2 text-xs" style="color:var(--text-mute)" data-taxonomy-recommendation-status role="status" aria-live="polite"></p>
      </details>

            <input type="hidden" name="industrySlug" id="input-industry-slug" value="" data-selection-source="manual" />
            <input type="hidden" name="categorySlug" id="input-category-slug" value="" data-selection-source="manual" />

            <div id="manual-category-picker" data-manual-category-picker role="group" aria-labelledby="category-search-label" class="hidden mt-4 rounded-xl border p-4" style="border-color:var(--border);background:var(--surface-2)">
              <label id="category-search-label" for="category-search-input" class="field-label">Search industries and categories <span class="field-marker field-marker-optional">Optional</span></label>
              <p id="category-filter-help" class="field-help">Please select an organization type first.</p>
              <span id="category-type-context" class="chip hidden mt-2 !text-[11px]"></span>
              <p id="category-manual-help" class="field-help">Search by category, industry, profession, or service. If nothing fits, choose an “Other” result to enter your exact name.</p>
              <div class="relative mt-2 category-picker">
                <input
                  type="search"
                  id="category-search-input"
                  class="input w-full !pl-9"
                  placeholder="e.g. Bakery, Plumbing, Counseling"
                  autocomplete="off"
                  aria-describedby="category-filter-help category-manual-help"
                />
                <svg class="absolute left-3 top-3 h-4 w-4 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <div id="category-search-results" class="hidden absolute left-0 right-0 top-full z-20 mt-1.5 max-h-[260px] overflow-y-auto rounded-xl border bg-[var(--surface)] shadow-lg" style="border-color:var(--border)"></div>
              </div>
              <div id="category-filter-status" class="mt-1.5 hidden text-xs font-semibold" style="color:var(--teal)" aria-live="polite"></div>
            </div>

            <div id="category-chips-primary" class="hidden mt-3 flex flex-wrap items-center gap-2">
              <span class="chip !text-[11px] font-bold" style="border-color:var(--teal); color:var(--teal)">
                <span id="category-chip-text"></span>
                <span id="category-selection-source" class="hidden ml-1 rounded-full border px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide">Suggested</span>
                <button type="button" id="category-chip-clear" class="ml-1.5 hover:opacity-75 focus:outline-none" aria-label="Clear selected category">✕</button>
              </span>
            </div>
            <div id="custom-category-wrap" class="hidden mt-3 rounded-xl p-3.5 border border-[var(--border)] bg-[var(--surface-2)]">
              <label class="block text-xs font-medium">Your category name <span class="field-marker field-marker-required">Required for Other</span>
                <input name="customCategory" id="input-custom-category" class="input mt-1.5 w-full" placeholder="e.g. Specialty bakery or stained-glass restoration" maxlength="180" />
              </label>
              <p class="text-[11px] mt-1" style="color:var(--text-mute)">Enter the specific category people would search for.</p>
            </div>
            <p id="category-type-warning" class="mt-3 hidden rounded-xl border border-amber-300 bg-amber-50 p-3 text-xs font-semibold text-amber-800" role="status">Category cleared — it doesn't match the new organization type. Please select a new category.</p>
            <p id="category-manual-status" class="sr-only" aria-live="polite"></p>

            <details class="disclose org-card mt-5" data-open-if>
              <summary>
                <span>
                  <span class="block text-sm font-bold">About your organization</span>
                  <span class="mt-0.5 block text-xs font-medium" style="color:var(--text-mute)">Optional — year, size, hours, service area, and price.</span>
                </span>
              </summary>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <label class="field-label">Year founded <span class="field-marker field-marker-optional">Optional</span>
                  <input name="yearFounded" type="number" inputmode="numeric" min="1800" max={thisYear} class="input mt-1.5" placeholder="e.g. 1998" />
                </label>
                <label class="field-label">Organization size <span class="field-marker field-marker-optional">Optional</span>
                  <select name="employeeCount" class="input mt-1.5">
                    <option value="">Select size (optional)</option>
                    {SIZE_OPTIONS.map((s) => <option value={s}>{s}</option>)}
                  </select>
                </label>
                <label class="field-label">Ownership type <span class="field-marker field-marker-optional">Optional</span>
                  <select name="ownershipType" class="input mt-1.5">
                    <option value="">Select ownership (optional)</option>
                    {OWNERSHIP_OPTIONS.map((o) => <option value={o}>{o}</option>)}
                  </select>
                </label>
                <HoursEditor id="add-listing-hours-editor" />
                <label class="field-label">Service area <span class="field-marker field-marker-optional">Optional</span>
                  <input name="serviceArea" maxlength="300" class="input mt-1.5" placeholder="e.g. Austin metro; delivery within 25 miles" />
                  <span class="field-help">Cities, counties, or regions you serve.</span>
                </label>
                <label class="field-label">Price range <span class="field-marker field-marker-optional">Optional</span>
                  <select name="priceRange" class="input mt-1.5 block w-full">
                    <option value="">Select price range</option>
                    <option value="$">$ (Inexpensive / Budget-friendly)</option>
                    <option value="$$">$$ (Moderate / Standard)</option>
                    <option value="$$$">$$$ (Upscale / Premium)</option>
                    <option value="$$$$">$$$$ (High-end / Specialized)</option>
                  </select>
                  <span class="field-help">Used for price-based filtering across the directory.</span>
                </label>
              </div>
            </details>
          </section>

          <!-- Section 2: Optional services; category selection is completed in Step 1. -->
          <section id="section-services" aria-labelledby="section-services-heading" class="form-section card">
            <div class="section-head">
              <span class="section-num" aria-hidden="true">02</span>
              <div class="section-head-copy">
                <h2 id="section-services-heading" class="section-title">Professions &amp; services <span class="field-marker field-marker-optional">Optional</span></h2>
                <p class="section-lede">Optional. Choose roles and services after selecting a category in Basics &amp; category.</p>
              </div>
            </div>
            <div id="profession-options" class="mt-4 grid gap-2 sm:grid-cols-2" aria-live="polite">
              <p class="field-help">Select a category in Step 1 to see matching professions.</p>
            </div>
            <label class="field-label mt-4 block">Custom profession(s) <span class="field-marker field-marker-optional">Optional</span>
              <textarea name="customProfessions" id="input-custom-professions" rows="2" maxlength="600" class="input mt-1.5 w-full" placeholder="Add a profession not listed (one per line)"></textarea>
              <span class="field-help">Separate multiple entries with a new line, comma, or semicolon.</span>
            </label>
            <div class="mt-4">
              <p class="field-label">Services you provide <span class="field-marker field-marker-optional">Optional</span></p>
              <div id="service-options" class="mt-2 grid gap-2 sm:grid-cols-2" aria-live="polite">
                <p class="field-help">Choose a profession above to see its service examples.</p>
              </div>
            </div>
            <label class="field-label mt-4 block">Custom service(s) <span class="field-marker field-marker-optional">Optional</span>
              <textarea name="customServices" id="input-custom-services" rows="2" maxlength="1000" class="input mt-1.5 w-full" placeholder="Add other services (one per line)"></textarea>
              <span class="field-help">Select taxonomy examples above or add your own services.</span>
            </label>
          </section>

          <!-- Faith identity is required; disclosure stays compact until the user opens it. -->
          <details id="section-faith" aria-labelledby="section-faith-heading" class="form-section card disclose faith-disclosure">
            <summary class="section-head">
              <div class="section-head-copy">
                <h2 id="section-faith-heading" class="section-title">Faith identity &amp; denomination <span class="field-marker field-marker-required">Required</span></h2>
                <p class="section-lede">Choose at least one denomination or add a statement of faith. Either meets this requirement; up to two denominations may be selected.</p>
              </div>
              <span id="denom-counter" class="chip !text-[11px]">0 of 2 selected</span>
            </summary>

            <div id="faith-identity-group" role="group" aria-labelledby="section-faith-heading" aria-describedby="faith-requirement-help faith-identity-error" aria-required="true">
            <p id="faith-requirement-help" class="field-help mt-4">Required: add a denomination or a statement of faith. “Other” requires a custom denomination name.</p>
            <p id="faith-identity-error" class="field-validation-error" role="alert" hidden>Choose at least one denomination or add a statement of faith before publishing.</p>

            <!-- Active Selection Chips Display -->
            <div id="denom-chips-container" class="mt-5 flex flex-wrap items-center gap-2 min-h-[38px] p-2.5 rounded-xl border border-dashed border-[var(--border)] bg-[var(--surface-2)]">
              <span id="denom-empty-hint" class="text-xs" style="color:var(--text-mute)">No denominations selected yet. Choose up to two below.</span>
            </div>

            <!-- Hidden inputs for multi-denomination form submission -->
            <div id="denom-hidden-inputs"></div>

            <!-- Selection Controls: searchable denomination typeahead (same interaction as the category search) -->
            <div class="mt-4">
              <label for="denom-search-input" class="field-label">Denominations <span class="field-marker field-marker-required">One way to meet the requirement</span></label>
              <div class="relative mt-2">
                <input
                  type="search"
                  id="denom-search-input"
                  class="input w-full !pl-9"
                  placeholder="Search denominations (e.g. Baptist, Methodist, Non-Denominational)..."
                  autocomplete="off"
                  aria-describedby="denom-search-help faith-requirement-help faith-identity-error"
                />
                <svg class="absolute left-3 top-3 h-4 w-4 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <div id="denom-search-results" class="hidden absolute left-0 right-0 top-full z-20 mt-1.5 max-h-[260px] overflow-y-auto rounded-xl border bg-[var(--surface)] shadow-lg" style="border-color:var(--border)"></div>
              </div>
              <p id="denom-search-help" class="field-help mt-1.5">Type to filter denominations, then click to add — up to two. Pick "Other (specify custom denomination)" to enter your own.</p>
            </div>

            <!-- Custom Denomination Input when 'Other' is chosen -->
            <div id="custom-denom-wrap" class="hidden mt-3 rounded-xl p-3 border border-[var(--border)] bg-[var(--surface-2)]">
              <label class="block text-xs font-medium">Custom denomination or movement name <span class="field-marker field-marker-required">Required for Other</span>
                <input
                  name="customDenomination"
                  id="custom-denom-input"
                  class="input mt-1.5 w-full"
                  placeholder="e.g. Calvary Chapel, Vineyard Movement, Independent Baptist..."
                  maxlength="180"
                  aria-describedby="faith-requirement-help faith-identity-error"
                />
              </label>
            </div>

            <div class="setting-list mt-4">
              <label class="setting-row">
                <input type="checkbox" name="showDenomination" value="1" checked class="peer sr-only" />
                <span class="setting-copy">
                  <span class="setting-title">Display faith affiliation publicly on listing <span class="field-marker field-marker-optional">Optional</span></span>
                  <span class="setting-help">When off, your denomination is stored privately and will not appear on your public listing.</span>
                </span>
                <span class="setting-badge setting-badge-off">Off</span>
                <span class="setting-badge setting-badge-on">On</span>
                <span class="public-switch" aria-hidden="true"></span>
              </label>
            </div>

            <details class="disclose mt-5" data-open-if>
              <summary>
                <span class="text-sm font-bold">Statement of faith <span class="field-marker field-marker-required">Alternative way to meet requirement</span></span>
              </summary>
              <label class="field-label mt-3 block" for="input-statement">Statement of faith <span class="field-marker field-marker-required">One way to meet the requirement</span>
                <textarea name="statementOfFaith" id="input-statement" rows="3" maxlength="8000" class="input mt-1.5" placeholder="Brief statement of faith, mission, or Christian core values..."></textarea>
              </label>
            </details>
            </div>
          </details>

          <!-- Section 3: Contact and Visibility -->
          <section id="section-contact" aria-labelledby="section-contact-heading" class="form-section card">
            <div class="section-head">
              <span class="section-num" aria-hidden="true">03</span>
              <div class="section-head-copy">
                <h2 id="section-contact-heading" class="section-title">Contact and visibility</h2>
                <p class="section-lede">For in-person listings, provide a city or state/region; choose Online-only to skip the location requirement. Other contact and visibility details are optional unless marked Required.</p>
              </div>
            </div>

            <label class="field-label mt-5 block">Preferred contact method <span class="field-marker field-marker-optional">Optional</span>
              <select name="contactPreference" class="input mt-1.5 block w-full">
                <option value="">Select preference</option>
                {CONTACT_PREF_OPTIONS.map((c) => <option value={c}>{c}</option>)}
              </select>
              <span class="field-help">How you'd rather receive inquiries through the directory.</span>
            </label>

            <div class="control-grid mt-4">
              <article class="control-card">
                <fieldset class="control-fieldset">
                  <legend class="control-title">Is this company hiring? <span class="field-marker field-marker-optional">Optional</span></legend>
                  <div class="control-row">
                    <div class="choice-group">
                      <label class="choice-pill" for="input-hiring-no">
                        <input type="radio" name="isHiring" value="0" id="input-hiring-no" checked class="sr-only" />
                        <span class="choice-mark" aria-hidden="true"></span>
                        <span class="choice-copy">No</span>
                      </label>
                      <label class="choice-pill" for="input-hiring-yes">
                        <input type="radio" name="isHiring" value="1" id="input-hiring-yes" class="sr-only" />
                        <span class="choice-mark" aria-hidden="true"></span>
                        <span class="choice-copy">Yes</span>
                      </label>
                    </div>
                  </div>
                  <p class="control-help">Choose Yes only if this organization is currently hiring. The default is No.</p>
                </fieldset>
              </article>

              <article id="online-toggle-wrap" class="control-card" data-online="off">
                <fieldset class="control-fieldset">
                  <legend class="control-title">Is this an online-only listing? <span class="field-marker field-marker-optional">Optional · defaults to in-person</span></legend>
                  <div class="control-row">
                    <div class="choice-group">
                      <label class="choice-pill" id="online-off-label" for="input-online-off" data-active="true">
                        <input type="radio" name="isOnlineOnly" value="0" id="input-online-off" checked class="sr-only" aria-describedby="online-state-text" />
                        <span class="choice-mark" aria-hidden="true"></span>
                        <span class="choice-copy">In-person</span>
                      </label>
                      <label class="choice-pill" id="online-on-label" for="input-online" data-active="false">
                        <input type="radio" name="isOnlineOnly" value="1" id="input-online" class="sr-only" aria-describedby="online-state-text" />
                        <span class="choice-mark" aria-hidden="true"></span>
                        <span class="choice-copy">Online-only</span>
