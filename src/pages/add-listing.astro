---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { INDUSTRIES } from '@/data/industries';
import { DENOMINATIONS } from '@/data/denominations';

const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success') === '1';
const slug = Astro.url.searchParams.get('slug');
const thisYear = new Date().getFullYear();

const popularDenominations = [
  { slug: 'non-denominational', name: 'Non-Denominational' },
  { slug: 'baptist', name: 'Baptist' },
  { slug: 'lutheran', name: 'Lutheran' },
  { slug: 'reformed-presbyterian', name: 'Presbyterian & Reformed' },
  { slug: 'methodist-wesleyan', name: 'Methodist & Wesleyan' },
  { slug: 'pentecostal-charismatic', name: 'Pentecostal & Charismatic' },
  { slug: 'anglican-episcopal', name: 'Anglican & Episcopal' },
  { slug: 'catholic', name: 'Catholic' },
  { slug: 'eastern-orthodox', name: 'Eastern Orthodox' },
  { slug: 'evangelical', name: 'Evangelical Free' },
  { slug: 'anabaptist', name: 'Anabaptist & Mennonite' },
  { slug: 'restorationist', name: 'Churches of Christ' },
  { slug: 'interdenominational', name: 'Interdenominational' },
  { slug: 'other', name: 'Other (specify custom denomination)' },
];

const allOtherDenominations = [...DENOMINATIONS]
  .filter((d) => !popularDenominations.some((p) => p.slug === d.slug))
  .sort((a, b) => a.name.localeCompare(b.name));

// Full denomination catalog for the searchable typeahead.
const denominationOptions = [
  ...popularDenominations.map((d) => ({ slug: d.slug, name: d.name })),
  ...allOtherDenominations.map((d) => ({ slug: d.slug, name: d.name })),
];

// Primary listing types shown as cards in Section 1.
const PRIMARY_TYPES = [
  { slug: 'business', label: 'Business', description: 'Christian-owned company, shop, or service provider' },
  { slug: 'church', label: 'Church', description: 'Local congregation — services, small groups, pastoral care' },
  { slug: 'ministry', label: 'Ministry', description: 'Parachurch outreach, missions, discipleship, media' },
  { slug: 'nonprofit', label: 'Nonprofit', description: 'Faith-based charity or community organization' },
  { slug: 'school', label: 'School', description: 'Christian school, college, seminary, or homeschool co-op' },
  { slug: 'event', label: 'Event', description: 'Conference, retreat, concert, camp, or gathering' },
  { slug: 'other', label: 'Other', description: 'Association, network, or other faith-aligned org' },
];

// Type → allowed industries. The `other` type exposes every industry.
const TYPE_CATEGORY_MAP = {
  business: [
    'food-beverage',
    'healthcare-wellness',
    'construction-skilled-trades',
    'professional-business-services',
    'retail-consumer',
    'arts-media-entertainment',
    'travel-hospitality',
    'other-industries',
  ],
  church: ['religious-organizations'],
  ministry: ['religious-organizations'],
  nonprofit: ['nonprofit-civic', 'other-industries'],
  school: ['education'],
  event: ['arts-media-entertainment', 'travel-hospitality', 'sports-recreation', 'other-industries'],
  other: INDUSTRIES.map((industry) => industry.slug),
};

// Optional per-industry category allow-lists within an allowed industry.
const TYPE_CATEGORY_FILTER = {
  church: {
    'religious-organizations': ['churches', 'ministry', 'other-religious'],
  },
  ministry: {
    'religious-organizations': ['churches', 'ministry', 'other-religious'],
  },
  nonprofit: {
    'nonprofit-civic': ['charity', 'community-outreach', 'youth-family', 'other-nonprofit'],
  },
  event: {
    'arts-media-entertainment': ['music', 'photography', 'videography'],
    'travel-hospitality': ['venues', 'event-services'],
    'sports-recreation': ['outdoor-recreation', 'coaching'],
    'other-industries': ['other-business'],
  },
};

// Slim industry payload for the client (professions are not needed on this page).
const industries = INDUSTRIES.map((ind) => ({
  slug: ind.slug,
  name: ind.name,
  categories: ind.categories.map((c) => ({ slug: c.slug, name: c.name })),
}));

// Organization-basics selects (labels match the server-side validation enums).
const SIZE_OPTIONS = ['Solo (just me)', '2–10', '11–50', '51–200', '201–500', '500+'];
const OWNERSHIP_OPTIONS = [
  'Privately owned',
  'Family-owned',
  'Partnership',
  'Corporation',
  'Cooperative',
  'Nonprofit / ministry-run',
  'Government / public',
];
const HOURS_OPTIONS = [
  { value: 'standard', label: 'Standard — Mon–Fri, 9a–5p' },
  { value: 'extended', label: 'Extended — evenings & Saturdays' },
  { value: 'weekends', label: 'Weekends only' },
  { value: 'appointment', label: 'By appointment only' },
  { value: 'always', label: 'Open 24 hours, every day' },
  { value: 'vary', label: 'Hours vary — contact us' },
];
const CONTACT_PREF_OPTIONS = ['Email', 'Phone call', 'Text message', 'Any is fine'];
---
<BaseLayout user={user} seo={{ title: 'List Your Business — Free Directory Listing | CrossLinkd', description: 'Create a free listing for your Christian-owned business, church, ministry, or professional practice. Published immediately and free to list.', path: '/add-listing' }}>
  <div class="mx-auto max-w-3xl px-4 py-10 pb-32">
    <h1 class="text-3xl font-extrabold tracking-tight">List your business</h1>
    <p class="section-sub">Free to list. Your business profile is published immediately to the CrossLinkd directory and searchable right away.</p>

    {success ? (
      <div class="card mt-6 border-l-4 p-6" style="border-left-color:var(--teal)">
        <h2 class="text-lg font-extrabold">Your listing is now live!</h2>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">Your business profile has been published to the CrossLinkd directory and is visible to visitors immediately.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {slug && <a href={`/directory/${slug}`} class="btn btn-primary">View public listing</a>}
          {user ? <a href="/dashboard/listings" class="btn btn-secondary">Manage your listings</a> : <a href="/auth/signup" class="btn btn-secondary">Create account to manage listing</a>}
          <a href="/search" class="btn btn-ghost">Browse directory</a>
        </div>
      </div>
    ) : (
      <form method="POST" action="/api/listings" class="card mt-6 space-y-8 p-6 sm:p-8" id="add-listing-form">
        {error && <p class="rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-600" role="alert">{error}</p>}
        {!user && <p class="rounded-xl p-3 text-sm" style="background:rgba(216,149,34,.12)">You’re creating a listing as a guest. <a href="/auth/signup" class="font-bold underline">Create a free account</a> to edit and manage this listing later.</p>}

        <!-- Section 1: Organization Basics -->
        <section aria-labelledby="section-basics-heading" class="pt-1">
          <div class="flex items-baseline gap-3">
            <span class="section-num" aria-hidden="true">01</span>
            <div>
              <h2 id="section-basics-heading" class="text-lg font-extrabold leading-tight">Organization basics</h2>
            </div>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Listing type — what you're offering or listing. Choose it first: it shapes which industry categories you can pick next.</p>

          <fieldset class="mt-5 border-0 p-0">
            <legend class="text-sm font-semibold">What best describes you? <span style="color:var(--accent)" aria-hidden="true">*</span></legend>
            <p class="mt-0.5 text-xs" style="color:var(--text-mute)">Select the type that best fits — this filters categories to only relevant options.</p>
            <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
              {PRIMARY_TYPES.map((t) => (
                <button
                  type="button"
                  class="type-card flex flex-col rounded-xl border p-3 text-left transition-all focus:outline-none focus:ring-2 hover:border-[var(--accent)]"
                  style="border-color:var(--border); background:var(--surface)"
                  data-type={t.slug}
                  data-selected="false"
                  aria-pressed="false"
                >
                  <span class="flex items-center justify-between gap-2">
                    <span class="font-bold text-sm">{t.label}</span>
                    <span class="type-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="mt-0.5 text-xs" style="color:var(--text-mute)">{t.description}</span>
                </button>
              ))}
            </div>
            <input type="hidden" name="typeSlug" id="input-type-slug" value="" />
            <p id="listing-type-error" class="mt-1.5 hidden text-xs font-semibold text-red-600" role="alert">Please select an organization type.</p>
          </fieldset>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <label class="text-sm font-semibold">Listing name *
              <input name="name" id="input-name" required minlength="2" maxlength="240" class="input mt-1.5" placeholder="Grace Community Church" />
            </label>
            <label class="text-sm font-semibold">Tagline
              <input name="tagline" maxlength="280" class="input mt-1.5" placeholder="Brief summary of what your business does" />
            </label>
          </div>

          <label class="mt-4 block text-sm font-semibold">Description
            <textarea name="description" rows="4" maxlength="8000" class="input mt-1.5" placeholder="Describe what your business offers, who you serve, and what makes your business distinct..."></textarea>
            <span class="mt-1 block text-xs" style="color:var(--text-mute)">Shown on your public profile — a sentence or two about what you do and who you serve.</span>
          </label>

          <!-- About your organization: structured, optional details -->
          <div class="org-card mt-5 rounded-2xl border p-4 sm:p-5" style="border-color:var(--border); background:var(--surface-2)">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-extrabold">About your organization</h3>
              <span class="rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide" style="background:var(--surface); color:var(--text-mute)">Optional</span>
            </div>
            <p class="mt-1 text-xs" style="color:var(--text-mute)">A few details that help visitors — and price, size, and location filters — understand who you are. You can leave anything blank.</p>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <label class="text-sm font-semibold">Year founded
                <input name="yearFounded" type="number" inputmode="numeric" min="1800" max={thisYear} class="input mt-1.5" placeholder="e.g. 1998" />
              </label>
              <label class="text-sm font-semibold">Organization size
                <select name="employeeCount" class="input mt-1.5">
                  <option value="">Select size (optional)</option>
                  {SIZE_OPTIONS.map((s) => <option value={s}>{s}</option>)}
                </select>
              </label>
              <label class="text-sm font-semibold">Ownership type
                <select name="ownershipType" class="input mt-1.5">
                  <option value="">Select ownership (optional)</option>
                  {OWNERSHIP_OPTIONS.map((o) => <option value={o}>{o}</option>)}
                </select>
              </label>
              <label class="text-sm font-semibold">Operating hours
                <select name="hours" class="input mt-1.5">
                  <option value="">Select typical hours (optional)</option>
                  {HOURS_OPTIONS.map((h) => <option value={h.value}>{h.label}</option>)}
                </select>
              </label>
              <label class="text-sm font-semibold sm:col-span-2">Service area
                <input name="serviceArea" maxlength="300" class="input mt-1.5" placeholder="e.g. Austin metro; delivery within 25 miles; nationwide online" />
                <span class="mt-1 block text-xs" style="color:var(--text-mute)">Cities, counties, regions you serve — or “nationwide”.</span>
              </label>
            </div>
          </div>

          <!-- Price range: its own clearly spaced block, generous separation at every breakpoint -->
          <div class="mt-7 mb-1 pr-1">
            <label class="block text-sm font-semibold">Price range
              <select name="priceRange" class="input mt-2 block w-full sm:w-1/2 pr-10">
                <option value="">Select price range (optional)</option>
                <option value="$">$ (Inexpensive / Budget-friendly)</option>
                <option value="$$">$$ (Moderate / Standard)</option>
                <option value="$$$">$$$ (Upscale / Premium)</option>
                <option value="$$$$">$$$$ (High-end / Specialized)</option>
              </select>
              <span class="mt-2 block text-xs" style="color:var(--text-mute)">Used for price-based filtering across the directory.</span>
            </label>
          </div>
        </section>

        <!-- Section 2: Category (type-filtered, single searchable picker) -->
        <section aria-labelledby="section-category-heading" class="border-t pt-7" style="border-color:var(--border)">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-baseline gap-3">
              <span class="section-num" aria-hidden="true">02</span>
              <div>
                <h2 id="section-category-heading" class="text-lg font-extrabold leading-tight">Industry &amp; business category</h2>
              </div>
            </div>
            <span id="category-type-context" class="chip hidden !text-[11px]"></span>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Where your listing belongs in the directory taxonomy — pick the most specific industry and category that describe it. This is separate from your listing type: the two work together, with options filtered to match the type selected above.</p>

          <!-- Hidden inputs for submission -->
          <input type="hidden" name="industrySlug" id="input-industry-slug" value="" />
          <input type="hidden" name="categorySlug" id="input-category-slug" value="" />

          <!-- Single searchable category picker (filtered by selected type) -->
          <div class="mt-4">
            <label for="category-search-input" class="text-sm font-semibold">Search &amp; pick a category</label>
            <p id="category-filter-help" class="mt-0.5 text-xs" style="color:var(--text-mute)">Please select an organization type first.</p>
            <div class="relative mt-2">
              <input
                type="search"
                id="category-search-input"
                class="input w-full !pl-9"
                placeholder="Search categories (e.g. Bakery, Plumbing, Roofing, Dental, Counseling)..."
                autocomplete="off"
                aria-describedby="category-filter-help"
              />
              <svg class="absolute left-3 top-3 h-4 w-4 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <div id="category-search-results" class="hidden absolute left-0 right-0 top-full z-20 mt-1.5 max-h-[260px] overflow-y-auto rounded-xl border bg-[var(--surface)] shadow-lg" style="border-color:var(--border)"></div>
            </div>
            <div id="category-filter-status" class="mt-1.5 hidden text-xs font-semibold" style="color:var(--teal)" aria-live="polite"></div>
          </div>

          <!-- Selected category chip -->
          <div id="category-chips-primary" class="hidden mt-3 flex flex-wrap items-center gap-2">
            <span class="chip !text-[11px] font-bold" style="border-color:var(--teal); color:var(--teal)">
              <span id="category-chip-text"></span>
              <button type="button" id="category-chip-clear" class="ml-1.5 hover:opacity-75 focus:outline-none" aria-label="Clear selected category">✕</button>
            </span>
          </div>

          <!-- Custom Category Input when 'Other' category is chosen -->
          <div id="custom-category-wrap" class="hidden mt-3 rounded-xl p-3.5 border border-[var(--border)] bg-[var(--surface-2)]">
            <label class="block text-xs font-semibold">Custom category name *
              <input name="customCategory" id="input-custom-category" class="input mt-1.5 w-full" placeholder="e.g. Specialty Gluten-Free Bakery, Stained Glass Restoration, etc." maxlength="180" />
            </label>
            <p class="text-[11px] mt-1" style="color:var(--text-mute)">Please specify your business's exact trade or service.</p>
          </div>

          <p id="category-type-warning" class="mt-3 hidden rounded-xl border border-amber-300 bg-amber-50 p-3 text-xs font-semibold text-amber-800" role="status">Category cleared — it doesn't match the new organization type. Please select a new category.</p>
        </section>

        <!-- Section 3: Faith Identity -->
        <section aria-labelledby="section-faith-heading" class="border-t pt-7" style="border-color:var(--border)">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-baseline gap-3">
              <span class="section-num" aria-hidden="true">03</span>
              <div>
                <h2 id="section-faith-heading" class="text-lg font-extrabold leading-tight">Faith identity &amp; denomination</h2>
              </div>
            </div>
            <span id="denom-counter" class="chip !text-[11px]">0 of 2 selected</span>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Select up to two denominations that best represent this organization.</p>

          <!-- Active Selection Chips Display -->
          <div id="denom-chips-container" class="mt-4 flex flex-wrap items-center gap-2 min-h-[38px] p-2.5 rounded-xl border border-dashed border-[var(--border)] bg-[var(--surface-2)]">
            <span id="denom-empty-hint" class="text-xs" style="color:var(--text-mute)">No denominations selected yet. Choose up to two below.</span>
          </div>

          <!-- Hidden inputs for multi-denomination form submission -->
          <div id="denom-hidden-inputs"></div>

          <!-- Selection Controls: searchable denomination typeahead (same interaction as the category search) -->
          <div class="mt-4">
            <label for="denom-search-input" class="text-sm font-semibold">Search denominations</label>
            <div class="relative mt-2">
              <input
                type="search"
                id="denom-search-input"
                class="input w-full !pl-9"
                placeholder="Search denominations (e.g. Baptist, Methodist, Non-Denominational)..."
                autocomplete="off"
                aria-describedby="denom-search-help"
              />
              <svg class="absolute left-3 top-3 h-4 w-4 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <div id="denom-search-results" class="hidden absolute left-0 right-0 top-full z-20 mt-1.5 max-h-[260px] overflow-y-auto rounded-xl border bg-[var(--surface)] shadow-lg" style="border-color:var(--border)"></div>
            </div>
            <p id="denom-search-help" class="mt-1.5 text-xs" style="color:var(--text-mute)">Type to filter denominations, then click to add — up to two. Pick "Other (specify custom denomination)" to enter your own.</p>
          </div>

          <!-- Custom Denomination Input when 'Other' is chosen -->
          <div id="custom-denom-wrap" class="hidden mt-3 rounded-xl p-3 border border-[var(--border)] bg-[var(--surface-2)]">
            <label class="block text-xs font-semibold">Custom denomination or movement name *
              <input
                name="customDenomination"
                id="custom-denom-input"
                class="input mt-1.5 w-full"
                placeholder="e.g. Calvary Chapel, Vineyard Movement, Independent Baptist..."
                maxlength="180"
              />
            </label>
          </div>

          <label class="mt-4 flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer">
            <input type="checkbox" name="showDenomination" value="1" checked class="peer sr-only" />
            <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
            <span>Display faith affiliation publicly on listing</span>
            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
            <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
          </label>
          <p class="mt-0.5 text-xs" style="color:var(--text-mute)">When unchecked, your denomination is stored privately and will not appear on your public listing.</p>

          <label class="mt-5 block text-sm font-semibold">Statement of faith <span style="color:var(--text-mute)">(optional, displayed on your profile)</span>
            <textarea name="statementOfFaith" id="input-statement" rows="3" maxlength="8000" class="input mt-1.5" placeholder="Brief statement of faith, mission, or Christian core values (optional)..."></textarea>
          </label>
        </section>

        <!-- Section 4: Contact and Visibility -->
        <section aria-labelledby="section-contact-heading" class="border-t pt-7" style="border-color:var(--border)">
          <div class="flex items-baseline gap-3">
            <span class="section-num" aria-hidden="true">04</span>
            <div>
              <h2 id="section-contact-heading" class="text-lg font-extrabold leading-tight">Contact and visibility</h2>
            </div>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Choose exactly which contact details appear publicly on your listing profile.</p>

          <div class="card mt-4 p-3.5 text-xs leading-relaxed" style="background:var(--surface-2);color:var(--text-soft)">
            <strong>Privacy Guarantee:</strong> Information kept private is used solely for account administration and verification. Private fields are never exposed in search results, cards, page metadata, or public APIs.
          </div>

          <!-- How we should reach you (organization contact preference) -->
          <div class="mt-4 sm:w-1/2 pr-1">
            <label class="block text-sm font-semibold">Preferred contact method
              <select name="contactPreference" class="input mt-1.5 block w-full">
                <option value="">Select preference (optional)</option>
                {CONTACT_PREF_OPTIONS.map((c) => <option value={c}>{c}</option>)}
              </select>
              <span class="mt-1.5 block text-xs" style="color:var(--text-mute)">How you'd rather receive inquiries through the directory.</span>
            </label>
          </div>

          <!-- Online-only toggle -->
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <label for="input-online" class="flex items-center gap-2.5 text-sm font-semibold cursor-pointer">
              <input type="checkbox" name="isOnlineOnly" value="1" id="input-online" class="peer sr-only" />
              <span class="relative inline-block h-6 w-11 rounded-full bg-gray-200 transition-colors peer-checked:bg-[var(--accent)] after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
              <span>This is an online-only listing (serves nationwide)</span>
            </label>
            <span id="online-off-label" class="text-[11px] font-bold uppercase tracking-wide" style="color:var(--text-mute)">In-person</span>
            <span id="online-on-label" class="text-[11px] font-bold uppercase tracking-wide" style="color:var(--text-mute)">Online-only</span>
          </div>

          <!-- Physical Location -->
          <div id="location-fields" class="mt-4 space-y-2">
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="text-sm font-semibold">City
                <input name="city" id="input-city" maxlength="120" class="input mt-1.5" placeholder="Enter city" />
              </label>
              <label class="text-sm font-semibold">State / region
                <input name="region" id="input-region" maxlength="120" class="input mt-1.5" placeholder="Enter state or region" />
              </label>
              <label class="text-sm font-semibold">ZIP / Postal code
                <input name="postalCode" maxlength="24" class="input mt-1.5" placeholder="Enter postal code" />
              </label>
            </div>

            <label class="flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer pt-1">
              <input type="checkbox" name="showAddress" value="1" class="peer sr-only" />
              <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
              <span>Display postal code / full address publicly on listing</span>
              <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
              <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
            </label>
            <p class="text-xs" style="color:var(--text-mute)">When unchecked, only your general city and state are displayed; specific postal codes remain private.</p>
