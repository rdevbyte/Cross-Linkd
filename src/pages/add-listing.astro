      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      clip: auto;
      clip-path: none;
      overflow: visible;
      white-space: normal;
      opacity: 0;
      cursor: pointer;
    }
    label.choice-pill:hover {
      border-color: var(--border-strong);
      color: var(--text);
    }
    .choice-pill:has(:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    .choice-pill:has(:checked) {
      border-style: solid;
      border-color: var(--text);
      background: var(--surface-2);
      color: var(--text);
      font-weight: 800;
      box-shadow: inset 3px 0 0 var(--text);
    }
    .choice-mark {
      width: 0.55rem;
      height: 0.55rem;
      flex: none;
      border-radius: 999px;
      border: 1.5px solid currentColor;
      background: transparent;
    }
    .choice-pill:has(:checked) .choice-mark {
      background: currentColor;
      border-color: currentColor;
    }
    .choice-pill:has(:disabled) {
      cursor: not-allowed;
      opacity: 0.62;
    }
    .control-help {
      margin: 0;
      margin-top: auto;
      min-height: 2.6rem;
      font-size: 0.78rem;
      line-height: 1.45;
      color: var(--text-mute);
    }
    .control-card[hidden],
    .careers-card[hidden] { display: none !important; }

    /* ---- Settings rows: copy left, state + switch right ---- */
    .setting-list { display: grid; gap: 0.5rem; }
    .setting-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 0.75rem;
      min-height: 56px;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 0.8rem;
      background: var(--surface);
      cursor: pointer;
    }
    .setting-row:hover { border-color: var(--border-strong); }
    .setting-copy { display: grid; gap: 0.15rem; min-width: 0; }
    .setting-title { font-size: 0.8125rem; font-weight: 600; line-height: 1.35; color: var(--text); }
    .setting-help { font-size: 0.75rem; line-height: 1.4; color: var(--text-mute); }
    .setting-badge {
      border-radius: 999px;
      padding: 0.12rem 0.4rem;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .setting-badge-off { background: var(--surface-2); color: var(--text-mute); }
    .setting-badge-on { display: none; background: var(--accent-soft); color: var(--accent); }
    .setting-row .peer:checked ~ .setting-badge-off { display: none; }
    .setting-row .peer:checked ~ .setting-badge-on { display: inline-block; }
    .public-switch {
      position: relative;
      display: inline-block;
      height: 1.5rem;
      width: 2.75rem;
      flex: none;
      border-radius: 999px;
      background: #d8d0ba;
      transition: background-color 0.2s ease;
    }
    [data-theme='dark'] .public-switch { background: var(--border-strong); }
    .public-switch::after {
      content: '';
      position: absolute;
      left: 0.125rem;
      top: 0.125rem;
      height: 1.25rem;
      width: 1.25rem;
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 1px 2px rgba(15, 16, 20, 0.16);
      transition: transform 0.2s ease;
    }
    .setting-row .peer:checked ~ .public-switch { background: var(--accent); }
    .setting-row .peer:checked ~ .public-switch::after { transform: translateX(1.25rem); }
    .setting-row .peer:focus-visible ~ .public-switch {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    .public-panel {
      border: 1px solid var(--border);
      border-radius: 1rem;
      background: var(--surface-2);
      padding: 1rem;
    }
    @media (min-width: 640px) { .public-panel { padding: 1.25rem; } }
    .public-list { display: grid; gap: 0.75rem; }
    .public-card {
      display: grid;
      gap: 0.6rem;
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 0.9rem;
      background: var(--surface);
      padding: 0.9rem 1rem 1rem;
    }
    @media (min-width: 768px) {
      .public-card { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; column-gap: 1rem; }
      .public-card > .field-help { grid-column: 1; }
      .public-card > .public-toggle { grid-column: 2; grid-row: 1 / span 2; }
    }
    .public-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .public-toggle { margin: 0; }
    .public-toggle-copy { min-width: 0; }
    .public-help { min-height: 0; }

    /* ---- Review ---- */
    .review-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .req-pill {
      display: inline-flex;
      border-radius: 999px;
      padding: 0.12rem 0.45rem;
      background: var(--accent-soft);
      color: var(--text);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .review-preview {
      border: 1px solid var(--border);
      border-radius: 0.85rem;
      background: var(--surface-2);
      padding: 0.9rem;
    }
    .review-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .review-actions .btn:focus-visible,
    .review-check input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    .review-checklist {
      display: grid;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .review-checklist li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      min-height: 44px;
      border-radius: 0.75rem;
      padding: 0.35rem 0.7rem;
      background: var(--surface-2);
    }
    .review-checklist a {
      color: var(--text);
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .check-state {
      flex: none;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .review-checklist li[data-state='needed'] .check-state { color: var(--text-mute); }
    .review-checklist li[data-state='ready'] .check-state { color: var(--accent); }
    .review-checklist li[data-state='needed'] .check-state::before { content: '○ '; }
    .review-checklist li[data-state='ready'] .check-state::before { content: '✓ '; }
    .review-check {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      min-height: 44px;
      cursor: pointer;
      color: var(--text-soft);
      font-size: 0.8125rem;
      line-height: 1.45;
    }
    .review-publish { border-color: var(--border-strong); }
    .review-actions .btn { min-height: 44px; }
    .review-actions .btn-primary { flex: 1 1 16rem; }
    .review-missing {
      border-radius: 0.75rem;
      padding: 0.65rem 0.8rem;
      background: rgba(159, 45, 45, 0.1);
      color: #9f2d2d;
      font-size: 0.8125rem;
      font-weight: 650;
    }
    .form-status:not(.hidden) { animation: status-in 0.18s ease; }
    @keyframes status-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: none; }
    }

    /* ---- Step navigation (pills on small screens, vertical stepper in the rail) ---- */
    .form-jump {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      counter-reset: step;
    }
    .form-jump a {
      display: inline-flex;
      min-height: 40px;
      align-items: center;
      gap: 0.45rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.2rem 0.8rem 0.2rem 0.45rem;
      background: var(--surface);
      color: var(--text-soft);
      font-size: 0.78rem;
      font-weight: 500;
      transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
    }
    .form-jump a::before {
      counter-increment: step;
      content: counter(step);
      display: inline-flex; align-items: center; justify-content: center;
      width: 1.35rem; height: 1.35rem; border-radius: 999px;
      background: var(--surface-2); border: 1px solid var(--border-strong);
      font-size: 0.68rem; font-weight: 600; color: var(--text-soft);
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .form-jump a[data-complete='true']::before {
      content: '✓';
      background: var(--accent); border-color: var(--accent); color: var(--accent-ink);
      animation: step-done 0.28s ease;
    }
    @keyframes step-done {
      from { transform: scale(0.6); }
      60% { transform: scale(1.12); }
      to { transform: none; }
    }
    .form-jump a[aria-current='step'] {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--text);
      font-weight: 600;
    }
    .form-jump a:hover { border-color: var(--accent); color: var(--text); }
    .form-jump a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* ---- Disclosures ---- */
    details.disclose {
      border: 1px solid var(--border);
      border-radius: 1rem;
      background: var(--surface-2);
      padding: 0.85rem 1rem;
    }
    details.disclose > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      min-height: 44px;
      cursor: pointer;
      list-style: none;
    }
    details.disclose > summary::-webkit-details-marker { display: none; }
    details.disclose > summary::after {
      content: '';
      width: 0.45rem;
      height: 0.45rem;
      flex: none;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-2px);
    }
    details.disclose[open] > summary::after { transform: rotate(225deg) translateY(-1px); }
    details.disclose > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 0.5rem; }

    /* ---- Status + buttons ---- */
    .form-status {
      border-radius: 0.85rem;
      padding: 0.75rem 0.9rem;
      font-size: 0.875rem;
      font-weight: 650;
    }
    .form-status.is-error { background: rgba(159, 45, 45, 0.1); color: #9f2d2d; }
    .form-status.is-ok { background: var(--surface-2); color: var(--text); }
    .btn:disabled { cursor: not-allowed; opacity: 0.72; }
    .btn[aria-busy='true'] { cursor: progress; }

    @media (prefers-reduced-motion: reduce) {
      .choice-pill,
      .choice-mark,
      .type-card,
      .type-icon,
      .public-switch,
      .public-switch::after,
      .form-status,
      .form-jump a,
      .form-jump a::before,
      details.disclose > summary::after {
        transition: none;
        animation: none;
      }
    }
  </style>
</BaseLayout>
