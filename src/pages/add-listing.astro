---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { INDUSTRIES } from '@/data/industries';
import { DENOMINATIONS } from '@/data/denominations';
import { ATTESTATION } from '@/lib/trustCopy';

const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success') === '1';
const slug = Astro.url.searchParams.get('slug');
const thisYear = new Date().getFullYear();

const popularDenominations = [
  { slug: 'non-denominational', name: 'Non-Denominational' },
  { slug: 'baptist', name: 'Baptist' },
  { slug: 'lutheran', name: 'Lutheran' },
  { slug: 'reformed-presbyterian', name: 'Presbyterian & Reformed' },
  { slug: 'methodist-wesleyan', name: 'Methodist & Wesleyan' },
  { slug: 'pentecostal-charismatic', name: 'Pentecostal & Charismatic' },
  { slug: 'anglican-episcopal', name: 'Anglican & Episcopal' },
  { slug: 'catholic', name: 'Catholic' },
  { slug: 'eastern-orthodox', name: 'Eastern Orthodox' },
  { slug: 'evangelical', name: 'Evangelical Free' },
  { slug: 'anabaptist', name: 'Anabaptist & Mennonite' },
  { slug: 'restorationist', name: 'Churches of Christ' },
  { slug: 'interdenominational', name: 'Interdenominational' },
  { slug: 'other', name: 'Other (specify custom denomination)' },
];

const allOtherDenominations = [...DENOMINATIONS]
  .filter((d) => !popularDenominations.some((p) => p.slug === d.slug))
  .sort((a, b) => a.name.localeCompare(b.name));

// Full denomination catalog for the searchable typeahead.
const denominationOptions = [
  ...popularDenominations.map((d) => ({ slug: d.slug, name: d.name })),
  ...allOtherDenominations.map((d) => ({ slug: d.slug, name: d.name })),
];

// Primary listing types shown as cards in Section 1.
const PRIMARY_TYPES = [
  { slug: 'business', label: 'Business', description: 'Christian-owned company, shop, or service provider' },
  { slug: 'church', label: 'Church', description: 'Local congregation — services, small groups, pastoral care' },
  { slug: 'ministry', label: 'Ministry', description: 'Parachurch outreach, missions, discipleship, media' },
  { slug: 'nonprofit', label: 'Nonprofit', description: 'Faith-based charity or community organization' },
  { slug: 'school', label: 'School', description: 'Christian school, college, seminary, or homeschool co-op' },
  { slug: 'event', label: 'Event', description: 'Conference, retreat, concert, camp, or gathering' },
  { slug: 'other', label: 'Other', description: 'Association, network, or other faith-aligned org' },
];

// Type → allowed industries. The `other` type exposes every industry.
const TYPE_CATEGORY_MAP = {
  business: [
    'food-beverage',
    'healthcare-wellness',
    'construction-skilled-trades',
    'professional-business-services',
    'retail-consumer',
    'arts-media-entertainment',
    'travel-hospitality',
    'other-industries',
  ],
  church: ['religious-organizations'],
  ministry: ['religious-organizations'],
  nonprofit: ['nonprofit-civic', 'other-industries'],
  school: ['education'],
  event: ['arts-media-entertainment', 'travel-hospitality', 'sports-recreation', 'other-industries'],
  other: INDUSTRIES.map((industry) => industry.slug),
};

// Optional per-industry category allow-lists within an allowed industry.
const TYPE_CATEGORY_FILTER = {
  church: {
    'religious-organizations': ['churches', 'ministry', 'other-religious'],
  },
  ministry: {
    'religious-organizations': ['churches', 'ministry', 'other-religious'],
  },
  nonprofit: {
    'nonprofit-civic': ['charity', 'community-outreach', 'youth-family', 'other-nonprofit'],
  },
  event: {
    'arts-media-entertainment': ['music', 'photography', 'videography'],
    'travel-hospitality': ['venues', 'event-services'],
    'sports-recreation': ['outdoor-recreation', 'coaching'],
    'other-industries': ['other-business'],
  },
};

// Slim industry payload for the client (professions are not needed on this page).
const industries = INDUSTRIES.map((ind) => ({
  slug: ind.slug,
  name: ind.name,
  categories: ind.categories.map((c) => ({ slug: c.slug, name: c.name })),
}));

// Organization-basics selects (labels match the server-side validation enums).
const SIZE_OPTIONS = ['Solo (just me)', '2–10', '11–50', '51–200', '201–500', '500+'];
const OWNERSHIP_OPTIONS = [
  'Privately owned',
  'Family-owned',
  'Partnership',
  'Corporation',
  'Cooperative',
  'Nonprofit / ministry-run',
  'Government / public',
];
const HOURS_OPTIONS = [
  { value: 'standard', label: 'Standard — Mon–Fri, 9a–5p' },
  { value: 'extended', label: 'Extended — evenings & Saturdays' },
  { value: 'weekends', label: 'Weekends only' },
  { value: 'appointment', label: 'By appointment only' },
  { value: 'always', label: 'Open 24 hours, every day' },
  { value: 'vary', label: 'Hours vary — contact us' },
];
const CONTACT_PREF_OPTIONS = ['Email', 'Phone call', 'Text message', 'Any is fine'];
---
<BaseLayout user={user} seo={{ title: 'List Your Business — Free Directory Listing | CrossLinkd', description: 'Submit an owner-submitted listing for your business, church, ministry, or practice. CrossLinkd does not independently verify faith, ownership, licenses, or service quality.', path: '/add-listing' }}>
  <div class="mx-auto max-w-5xl px-4 py-8 pb-32" data-motion="static">
    <h1 class="text-3xl font-extrabold tracking-tight">List your business</h1>
    <p class="section-sub">Free to list. Your profile is owner-submitted. Publishing it does not verify faith, ownership, licenses, or service quality. Fields marked * are required. Everything else can wait.</p>
    <details class="disclose mt-4">
      <summary>What a listing does not confirm</summary>
      <p class="mt-2 text-sm leading-relaxed" style="color:var(--text-soft)">CrossLinkd is a community directory. Business owners submit information about their business and may identify it as Christian-owned. CrossLinkd reviews submissions for completeness and obvious inconsistencies but does not independently verify faith, ownership, licenses, certifications, credentials, or service quality. Please perform your own due diligence before hiring or supporting a listed organization.</p>
    </details>
    <nav class="form-jump mt-4" aria-label="Form sections">
      <a href="#section-basics">Basics</a>
      <a href="#section-category">Category</a>
      <a href="#section-faith">Faith</a>
      <a href="#section-contact">Contact</a>
      <a href="#section-review">Review</a>
    </nav>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card p-4 text-sm leading-relaxed" style="color:var(--text-soft)"><strong style="color:var(--text)">Required.</strong> Organization type, listing name, and the accuracy attestation. No identity documents, licenses, or private religious records.</div>
      <div class="card p-4 text-sm leading-relaxed" style="color:var(--text-soft)"><strong style="color:var(--text)">Public.</strong> Only the contact fields you turn on appear on the profile. A faith statement is optional and self-reported.</div>
      <div class="card p-4 text-sm leading-relaxed" style="color:var(--text-soft)"><strong style="color:var(--text)">Review.</strong> A complete form may publish as owner-submitted. Missing required fields are not published. A completeness check is not a license or faith check.</div>
      <div class="card p-4 text-sm leading-relaxed" style="color:var(--text-soft)"><strong style="color:var(--text)">Afterward.</strong> Claim the listing to edit it. <a href="/contact?topic=correction" class="underline">Request a correction</a> or <a href="/contact?topic=removal" class="underline">removal</a>. A listing is not an endorsement.</div>
    </div>
    <p class="mt-3 text-sm font-semibold">Free forever for the basic listing. No credit card required.</p>

    {success ? (
      <div class="card mt-6 border-l-4 p-6" style="border-left-color:var(--teal)" role="status">
        <h2 class="text-lg font-extrabold">Your listing is now live</h2>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">It is published as an owner-submitted listing. That is not a verification of faith, ownership, licenses, credentials, or service quality.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {slug && <a href={`/directory/${slug}`} class="btn btn-primary">View public listing</a>}
          {user ? <a href="/dashboard/listings" class="btn btn-secondary">Manage your listings</a> : <a href="/auth/signup" class="btn btn-secondary">Create account to manage listing</a>}
        </div>
      </div>
    ) : (
      <form method="POST" action="/api/listings" class="card mt-6 space-y-8 p-5 sm:p-8" id="add-listing-form" data-motion="static">
        <p class="hp-field" aria-hidden="true"><label>Leave this blank<input type="text" name="hp_company" tabindex="-1" autocomplete="off" /></label></p>
        {error && <p class="rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-600" role="alert">{error}</p>}
        <p id="form-status" class="form-status hidden" role="status" aria-live="polite"></p>
        {!user && <p class="rounded-xl p-3 text-sm" style="background:rgba(216,149,34,.12)">You’re creating a listing as a guest. Add a contact email before publishing. <a href="/auth/signup" class="font-bold underline">Create a free account</a> to edit and manage this listing later.</p>}

        <!-- Section 1: Organization Basics -->
        <section id="section-basics" aria-labelledby="section-basics-heading" class="form-section pt-1">
          <div class="flex items-baseline gap-3">
            <span class="section-num" aria-hidden="true">01</span>
            <div>
              <h2 id="section-basics-heading" class="text-lg font-extrabold leading-tight">Organization basics</h2>
            </div>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Listing type — what you're offering or listing. Choose it first: it shapes which industry categories you can pick next.</p>

          <fieldset class="mt-5 border-0 p-0">
            <legend class="text-sm font-semibold">What best describes you? <span class="req" aria-hidden="true">*</span><span class="sr-only"> required</span></legend>
            <p class="mt-0.5 text-xs" style="color:var(--text-mute)">Select the type that best fits — this filters categories to only relevant options.</p>
            <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
              {PRIMARY_TYPES.map((t) => (
                <button
                  type="button"
                  class="type-card flex flex-col rounded-xl border p-3 text-left transition-all focus:outline-none focus:ring-2 hover:border-[var(--accent)]"
                  style="border-color:var(--border); background:var(--surface)"
                  data-type={t.slug}
                  data-selected="false"
                  aria-pressed="false"
                >
                  <span class="flex items-center justify-between gap-2">
                    <span class="font-bold text-sm">{t.label}</span>
                    <span class="type-check" aria-hidden="true">✓</span>
                  </span>
                  <span class="mt-0.5 text-xs" style="color:var(--text-mute)">{t.description}</span>
                </button>
              ))}
            </div>
            <input type="hidden" name="typeSlug" id="input-type-slug" value="" />
            <p id="listing-type-error" class="mt-1.5 hidden text-xs font-semibold text-red-600" role="alert">Please select an organization type.</p>
          </fieldset>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <label class="text-sm font-semibold" for="input-name">Listing name <span class="req" aria-hidden="true">*</span><span class="sr-only"> required</span>
              <input name="name" id="input-name" required minlength="2" maxlength="240" class="input mt-1.5" placeholder="Grace Community Church" aria-required="true" />
            </label>
            <label class="text-sm font-semibold">Tagline <span class="opt">Optional</span>
              <input name="tagline" maxlength="280" class="input mt-1.5" placeholder="Brief summary of what your business does" />
            </label>
          </div>

          <label class="mt-4 block text-sm font-semibold">Description <span class="opt">Optional</span>
            <textarea name="description" rows="4" maxlength="8000" class="input mt-1.5" placeholder="Describe what your business offers, who you serve, and what makes your business distinct..."></textarea>
            <span class="mt-1 block text-xs" style="color:var(--text-mute)">Shown on your public profile — a sentence or two about what you do and who you serve.</span>
          </label>

          <details class="disclose org-card mt-5" data-open-if>
            <summary>
              <span>
                <span class="block text-sm font-extrabold">About your organization</span>
                <span class="mt-0.5 block text-xs font-medium" style="color:var(--text-mute)">Optional. Year, size, hours, service area, and price.</span>
              </span>
              <span class="opt">Optional</span>
            </summary>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <label class="text-sm font-semibold">Year founded
                <input name="yearFounded" type="number" inputmode="numeric" min="1800" max={thisYear} class="input mt-1.5" placeholder="e.g. 1998" />
              </label>
              <label class="text-sm font-semibold">Organization size
                <select name="employeeCount" class="input mt-1.5">
                  <option value="">Select size (optional)</option>
                  {SIZE_OPTIONS.map((s) => <option value={s}>{s}</option>)}
                </select>
              </label>
              <label class="text-sm font-semibold">Ownership type
                <select name="ownershipType" class="input mt-1.5">
                  <option value="">Select ownership (optional)</option>
                  {OWNERSHIP_OPTIONS.map((o) => <option value={o}>{o}</option>)}
                </select>
              </label>
              <label class="text-sm font-semibold">Operating hours
                <select name="hours" class="input mt-1.5">
                  <option value="">Select typical hours (optional)</option>
                  {HOURS_OPTIONS.map((h) => <option value={h.value}>{h.label}</option>)}
                </select>
              </label>
              <label class="text-sm font-semibold">Service area <span class="opt">Optional</span>
                <input name="serviceArea" maxlength="300" class="input mt-1.5" placeholder="e.g. Austin metro; delivery within 25 miles" />
                <span class="mt-1 block text-xs" style="color:var(--text-mute)">Cities, counties, or regions you serve.</span>
              </label>
              <label class="text-sm font-semibold">Price range <span class="opt">Optional</span>
                <select name="priceRange" class="input mt-1.5 block w-full">
                  <option value="">Select price range</option>
                  <option value="$">$ (Inexpensive / Budget-friendly)</option>
                  <option value="$$">$$ (Moderate / Standard)</option>
                  <option value="$$$">$$$ (Upscale / Premium)</option>
                  <option value="$$$$">$$$$ (High-end / Specialized)</option>
                </select>
                <span class="mt-1 block text-xs" style="color:var(--text-mute)">Used for price-based filtering across the directory.</span>
              </label>
            </div>
          </details>
        </section>

        <!-- Section 2: Category (type-filtered, single searchable picker) -->
        <section id="section-category" aria-labelledby="section-category-heading" class="form-section border-t pt-7" style="border-color:var(--border)">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-baseline gap-3">
              <span class="section-num" aria-hidden="true">02</span>
              <div>
                <h2 id="section-category-heading" class="text-lg font-extrabold leading-tight">Industry &amp; business category</h2>
              </div>
            </div>
            <span id="category-type-context" class="chip hidden !text-[11px]"></span>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Where your listing belongs in the directory taxonomy — pick the most specific industry and category that describe it. This is separate from your listing type: the two work together, with options filtered to match the type selected above.</p>

          <!-- Hidden inputs for submission -->
          <input type="hidden" name="industrySlug" id="input-industry-slug" value="" />
          <input type="hidden" name="categorySlug" id="input-category-slug" value="" />

          <!-- Single searchable category picker (filtered by selected type) -->
          <div class="mt-4">
            <label for="category-search-input" class="text-sm font-semibold">Search &amp; pick a category</label>
            <p id="category-filter-help" class="mt-0.5 text-xs" style="color:var(--text-mute)">Please select an organization type first.</p>
            <div class="relative mt-2">
              <input
                type="search"
                id="category-search-input"
                class="input w-full !pl-9"
                placeholder="Search categories (e.g. Bakery, Plumbing, Roofing, Dental, Counseling)..."
                autocomplete="off"
                aria-describedby="category-filter-help"
              />
              <svg class="absolute left-3 top-3 h-4 w-4 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <div id="category-search-results" class="hidden absolute left-0 right-0 top-full z-20 mt-1.5 max-h-[260px] overflow-y-auto rounded-xl border bg-[var(--surface)] shadow-lg" style="border-color:var(--border)"></div>
            </div>
            <div id="category-filter-status" class="mt-1.5 hidden text-xs font-semibold" style="color:var(--teal)" aria-live="polite"></div>
          </div>

          <!-- Selected category chip -->
          <div id="category-chips-primary" class="hidden mt-3 flex flex-wrap items-center gap-2">
            <span class="chip !text-[11px] font-bold" style="border-color:var(--teal); color:var(--teal)">
              <span id="category-chip-text"></span>
              <button type="button" id="category-chip-clear" class="ml-1.5 hover:opacity-75 focus:outline-none" aria-label="Clear selected category">✕</button>
            </span>
          </div>

          <!-- Custom Category Input when 'Other' category is chosen -->
          <div id="custom-category-wrap" class="hidden mt-3 rounded-xl p-3.5 border border-[var(--border)] bg-[var(--surface-2)]">
            <label class="block text-xs font-semibold">Custom category name *
              <input name="customCategory" id="input-custom-category" class="input mt-1.5 w-full" placeholder="e.g. Specialty Gluten-Free Bakery, Stained Glass Restoration, etc." maxlength="180" />
            </label>
            <p class="text-[11px] mt-1" style="color:var(--text-mute)">Please specify your business's exact trade or service.</p>
          </div>

          <p id="category-type-warning" class="mt-3 hidden rounded-xl border border-amber-300 bg-amber-50 p-3 text-xs font-semibold text-amber-800" role="status">Category cleared — it doesn't match the new organization type. Please select a new category.</p>
        </section>

        <!-- Section 3: Faith Identity -->
        <section id="section-faith" aria-labelledby="section-faith-heading" class="form-section border-t pt-7" style="border-color:var(--border)">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-baseline gap-3">
              <span class="section-num" aria-hidden="true">03</span>
              <div>
                <h2 id="section-faith-heading" class="text-lg font-extrabold leading-tight">Faith identity &amp; denomination</h2>
              </div>
            </div>
            <span id="denom-counter" class="chip !text-[11px]">0 of 2 selected</span>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Select up to two denominations that best represent this organization.</p>

          <!-- Active Selection Chips Display -->
          <div id="denom-chips-container" class="mt-4 flex flex-wrap items-center gap-2 min-h-[38px] p-2.5 rounded-xl border border-dashed border-[var(--border)] bg-[var(--surface-2)]">
            <span id="denom-empty-hint" class="text-xs" style="color:var(--text-mute)">No denominations selected yet. Choose up to two below.</span>
          </div>

          <!-- Hidden inputs for multi-denomination form submission -->
          <div id="denom-hidden-inputs"></div>

          <!-- Selection Controls: searchable denomination typeahead (same interaction as the category search) -->
          <div class="mt-4">
            <label for="denom-search-input" class="text-sm font-semibold">Search denominations</label>
            <div class="relative mt-2">
              <input
                type="search"
                id="denom-search-input"
                class="input w-full !pl-9"
                placeholder="Search denominations (e.g. Baptist, Methodist, Non-Denominational)..."
                autocomplete="off"
                aria-describedby="denom-search-help"
              />
              <svg class="absolute left-3 top-3 h-4 w-4 text-[var(--text-mute)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <div id="denom-search-results" class="hidden absolute left-0 right-0 top-full z-20 mt-1.5 max-h-[260px] overflow-y-auto rounded-xl border bg-[var(--surface)] shadow-lg" style="border-color:var(--border)"></div>
            </div>
            <p id="denom-search-help" class="mt-1.5 text-xs" style="color:var(--text-mute)">Type to filter denominations, then click to add — up to two. Pick "Other (specify custom denomination)" to enter your own.</p>
          </div>

          <!-- Custom Denomination Input when 'Other' is chosen -->
          <div id="custom-denom-wrap" class="hidden mt-3 rounded-xl p-3 border border-[var(--border)] bg-[var(--surface-2)]">
            <label class="block text-xs font-semibold">Custom denomination or movement name *
              <input
                name="customDenomination"
                id="custom-denom-input"
                class="input mt-1.5 w-full"
                placeholder="e.g. Calvary Chapel, Vineyard Movement, Independent Baptist..."
                maxlength="180"
              />
            </label>
          </div>

          <label class="mt-4 flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer">
            <input type="checkbox" name="showDenomination" value="1" checked class="peer sr-only" />
            <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
            <span>Display faith affiliation publicly on listing</span>
            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
            <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
          </label>
          <p class="mt-0.5 text-xs" style="color:var(--text-mute)">When unchecked, your denomination is stored privately and will not appear on your public listing.</p>

          <details class="disclose mt-5" data-open-if>
            <summary>
              <span class="text-sm font-extrabold">Statement of faith</span>
              <span class="opt">Optional</span>
            </summary>
            <label class="mt-3 block text-sm font-semibold" for="input-statement">Shown on your profile if you add one
              <textarea name="statementOfFaith" id="input-statement" rows="3" maxlength="8000" class="input mt-1.5" placeholder="Brief statement of faith, mission, or Christian core values..."></textarea>
            </label>
          </details>
        </section>

        <!-- Section 4: Contact and Visibility -->
        <section id="section-contact" aria-labelledby="section-contact-heading" class="form-section border-t pt-7" style="border-color:var(--border)">
          <div class="flex items-baseline gap-3">
            <span class="section-num" aria-hidden="true">04</span>
            <div>
              <h2 id="section-contact-heading" class="text-lg font-extrabold leading-tight">Contact and visibility</h2>
            </div>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Choose exactly which contact details appear publicly on your listing profile.</p>

          <div class="card mt-4 p-3.5 text-xs leading-relaxed" style="background:var(--surface-2);color:var(--text-soft)">
            <strong>Privacy note:</strong> Information you keep private is used for account administration and listing review. Private fields are not shown on public cards or in search. Keeping a field private is not a verification of that field.
          </div>

          <label class="mt-4 block text-sm font-semibold">Preferred contact method <span class="opt">Optional</span>
            <select name="contactPreference" class="input mt-1.5 block w-full">
              <option value="">Select preference</option>
              {CONTACT_PREF_OPTIONS.map((c) => <option value={c}>{c}</option>)}
            </select>
            <span class="mt-1.5 block text-xs" style="color:var(--text-mute)">How you'd rather receive inquiries through the directory.</span>
          </label>

          <div class="control-grid mt-4">
            <article class="control-card">
              <fieldset class="control-fieldset">
                <legend class="control-title">Is this company hiring?</legend>
                <div class="control-row">
                  <div class="choice-group">
                    <label class="choice-pill" for="input-hiring-no">
                      <input type="radio" name="isHiring" value="0" id="input-hiring-no" checked class="sr-only" />
                      <span class="choice-mark" aria-hidden="true"></span>
                      <span class="choice-copy">No</span>
                    </label>
                    <label class="choice-pill" for="input-hiring-yes">
                      <input type="radio" name="isHiring" value="1" id="input-hiring-yes" class="sr-only" />
                      <span class="choice-mark" aria-hidden="true"></span>
                      <span class="choice-copy">Yes</span>
                    </label>
                  </div>
                </div>
                <p class="control-help">Choose Yes only if this organization is currently hiring. The default is No.</p>
              </fieldset>
            </article>

            <article id="online-toggle-wrap" class="control-card" data-online="off">
              <fieldset class="control-fieldset">
                <legend class="control-title">Is this an online-only listing?</legend>
                <div class="control-row">
                  <div class="choice-group">
                    <label class="choice-pill" id="online-off-label" for="input-online-off" data-active="true">
                      <input type="radio" name="isOnlineOnly" value="0" id="input-online-off" checked class="sr-only" aria-describedby="online-state-text" />
                      <span class="choice-mark" aria-hidden="true"></span>
                      <span class="choice-copy">In-person</span>
                    </label>
                    <label class="choice-pill" id="online-on-label" for="input-online" data-active="false">
                      <input type="radio" name="isOnlineOnly" value="1" id="input-online" class="sr-only" aria-describedby="online-state-text" />
                      <span class="choice-mark" aria-hidden="true"></span>
                      <span class="choice-copy">Online-only</span>
                    </label>
                  </div>
                </div>
                <p id="online-state-text" class="control-help" aria-live="polite">This listing is for in-person services.</p>
              </fieldset>
            </article>
          </div>

          <div id="careers-url-field" class="control-card careers-card mt-4" hidden>
            <label for="input-careers-url" class="control-label">Where can people view open positions? <span class="opt">Optional</span>
              <input id="input-careers-url" name="careersUrl" type="text" inputmode="url" autocomplete="url" maxlength="2000" class="input mt-1.5" placeholder="https://example.com/careers" aria-describedby="careers-url-help careers-url-error" />
            </label>
            <p id="careers-url-help" class="control-help">Add a careers page or job-listing link. This is optional, even if hiring is set to Yes.</p>
            <p id="careers-url-error" class="mt-1.5 text-xs font-semibold text-red-600" role="alert" hidden>Enter a valid http:// or https:// URL.</p>
          </div>

          <!-- Physical Location -->
          <div id="location-fields" class="mt-4 space-y-2">
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="text-sm font-semibold">City
                <input name="city" id="input-city" maxlength="120" class="input mt-1.5" placeholder="Enter city" />
              </label>
              <label class="text-sm font-semibold">State / region
                <input name="region" id="input-region" maxlength="120" class="input mt-1.5" placeholder="Enter state or region" />
              </label>
              <label class="text-sm font-semibold">ZIP / Postal code
                <input name="postalCode" maxlength="24" class="input mt-1.5" placeholder="Enter postal code" />
              </label>
            </div>

            <label class="flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer pt-1">
              <input type="checkbox" name="showAddress" value="1" class="peer sr-only" />
              <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
              <span>Display postal code / full address publicly on listing</span>
              <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
              <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
            </label>
            <p class="text-xs" style="color:var(--text-mute)">When unchecked, only your general city and state are displayed; specific postal codes remain private.</p>
          </div>
          <p id="location-disabled-note" class="hidden mt-3 rounded-xl border p-3 text-xs font-semibold" style="border-color:var(--border); background:var(--surface-2); color:var(--text-soft)">Location fields are hidden for online-only listings — you serve customers nationwide.</p>

          <div class="mt-5 rounded-2xl border p-4 sm:p-5" style="border-color:var(--border); background:var(--surface-2)">
            <h3 class="text-sm font-extrabold">What the public sees</h3>
            <p class="mt-1 text-xs" style="color:var(--text-mute)">Each detail stays private until you switch its toggle on.</p>
            <div class="public-grid mt-4">
              <article class="public-card">
                <label class="public-label">Website URL
                  <input name="website" type="url" class="input mt-1.5" placeholder="https://yourbusiness.com" />
                </label>
                <label class="public-toggle">
                  <input type="checkbox" name="showWebsite" value="1" class="peer sr-only" />
                  <span class="public-switch" aria-hidden="true"></span>
                  <span class="public-toggle-copy">Display website publicly on listing</span>
                  <span class="public-badge public-badge-off">Off</span>
                  <span class="public-badge public-badge-on">On</span>
                </label>
                <p class="public-help">When checked, a direct "Website" link will appear on your public profile.</p>
              </article>
              <article class="public-card">
                <label class="public-label">Phone number
                  <input name="phone" maxlength="60" class="input mt-1.5" placeholder="Enter phone number" />
                </label>
                <label class="public-toggle">
                  <input type="checkbox" name="showPhone" value="1" class="peer sr-only" />
                  <span class="public-switch" aria-hidden="true"></span>
                  <span class="public-toggle-copy">Display phone number publicly on listing</span>
                  <span class="public-badge public-badge-off">Off</span>
                  <span class="public-badge public-badge-on">On</span>
                </label>
                <p class="public-help">When unchecked, the phone number is stored for listing administration and is not shown to the public. Storing it does not confirm the number.</p>
              </article>
              <article class="public-card">
                <label class="public-label">Contact email
                  <input
                    name="email"
                    type="email"
                    class="input mt-1.5"
                    placeholder="contact@yourbusiness.com"
                    value={user?.email ?? ''}
                  />
                </label>
                <label class="public-toggle">
                  <input type="checkbox" name="showEmail" value="1" class="peer sr-only" />
                  <span class="public-switch" aria-hidden="true"></span>
                  <span class="public-toggle-copy">Display email address publicly on listing</span>
                  <span class="public-badge public-badge-off">Off</span>
                  <span class="public-badge public-badge-on">On</span>
                </label>
                <p class="public-help">
                  When unchecked, your email is kept strictly private. Prospective clients can still reach you securely using our on-site inquiry form without seeing your email address.
                  {user?.email && <span class="public-note">Account email: <strong>{user.email}</strong>. Pre-filled for your convenience; feel free to change it to your organization's inquiry address.</span>}
                </p>
              </article>
            </div>
          </div>
        </section>

        <section id="section-review" aria-labelledby="section-review-heading" class="form-section border-t pt-7" style="border-color:var(--border)">
          <div class="flex items-baseline gap-3">
            <span class="section-num" aria-hidden="true">05</span>
            <div>
              <h2 id="section-review-heading" class="text-lg font-extrabold leading-tight">Review and publish</h2>
            </div>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">Check the summary, confirm the required statements, then publish. Publishing creates an owner-submitted listing. It does not verify faith, ownership, licenses, credentials, or service quality.</p>

          <div class="review-layout mt-5">
            <article class="review-card" aria-labelledby="review-summary-heading">
              <div class="review-card-head">
                <h3 id="review-summary-heading" class="text-sm font-extrabold">Listing summary</h3>
                <span class="opt">Preview</span>
              </div>
              <p class="text-xs leading-relaxed" style="color:var(--text-soft)">Preview only. A published profile is labeled Owner-submitted. That is not a verification.</p>
              <div id="live-preview" class="review-preview">
                <div class="flex items-start gap-4">
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border text-[10px] font-bold uppercase tracking-wide" style="border-color:var(--border); background:var(--surface-2); color:var(--text-mute)">Logo</div>
                  <div class="min-w-0">
                    <p id="preview-name" class="truncate font-extrabold" style="color:var(--text-mute)">Your listing name</p>
                    <p id="preview-type" class="mt-0.5 text-xs font-semibold" style="color:var(--text-mute)">No type selected yet</p>
                    <p id="preview-category" class="mt-0.5 text-xs" style="color:var(--text-soft)">No category selected</p>
                    <p id="preview-location" class="mt-0.5 text-xs" style="color:var(--text-mute)">Location not set</p>
                  </div>
                </div>
              </div>
              <div class="review-links">
                <a href="#section-basics">Edit basics</a>
                <a href="#section-category">Edit category</a>
                <a href="#section-faith">Edit faith</a>
                <a href="#section-contact">Edit contact</a>
              </div>
            </article>

            <article class="review-card" aria-labelledby="review-required-heading">
              <div class="review-card-head">
                <h3 id="review-required-heading" class="text-sm font-extrabold">Required before publishing</h3>
                <span class="req-pill">Required</span>
              </div>
              <ul id="review-checklist" class="review-checklist">
                <li data-check="type" data-state="needed"><a href="#section-basics">Organization type</a><span class="check-state">Needed</span></li>
                <li data-check="name" data-state="needed"><a href="#input-name">Listing name</a><span class="check-state">Needed</span></li>
                <li data-check="attestation" data-state="needed"><a href="#input-attestation">Accuracy confirmation</a><span class="check-state">Needed</span></li>
                <li data-check="terms" data-state="needed"><a href="#input-terms">Terms agreement</a><span class="check-state">Needed</span></li>
              </ul>
              <label class="review-check" for="input-attestation">
                <input type="checkbox" name="attestation" id="input-attestation" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--accent)]" />
                <span>{ATTESTATION}</span>
              </label>
              <label class="review-check" for="input-terms">
                <input type="checkbox" name="terms" id="input-terms" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--accent)]" />
                <span>I am authorized to list this organization, and I agree to the <a href="/terms" class="underline">Terms of Service</a> and <a href="/guidelines" class="underline">Community Guidelines</a>.</span>
              </label>
            </article>
          </div>

          <details class="disclose mt-4" data-open-if>
            <summary>
              <span class="text-sm font-extrabold">Discovery tags</span>
              <span class="opt">Optional</span>
            </summary>
            <label class="mt-3 block text-sm font-semibold">Hashtags <span class="opt">Optional</span>
              <input name="hashtags" class="input mt-1.5" placeholder="e.g. ChristianOwned, FamilyOwned, VeteranOwned" />
              <span class="mt-1 block text-xs font-medium" style="color:var(--text-mute)">Comma-separated. These help search. They are not a verification.</span>
            </label>
          </details>

          <article class="review-card review-publish mt-4" aria-labelledby="review-publish-heading">
            <div class="review-card-head">
              <h3 id="review-publish-heading" class="text-sm font-extrabold">Publish this listing</h3>
              <span class="req-pill">Final step</span>
            </div>
            <p id="publish-help" class="text-sm leading-relaxed" style="color:var(--text-soft)">Publishing submits this form. If the required fields are valid, the listing goes live as owner-submitted. It does not start a verification, charge a fee, or endorse the organization. You can still save a draft instead.</p>
            <p id="review-missing" class="review-missing" hidden></p>
            <div class="review-actions">
              <button type="submit" id="review-publish-btn" class="btn btn-primary" data-label="Publish" aria-describedby="publish-help">Publish</button>
              <button type="button" id="review-draft-btn" class="btn btn-secondary">Save draft</button>
            </div>
            <p id="review-status" class="form-status hidden" aria-hidden="true"></p>
          </article>
        </section>
      </form>
    )}

    {!success && (
      <>
        <!-- Sticky action bar -->
        <div id="sticky-bar" class="fixed inset-x-0 bottom-0 z-40 border-t backdrop-blur" style="border-color:var(--border); background:color-mix(in srgb, var(--surface) 94%, transparent)">
          <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-[180px] flex-1">
              <div class="h-2 w-full max-w-[240px] overflow-hidden rounded-full" style="background:var(--surface-2)">
                <div id="progress-bar" class="h-2 rounded-full transition-all duration-300" style="background: var(--accent); width: 0%"></div>
              </div>
              <p id="progress-text" class="mt-1 text-xs font-semibold" style="color:var(--text-mute)" aria-live="polite">0 of 4 sections complete</p>
            </div>
            <p id="sticky-status" class="form-status hidden w-full" aria-hidden="true"></p>
            <div class="flex w-full gap-2 sm:w-auto sm:flex-wrap sm:justify-end sm:gap-2">
              <button type="button" id="save-draft-btn" class="btn btn-secondary flex-1 sm:flex-none" form="add-listing-form">Save draft</button>
              <button type="submit" id="publish-btn" class="btn btn-primary flex-1 sm:flex-none" form="add-listing-form" data-label="Publish" aria-describedby="publish-help">Publish</button>
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script define:vars={{ industries, typeCategoryMap: TYPE_CATEGORY_MAP, typeCategoryFilter: TYPE_CATEGORY_FILTER, denominations: denominationOptions }}>
    // ---------------------------------------------------------------------
    // State
    // ---------------------------------------------------------------------
    const form = document.getElementById('add-listing-form');
    const typeCards = document.querySelectorAll('.type-card');
    const inputTypeSlug = document.getElementById('input-type-slug');
    const listingTypeError = document.getElementById('listing-type-error');
    const nameInput = document.getElementById('input-name');
    const statementInput = document.getElementById('input-statement');

    const categoryHelp = document.getElementById('category-filter-help');
    const categoryStatus = document.getElementById('category-filter-status');
    const categoryWarning = document.getElementById('category-type-warning');
    const inputIndustrySlug = document.getElementById('input-industry-slug');
    const inputCategorySlug = document.getElementById('input-category-slug');
    const chipsWrap = document.getElementById('category-chips-primary');
    const chipText = document.getElementById('category-chip-text');
    const chipClear = document.getElementById('category-chip-clear');
    const customWrap = document.getElementById('custom-category-wrap');
    const inputCustomCategory = document.getElementById('input-custom-category');

    const searchInput = document.getElementById('category-search-input');
    const searchResults = document.getElementById('category-search-results');
    const denomSearchInput = document.getElementById('denom-search-input');
    const denomSearchResults = document.getElementById('denom-search-results');
    const categoryTypeContext = document.getElementById('category-type-context');

    const onlineToggle = document.getElementById('input-online');
    const locationFields = document.getElementById('location-fields');
    const locationNote = document.getElementById('location-disabled-note');
    const cityInput = document.getElementById('input-city');
    const regionInput = document.getElementById('input-region');
    const postalInput = document.querySelector('input[name="postalCode"]');

    const previewName = document.getElementById('preview-name');
    const previewType = document.getElementById('preview-type');
    const previewCategory = document.getElementById('preview-category');
    const previewLocation = document.getElementById('preview-location');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');
    const stickyBar = document.getElementById('sticky-bar');
    const saveDraftBtn = document.getElementById('save-draft-btn') as HTMLButtonElement | null;

    const flatCategories = [];
    industries.forEach((ind) => {
      (ind.categories || []).forEach((cat) => {
        flatCategories.push({ catSlug: cat.slug, catName: cat.name, indSlug: ind.slug, indName: ind.name });
      });
    });

    const typeCardsArr = Array.from(typeCards);
    let selectedType = '';
    let filteredFlatCategories = flatCategories;
    let warningTimer = null;

    const TYPE_HELPERS = {
      business: 'Showing business categories',
      church: 'Showing faith-based categories for Churches — religious organizations, community outreach, counseling.',
      ministry: 'Showing faith-based categories for Ministries — outreach, missions, discipleship, and media.',
      nonprofit: 'Showing categories for faith-based charities and community organizations.',
      school: 'Showing education categories for Christian schools, colleges, seminaries, and co-ops.',
      event: 'Showing event-friendly categories for conferences, retreats, concerts, camps, and gatherings.',
      other: 'Showing all categories — choose the industry and category that fits best.',
    };

    const STATE_ABBREV = {
      alabama: 'AL', alaska: 'AK', arizona: 'AZ', arkansas: 'AR', california: 'CA', colorado: 'CO',
      connecticut: 'CT', delaware: 'DE', 'district of columbia': 'DC', florida: 'FL', georgia: 'GA',
      hawaii: 'HI', idaho: 'ID', illinois: 'IL', indiana: 'IN', iowa: 'IA', kansas: 'KS',
      kentucky: 'KY', louisiana: 'LA', maine: 'ME', maryland: 'MD', massachusetts: 'MA', michigan: 'MI',
      minnesota: 'MN', mississippi: 'MS', missouri: 'MO', montana: 'MT', nebraska: 'NE', nevada: 'NV',
      'new hampshire': 'NH', 'new jersey': 'NJ', 'new mexico': 'NM', 'new york': 'NY', 'north carolina': 'NC',
      'north dakota': 'ND', ohio: 'OH', oklahoma: 'OK', oregon: 'OR', pennsylvania: 'PA', 'rhode island': 'RI',
      'south carolina': 'SC', 'south dakota': 'SD', tennessee: 'TN', texas: 'TX', utah: 'UT', vermont: 'VT',
      virginia: 'VA', washington: 'WA', 'west virginia': 'WV', wisconsin: 'WI', wyoming: 'WY',
    };

    // ---------------------------------------------------------------------
    // Type → category filtering helpers
    // ---------------------------------------------------------------------
    function getAllowedIndustriesForType(typeSlug) {
      if (!typeSlug) return [];
      const allowed = typeCategoryMap[typeSlug] || [];
      return industries.filter((ind) => allowed.includes(ind.slug));
    }

    function getCategoryFilterForType(typeSlug) {
      if (!typeSlug) return null;
      return typeCategoryFilter[typeSlug] || null;
    }

    function showTypeWarning() {
      if (!categoryWarning) return;
      categoryWarning.classList.remove('hidden');
      if (warningTimer) clearTimeout(warningTimer);
      warningTimer = setTimeout(() => {
        categoryWarning.classList.add('hidden');
      }, 6000);
    }

    function clearCategorySelection(showWarning) {
      if (inputIndustrySlug) inputIndustrySlug.value = '';
      if (inputCategorySlug) inputCategorySlug.value = '';
      if (chipsWrap) chipsWrap.classList.add('hidden');
      if (chipText) chipText.textContent = '';
      if (customWrap) customWrap.classList.add('hidden');
      if (inputCustomCategory) {
        inputCustomCategory.value = '';
        inputCustomCategory.required = false;
      }
      if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }
      if (showWarning) showTypeWarning();
      updatePreview();
      updateCompletion();
    }

    function applyCategorySelection(indSlug, indName, catSlug, catName) {
      if (inputIndustrySlug) inputIndustrySlug.value = indSlug;
      if (inputCategorySlug) inputCategorySlug.value = catSlug;
      if (chipText) chipText.textContent = `${indName} › ${catName}`;
      if (chipsWrap) chipsWrap.classList.remove('hidden');

      const isOther = catSlug.startsWith('other') || indSlug === 'other-industries';
      if (customWrap && inputCustomCategory) {
        if (isOther) {
          customWrap.classList.remove('hidden');
          inputCustomCategory.required = true;
        } else {
          customWrap.classList.add('hidden');
          inputCustomCategory.required = false;
          inputCustomCategory.value = '';
        }
      }
      updatePreview();
      updateCompletion();
    }

    // Recompute the type-filtered category pool (single source for the search
    // picker + helper/status/context copy). No <select> is involved.
    function rebuildCategoryPoolForType(typeSlug) {
      const previousCatSlug = inputCategorySlug ? inputCategorySlug.value : '';
      const allowedIndustries = getAllowedIndustriesForType(typeSlug);
      const catFilter = getCategoryFilterForType(typeSlug);
      const allowedSet = new Set();
      const rebuiltFlat = [];

      allowedIndustries.forEach((ind) => {
        const filterCats = catFilter && catFilter[ind.slug] ? catFilter[ind.slug] : null;
        const cats = filterCats ? ind.categories.filter((c) => filterCats.includes(c.slug)) : ind.categories.slice();
        cats.forEach((cat) => {
          allowedSet.add(cat.slug);
          rebuiltFlat.push({ catSlug: cat.slug, catName: cat.name, indSlug: ind.slug, indName: ind.name });
        });
      });

      const validType = Boolean(typeSlug) && Object.prototype.hasOwnProperty.call(typeCategoryMap, typeSlug);
      filteredFlatCategories = rebuiltFlat;

      if (validType) {
        if (categoryHelp) categoryHelp.textContent = TYPE_HELPERS[typeSlug] || 'Showing categories for this organization type.';
        if (categoryStatus) {
          categoryStatus.textContent = `${allowedSet.size} categories available for this type`;
          categoryStatus.classList.remove('hidden');
        }
        if (categoryTypeContext) {
          const typeCard = document.querySelector(`.type-card[data-type="${typeSlug}"]`);
          const typeLabel = typeCard ? typeCard.querySelector('span span')?.textContent : '';
          categoryTypeContext.textContent = typeLabel ? `For: ${typeLabel}` : 'For your listing type';
          categoryTypeContext.classList.remove('hidden');
        }
      } else {
        if (categoryHelp) categoryHelp.textContent = 'Please select an organization type first.';
        if (categoryStatus) {
          categoryStatus.textContent = '';
          categoryStatus.classList.add('hidden');
        }
        if (categoryTypeContext) categoryTypeContext.classList.add('hidden');
      }

      const stillValid = Boolean(previousCatSlug) && allowedSet.has(previousCatSlug);
      if (!stillValid) clearCategorySelection(Boolean(previousCatSlug));
      else if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }

      updatePreview();
      updateCompletion();
    }

    // ---------------------------------------------------------------------
    // Type cards
    // ---------------------------------------------------------------------
    typeCardsArr.forEach((card) => {
      card.addEventListener('click', () => {
        const nextType = card.getAttribute('data-type') || '';
        const prevType = selectedType;
        if (!nextType || nextType === prevType) return;
        selectedType = nextType;
        if (inputTypeSlug) inputTypeSlug.value = nextType;
        if (listingTypeError) listingTypeError.classList.add('hidden');
        typeCardsArr.forEach((c) => {
          const active = c === card;
          c.setAttribute('aria-pressed', String(active));
          c.setAttribute('data-selected', String(active));
        });
        rebuildCategoryPoolForType(nextType);
      });
    });

    // ---------------------------------------------------------------------
    // Category chip clear (the picker itself is a typeahead — see below)
    // ---------------------------------------------------------------------
    chipClear?.addEventListener('click', () => {
      clearCategorySelection(false);
      searchInput?.focus();
    });

    // ---------------------------------------------------------------------
    // Category search — the single category picker, type-filtered
    // ---------------------------------------------------------------------
    function renderCategoryResults(q) {
      if (!searchInput || !searchResults) return;
      searchResults.innerHTML = '';
      if (!q) {
        searchResults.classList.add('hidden');
        return;
      }
      // Use the type-filtered list once a type is selected; fall back to the
      // full list only when no type filtering is active.
      const source = selectedType ? filteredFlatCategories : flatCategories;
      const matches = source
        .filter(
          (c) =>
            c.catName.toLowerCase().includes(q) ||
            c.indName.toLowerCase().includes(q) ||
            c.catSlug.includes(q),
        )
        .slice(0, 8);
      if (!matches.length) {
        searchResults.classList.add('hidden');
        return;
      }
      matches.forEach((m) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center justify-between px-3 py-2 text-left text-xs hover:bg-[var(--surface-2)]';
        btn.style.borderBottom = '1px solid var(--border)';
        btn.setAttribute('data-slug', m.catSlug);
        btn.setAttribute('data-industry-slug', m.indSlug);
        const label = document.createElement('span');
        label.textContent = m.catName;
        const ind = document.createElement('span');
        ind.textContent = m.indName;
        ind.style.color = 'var(--text-mute)';
        btn.appendChild(label);
        btn.appendChild(ind);
        btn.addEventListener('click', () => {
          applyCategorySelection(m.indSlug, m.indName, m.catSlug, m.catName);
          searchInput.value = '';
          searchResults.innerHTML = '';
          searchResults.classList.add('hidden');
        });
        searchResults.appendChild(btn);
      });
      searchResults.classList.remove('hidden');
    }

    function setupCategorySearch() {
      if (!searchInput || !searchResults) return;
      searchInput.addEventListener('input', () => {
        renderCategoryResults(searchInput.value.toLowerCase().trim());
      });
      searchInput.addEventListener('focus', () => {
        renderCategoryResults(searchInput.value.toLowerCase().trim());
      });
      document.addEventListener('click', (e) => {
        if (searchResults.classList.contains('hidden')) return;
        if (searchInput.contains(e.target) || searchResults.contains(e.target)) return;
        searchResults.classList.add('hidden');
      });
    }
    setupCategorySearch();

    // ---------------------------------------------------------------------
    // Multi-Denomination Selector Controller (Up to 2)
    // ---------------------------------------------------------------------
    const selectedDenoms = new Map(); // slug -> name
    const chipsContainer = document.getElementById('denom-chips-container');
    const emptyHint = document.getElementById('denom-empty-hint');
    const counterBadge = document.getElementById('denom-counter');
    const hiddenInputsWrap = document.getElementById('denom-hidden-inputs');
    const customDenomWrap = document.getElementById('custom-denom-wrap');
    const customDenomInput = document.getElementById('custom-denom-input');

    function renderDenominations() {
      if (chipsContainer) {
        chipsContainer.querySelectorAll('.denom-chip').forEach((c) => c.remove());
        if (selectedDenoms.size === 0) {
          emptyHint?.classList.remove('hidden');
        } else {
          emptyHint?.classList.add('hidden');
          selectedDenoms.forEach((name, slug) => {
            const chip = document.createElement('span');
            chip.className = 'denom-chip inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border border-[var(--teal)] bg-[rgba(46,146,131,0.12)] text-[var(--teal)]';
            chip.innerHTML = `<span></span><button type="button" class="remove-chip hover:opacity-75 focus:outline-none" aria-label="Remove denomination" data-slug=""></button>`;
            chip.querySelector('span').textContent = name;
            const rm = chip.querySelector('.remove-chip');
            rm.setAttribute('aria-label', `Remove ${name}`);
            rm.setAttribute('data-slug', slug);
            rm.textContent = '✕';
            rm.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleDenomination(slug, name);
            });
            chipsContainer.appendChild(chip);
          });
        }
      }

      if (hiddenInputsWrap) {
        hiddenInputsWrap.innerHTML = '';
        selectedDenoms.forEach((_, slug) => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'denominations';
          input.value = slug;
          hiddenInputsWrap.appendChild(input);
        });
      }

      if (counterBadge) {
        const count = selectedDenoms.size;
        if (count === 2) {
          counterBadge.style.color = 'var(--teal)';
          counterBadge.textContent = '2 of 2 selected (maximum)';
        } else {
          counterBadge.style.color = '';
          counterBadge.textContent = `${count} of 2 selected`;
        }
      }

      // Keep the typeahead results in sync with the current selection.
      buildDenomResults();

      if (customDenomWrap && customDenomInput) {
        if (selectedDenoms.has('other')) {
          customDenomWrap.classList.remove('hidden');
          customDenomInput.required = true;
        } else {
          customDenomWrap.classList.add('hidden');
          customDenomInput.required = false;
        }
      }
      updateCompletion();
    }

    function toggleDenomination(slug, name) {
      if (selectedDenoms.has(slug)) {
        selectedDenoms.delete(slug);
      } else {
        if (selectedDenoms.size >= 2) {
          alert('You can select up to two denominations. Remove one to choose another.');
          return;
        }
        selectedDenoms.set(slug, name);
      }
      renderDenominations();
    }

    // ---------------------------------------------------------------------
    // Denomination typeahead — same searchable interaction as the category
    // field: type to filter the catalog, click a result to add/remove.
    // ---------------------------------------------------------------------
    function buildDenomResults() {
      if (!denomSearchInput || !denomSearchResults) return;
      const q = denomSearchInput.value.toLowerCase().trim();
      const matches = (denominations || [])
        .filter((d) => !q || d.name.toLowerCase().includes(q) || d.slug.includes(q))
        .slice(0, 12);
      denomSearchResults.innerHTML = '';
      if (!matches.length) {
        denomSearchResults.classList.add('hidden');
        return;
      }
      matches.forEach((d) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center justify-between px-3 py-2 text-left text-xs hover:bg-[var(--surface-2)]';
        btn.style.borderBottom = '1px solid var(--border)';
        btn.setAttribute('data-slug', d.slug);
        const isSelected = selectedDenoms.has(d.slug);
        if (isSelected) {
          btn.style.background = 'var(--accent-soft)';
        }
        const label = document.createElement('span');
        label.textContent = d.name;
        label.style.fontWeight = isSelected ? '700' : '500';
        const mark = document.createElement('span');
        mark.textContent = isSelected ? '✓ Selected' : 'Add';
        mark.style.color = isSelected ? 'var(--accent)' : 'var(--text-mute)';
        btn.appendChild(label);
        btn.appendChild(mark);
        btn.addEventListener('click', () => {
          toggleDenomination(d.slug, d.name);
          denomSearchInput.value = '';
          denomSearchResults.innerHTML = '';
          denomSearchResults.classList.add('hidden');
        });
        denomSearchResults.appendChild(btn);
      });
    }

    function setupDenominationSearch() {
      if (!denomSearchInput || !denomSearchResults) return;
      denomSearchInput.addEventListener('focus', () => {
        buildDenomResults();
        denomSearchResults.classList.remove('hidden');
      });
      denomSearchInput.addEventListener('input', () => {
        buildDenomResults();
        denomSearchResults.classList.remove('hidden');
      });
      document.addEventListener('click', (e) => {
        if (denomSearchResults.classList.contains('hidden')) return;
        if (denomSearchInput.contains(e.target) || denomSearchResults.contains(e.target)) return;
        denomSearchResults.classList.add('hidden');
      });
    }
    setupDenominationSearch();

    // ---------------------------------------------------------------------
    // Online-only toggle
    // ---------------------------------------------------------------------
    const onlineWrap = document.getElementById('online-toggle-wrap');
    const onlineStateText = document.getElementById('online-state-text');
    function onlineToggleState(checked) {
      const on = Boolean(checked);
      return {
        mode: on ? 'on' : 'off',
        activeId: on ? 'online-on-label' : 'online-off-label',
        inactiveId: on ? 'online-off-label' : 'online-on-label',
        message: on
          ? 'This listing is for online services only.'
          : 'This listing is for in-person services.',
        formValue: on ? '1' : '',
      };
    }
    function paintOnlineChoice(label, active, mode) {
      label.classList.toggle('is-active', active);
      label.classList.toggle('is-inactive', !active);
      label.dataset.active = active ? 'true' : 'false';
      label.dataset.mode = mode;
    }
    function syncOnlineMode() {
      const state = onlineToggleState(Boolean(onlineToggle && onlineToggle.checked));
      if (onlineWrap) onlineWrap.dataset.online = state.mode;
      for (const label of [document.getElementById('online-off-label'), document.getElementById('online-on-label')]) {
        if (!label) continue;
        paintOnlineChoice(label, label.id === state.activeId, state.mode);
      }
      if (onlineStateText) onlineStateText.textContent = state.message;
    }
    function applyOnlineToggle() {
      const on = Boolean(onlineToggle && onlineToggle.checked);
      locationFields?.classList.toggle('hidden', on);
      locationNote?.classList.toggle('hidden', !on);
      syncOnlineMode();
      updatePreview();
      updateCompletion();
    }
    if (onlineToggle) {
      document.querySelectorAll('#online-toggle-wrap input[name="isOnlineOnly"]').forEach((input) => {
        input.addEventListener('change', applyOnlineToggle);
        input.addEventListener('input', applyOnlineToggle);
      });
      syncOnlineMode();
    }
    if (form) {
      form.addEventListener('formdata', (event) => {
        if (event.formData.get('isOnlineOnly') !== '1') event.formData.delete('isOnlineOnly');
      });
    }

    const hiringYes = document.getElementById('input-hiring-yes');
    const careersWrap = document.getElementById('careers-url-field');
    const careersInput = document.getElementById('input-careers-url');
    const careersError = document.getElementById('careers-url-error');

    function careersUrlError(value) {
      const trimmed = String(value ?? '').trim();
      if (!trimmed) return '';
      try {
        const url = new URL(trimmed);
        if ((url.protocol !== 'http:' && url.protocol !== 'https:') || !url.hostname) {
          return 'Enter a valid http:// or https:// URL.';
        }
        return '';
      } catch {
        return 'Enter a valid http:// or https:// URL.';
      }
    }

    function showCareersError(message) {
      if (!careersError || !careersInput) return;
      if (message) {
        careersError.textContent = message;
        careersError.hidden = false;
        careersInput.setAttribute('aria-invalid', 'true');
      } else {
        careersError.hidden = true;
        careersInput.removeAttribute('aria-invalid');
      }
    }

    function hiringOn() {
      return Boolean(hiringYes && hiringYes.checked);
    }

    function syncHiring() {
      if (careersWrap) careersWrap.hidden = !hiringOn();
    }

    document.querySelectorAll('input[name="isHiring"]').forEach((input) => {
      input.addEventListener('change', () => {
        syncHiring();
        if (!hiringOn()) showCareersError('');
      });
    });
    syncHiring();
    if (careersInput) {
      careersInput.addEventListener('input', () => {
        if (!careersUrlError(careersInput.value)) showCareersError('');
      });
      careersInput.addEventListener('blur', () => {
        if (hiringOn()) showCareersError(careersUrlError(careersInput.value));
      });
    }

    // ---------------------------------------------------------------------
    // Live preview
    // ---------------------------------------------------------------------
    function formatCity(value) {
      return value.replace(/\S+/g, (w) => w.charAt(0).toUpperCase() + w.slice(1));
    }

    function abbrevRegion(value) {
      const raw = (value || '').trim();
      if (!raw) return '';
      if (raw.length === 2) return raw.toUpperCase();
      return STATE_ABBREV[raw.toLowerCase()] || raw;
    }

    function updatePreview() {
      const nameVal = nameInput ? nameInput.value.trim() : '';
      if (previewName) {
        if (nameVal) {
          previewName.textContent = nameVal;
          previewName.style.color = 'var(--text)';
        } else {
          previewName.textContent = 'Your listing name';
          previewName.style.color = 'var(--text-mute)';
        }
      }
      if (previewType) {
        const card = typeCardsArr.find((c) => (c.getAttribute('data-type') || '') === selectedType);
        const label = card ? card.querySelector('span span')?.textContent : '';
        if (label) {
          previewType.textContent = label;
          previewType.style.color = 'var(--text-soft)';
        } else {
          previewType.textContent = 'No type selected yet';
          previewType.style.color = 'var(--text-mute)';
        }
      }
      if (previewCategory) {
        if (inputCategorySlug && inputCategorySlug.value && chipText) {
          previewCategory.textContent = chipText.textContent;
        } else {
          previewCategory.textContent = 'No category selected';
        }
      }
      if (previewLocation) {
        if (onlineToggle && onlineToggle.checked) {
          previewLocation.textContent = 'Online-only • Serves nationwide';
        } else {
          const city = cityInput ? formatCity(cityInput.value.trim()) : '';
          const region = regionInput ? abbrevRegion(regionInput.value) : '';
          if (city || region) {
            previewLocation.textContent = [city, region].filter(Boolean).join(', ');
          } else {
            previewLocation.textContent = 'Location not set';
          }
        }
      }
    }

    // ---------------------------------------------------------------------
    // Completion / progress
    // ---------------------------------------------------------------------
    function updateCompletion() {
      const s1 = selectedType !== '' && (nameInput ? nameInput.value.trim().length >= 2 : false);
      const s2 = Boolean(inputCategorySlug && inputCategorySlug.value);
      const stmt = statementInput ? statementInput.value.trim() : '';
      const s3 = selectedDenoms.size >= 1 || stmt.length > 0;
      const online = Boolean(onlineToggle && onlineToggle.checked);
      const city = cityInput ? cityInput.value.trim() : '';
      const region = regionInput ? regionInput.value.trim() : '';
      const postal = postalInput ? postalInput.value.trim() : '';
      const s4 = online || Boolean(city || region || postal);

      const done = [s1, s2, s3, s4].filter(Boolean).length;
      if (progressText) progressText.textContent = `${done} of 4 sections complete`;
      if (progressBar) progressBar.style.width = `${(done / 4) * 100}%`;
      updateReviewChecklist();
    }

    let reviewAttempted = false;
    function updateReviewChecklist() {
      const attestation = document.getElementById('input-attestation');
      const terms = document.getElementById('input-terms');
      const checks = {
        type: selectedType !== '',
        name: Boolean(nameInput && nameInput.value.trim().length >= 2),
        attestation: Boolean(attestation && attestation.checked),
        terms: Boolean(terms && terms.checked),
      };
      const labels = {
        type: 'organization type',
        name: 'listing name',
        attestation: 'accuracy confirmation',
        terms: 'terms agreement',
      };
      const missing = [];
      Object.keys(checks).forEach((key) => {
        const item = document.querySelector('#review-checklist [data-check="' + key + '"]');
        if (!item) return;
        const ready = checks[key];
        item.dataset.state = ready ? 'ready' : 'needed';
        const state = item.querySelector('.check-state');
        if (state) state.textContent = ready ? 'Ready' : 'Needed';
        if (!ready) missing.push(labels[key]);
      });
      const missingEl = document.getElementById('review-missing');
      if (!missingEl) return;
      if (reviewAttempted && missing.length) {
        missingEl.hidden = false;
        missingEl.textContent = 'Still needed before publishing: ' + missing.join(', ') + '.';
      } else {
        missingEl.hidden = true;
        missingEl.textContent = '';
      }
    }

    // ---------------------------------------------------------------------
    // Live input bindings
    // ---------------------------------------------------------------------
    [nameInput, statementInput, cityInput, regionInput, postalInput].forEach((el) => {
      if (!el) return;
      el.addEventListener('input', () => {
        updatePreview();
        updateCompletion();
      });
    });

    // ---------------------------------------------------------------------
    // Form submission guard — listing type is the only client-gated field;
    // category selection is optional (server accepts listings without one).
    // ---------------------------------------------------------------------
    const formStatus = document.getElementById('form-status');
    const reviewStatus = document.getElementById('review-status');
    const stickyStatus = document.getElementById('sticky-status');
    const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement | null;
    const reviewPublishBtn = document.getElementById('review-publish-btn') as HTMLButtonElement | null;
    function showFormStatus(message, kind) {
      [formStatus, reviewStatus, stickyStatus].forEach((el) => {
        if (!el) return;
        el.textContent = message;
        el.classList.remove('hidden', 'is-error', 'is-ok');
        el.classList.add(kind === 'error' ? 'is-error' : 'is-ok');
      });
    }
    function setPublishBusy(busy) {
      [publishBtn, reviewPublishBtn].forEach((button) => {
        if (!button) return;
        button.disabled = busy;
        if (busy) {
          button.setAttribute('aria-busy', 'true');
          button.textContent = 'Publishing…';
        } else {
          button.removeAttribute('aria-busy');
          button.textContent = button.dataset.label || 'Publish';
        }
      });
    }
    document.querySelectorAll('details[data-open-if]').forEach((panel) => {
      const filled = Array.from(panel.querySelectorAll('input, select, textarea')).some((el) => 'value' in el && String(el.value).trim() !== '');
      if (filled) panel.open = true;
    });
    if (form) {
      form.addEventListener('invalid', (event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
          field.setAttribute('aria-invalid', 'true');
          const panel = field.closest('details');
          if (panel) panel.open = true;
        }
        reviewAttempted = true;
        updateReviewChecklist();
        showFormStatus('Check the highlighted fields. Required items are marked.', 'error');
      }, true);
      form.addEventListener('input', (event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
          if (field.validity.valid) field.removeAttribute('aria-invalid');
        }
        updateReviewChecklist();
      });
      form.addEventListener('change', () => updateReviewChecklist());
      form.addEventListener('submit', (e) => {
        if (!selectedType) {
          e.preventDefault();
          reviewAttempted = true;
          updateReviewChecklist();
          if (listingTypeError) listingTypeError.classList.remove('hidden');
          typeCardsArr[0]?.focus();
          showFormStatus('Select an organization type before publishing.', 'error');
          return;
        }
        const careersMessage = careersUrlError(careersInput ? careersInput.value : '');
        if (careersMessage) {
          e.preventDefault();
          reviewAttempted = true;
          updateReviewChecklist();
          if (hiringYes && !hiringYes.checked) {
            hiringYes.checked = true;
            syncHiring();
          }
          showCareersError(careersMessage);
          careersInput?.focus();
          showFormStatus(careersMessage, 'error');
          return;
        }
        setPublishBusy(true);
        if (saveDraftBtn) saveDraftBtn.disabled = true;
        const reviewDraftBtn = document.getElementById('review-draft-btn');
        if (reviewDraftBtn) reviewDraftBtn.disabled = true;
        showFormStatus('Publishing your listing…', 'ok');
      });
    }

    // ---------------------------------------------------------------------
    // Save draft
    // ---------------------------------------------------------------------
    if (saveDraftBtn && form) {
      saveDraftBtn.addEventListener('click', async () => {
        const fd = new FormData(form);
        const listing = {
          name: String(fd.get('name') ?? ''),
          typeSlug: String(fd.get('typeSlug') ?? ''),
          tagline: String(fd.get('tagline') ?? ''),
          description: String(fd.get('description') ?? ''),
          website: String(fd.get('website') ?? ''),
          phone: String(fd.get('phone') ?? ''),
          email: String(fd.get('email') ?? ''),
          city: String(fd.get('city') ?? ''),
          region: String(fd.get('region') ?? ''),
          postalCode: String(fd.get('postalCode') ?? ''),
          industrySlug: String(fd.get('industrySlug') ?? ''),
          categorySlug: String(fd.get('categorySlug') ?? ''),
          customCategory: String(fd.get('customCategory') ?? ''),
          statementOfFaith: String(fd.get('statementOfFaith') ?? ''),
          priceRange: String(fd.get('priceRange') ?? ''),
          yearFounded: fd.get('yearFounded') ? Number(fd.get('yearFounded')) : undefined,
          employeeCount: String(fd.get('employeeCount') ?? ''),
          ownershipType: String(fd.get('ownershipType') ?? ''),
          serviceArea: String(fd.get('serviceArea') ?? ''),
          hours: String(fd.get('hours') ?? ''),
          contactPreference: String(fd.get('contactPreference') ?? ''),
          isOnlineOnly: fd.get('isOnlineOnly') === '1',
          isHiring: fd.get('isHiring') === '1',
          careersUrl: String(fd.get('careersUrl') ?? ''),
          denominations: fd.getAll('denominations').map((v) => String(v)),
          hashtags: String(fd.get('hashtags') ?? '').split(',').map((s) => s.trim().replace(/^#/, '')).filter(Boolean),
        };
        if (!listing.name || listing.name.trim().length < 2) {
          showFormStatus('Please enter a listing name before saving a draft.', 'error');
          nameInput?.focus();
          return;
        }
        const draftLabel = saveDraftBtn.textContent;
        const reviewDraftBtn = document.getElementById('review-draft-btn');
        saveDraftBtn.disabled = true;
        saveDraftBtn.setAttribute('aria-busy', 'true');
        saveDraftBtn.textContent = 'Saving…';
        if (reviewDraftBtn) {
          reviewDraftBtn.disabled = true;
          reviewDraftBtn.setAttribute('aria-busy', 'true');
          reviewDraftBtn.textContent = 'Saving…';
        }
        showFormStatus('Saving draft…', 'ok');
        try {
          const res = await fetch('/api/submissions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'draft', listing }),
          });
          if (res.ok) {
            showFormStatus('Draft saved.', 'ok');
          } else if (res.status === 401) {
            showFormStatus('Please sign in to save a draft.', 'error');
          } else {
            const j = await res.json().catch(() => ({}));
            showFormStatus(j.error || 'Could not save the draft. Please try again.', 'error');
          }
        } catch {
          showFormStatus('Could not save the draft. Please try again.', 'error');
        } finally {
          saveDraftBtn.disabled = false;
          saveDraftBtn.removeAttribute('aria-busy');
          saveDraftBtn.textContent = draftLabel;
          const reviewDraftBtn = document.getElementById('review-draft-btn');
          if (reviewDraftBtn) {
            reviewDraftBtn.disabled = false;
            reviewDraftBtn.removeAttribute('aria-busy');
            reviewDraftBtn.textContent = 'Save draft';
          }
        }
      });
    }
    const reviewDraftBtn = document.getElementById('review-draft-btn');
    if (reviewDraftBtn && saveDraftBtn) {
      reviewDraftBtn.addEventListener('click', () => saveDraftBtn.click());
    }

    // Initial state pass.
    updatePreview();
    updateCompletion();
  </script>

  <style>
    .section-num {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      color: var(--accent);
      flex-shrink: 0;
    }
    .type-card {
      position: relative;
    }
    .type-card .type-check {
      display: none;
      align-items: center;
      justify-content: center;
      height: 1.25rem;
      min-width: 1.25rem;
      padding: 0 0.35rem;
      border-radius: 9999px;
      font-size: 0.65rem;
      font-weight: 800;
      background: var(--accent);
      color: #fff;
    }
    .type-card[aria-pressed='true'] {
      border-color: var(--accent) !important;
      background: var(--accent-soft) !important;
      box-shadow: 0 0 0 1px var(--accent);
    }
    .type-card[aria-pressed='true'] .type-check {
      display: inline-flex;
    }
    .type-card:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--ring);
    }
    .type-card[aria-pressed='true']:focus-visible {
      box-shadow: 0 0 0 1px var(--accent), 0 0 0 3px var(--ring);
    }
    #category-search-results button:focus-visible,
    #denom-search-results button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .org-card h3 {
      letter-spacing: 0.01em;
    }
    select.input {
      max-width: 100%;
    }
    .control-grid {
      display: grid;
      gap: 1rem;
      align-items: stretch;
    }
    @media (min-width: 768px) {
      .control-grid { grid-template-columns: 1fr 1fr; }
    }
    .control-card,
    .review-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      height: 100%;
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 0.9rem;
      background: var(--surface);
      padding: 1rem;
    }
    .control-fieldset {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      flex: 1 1 auto;
      width: 100%;
      height: 100%;
      min-width: 0;
      border: 0;
      margin: 0;
      padding: 0;
    }
    legend.control-title {
      float: none;
      width: 100%;
    }
    .control-title {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      margin: 0;
      padding: 0;
      color: var(--text);
      font-size: 0.875rem;
      font-weight: 700;
      line-height: 1.35;
    }
    .control-label { display: block; }
    .control-row {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .choice-group {
      display: grid;
