          <p id="location-disabled-note" class="hidden mt-3 rounded-xl border p-3 text-xs font-semibold" style="border-color:var(--border); background:var(--surface-2); color:var(--text-soft)">Location fields are hidden for online-only listings — you serve customers nationwide.</p>

          <!-- What the public sees: contact fields + their visibility toggles grouped together -->
          <div class="mt-5 rounded-2xl border p-4 sm:p-5" style="border-color:var(--border); background:var(--surface-2)">
            <h3 class="text-sm font-extrabold">What the public sees</h3>
            <p class="mt-1 text-xs" style="color:var(--text-mute)">Each detail below stays private until you switch its toggle on.</p>

            <!-- Website -->
            <div class="mt-4 space-y-1.5">
              <label class="block text-sm font-semibold">Website URL
                <input name="website" type="url" class="input mt-1.5" placeholder="https://yourbusiness.com" />
              </label>
              <label class="flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer">
                <input type="checkbox" name="showWebsite" value="1" class="peer sr-only" />
                <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
                <span>Display website publicly on listing</span>
                <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
                <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
              </label>
              <p class="text-xs" style="color:var(--text-mute)">When checked, a direct "Website" link will appear on your public profile.</p>
            </div>

            <hr class="my-4" style="border-color:var(--border)" />

            <!-- Phone Number -->
            <div class="space-y-1.5">
              <label class="block text-sm font-semibold">Phone number
                <input name="phone" maxlength="60" class="input mt-1.5" placeholder="Enter phone number" />
              </label>
              <label class="flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer">
                <input type="checkbox" name="showPhone" value="1" class="peer sr-only" />
                <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
                <span>Display phone number publicly on listing</span>
                <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
                <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
              </label>
              <p class="text-xs" style="color:var(--text-mute)">When unchecked, phone number is stored for verification only and not shown to the public.</p>
            </div>

            <hr class="my-4" style="border-color:var(--border)" />

            <!-- Contact Email -->
            <div class="space-y-1.5">
              <label class="block text-sm font-semibold">Contact email
                <input
                  name="email"
                  type="email"
                  class="input mt-1.5"
                  placeholder="contact@yourbusiness.com"
                  value={user?.email ?? ''}
                />
              </label>
              {user?.email && (
                <p class="text-xs" style="color:var(--text-soft)">
                  Account email: <strong>{user.email}</strong>. Pre-filled for your convenience; feel free to change it to your organization's inquiry address.
                </p>
              )}
              <label class="flex flex-wrap items-center gap-2.5 text-xs font-semibold cursor-pointer">
                <input type="checkbox" name="showEmail" value="1" class="peer sr-only" />
                <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
                <span>Display email address publicly on listing</span>
                <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
                <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
              </label>
              <p class="text-xs" style="color:var(--text-mute)">When unchecked, your email is kept strictly private. Prospective clients can still reach you securely using our on-site inquiry form without seeing your email address.</p>
            </div>
          </div>
        </section>

        <!-- Hashtags + agreement -->
        <section aria-labelledby="section-tags-heading" class="border-t pt-7" style="border-color:var(--border)">
          <h2 id="section-tags-heading" class="text-lg font-extrabold leading-tight">Discovery tags</h2>
          <label class="mt-3 block text-sm font-semibold">Hashtags <span style="color:var(--text-mute)">(comma-separated)</span>
            <input name="hashtags" class="input mt-1.5" placeholder="e.g. ChristianOwned, FamilyOwned, VeteranOwned" />
          </label>

          <!-- Agreement -->
          <label class="mt-5 flex flex-wrap items-center gap-2.5 text-[13px] cursor-pointer" style="color:var(--text-soft)">
            <input type="checkbox" required class="peer sr-only" />
            <span class="relative inline-block h-6 w-11 shrink-0 rounded-full bg-gray-200 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-[''] peer-checked:bg-[var(--accent)] peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--ring)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--surface)]" aria-hidden="true"></span>
            <span class="flex-1 min-w-0">I affirm this information is accurate, I am authorized to list this business, and I agree to the <a href="/terms" class="underline">Terms of Service</a> and <a href="/guidelines" class="underline">Community Guidelines</a>.</span>
            <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--surface-2)] text-[var(--text-mute)] peer-checked:hidden">Off</span>
            <span class="hidden rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide bg-[var(--accent-soft)] text-[var(--accent)] peer-checked:inline-block">On</span>
          </label>
        </section>
      </form>
    )}

    {!success && (
      <>
        <!-- Live preview -->
        <div id="live-preview" class="card mt-6 p-6">
          <h2 class="text-base font-bold">Live preview</h2>
          <p class="mt-0.5 text-xs" style="color:var(--text-soft)">This is how your listing will appear in the directory.</p>
          <div class="mt-4 flex items-start gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border text-[10px] font-bold uppercase tracking-wide" style="border-color:var(--border); background:var(--surface-2); color:var(--text-mute)">Logo</div>
            <div class="min-w-0">
              <p id="preview-name" class="truncate font-extrabold" style="color:var(--text-mute)">Your listing name</p>
              <p id="preview-type" class="mt-0.5 text-xs font-semibold" style="color:var(--text-mute)">No type selected yet</p>
              <p id="preview-category" class="mt-0.5 text-xs" style="color:var(--text-soft)">No category selected</p>
              <p id="preview-location" class="mt-0.5 text-xs" style="color:var(--text-mute)">Location not set</p>
            </div>
          </div>
        </div>

        <!-- Sticky action bar -->
        <div id="sticky-bar" class="fixed inset-x-0 bottom-0 z-40 border-t backdrop-blur" style="border-color:var(--border); background:color-mix(in srgb, var(--surface) 94%, transparent)">
          <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-[180px] flex-1">
              <div class="h-2 w-full max-w-[240px] overflow-hidden rounded-full" style="background:var(--surface-2)">
                <div id="progress-bar" class="h-2 rounded-full transition-all duration-300" style="background: var(--accent); width: 0%"></div>
              </div>
              <p id="progress-text" class="mt-1 text-xs font-semibold" style="color:var(--text-mute)" aria-live="polite">0 of 4 sections complete</p>
            </div>
            <div class="flex w-full gap-2 sm:w-auto sm:flex-wrap sm:justify-end sm:gap-2">
              <button type="button" id="save-draft-btn" class="btn btn-secondary flex-1 sm:flex-none" form="add-listing-form">Save draft</button>
              <button type="submit" class="btn btn-primary flex-1 sm:flex-none" form="add-listing-form">Publish business listing</button>
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script define:vars={{ industries, typeCategoryMap: TYPE_CATEGORY_MAP, typeCategoryFilter: TYPE_CATEGORY_FILTER, denominations: denominationOptions }}>
    // ---------------------------------------------------------------------
    // State
    // ---------------------------------------------------------------------
    const form = document.getElementById('add-listing-form');
    const typeCards = document.querySelectorAll('.type-card');
    const inputTypeSlug = document.getElementById('input-type-slug');
    const listingTypeError = document.getElementById('listing-type-error');
    const nameInput = document.getElementById('input-name');
    const statementInput = document.getElementById('input-statement');

    const categoryHelp = document.getElementById('category-filter-help');
    const categoryStatus = document.getElementById('category-filter-status');
    const categoryWarning = document.getElementById('category-type-warning');
    const inputIndustrySlug = document.getElementById('input-industry-slug');
    const inputCategorySlug = document.getElementById('input-category-slug');
    const chipsWrap = document.getElementById('category-chips-primary');
    const chipText = document.getElementById('category-chip-text');
    const chipClear = document.getElementById('category-chip-clear');
    const customWrap = document.getElementById('custom-category-wrap');
    const inputCustomCategory = document.getElementById('input-custom-category');

    const searchInput = document.getElementById('category-search-input');
    const searchResults = document.getElementById('category-search-results');
    const denomSearchInput = document.getElementById('denom-search-input');
    const denomSearchResults = document.getElementById('denom-search-results');
    const categoryTypeContext = document.getElementById('category-type-context');

    const onlineToggle = document.getElementById('input-online');
    const locationFields = document.getElementById('location-fields');
    const locationNote = document.getElementById('location-disabled-note');
    const cityInput = document.getElementById('input-city');
    const regionInput = document.getElementById('input-region');
    const postalInput = document.querySelector('input[name="postalCode"]');

    const previewName = document.getElementById('preview-name');
    const previewType = document.getElementById('preview-type');
    const previewCategory = document.getElementById('preview-category');
    const previewLocation = document.getElementById('preview-location');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');
    const stickyBar = document.getElementById('sticky-bar');
    const saveDraftBtn = document.getElementById('save-draft-btn');

    const flatCategories = [];
    industries.forEach((ind) => {
      (ind.categories || []).forEach((cat) => {
        flatCategories.push({ catSlug: cat.slug, catName: cat.name, indSlug: ind.slug, indName: ind.name });
      });
    });

    const typeCardsArr = Array.from(typeCards);
    let selectedType = '';
    let filteredFlatCategories = flatCategories;
    let warningTimer = null;

    const TYPE_HELPERS = {
      business: 'Showing business categories',
      church: 'Showing faith-based categories for Churches — religious organizations, community outreach, counseling.',
      ministry: 'Showing faith-based categories for Ministries — outreach, missions, discipleship, and media.',
      nonprofit: 'Showing categories for faith-based charities and community organizations.',
      school: 'Showing education categories for Christian schools, colleges, seminaries, and co-ops.',
      event: 'Showing event-friendly categories for conferences, retreats, concerts, camps, and gatherings.',
      other: 'Showing all categories — choose the industry and category that fits best.',
    };

    const STATE_ABBREV = {
      alabama: 'AL', alaska: 'AK', arizona: 'AZ', arkansas: 'AR', california: 'CA', colorado: 'CO',
      connecticut: 'CT', delaware: 'DE', 'district of columbia': 'DC', florida: 'FL', georgia: 'GA',
      hawaii: 'HI', idaho: 'ID', illinois: 'IL', indiana: 'IN', iowa: 'IA', kansas: 'KS',
      kentucky: 'KY', louisiana: 'LA', maine: 'ME', maryland: 'MD', massachusetts: 'MA', michigan: 'MI',
      minnesota: 'MN', mississippi: 'MS', missouri: 'MO', montana: 'MT', nebraska: 'NE', nevada: 'NV',
      'new hampshire': 'NH', 'new jersey': 'NJ', 'new mexico': 'NM', 'new york': 'NY', 'north carolina': 'NC',
      'north dakota': 'ND', ohio: 'OH', oklahoma: 'OK', oregon: 'OR', pennsylvania: 'PA', 'rhode island': 'RI',
      'south carolina': 'SC', 'south dakota': 'SD', tennessee: 'TN', texas: 'TX', utah: 'UT', vermont: 'VT',
      virginia: 'VA', washington: 'WA', 'west virginia': 'WV', wisconsin: 'WI', wyoming: 'WY',
    };

    // ---------------------------------------------------------------------
    // Type → category filtering helpers
    // ---------------------------------------------------------------------
    function getAllowedIndustriesForType(typeSlug) {
      if (!typeSlug) return [];
      const allowed = typeCategoryMap[typeSlug] || [];
      return industries.filter((ind) => allowed.includes(ind.slug));
    }

    function getCategoryFilterForType(typeSlug) {
      if (!typeSlug) return null;
      return typeCategoryFilter[typeSlug] || null;
    }

    function showTypeWarning() {
      if (!categoryWarning) return;
      categoryWarning.classList.remove('hidden');
      if (warningTimer) clearTimeout(warningTimer);
      warningTimer = setTimeout(() => {
        categoryWarning.classList.add('hidden');
      }, 6000);
    }

    function clearCategorySelection(showWarning) {
      if (inputIndustrySlug) inputIndustrySlug.value = '';
      if (inputCategorySlug) inputCategorySlug.value = '';
      if (chipsWrap) chipsWrap.classList.add('hidden');
      if (chipText) chipText.textContent = '';
      if (customWrap) customWrap.classList.add('hidden');
      if (inputCustomCategory) {
        inputCustomCategory.value = '';
        inputCustomCategory.required = false;
      }
      if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }
      if (showWarning) showTypeWarning();
      updatePreview();
      updateCompletion();
    }

    function applyCategorySelection(indSlug, indName, catSlug, catName) {
      if (inputIndustrySlug) inputIndustrySlug.value = indSlug;
      if (inputCategorySlug) inputCategorySlug.value = catSlug;
      if (chipText) chipText.textContent = `${indName} › ${catName}`;
      if (chipsWrap) chipsWrap.classList.remove('hidden');

      const isOther = catSlug.startsWith('other') || indSlug === 'other-industries';
      if (customWrap && inputCustomCategory) {
        if (isOther) {
          customWrap.classList.remove('hidden');
          inputCustomCategory.required = true;
        } else {
          customWrap.classList.add('hidden');
          inputCustomCategory.required = false;
          inputCustomCategory.value = '';
        }
      }
      updatePreview();
      updateCompletion();
    }

    // Recompute the type-filtered category pool (single source for the search
    // picker + helper/status/context copy). No <select> is involved.
    function rebuildCategoryPoolForType(typeSlug) {
      const previousCatSlug = inputCategorySlug ? inputCategorySlug.value : '';
      const allowedIndustries = getAllowedIndustriesForType(typeSlug);
      const catFilter = getCategoryFilterForType(typeSlug);
      const allowedSet = new Set();
      const rebuiltFlat = [];

      allowedIndustries.forEach((ind) => {
        const filterCats = catFilter && catFilter[ind.slug] ? catFilter[ind.slug] : null;
        const cats = filterCats ? ind.categories.filter((c) => filterCats.includes(c.slug)) : ind.categories.slice();
        cats.forEach((cat) => {
          allowedSet.add(cat.slug);
          rebuiltFlat.push({ catSlug: cat.slug, catName: cat.name, indSlug: ind.slug, indName: ind.name });
        });
      });

      const validType = Boolean(typeSlug) && Object.prototype.hasOwnProperty.call(typeCategoryMap, typeSlug);
      filteredFlatCategories = rebuiltFlat;

      if (validType) {
        if (categoryHelp) categoryHelp.textContent = TYPE_HELPERS[typeSlug] || 'Showing categories for this organization type.';
        if (categoryStatus) {
          categoryStatus.textContent = `${allowedSet.size} categories available for this type`;
          categoryStatus.classList.remove('hidden');
        }
        if (categoryTypeContext) {
          const typeCard = document.querySelector(`.type-card[data-type="${typeSlug}"]`);
          const typeLabel = typeCard ? typeCard.querySelector('span span')?.textContent : '';
          categoryTypeContext.textContent = typeLabel ? `For: ${typeLabel}` : 'For your listing type';
          categoryTypeContext.classList.remove('hidden');
        }
      } else {
        if (categoryHelp) categoryHelp.textContent = 'Please select an organization type first.';
        if (categoryStatus) {
          categoryStatus.textContent = '';
          categoryStatus.classList.add('hidden');
        }
        if (categoryTypeContext) categoryTypeContext.classList.add('hidden');
      }

      const stillValid = Boolean(previousCatSlug) && allowedSet.has(previousCatSlug);
      if (!stillValid) clearCategorySelection(Boolean(previousCatSlug));
      else if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }

      updatePreview();
      updateCompletion();
    }

    // ---------------------------------------------------------------------
    // Type cards
    // ---------------------------------------------------------------------
    typeCardsArr.forEach((card) => {
      card.addEventListener('click', () => {
        const nextType = card.getAttribute('data-type') || '';
        const prevType = selectedType;
        if (!nextType || nextType === prevType) return;
        selectedType = nextType;
        if (inputTypeSlug) inputTypeSlug.value = nextType;
        if (listingTypeError) listingTypeError.classList.add('hidden');
        typeCardsArr.forEach((c) => {
          const active = c === card;
          c.setAttribute('aria-pressed', String(active));
          c.setAttribute('data-selected', String(active));
        });
        rebuildCategoryPoolForType(nextType);
      });
    });

    // ---------------------------------------------------------------------
    // Category chip clear (the picker itself is a typeahead — see below)
    // ---------------------------------------------------------------------
    chipClear?.addEventListener('click', () => {
      clearCategorySelection(false);
      searchInput?.focus();
    });

    // ---------------------------------------------------------------------
    // Category search — the single category picker, type-filtered
    // ---------------------------------------------------------------------
    function renderCategoryResults(q) {
      if (!searchInput || !searchResults) return;
      searchResults.innerHTML = '';
      if (!q) {
        searchResults.classList.add('hidden');
        return;
      }
      // Use the type-filtered list once a type is selected; fall back to the
      // full list only when no type filtering is active.
      const source = selectedType ? filteredFlatCategories : flatCategories;
      const matches = source
        .filter(
          (c) =>
            c.catName.toLowerCase().includes(q) ||
            c.indName.toLowerCase().includes(q) ||
            c.catSlug.includes(q),
        )
        .slice(0, 8);
      if (!matches.length) {
        searchResults.classList.add('hidden');
        return;
      }
      matches.forEach((m) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center justify-between px-3 py-2 text-left text-xs hover:bg-[var(--surface-2)]';
        btn.style.borderBottom = '1px solid var(--border)';
        btn.setAttribute('data-slug', m.catSlug);
        btn.setAttribute('data-industry-slug', m.indSlug);
        const label = document.createElement('span');
        label.textContent = m.catName;
        const ind = document.createElement('span');
        ind.textContent = m.indName;
        ind.style.color = 'var(--text-mute)';
        btn.appendChild(label);
        btn.appendChild(ind);
        btn.addEventListener('click', () => {
          applyCategorySelection(m.indSlug, m.indName, m.catSlug, m.catName);
          searchInput.value = '';
          searchResults.innerHTML = '';
          searchResults.classList.add('hidden');
        });
        searchResults.appendChild(btn);
      });
      searchResults.classList.remove('hidden');
    }

    function setupCategorySearch() {
      if (!searchInput || !searchResults) return;
      searchInput.addEventListener('input', () => {
        renderCategoryResults(searchInput.value.toLowerCase().trim());
      });
      searchInput.addEventListener('focus', () => {
        renderCategoryResults(searchInput.value.toLowerCase().trim());
      });
      document.addEventListener('click', (e) => {
        if (searchResults.classList.contains('hidden')) return;
        if (searchInput.contains(e.target) || searchResults.contains(e.target)) return;
        searchResults.classList.add('hidden');
      });
    }
    setupCategorySearch();

    // ---------------------------------------------------------------------
    // Multi-Denomination Selector Controller (Up to 2)
    // ---------------------------------------------------------------------
    const selectedDenoms = new Map(); // slug -> name
    const chipsContainer = document.getElementById('denom-chips-container');
    const emptyHint = document.getElementById('denom-empty-hint');
    const counterBadge = document.getElementById('denom-counter');
    const hiddenInputsWrap = document.getElementById('denom-hidden-inputs');
    const customDenomWrap = document.getElementById('custom-denom-wrap');
    const customDenomInput = document.getElementById('custom-denom-input');

    function renderDenominations() {
      if (chipsContainer) {
        chipsContainer.querySelectorAll('.denom-chip').forEach((c) => c.remove());
        if (selectedDenoms.size === 0) {
          emptyHint?.classList.remove('hidden');
        } else {
          emptyHint?.classList.add('hidden');
          selectedDenoms.forEach((name, slug) => {
            const chip = document.createElement('span');
            chip.className = 'denom-chip inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border border-[var(--teal)] bg-[rgba(46,146,131,0.12)] text-[var(--teal)]';
            chip.innerHTML = `<span></span><button type="button" class="remove-chip hover:opacity-75 focus:outline-none" aria-label="Remove denomination" data-slug=""></button>`;
            chip.querySelector('span').textContent = name;
            const rm = chip.querySelector('.remove-chip');
            rm.setAttribute('aria-label', `Remove ${name}`);
            rm.setAttribute('data-slug', slug);
            rm.textContent = '✕';
            rm.addEventListener('click', (e) => {
              e.stopPropagation();
              toggleDenomination(slug, name);
            });
            chipsContainer.appendChild(chip);
          });
        }
      }

      if (hiddenInputsWrap) {
        hiddenInputsWrap.innerHTML = '';
        selectedDenoms.forEach((_, slug) => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'denominations';
          input.value = slug;
          hiddenInputsWrap.appendChild(input);
        });
      }

      if (counterBadge) {
        const count = selectedDenoms.size;
        if (count === 2) {
          counterBadge.style.color = 'var(--teal)';
          counterBadge.textContent = '2 of 2 selected (maximum)';
        } else {
          counterBadge.style.color = '';
          counterBadge.textContent = `${count} of 2 selected`;
        }
      }

      // Keep the typeahead results in sync with the current selection.
      buildDenomResults();

      if (customDenomWrap && customDenomInput) {
        if (selectedDenoms.has('other')) {
          customDenomWrap.classList.remove('hidden');
          customDenomInput.required = true;
        } else {
          customDenomWrap.classList.add('hidden');
          customDenomInput.required = false;
        }
      }
      updateCompletion();
    }

    function toggleDenomination(slug, name) {
      if (selectedDenoms.has(slug)) {
        selectedDenoms.delete(slug);
      } else {
        if (selectedDenoms.size >= 2) {
          alert('You can select up to two denominations. Remove one to choose another.');
          return;
        }
        selectedDenoms.set(slug, name);
      }
      renderDenominations();
    }

    // ---------------------------------------------------------------------
    // Denomination typeahead — same searchable interaction as the category
    // field: type to filter the catalog, click a result to add/remove.
    // ---------------------------------------------------------------------
    function buildDenomResults() {
      if (!denomSearchInput || !denomSearchResults) return;
      const q = denomSearchInput.value.toLowerCase().trim();
      const matches = (denominations || [])
        .filter((d) => !q || d.name.toLowerCase().includes(q) || d.slug.includes(q))
        .slice(0, 12);
      denomSearchResults.innerHTML = '';
      if (!matches.length) {
        denomSearchResults.classList.add('hidden');
        return;
      }
      matches.forEach((d) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center justify-between px-3 py-2 text-left text-xs hover:bg-[var(--surface-2)]';
        btn.style.borderBottom = '1px solid var(--border)';
        btn.setAttribute('data-slug', d.slug);
        const isSelected = selectedDenoms.has(d.slug);
        if (isSelected) {
          btn.style.background = 'var(--accent-soft)';
        }
        const label = document.createElement('span');
        label.textContent = d.name;
        label.style.fontWeight = isSelected ? '700' : '500';
        const mark = document.createElement('span');
        mark.textContent = isSelected ? '✓ Selected' : 'Add';
        mark.style.color = isSelected ? 'var(--accent)' : 'var(--text-mute)';
        btn.appendChild(label);
        btn.appendChild(mark);
        btn.addEventListener('click', () => {
          toggleDenomination(d.slug, d.name);
          denomSearchInput.value = '';
          denomSearchResults.innerHTML = '';
          denomSearchResults.classList.add('hidden');
        });
        denomSearchResults.appendChild(btn);
      });
    }

    function setupDenominationSearch() {
      if (!denomSearchInput || !denomSearchResults) return;
      denomSearchInput.addEventListener('focus', () => {
        buildDenomResults();
        denomSearchResults.classList.remove('hidden');
      });
      denomSearchInput.addEventListener('input', () => {
        buildDenomResults();
        denomSearchResults.classList.remove('hidden');
      });
      document.addEventListener('click', (e) => {
        if (denomSearchResults.classList.contains('hidden')) return;
        if (denomSearchInput.contains(e.target) || denomSearchResults.contains(e.target)) return;
        denomSearchResults.classList.add('hidden');
      });
    }
    setupDenominationSearch();

    // ---------------------------------------------------------------------
    // Online-only toggle
    // ---------------------------------------------------------------------
    if (onlineToggle) {
      onlineToggle.addEventListener('change', () => {
        const on = onlineToggle.checked;
        locationFields?.classList.toggle('hidden', on);
        locationNote?.classList.toggle('hidden', !on);
        updatePreview();
        updateCompletion();
      });
    }

    // ---------------------------------------------------------------------
    // Live preview
    // ---------------------------------------------------------------------
    function formatCity(value) {
      return value.replace(/\S+/g, (w) => w.charAt(0).toUpperCase() + w.slice(1));
    }

    function abbrevRegion(value) {
      const raw = (value || '').trim();
      if (!raw) return '';
      if (raw.length === 2) return raw.toUpperCase();
      return STATE_ABBREV[raw.toLowerCase()] || raw;
    }

    function updatePreview() {
      const nameVal = nameInput ? nameInput.value.trim() : '';
      if (previewName) {
        if (nameVal) {
          previewName.textContent = nameVal;
          previewName.style.color = 'var(--text)';
        } else {
          previewName.textContent = 'Your listing name';
          previewName.style.color = 'var(--text-mute)';
        }
      }
      if (previewType) {
        const card = typeCardsArr.find((c) => (c.getAttribute('data-type') || '') === selectedType);
        const label = card ? card.querySelector('span span')?.textContent : '';
        if (label) {
          previewType.textContent = label;
          previewType.style.color = 'var(--text-soft)';
        } else {
          previewType.textContent = 'No type selected yet';
          previewType.style.color = 'var(--text-mute)';
        }
      }
      if (previewCategory) {
        if (inputCategorySlug && inputCategorySlug.value && chipText) {
          previewCategory.textContent = chipText.textContent;
        } else {
          previewCategory.textContent = 'No category selected';
        }
      }
      if (previewLocation) {
        if (onlineToggle && onlineToggle.checked) {
          previewLocation.textContent = 'Online-only • Serves nationwide';
        } else {
          const city = cityInput ? formatCity(cityInput.value.trim()) : '';
          const region = regionInput ? abbrevRegion(regionInput.value) : '';
          if (city || region) {
            previewLocation.textContent = [city, region].filter(Boolean).join(', ');
          } else {
            previewLocation.textContent = 'Location not set';
          }
        }
      }
    }

    // ---------------------------------------------------------------------
    // Completion / progress
    // ---------------------------------------------------------------------
    function updateCompletion() {
      const s1 = selectedType !== '' && (nameInput ? nameInput.value.trim().length >= 2 : false);
      const s2 = Boolean(inputCategorySlug && inputCategorySlug.value);
      const stmt = statementInput ? statementInput.value.trim() : '';
      const s3 = selectedDenoms.size >= 1 || stmt.length > 0;
      const online = Boolean(onlineToggle && onlineToggle.checked);
      const city = cityInput ? cityInput.value.trim() : '';
      const region = regionInput ? regionInput.value.trim() : '';
      const postal = postalInput ? postalInput.value.trim() : '';
      const s4 = online || Boolean(city || region || postal);

      const done = [s1, s2, s3, s4].filter(Boolean).length;
      if (progressText) progressText.textContent = `${done} of 4 sections complete`;
      if (progressBar) progressBar.style.width = `${(done / 4) * 100}%`;
    }

    // ---------------------------------------------------------------------
    // Live input bindings
    // ---------------------------------------------------------------------
    [nameInput, statementInput, cityInput, regionInput, postalInput].forEach((el) => {
      if (!el) return;
      el.addEventListener('input', () => {
        updatePreview();
        updateCompletion();
      });
    });

    // ---------------------------------------------------------------------
    // Form submission guard — listing type is the only client-gated field;
    // category selection is optional (server accepts listings without one).
    // ---------------------------------------------------------------------
    if (form) {
      form.addEventListener('submit', (e) => {
        if (!selectedType) {
          e.preventDefault();
          if (listingTypeError) listingTypeError.classList.remove('hidden');
          typeCardsArr[0]?.focus();
        }
      });
    }

    // ---------------------------------------------------------------------
    // Save draft
    // ---------------------------------------------------------------------
    if (saveDraftBtn && form) {
      saveDraftBtn.addEventListener('click', async () => {
        const fd = new FormData(form);
        const listing = {
          name: String(fd.get('name') ?? ''),
          typeSlug: String(fd.get('typeSlug') ?? ''),
          tagline: String(fd.get('tagline') ?? ''),
          description: String(fd.get('description') ?? ''),
          website: String(fd.get('website') ?? ''),
          phone: String(fd.get('phone') ?? ''),
          email: String(fd.get('email') ?? ''),
          city: String(fd.get('city') ?? ''),
          region: String(fd.get('region') ?? ''),
          postalCode: String(fd.get('postalCode') ?? ''),
          industrySlug: String(fd.get('industrySlug') ?? ''),
          categorySlug: String(fd.get('categorySlug') ?? ''),
          customCategory: String(fd.get('customCategory') ?? ''),
          statementOfFaith: String(fd.get('statementOfFaith') ?? ''),
          priceRange: String(fd.get('priceRange') ?? ''),
          yearFounded: fd.get('yearFounded') ? Number(fd.get('yearFounded')) : undefined,
          employeeCount: String(fd.get('employeeCount') ?? ''),
          ownershipType: String(fd.get('ownershipType') ?? ''),
          serviceArea: String(fd.get('serviceArea') ?? ''),
          hours: String(fd.get('hours') ?? ''),
          contactPreference: String(fd.get('contactPreference') ?? ''),
          isOnlineOnly: fd.get('isOnlineOnly') === '1',
          denominations: fd.getAll('denominations').map((v) => String(v)),
          hashtags: String(fd.get('hashtags') ?? '').split(',').map((s) => s.trim().replace(/^#/, '')).filter(Boolean),
        };
        if (!listing.name || listing.name.trim().length < 2) {
          alert('Please enter a listing name before saving a draft.');
          nameInput?.focus();
          return;
        }
        try {
          const res = await fetch('/api/submissions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'draft', listing }),
          });
          if (res.ok) {
            alert('Draft saved.');
          } else if (res.status === 401) {
            alert('Please sign in to save a draft.');
          } else {
            const j = await res.json().catch(() => ({}));
            alert(j.error || 'Could not save the draft. Please try again.');
          }
        } catch {
          alert('Could not save the draft. Please try again.');
        }
      });
    }

    // Initial state pass.
    updatePreview();
    updateCompletion();
  </script>

  <style>
    .section-num {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      color: var(--accent);
      flex-shrink: 0;
    }
    .type-card {
      position: relative;
    }
    .type-card .type-check {
      display: none;
      align-items: center;
      justify-content: center;
      height: 1.25rem;
      min-width: 1.25rem;
      padding: 0 0.35rem;
      border-radius: 9999px;
      font-size: 0.65rem;
      font-weight: 800;
      background: var(--accent);
      color: #fff;
    }
    .type-card[aria-pressed='true'] {
      border-color: var(--accent) !important;
      background: var(--accent-soft) !important;
      box-shadow: 0 0 0 1px var(--accent);
    }
    .type-card[aria-pressed='true'] .type-check {
      display: inline-flex;
    }
    .type-card:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--ring);
    }
    .type-card[aria-pressed='true']:focus-visible {
      box-shadow: 0 0 0 1px var(--accent), 0 0 0 3px var(--ring);
    }
    #category-search-results button:focus-visible,
    #denom-search-results button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .org-card h3 {
      letter-spacing: 0.01em;
    }
    select.input {
      max-width: 100%;
    }
  </style>
</BaseLayout>
