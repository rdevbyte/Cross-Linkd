---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { denominationBySlug, traditionBySlug } from '@/data/denominations';
import { getPublicListings } from '@/lib/publicListings';

const corpus = await getPublicListings();

const { slug } = Astro.params;
const denom = slug ? denominationBySlug(slug) : undefined;
if (!denom) return Astro.redirect('/browse/denominations', 302);
const user = Astro.locals.user;
const tradition = traditionBySlug(denom.tradition);
const matches = corpus.filter((l) => l.denominations.includes(denom.slug));
---
<BaseLayout user={user} seo={{ title: `${denom.name} — CrossLinkd`, description: denom.description, path: `/denominations/${denom.slug}` }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <nav class="text-[13px]" style="color:var(--text-mute)"><a href="/browse/denominations" class="hover:underline">Traditions</a> / <span style="color:var(--text)">{denom.name}</span></nav>
    <p class="chip mt-3 w-fit">{tradition?.name}</p>
    <h1 class="mt-2 text-3xl font-extrabold">{denom.name}</h1>
    <p class="section-sub">{denom.description}</p>
    {denom.aliases.length > 0 && <p class="mt-2 text-sm" style="color:var(--text-mute)">Also known as: {denom.aliases.join(', ')}</p>}
    <h2 class="mt-8 text-xl font-extrabold">Listings ({matches.length})</h2>
    {matches.length === 0 ? (
      <div class="mt-4"><EmptyState title="No listings yet" body={`Know a ${denom.name} church, ministry, or business? Add it to the directory.`} actionHref="/add-listing" actionLabel="List Your Business" /></div>
    ) : (
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{matches.map((l) => <ListingCard listing={l} />)}</div>
    )}
  </div>
</BaseLayout>
