---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
---
<BaseLayout user={user} seo={{ title: 'My Favorites — CrossLinkd', description: 'Your saved listings, collections, and followed ministries.', path: '/favorites', noindex: true }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-bold">My favorites</h1>
    <p class="section-sub">Saved on this device{user ? ` for ${user.displayName}` : ''}. Sign in on production to sync across devices.</p>
    <div id="fav-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div id="fav-empty" class="card mt-6 hidden p-8 text-center">
          <p class="mt-2 text-sm" style="color:var(--text-soft)">No favorites yet. Tap Save on any listing to save it here.</p>
      <a href="/search" class="btn btn-primary mt-4">Browse the directory</a>
    </div>
  </div>
  <script>
    import { formatRegionForDisplay } from '@/lib/location';

    const favs = JSON.parse(localStorage.getItem('cl:favorites:v1') ?? '[]');
    const grid = document.getElementById('fav-grid');
    const empty = document.getElementById('fav-empty');
    if (!favs.length) {
      empty?.classList.remove('hidden');
    } else {
      fetch(`/api/favorites?ids=${encodeURIComponent(favs.join(','))}`)
        .then((r) => r.json())
        .then((data) => {
          const items = data.listings ?? [];
          if (!items.length || !grid) { empty?.classList.remove('hidden'); return; }
          // Listing fields are owner-controlled: build nodes with textContent, never innerHTML.
          const el = (tag: string, className: string, text?: string) => {
            const node = document.createElement(tag);
            if (className) node.className = className;
            if (text !== undefined) node.textContent = text;
            return node;
          };
          grid.replaceChildren(...items.map((l: any) => {
            const article = el('article', 'card card-hover overflow-hidden');
            const link = document.createElement('a');
            link.className = 'block p-5';
            link.href = `/directory/${encodeURIComponent(String(l.slug ?? ''))}`;
            const type = el('p', 'text-xs font-bold uppercase tracking-wide', String(l.typeSlug ?? ''));
            type.style.color = 'var(--teal)';
            const name = el('p', 'mt-1 text-lg font-bold', String(l.name ?? ''));
            const tagline = el('p', 'mt-1 text-sm', String(l.tagline ?? ''));
            tagline.style.color = 'var(--text-soft)';
            const where = l.isOnlineOnly ? 'Online' : `${l.city ?? ''}, ${formatRegionForDisplay(l.region)}`;
            const meta = el('p', 'mt-2 text-sm', `★ ${Number(l.rating ?? 0).toFixed(1)} • ${where}`);
            link.append(type, name, tagline, meta);
            article.append(link);
            return article;
          }));
        })
        .catch(() => empty?.classList.remove('hidden'));
    }
  </script>
</BaseLayout>
