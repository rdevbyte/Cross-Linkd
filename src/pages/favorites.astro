---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
---
<BaseLayout user={user} seo={{ title: 'My Favorites — CrossLinkd', description: 'Your saved listings, collections, and followed ministries.', path: '/favorites', noindex: true }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-extrabold">My favorites</h1>
    <p class="section-sub">Saved on this device{user ? ` for ${user.displayName}` : ''}. Sign in on production to sync across devices.</p>
    <div id="fav-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div id="fav-empty" class="card mt-6 hidden p-8 text-center">
          <p class="mt-2 text-sm" style="color:var(--text-soft)">No favorites yet. Tap Save on any listing to save it here.</p>
      <a href="/search" class="btn btn-primary mt-4">Browse the directory</a>
    </div>
  </div>
  <script>
    const favs = JSON.parse(localStorage.getItem('cl:favorites:v1') ?? '[]');
    const grid = document.getElementById('fav-grid');
    const empty = document.getElementById('fav-empty');
    if (!favs.length) {
      empty?.classList.remove('hidden');
    } else {
      fetch(`/api/favorites?ids=${encodeURIComponent(favs.join(','))}`)
        .then((r) => r.json())
        .then((data) => {
          const items = data.listings ?? [];
          if (!items.length || !grid) { empty?.classList.remove('hidden'); return; }
          grid.innerHTML = items.map((l: any) => `
            <article class="card card-hover overflow-hidden">
              <a href="/directory/${l.slug}" class="block p-5">
                <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">${l.typeSlug}</p>
                <p class="mt-1 text-lg font-bold">${l.name}</p>
                <p class="mt-1 text-sm" style="color:var(--text-soft)">${l.tagline ?? ''}</p>
                <p class="mt-2 text-sm">★ ${Number(l.rating).toFixed(1)} • ${l.isOnlineOnly ? 'Online' : `${l.city}, ${l.region}`}</p>
              </a>
            </article>`).join('');
        })
        .catch(() => empty?.classList.remove('hidden'));
    }
  </script>
</BaseLayout>
