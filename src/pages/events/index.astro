---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SAMPLE_EVENTS, eventDate, type SampleEvent } from '@/data/events';
import { includeSamples } from '@/lib/sampleGate';
const user = Astro.locals.user;
const cat = Astro.url.searchParams.get('category');
const events: SampleEvent[] = (includeSamples() ? [...SAMPLE_EVENTS] : [])
  .filter((e) => !cat || e.category === cat)
  .sort((a, b) => a.startsInDays - b.startsInDays);
const cats = includeSamples() ? [...new Set(SAMPLE_EVENTS.map((e) => e.category))] : [];
---
<BaseLayout user={user} seo={{ title: 'Christian Events — Conferences, Worship Nights, Retreats', description: 'Find church services, conferences, concerts, retreats, volunteer opportunities, and more.', path: '/events' }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-extrabold">Upcoming events</h1>
    <p class="section-sub">Worship nights, conferences, retreats, serve days, and gatherings across traditions.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <a href="/events" class={`chip ${!cat ? 'chip-active' : ''}`}>All</a>
      {cats.map((c) => <a href={`/events?category=${encodeURIComponent(c)}`} class={`chip ${cat === c ? 'chip-active' : ''}`}>{c}</a>)}
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
      {events.map((e) => (
        <a href={`/events/${e.slug}`} class="card card-hover overflow-hidden">
          <div class="h-28" style={`background:hsl(${e.hue},26%,80%)`}></div>
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">
              {eventDate(e.startsInDays).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}
            </p>
            <p class="mt-1 font-bold">{e.title}</p>
            <p class="mt-1 line-clamp-2 text-sm" style="color:var(--text-soft)">{e.description}</p>
            <p class="mt-2 text-[13px]" style="color:var(--text-mute)">{e.format === 'online' ? 'Online' : `${e.venue ?? ''} • ${e.city}${e.region ? `, ${e.region}` : ''}`} • {e.cost}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
