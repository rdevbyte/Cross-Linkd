---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublicListings } from '@/lib/publicListings';
import { FOCUS_STATES } from '@/data/locations';
import { slugify } from '@/lib/slug';
import { isUsRegion, SHORT_DISCLAIMER } from '@/lib/trustCopy';
import { formatRegionForDisplay } from '@/lib/location';

const corpus = await getPublicListings();
const user = Astro.locals.user;

// Only display states and cities that actually have published listings
interface CityItem {
  city: string;
  region: string;
  slug: string;
  count: number;
}

interface StateGroup {
  name: string;
  abbr: string;
  slug: string;
  count: number;
  cities: CityItem[];
}

const stateMap = new Map<string, StateGroup>();
for (const item of corpus) {
  if (!item.isOnlineOnly && item.city && item.region) {
    const regionUpper = item.region.trim().toUpperCase();
    const cityTrimmed = item.city.trim();
    const matchingFocusState = FOCUS_STATES.find((s) => s.abbr === regionUpper);
    const stateName = matchingFocusState?.name ?? regionUpper;
    const stateSlug = matchingFocusState?.slug ?? slugify(stateName);

    let group = stateMap.get(regionUpper);
    if (!group) {
      group = {
        name: stateName,
        abbr: regionUpper,
        slug: stateSlug,
        count: 0,
        cities: [],
      };
      stateMap.set(regionUpper, group);
    }
    group.count += 1;

    let cityItem = group.cities.find((c) => c.city.toLowerCase() === cityTrimmed.toLowerCase());
    if (!cityItem) {
      cityItem = {
        city: cityTrimmed,
        region: regionUpper,
        slug: slugify(`${cityTrimmed}-${regionUpper}`),
        count: 0,
      };
      group.cities.push(cityItem);
    }
    cityItem.count += 1;
  }
}

const activeStates = Array.from(stateMap.values()).sort((a, b) => b.count - a.count);
activeStates.forEach((s) => s.cities.sort((a, b) => b.count - a.count));

const seo = {
  title: 'Browse locations | CrossLinkd',
  description: `Browse directory listings by place. ${SHORT_DISCLAIMER}`,
  path: '/browse/locations',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold">Browse by location</h1>
    <p class="section-sub">
      {activeStates.length > 0
        ? `Only places with published listings appear here. Search suggestions focus on selected metros in Texas, Tennessee, Georgia, Arizona, and Colorado; other places appear when listings are published. Coverage is not comprehensive. ${SHORT_DISCLAIMER}`
        : 'No places are listed yet. Locations appear here when profiles are published. Search suggestions focus on selected U.S. metros; coverage is not comprehensive.'}
    </p>

    {activeStates.length > 0 ? (
      activeStates.map((state) => (
        <section class="mt-8" aria-label={state.name}>
          <div class="flex items-baseline justify-between">
            <h2 class="text-xl font-semibold">
              <a href={isUsRegion(state.abbr) ? `/states/${state.slug}` : (state.cities[0] ? `/locations/${state.cities[0].slug}` : '/search')} class="hover:underline">{formatRegionForDisplay(state.abbr)}</a>
            </h2>
            <span class="chip">{state.count} {state.count === 1 ? 'listing' : 'listings'}</span>
          </div>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
            {state.cities.map((c) => (
              <a href={`/locations/${c.slug}`} class="card card-hover p-4">
                <div class="flex items-baseline justify-between gap-2">
                  <p class="font-bold">{c.city}, {formatRegionForDisplay(c.region)}</p>
                  <span class="chip !py-0.5 !text-[11px] font-bold">{c.count}</span>
                </div>
                <p class="mt-1 text-[13px]" style="color:var(--text-soft)">Published listings in this location.</p>
              </a>
            ))}
            <a href={`/search?near=${encodeURIComponent(state.name)}`} class="card card-hover p-4">
              <p class="font-bold">All of {formatRegionForDisplay(state.abbr)}</p>
              <p class="mt-1 text-[13px]" style="color:var(--text-soft)">Search published listings in this place.</p>
            </a>
          </div>
        </section>
      ))
    ) : (
      <div class="card mt-8 flex flex-col items-center justify-center p-8 text-center sm:p-12">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h2 class="mt-4 text-lg font-semibold">No places listed yet</h2>
        <p class="mt-2 max-w-md text-sm leading-relaxed" style="color:var(--text-soft)">
          Location cards show where profiles have been published. They do not indicate that listings were checked or endorsed.
        </p>
      </div>
    )}

    <div class="card mt-10 p-6">
      <h2 class="font-semibold">Online-only listings</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">
        If an online-only profile includes a service area, it was supplied with the listing. <a href="/search?onlineOnly=1" class="underline">Browse online-only listings</a>. {SHORT_DISCLAIMER}
      </p>
    </div>
  </div>
</BaseLayout>
