---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { allProfessions, industryBySlug } from '@/data/industries';
import { getPublicListings } from '@/lib/publicListings';

const corpus = await getPublicListings();
const user = Astro.locals.user;
const profs = allProfessions();
const countFor = (slug: string) => corpus.filter((l) => l.professions.includes(slug)).length;
const publishedCount = profs.reduce((sum, profession) => sum + countFor(profession.slug), 0);
---
<BaseLayout user={user} seo={{ title: 'Browse Professions — CrossLinkd', description: 'Find Christian professionals: counselors, attorneys, realtors, photographers, contractors, and more.', path: '/browse/professions' }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-bold">Browse professions</h1>
    <p class="section-sub">Some professions are regulated. A “Regulated profession” label means the field often requires a license. CrossLinkd does not confirm that license.</p>
    {publishedCount === 0 && (
      <p class="card mt-6 p-4 text-sm leading-relaxed" style="color:var(--text-soft)" role="status">No published listings use these professions yet. A profession with zero listings is not a coverage claim.</p>
    )}
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
      {profs.map((p) => (
        <a href={`/professions/${p.slug}`} class="card card-hover p-4">
          <p class="font-bold">{p.name} {p.requiresLicense && <span class="badge-verify ml-1" style="background:var(--surface-2);color:var(--text-soft)">Regulated profession</span>}</p>
          <p class="mt-1 text-[13px]" style="color:var(--text-mute)">{industryBySlug(p.industrySlug)?.name} • {countFor(p.slug)} listing(s)</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
