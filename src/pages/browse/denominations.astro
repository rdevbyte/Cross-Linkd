---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DENOMINATIONS, TRADITIONS } from '@/data/denominations';
import { getPublicListings } from '@/lib/publicListings';

const corpus = await getPublicListings();
const user = Astro.locals.user;
const countFor = (slug: string) => corpus.filter((listing) => listing.denominations.includes(slug)).length;
const publishedCount = DENOMINATIONS.reduce((sum, denomination) => sum + countFor(denomination.slug), 0);
const groups = [...TRADITIONS]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((tradition) => ({
    ...tradition,
    items: DENOMINATIONS.filter((denomination) => denomination.tradition === tradition.slug).sort((a, b) => a.name.localeCompare(b.name)),
  }))
  .filter((group) => group.items.length > 0);
---
<BaseLayout user={user} seo={{ title: 'Browse Traditions — CrossLinkd', description: 'Traditions and denominations used on published listings. A denomination is self-identified, not a CrossLinkd endorsement.', path: '/browse/denominations' }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-bold">Browse traditions</h1>
    <p class="section-sub">A denomination on a listing is self-identified. It is not a CrossLinkd endorsement or a verification.</p>
    {publishedCount === 0 && (
      <p class="card mt-6 p-4 text-sm leading-relaxed" style="color:var(--text-soft)" role="status">No published listings name a denomination yet. A tradition with zero listings is not a coverage claim.</p>
    )}
    <div class="mt-8 space-y-8">
      {groups.map((group) => (
        <section aria-labelledby={`tradition-${group.slug}`}>
          <h2 id={`tradition-${group.slug}`} class="text-xl font-semibold">{group.name}</h2>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((denomination) => (
              <a href={`/denominations/${denomination.slug}`} class="card card-hover p-4">
                <p class="font-bold">{denomination.name}</p>
                <p class="mt-1 text-[13px]" style="color:var(--text-mute)">{countFor(denomination.slug)} published listing{countFor(denomination.slug) === 1 ? '' : 's'}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
