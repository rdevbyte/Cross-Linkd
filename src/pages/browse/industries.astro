---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { INDUSTRIES } from '@/data/industries';
import { getPublicListings } from '@/lib/publicListings';

const corpus = await getPublicListings();
const user = Astro.locals.user;
const countFor = (slug: string) => corpus.filter((l) => l.industries.includes(slug)).length;
const publishedCount = INDUSTRIES.reduce((sum, industry) => sum + countFor(industry.slug), 0);
---
<BaseLayout user={user} seo={{ title: 'Browse Industries — CrossLinkd', description: 'Explore every industry in the directory, from skilled trades to healthcare to creative services.', path: '/browse/industries' }}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-bold">Browse industries</h1>
    <p class="section-sub">Industry → Category → Profession → Service. Listings can belong to multiple industries.</p>
    {publishedCount === 0 && (
      <p class="card mt-6 p-4 text-sm leading-relaxed" style="color:var(--text-soft)" role="status">No published listings are in these industries yet. A category with zero listings is not a coverage claim, and this page does not invent businesses to fill it.</p>
    )}
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
      {INDUSTRIES.map((i) => (
        <a href={`/industries/${i.slug}`} class="card card-hover p-5">
          <p class="font-bold">{i.name}</p>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">{i.description}</p>
          <p class="mt-2 text-[13px]" style="color:var(--text-mute)">{i.categories.length} categories • {countFor(i.slug)} published listing{countFor(i.slug) === 1 ? '' : 's'}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
