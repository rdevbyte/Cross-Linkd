---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
const sent = Astro.url.searchParams.get('sent') === '1';
const topic = Astro.url.searchParams.get('topic') ?? '';
const error = Astro.url.searchParams.get('error') ?? '';
const topics: [string, string][] = [
  ['general', 'General question'],
  ['support', 'Listing support'],
  ['status', 'Listing status'],
  ['inaccurate', 'Report inaccurate information'],
  ['duplicate', 'Report a duplicate'],
  ['spam', 'Report spam or impersonation'],
  ['correction', 'Request a correction'],
  ['removal', 'Request removal'],
  ['report', 'Report a listing'],
  ['review', 'Report a review'],
  ['appeals', 'Appeals'],
  ['partnership', 'Partnership'],
  ['press', 'Press'],
];
const selectedTopic = topics.find(([id]) => id === topic)?.[0]
  ?? topics.find(([, label]) => label.toLowerCase() === topic.toLowerCase())?.[0]
  ?? topics.find(([, label]) => topic && label.toLowerCase().includes(topic.toLowerCase()))?.[0]
  ?? 'general';
---
<BaseLayout user={user} seo={{ title: 'Contact — CrossLinkd', description: 'Send a message to CrossLinkd. A saved message is not a promise of a reply time, and a reply is not a verification.', path: '/contact' }}>
  <div class="mx-auto max-w-xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Contact us</h1>
    <p class="section-sub">A person can read saved messages. We do not promise a reply within 1–2 business days.</p>

    <div class="card mt-4 p-5 text-sm leading-relaxed" style="color:var(--text-soft)">
      <p>Have a question about a listing, a report, or the community guidelines? Submit your message below. A reply is not a verification of a business.</p>
    </div>

    {sent ? (
      <div class="card mt-6 p-6" style="border-left:4px solid var(--teal)" role="status"><p class="font-bold">Message saved</p><p class="text-sm" style="color:var(--text-soft)">A person can read it from the contact inbox. We do not promise a reply time, and a reply is not a verification of a business.</p></div>
    ) : (
      <form method="POST" action="/api/contact" class="card mt-6 space-y-4 p-6">
        <input type="hidden" name="return" value="/contact" />
        <p class="hp-field" aria-hidden="true"><label>Leave this blank<input type="text" name="hp_company" tabindex="-1" autocomplete="off" /></label></p>
        {error && <p class="rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-700" role="alert">{error}</p>}
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="text-sm font-medium">Name<input name="name" required class="input mt-1.5" value={user?.displayName ?? ''} /></label>
          <label class="text-sm font-medium">Email<input name="email" type="email" required class="input mt-1.5" value={user?.email ?? ''} /></label>
        </div>
        <label class="block text-sm font-medium">Topic
          <select name="topic" class="input mt-1.5">
            {topics.map(([id, label]) => (
              <option value={label} selected={id === selectedTopic}>{label}</option>
            ))}
          </select>
        </label>
        <label class="block text-sm font-medium">Message<textarea name="message" required rows="5" class="input mt-1.5"></textarea></label>
        <button class="btn btn-primary w-full !py-3" type="submit">Send message</button>
      </form>
    )}
  </div>
</BaseLayout>
