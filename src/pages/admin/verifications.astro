---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
const user = Astro.locals.user;
const rows = [
  ['Grace & Grain Bakery', 'Christian-Owned', 'Evidence: business license + staff page', 'pending'],
  ['Mercy Well Counseling', 'Credential', 'License LPC-S #TX-88231 — auto-check passed', 'pending'],
  ['Psalm 23 Media', '✓ Claimed', 'Work email verified; domain pending', 'pending'],
  ['Cornerstone Plumbing', 'Domain', 'TXT record found ✓', 'ready'],
];
const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;

---
<DashboardLayout user={user} admin active="verifications" seo={{ title: 'Admin: Verifications', description: 'Review verifications.', path: '/admin/verifications', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Verification review</h1>
  <div class="card p-3 text-[13px] mt-3" style="border-left:4px solid var(--accent)" role="note"><strong>Preview data.</strong> This section shows illustrative sample content while the platform is in preview; live data replaces it as activity grows.</div>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Requirements per badge: <a href="/trust" class="underline">Trust page</a>. Never imply denominational endorsement.</p>
  <div class="mt-4 space-y-3">
    {rows.map(([name, badge, evidence, state]) => (
      <div class="card p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div><p class="font-bold">{name}</p><p class="text-[13px]" style="color:var(--text-mute)">{badge} • {evidence}</p></div>
          <span class="chip !text-[11px]">{state === 'ready' ? 'Ready to approve' : 'Needs review'}</span>
        </div>
        <div class="mt-3 flex gap-2">
          <button class="btn btn-primary !py-1.5 !text-sm" type="button" onclick="alert('Badge granted! (demo)')">Approve</button>
          <button class="btn btn-secondary !py-1.5 !text-sm" type="button" onclick="alert('More evidence requested. (demo)')">Request evidence</button>
          <button class="btn btn-ghost !py-1.5 !text-sm" type="button" onclick="alert('Rejected with note. (demo)')">Reject</button>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
