---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';

const gate = requireAdminPage(Astro);
if (gate) return gate;
const user = Astro.locals.user;
---
<DashboardLayout user={user} admin active="verifications" seo={{ title: 'Admin: Listing notes', description: 'Internal notes about listing labels. This is not a verification queue.', path: '/admin/verifications', noindex: true }}>
  <h1 class="text-2xl font-bold">Listing notes</h1>
  <p class="mt-1 text-sm leading-relaxed" style="color:var(--text-soft)">This page does not approve verification badges or certify businesses. Public labels describe a recorded submission source, account access to manage a profile, or directory status.</p>
  <div class="card mt-6 p-6">
    <h2 class="font-semibold">No listing-verification queue</h2>
    <p class="mt-2 text-sm leading-relaxed" style="color:var(--text-soft)">CrossLinkd does not independently verify listing details. Inclusion is not an endorsement. Use the listings and messages queues for their existing moderation tasks.</p>
  </div>
</DashboardLayout>
