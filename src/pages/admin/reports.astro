---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
const user = Astro.locals.user;
const rows = [
  ['Duplicate', '“Grace & Grain” vs “Grace and Grain Bakery”', 'open'],
  ['Impersonation', 'Claim of fake pastor profile', 'triaging'],
  ['Spam', 'Bulk identical reviews from new accounts', 'open'],
  ['Copyright', 'Profile photo reuse allegation', 'triaging'],
  ['Inappropriate content', 'Youth listing photo report', 'open'],
];
const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;

---
<DashboardLayout user={user} admin active="reports" seo={{ title: 'Admin: Reports', description: 'Handle reports.', path: '/admin/reports', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Reports & duplicates</h1>
  <div class="card p-3 text-[13px] mt-3" style="border-left:4px solid var(--accent)" role="note"><strong>Preview data.</strong> This section shows illustrative sample content while the platform is in preview; live data replaces it as activity grows.</div>
  <div class="mt-4 space-y-3">
    {rows.map(([kind, desc, state]) => (
      <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
        <div><p class="font-bold">{kind}</p><p class="text-sm" style="color:var(--text-soft)">{desc}</p></div>
        <div class="flex items-center gap-2">
          <span class="chip !text-[11px]">{state}</span>
          <button class="btn btn-secondary !py-1.5 !text-sm" type="button" onclick="alert('Marked resolved. (demo)')">Resolve</button>
          <button class="btn btn-ghost !py-1.5 !text-sm" type="button" onclick="alert('Dismissed. (demo)')">Dismiss</button>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
