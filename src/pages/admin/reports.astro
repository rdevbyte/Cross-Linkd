---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { desc, eq } from 'drizzle-orm';
import { getDb, hasDatabase } from '@/db/client';
import { listings, reports } from '@/db/schema';
import { requireAdminPage } from '@/lib/guards';

const gate = requireAdminPage(Astro);
if (gate) return gate;
const user = Astro.locals.user;

let rows: Array<{ id: string; reason: string; details: string; status: string; listing: string; created: string }> = [];
let unavailable = !hasDatabase();
if (hasDatabase()) {
  const db = getDb();
  if (!db) unavailable = true;
  else {
    try {
      const records = await db
        .select({
          id: reports.id,
          reason: reports.reason,
          details: reports.details,
          status: reports.status,
          createdAt: reports.createdAt,
          listingName: listings.name,
        })
        .from(reports)
        .leftJoin(listings, eq(reports.listingId, listings.id))
        .orderBy(desc(reports.createdAt))
        .limit(100);
      rows = records.map((row) => ({
        id: row.id,
        reason: row.reason,
        details: row.details ?? '',
        status: row.status,
        listing: row.listingName ?? 'No linked listing',
        created: row.createdAt ? row.createdAt.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : '',
      }));
    } catch (err) {
      console.error('[admin/reports] query failed', err instanceof Error ? err.name : 'error');
      unavailable = true;
    }
  }
}
---
<DashboardLayout user={user} admin active="reports" seo={{ title: 'Admin: Reports', description: 'Saved contact messages and reports.', path: '/admin/reports', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Reports and messages</h1>
  <p class="section-sub">Contact, feedback, appeal, and listing-inquiry forms save here. Reading a message does not verify a business, and this page does not send a reply.</p>
  {unavailable ? (
    <p class="card mt-6 p-5 text-sm" role="status" style="color:var(--text-soft)">The directory database is not connected, so saved messages cannot be listed.</p>
  ) : rows.length === 0 ? (
    <p class="card mt-6 p-5 text-sm" role="status" style="color:var(--text-soft)">No saved messages yet.</p>
  ) : (
    <div class="mt-4 space-y-3">
      {rows.map((row) => (
        <article class="card p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-bold">{row.reason}</h2>
            <span class="chip !text-[11px]">{row.status}</span>
          </div>
          <p class="mt-1 text-xs" style="color:var(--text-mute)">{row.listing}{row.created ? ` · ${row.created}` : ''}</p>
          <pre class="mt-3 whitespace-pre-wrap text-sm leading-relaxed" style="color:var(--text-soft)">{row.details}</pre>
        </article>
      ))}
    </div>
  )}
</DashboardLayout>
