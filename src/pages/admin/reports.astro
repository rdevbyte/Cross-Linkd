---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { reports, listings } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;
const user = Astro.locals.user;

let rows: Array<{
  id: string;
  kind: string;
  reason: string;
  state: string;
  listingName: string;
}> = [];

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const records = await db
        .select({
          id: reports.id,
          reason: reports.reason,
          details: reports.details,
          status: reports.status,
          listingName: listings.name,
        })
        .from(reports)
        .leftJoin(listings, eq(reports.listingId, listings.id))
        .where(eq(reports.status, 'open'))
        .orderBy(desc(reports.createdAt));

      rows = records.map((r) => ({
        id: r.id,
        kind: r.reason,
        reason: r.details ?? (r.listingName ? `Report regarding ${r.listingName}` : 'No details provided'),
        state: r.status,
        listingName: r.listingName ?? 'Directory Listing',
      }));
    } catch (err) {
      console.error('[admin/reports] query failed:', err);
    }
  }
}
---
<DashboardLayout user={user} admin active="reports" seo={{ title: 'Admin: Reports', description: 'Handle reports.', path: '/admin/reports', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Reports & moderation</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Handle community flags, duplicate reports, and policy notices.</p>

  {rows.length === 0 ? (
    <div class="card mt-6 p-8 text-center sm:p-12">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <h2 class="mt-4 text-base font-bold">No active reports</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">All community reports and flags have been addressed.</p>
    </div>
  ) : (
    <div class="mt-4 space-y-3">
      {rows.map((r) => (
        <div class="card flex flex-wrap items-center justify-between gap-3 p-4">
          <div><p class="font-bold">{r.kind}</p><p class="text-sm" style="color:var(--text-soft)">{r.reason}</p></div>
          <div class="flex items-center gap-2">
            <span class="chip !text-[11px]">{r.state}</span>
            <button class="btn btn-secondary !py-1.5 !text-sm" type="button" onclick={`alert('Report ${r.id} marked resolved.')`}>Resolve</button>
            <button class="btn btn-ghost !py-1.5 !text-sm" type="button" onclick={`alert('Report ${r.id} dismissed.')`}>Dismiss</button>
          </div>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
