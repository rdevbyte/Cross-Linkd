---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { listings, reviews, users, listingClaims } from '@/db/schema';
import { sql } from 'drizzle-orm';

const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;
const user = Astro.locals.user;

let totalListings = 0;
let totalReviews = 0;
let totalUsers = 0;
let totalClaims = 0;

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const [lCount, rCount, uCount, cCount] = await Promise.all([
        db.select({ count: sql<number>`count(*)::int` }).from(listings),
        db.select({ count: sql<number>`count(*)::int` }).from(reviews),
        db.select({ count: sql<number>`count(*)::int` }).from(users),
        db.select({ count: sql<number>`count(*)::int` }).from(listingClaims),
      ]);
      totalListings = lCount[0]?.count ?? 0;
      totalReviews = rCount[0]?.count ?? 0;
      totalUsers = uCount[0]?.count ?? 0;
      totalClaims = cCount[0]?.count ?? 0;
    } catch (err) {
      console.error('[admin/analytics] query failed:', err);
    }
  }
}
---
<DashboardLayout user={user} admin active="analytics" seo={{ title: 'Admin: Analytics', description: 'Platform analytics.', path: '/admin/analytics', noindex: true }}>
  <h1 class="text-2xl font-bold">Platform analytics</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Live database records and platform usage metrics.</p>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {[
      ['Total listings', totalListings],
      ['Submitted reviews', totalReviews],
      ['Registered members', totalUsers],
      ['Ownership claims', totalClaims],
    ].map(([l, v]) => (
      <div class="card p-4">
        <p class="text-[13px]" style="color:var(--text-mute)">{l}</p>
        <p class="text-2xl font-bold">{v}</p>
      </div>
    ))}
  </div>

  <div class="card mt-6 p-6">
    <h2 class="font-semibold">Search & discovery insights</h2>
    <p class="mt-2 text-sm leading-relaxed" style="color:var(--text-soft)">
      Search telemetry is aggregated as visitors explore categories, denominations, and regional directories. Search queries yielding zero matches are monitored to inform category expansion.
    </p>
  </div>
</DashboardLayout>
