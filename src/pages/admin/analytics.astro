---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
const user = Astro.locals.user;
const searches = [['church near me', '12,480'], ['christian counselor', '8,204'], ['bakery #baptist', '5,911'], ['plumber dallas', '4,377'], ['worship night', '3,902']];
const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;

---
<DashboardLayout user={user} admin active="analytics" seo={{ title: 'Admin: Analytics', description: 'Platform analytics.', path: '/admin/analytics', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Platform analytics</h1>
  <div class="card p-3 text-[13px] mt-3" style="border-left:4px solid var(--accent)" role="note"><strong>Preview data.</strong> This section shows illustrative sample content while the platform is in preview; live data replaces it as activity grows.</div>
  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {[['Searches (30d)', '184k'], ['Listing views', '96k'], ['New listings', '312'], ['Reviews submitted', '1,204']].map(([l, v]) => (
      <div class="card p-4"><p class="text-[13px]" style="color:var(--text-mute)">{l}</p><p class="text-2xl font-extrabold">{v}</p></div>
    ))}
  </div>
  <div class="card mt-4 p-6">
    <h2 class="font-extrabold">Top search terms</h2>
    <ul class="mt-3 space-y-2 text-sm">{searches.map(([t, n]) => <li class="flex justify-between"><span>{t}</span><strong>{n}</strong></li>)}</ul>
    <p class="mt-3 text-[13px]" style="color:var(--text-mute)">Zero-result terms feed the taxonomy + content backlog. Full event-level analytics ship in Phase 2.</p>
  </div>
</DashboardLayout>
