---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { reviews, listings, users } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;
const user = Astro.locals.user;

let rows: Array<{
  id: string;
  listing: string;
  author: string;
  excerpt: string;
  state: string;
}> = [];

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const records = await db
        .select({
          id: reviews.id,
          rating: reviews.rating,
          body: reviews.body,
          status: reviews.status,
          listingName: listings.name,
          userEmail: users.email,
        })
        .from(reviews)
        .leftJoin(listings, eq(reviews.listingId, listings.id))
        .leftJoin(users, eq(reviews.authorId, users.id))
        .where(eq(reviews.status, 'pending'))
        .orderBy(desc(reviews.createdAt));

      rows = records.map((r) => ({
        id: r.id,
        listing: r.listingName ?? 'Directory Listing',
        author: r.userEmail ?? 'Member',
        excerpt: `★ ${r.rating}.0 — “${r.body?.slice(0, 100) ?? ''}”`,
        state: r.status,
      }));
    } catch (err) {
      console.error('[admin/reviews] query failed:', err);
    }
  }
}
---
<DashboardLayout user={user} admin active="reviews" seo={{ title: 'Admin: Reviews', description: 'Moderate reviews.', path: '/admin/reviews', noindex: true }}>
  <h1 class="text-2xl font-bold">Review moderation</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Policy: <a href="/reviews-policy" class="underline">Review Policy</a>. Never publish anonymous accusations of serious misconduct without process.</p>

  {rows.length === 0 ? (
    <div class="card mt-6 p-8 text-center sm:p-12">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h2 class="mt-4 text-base font-semibold">No reviews pending moderation</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Submitted user reviews will appear here for moderation. Approving a review does not verify the reviewer or the business.</p>
    </div>
  ) : (
    <div class="mt-4 space-y-3">
      {rows.map((r) => (
        <div class="card p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-bold">{r.listing} <span class="font-normal" style="color:var(--text-mute)">— {r.author}</span></p>
            <span class="chip !text-[11px]">{r.state === 'flagged' ? 'Flagged' : 'Pending'}</span>
          </div>
          <p class="mt-1 text-sm">{r.excerpt}</p>
          <div class="mt-3 flex gap-2">
            <button class="btn btn-primary !py-1.5 !text-sm" type="button" onclick={`alert('Review ${r.id} published.')`}>Publish</button>
            <button class="btn btn-ghost !py-1.5 !text-sm" type="button" onclick={`alert('Review ${r.id} removed.')`}>Remove</button>
          </div>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
