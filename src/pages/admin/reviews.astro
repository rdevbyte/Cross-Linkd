---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { reviews, listings, users } from '@/db/schema';
import { and, desc, eq, inArray, isNotNull, isNull } from 'drizzle-orm';

const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;
const user = Astro.locals.user;

let rows: Array<{
  id: string;
  listing: string;
  author: string;
  excerpt: string;
  state: string;
}> = [];
let pendingResponses: Array<{ id: string; listing: string; reviewBody: string; response: string }> = [];

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const records = await db
        .select({
          id: reviews.id,
          rating: reviews.rating,
          body: reviews.body,
          status: reviews.status,
          listingName: listings.name,
          userEmail: users.email,
        })
        .from(reviews)
        .leftJoin(listings, eq(reviews.listingId, listings.id))
        .leftJoin(users, eq(reviews.authorId, users.id))
        .where(and(inArray(reviews.status, ['pending', 'flagged']), isNull(reviews.deletedAt)))
        .orderBy(desc(reviews.createdAt));

      rows = records.map((r) => ({
        id: r.id,
        listing: r.listingName ?? 'Directory Listing',
        author: r.userEmail ?? 'Member',
        excerpt: `★ ${r.rating}.0 — “${r.body?.slice(0, 100) ?? ''}”`,
        state: r.status,
      }));

      const responseRecords = await db
        .select({ id: reviews.id, response: reviews.ownerResponse, reviewBody: reviews.body, listingName: listings.name })
        .from(reviews)
        .innerJoin(listings, eq(reviews.listingId, listings.id))
        .where(and(
          eq(reviews.status, 'published'),
          isNull(reviews.deletedAt),
          isNull(listings.deletedAt),
          isNull(reviews.ownerRespondedAt),
          isNotNull(reviews.ownerResponse),
        ))
        .orderBy(desc(reviews.updatedAt));
      pendingResponses = responseRecords.map((row) => ({
        id: row.id,
        listing: row.listingName,
        reviewBody: row.reviewBody ?? '',
        response: row.response ?? '',
      }));
    } catch (err) {
      console.error('[admin/reviews] query failed:', err);
    }
  }
}
---
<DashboardLayout user={user} admin active="reviews" seo={{ title: 'Admin: Reviews', description: 'Moderate reviews.', path: '/admin/reviews', noindex: true }}>
  <h1 class="text-2xl font-bold">Review moderation</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Policy: <a href="/reviews-policy" class="underline">Review Policy</a>. Never publish anonymous accusations of serious misconduct without process.</p>
  <div id="review-banner" class="card mt-4 hidden border-l-4 p-4" role="status" style="border-left-color:var(--accent)"><p id="review-banner-text" class="text-sm font-bold"></p></div>

  {rows.length === 0 ? (
    <div class="card mt-6 p-8 text-center sm:p-12">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h2 class="mt-4 text-base font-semibold">No pending or flagged reviews</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Submitted user reviews will appear here for moderation. Approving a review does not verify the reviewer or the business.</p>
    </div>
  ) : (
    <div class="mt-4 space-y-3">
      {rows.map((r) => (
        <div class="card p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-bold">{r.listing} <span class="font-normal" style="color:var(--text-mute)">— {r.author}</span></p>
            <span class="chip !text-[11px]">{r.state === 'flagged' ? 'Flagged' : 'Pending'}</span>
          </div>
          <p class="mt-1 text-sm">{r.excerpt}</p>
          <div class="mt-3 flex gap-2">
            <button class="btn btn-primary !py-1.5 !text-sm" type="button" data-review-action="publish" data-review-id={r.id}>Publish</button>
            <button class="btn btn-ghost !py-1.5 !text-sm" type="button" data-review-action="remove" data-review-id={r.id}>Remove</button>
          </div>
        </div>
      ))}
    </div>
  )}

  {pendingResponses.length > 0 && (
    <section class="mt-8" aria-labelledby="owner-response-moderation-heading">
      <h2 id="owner-response-moderation-heading" class="text-xl font-bold">Owner responses awaiting moderation</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Responses remain private until approved. Removing a response uses the one-response limit; owners cannot resubmit.</p>
      <div class="mt-4 space-y-3">
        {pendingResponses.map((item) => (
          <article class="card p-4">
            <p class="font-bold">{item.listing}</p>
            <p class="mt-2 text-xs font-bold uppercase tracking-wide" style="color:var(--text-mute)">Review</p>
            <p class="mt-1 text-sm" style="color:var(--text-soft)">{item.reviewBody || 'No review text was provided.'}</p>
            <p class="mt-3 text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">Owner response</p>
            <p class="mt-1 whitespace-pre-wrap text-sm" style="color:var(--text-soft)">{item.response}</p>
            <div class="mt-3 flex gap-2">
              <button class="btn btn-primary !py-1.5 !text-sm" type="button" data-review-action="publish_response" data-review-id={item.id}>Approve response</button>
              <button class="btn btn-ghost !py-1.5 !text-sm" type="button" data-review-action="remove_response" data-review-id={item.id}>Remove response</button>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <script>
    function showReviewError(message: string) {
      const banner = document.getElementById('review-banner');
      const text = document.getElementById('review-banner-text');
      if (!banner || !text) return;
      text.textContent = message;
      banner.style.borderLeftColor = 'var(--accent)';
      banner.classList.remove('hidden');
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-review-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.reviewId ?? '';
        const action = button.dataset.reviewAction ?? '';
        if (!id || !['publish', 'remove', 'publish_response', 'remove_response'].includes(action)) return;
        if ((action === 'remove' || action === 'remove_response') && !confirm(action === 'remove_response' ? 'Remove this response from public view?' : 'Remove this review from public view?')) return;
        button.disabled = true;
        try {
          const response = await fetch(`/api/admin/reviews/${encodeURIComponent(id)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action }),
          });
          const result = await response.json().catch(() => ({ ok: false, error: 'Unexpected server response.' }));
          if (response.ok && result.ok) location.reload();
          else showReviewError(result.error ?? 'Review moderation failed. Please try again.');
        } catch {
          showReviewError('Network error. Please try again.');
        } finally {
          button.disabled = false;
        }
      });
    });
  </script>
</DashboardLayout>
