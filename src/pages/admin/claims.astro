---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { desc, eq } from 'drizzle-orm';
import { getDb, hasDatabase } from '@/db/client';
import { listingClaims, listings } from '@/db/schema';
import { requireAdminPage } from '@/lib/guards';

const gate = requireAdminPage(Astro);
if (gate) return gate;
const user = Astro.locals.user;

let rows: Array<{ id: string; name: string; email: string; relationship: string; evidence: string; status: string; listing: string; created: string }> = [];
let unavailable = !hasDatabase();
if (hasDatabase()) {
  const db = getDb();
  if (!db) unavailable = true;
  else {
    try {
      const records = await db
        .select({
          id: listingClaims.id,
          name: listingClaims.claimantName,
          email: listingClaims.claimantEmail,
          relationship: listingClaims.relationship,
          evidence: listingClaims.evidence,
          status: listingClaims.status,
          createdAt: listingClaims.createdAt,
          listingName: listings.name,
        })
        .from(listingClaims)
        .leftJoin(listings, eq(listingClaims.listingId, listings.id))
        .orderBy(desc(listingClaims.createdAt))
        .limit(100);
      rows = records.map((row) => ({
        id: row.id,
        name: row.name ?? 'Unnamed claimant',
        email: row.email ?? '',
        relationship: row.relationship ?? '',
        evidence: row.evidence ?? '',
        status: row.status,
        listing: row.listingName ?? 'Listing not linked',
        created: row.createdAt ? row.createdAt.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : '',
      }));
    } catch (err) {
      console.error('[admin/claims] query failed', err instanceof Error ? err.name : 'error');
      unavailable = true;
    }
  }
}
---
<DashboardLayout user={user} admin active="claims" seo={{ title: 'Admin: Claims', description: 'Saved listing claim requests.', path: '/admin/claims', noindex: true }}>
  <h1 class="text-2xl font-bold">Listing claims</h1>
  <p class="section-sub">A saved claim is not an ownership verification. Claims for listings that are not in the database are stored with the other reports.</p>
  {unavailable ? (
    <p class="card mt-6 p-5 text-sm" role="status" style="color:var(--text-soft)">The directory database is not connected, so claims cannot be listed.</p>
  ) : rows.length === 0 ? (
    <p class="card mt-6 p-5 text-sm" role="status" style="color:var(--text-soft)">No claim rows yet. Check <a href="/admin/reports" class="underline">reports</a> for requests that could not be tied to a database listing.</p>
  ) : (
    <div class="mt-4 space-y-3">
      {rows.map((row) => (
        <article class="card p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-semibold">{row.listing}</h2>
            <span class="chip !text-[11px]">{row.status}</span>
          </div>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">{row.name} · {row.email} · {row.relationship}</p>
          <p class="mt-1 text-xs" style="color:var(--text-mute)">{row.created}</p>
          <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed" style="color:var(--text-soft)">{row.evidence}</p>
        </article>
      ))}
    </div>
  )}
</DashboardLayout>
