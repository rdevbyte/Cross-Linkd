---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdminPage } from '@/lib/guards';
import { getDb, hasDatabase } from '@/db/client';
import { listingClaims, listings, users } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

const __adminGate = requireAdminPage(Astro);
if (__adminGate) return __adminGate;
const user = Astro.locals.user;

let rows: Array<{
  id: string;
  listingName: string;
  who: string;
  evidence: string;
  when: string;
}> = [];

if (hasDatabase()) {
  const db = getDb();
  if (db) {
    try {
      const records = await db
        .select({
          id: listingClaims.id,
          createdAt: listingClaims.createdAt,
          evidenceNotes: listingClaims.evidence,
          listingName: listings.name,
          claimantEmail: users.email,
        })
        .from(listingClaims)
        .leftJoin(listings, eq(listingClaims.listingId, listings.id))
        .leftJoin(users, eq(listingClaims.claimantId, users.id))
        .where(eq(listingClaims.status, 'pending'))
        .orderBy(desc(listingClaims.createdAt));

      rows = records.map((r) => ({
        id: r.id,
        listingName: r.listingName ?? 'Unknown listing',
        who: r.claimantEmail ?? 'Claimant',
        evidence: r.evidenceNotes ?? 'No notes provided',
        when: new Date(r.createdAt).toLocaleDateString(),
      }));
    } catch (err) {
      console.error('[admin/claims] query failed:', err);
    }
  }
}
---
<DashboardLayout user={user} admin active="claims" seo={{ title: 'Admin: Claims', description: 'Review claims.', path: '/admin/claims', noindex: true }}>
  <h1 class="text-2xl font-extrabold">Listing claims</h1>
  <p class="mt-1 text-sm" style="color:var(--text-soft)">Review ownership claims for directory listings.</p>

  {rows.length === 0 ? (
    <div class="card mt-6 p-8 text-center sm:p-12">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h2 class="mt-4 text-base font-bold">No pending claims</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">When members submit proof of business ownership, they will appear here for review.</p>
    </div>
  ) : (
    <div class="mt-4 space-y-3">
      {rows.map((r) => (
        <div class="card p-4">
          <p class="font-bold">{r.listingName}</p>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">{r.who} • {r.when}</p>
          <p class="mt-1 text-sm">Evidence: {r.evidence}</p>
          <div class="mt-3 flex gap-2">
            <button class="btn btn-primary !py-1.5 !text-sm" type="button" onclick={`alert('Claim ${r.id} approved.')`}>Approve & transfer</button>
            <button class="btn btn-ghost !py-1.5 !text-sm" type="button" onclick={`alert('Claim ${r.id} rejected.')`}>Reject</button>
          </div>
        </div>
      ))}
    </div>
  )}
</DashboardLayout>
