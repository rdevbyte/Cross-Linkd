---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LONG_DISCLAIMER } from '@/lib/trustCopy';
const user = Astro.locals.user;
const seo = {
  title: 'About CrossLinkd — Who We Are & How We Work',
  description: 'CrossLinkd is a small, one-person community directory. Listings may be submitted by owners or community members; details are not independently verified.',
  path: '/about',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">About CrossLinkd</h1>
    <p class="section-sub">A small, independently run, one-person directory — not a denomination, church network, or marketing agency.</p>

    <div class="prose-custom mt-8 space-y-4 text-[15px] leading-relaxed" style="color:var(--text-soft)">
      <p>
        <strong style="color:var(--text)">Why we built this.</strong> CrossLinkd helps people find Christian businesses and community organizations, and helps those organizations share a directory profile. It does not decide which business is right for you.
      </p>
      <p>
        <strong style="color:var(--text)">Who and where.</strong> The directory includes businesses, churches, ministries, schools, nonprofits, professionals, and related organizations. Location suggestions focus on selected U.S. metros: Dallas–Fort Worth, Nashville, Atlanta, Phoenix, and Colorado Springs. Other places appear only when profiles are published; online-only profiles are shown separately. Coverage is not comprehensive.
      </p>
      <p>
        <strong style="color:var(--text)">How to read a listing.</strong> Profiles may be submitted by business owners or community members. Where the submission source is recorded, it is labeled on the profile. Details are not independently verified, and directory inclusion is not an endorsement.
      </p>
      <p>
        <strong style="color:var(--text)">What we are not.</strong> We are not a denomination and do not judge anyone's doctrine. We describe traditions neutrally and do not rank them. Listing information, including faith, ownership, licenses, credentials, and service quality, is not independently verified by CrossLinkd.
      </p>
      <p>
        <strong style="color:var(--text)">How owners can manage a profile.</strong> An owner or authorized representative can request access to update an existing listing. Management access is not proof that the business or its claims have been verified.
      </p>
    </div>

    <div class="card mt-8 p-5 text-sm leading-relaxed" style="color:var(--text-soft)">
      <p>{LONG_DISCLAIMER}</p>
      <p class="mt-3">Use the <a href="/contact?topic=inaccurate" class="underline">contact form</a> to flag inaccurate, outdated, spam, or inappropriate content for review. No response time or outcome is promised.</p>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/how-it-works" class="btn btn-secondary">How it works</a>
      <a href="/submission-policy" class="btn btn-secondary">Submission policy</a>
      <a href="/contact" class="btn btn-primary">Contact us</a>
    </div>
  </div>
</BaseLayout>
