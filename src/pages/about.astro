---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;

const team: { name: string; role: string; bio: string; hue: number }[] = [
  {
    name: 'Tom Whitaker',
    role: 'Founder',
    bio: 'Spent 12 years in local software and four years helping his church vet contractors for facility projects. Started CrossLinkd after watching neighbors get burned by directories that list anyone who pays.',
    hue: 36,
  },
  {
    name: 'Grace Okafor',
    role: 'Head of Review',
    bio: 'Former paralegal. Leads the two-person team that checks every listing, calls every phone number, and reads every verification document. Says no about 1 in 5 times.',
    hue: 160,
  },
  {
    name: 'Diego Ramos',
    role: 'Community & Moderation',
    bio: 'Handles reviews, reports, and appeals. Answers the contact inbox within one business day. Former food-bank volunteer coordinator in Phoenix.',
    hue: 200,
  },
];

const seo = {
  title: 'About CrossLinkd — Who We Are & How We Work',
  description: 'Meet the small team behind CrossLinkd, why we built a hand-reviewed directory of Christian-owned businesses, and exactly how the directory is managed.',
  path: '/about',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">About CrossLinkd</h1>
    <p class="section-sub">A small, independent company in Dallas, Texas. We are not a denomination, a church network, or a marketing agency.</p>

    <div class="prose-custom mt-8 space-y-4 text-[15px] leading-relaxed" style="color:var(--text-soft)">
      <p>
        <strong style="color:var(--text)">Why we built this.</strong> People want to hire businesses that share their values, and Christian
        business owners want to be findable. But "Christian directory" searches turn up sites where anyone can pay for a listing and nobody
        checks it. We thought that could be done better: fewer listings, checked by hand, with badges that show their dates.
      </p>
      <p>
        <strong style="color:var(--text)">What we are.</strong> CrossLinkd is a directory and discovery service serving six metro areas:
        Dallas–Fort Worth, Nashville, Atlanta, Phoenix, and Colorado Springs. We list Christian-owned businesses, churches, ministries, and
        professionals. We check every listing before it goes live.
      </p>
      <p>
        <strong style="color:var(--text)">What we are not.</strong> We are not a denomination and we do not judge anyone's doctrine. We describe
        traditions neutrally and never rank them. A badge means we checked identity and evidence — nothing more. Directory inclusion is not
        an endorsement.
      </p>
      <p>
        <strong style="color:var(--text)">How we operate.</strong> Listing, claiming, and verification are free — CrossLinkd does not charge
        for anything right now. We do not sell your data and we do not run third-party ad networks. If we ever introduce paid features,
        they will be clearly explained here first.
      </p>
    </div>

    <h2 class="mt-12 text-2xl font-extrabold">The team</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {team.map((m) => (
        <div class="card p-5 text-center">
          <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full text-xl font-extrabold text-white" style={`background:hsl(${m.hue},45%,55%)`} aria-hidden="true">{m.name.split(' ').map((n) => n[0]).join('')}</span>
          <p class="mt-3 font-bold">{m.name}</p>
          <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">{m.role}</p>
          <p class="mt-2 text-[13px] leading-relaxed" style="color:var(--text-soft)">{m.bio}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-12 text-2xl font-extrabold">How the directory is managed</h2>
    <div class="prose-custom mt-3 space-y-3 text-[15px] leading-relaxed" style="color:var(--text-soft)">
      <p>Every listing passes a human review before publication — see <a href="/how-it-works" class="underline">how it works</a>. Reviews are screened under our <a href="/reviews-policy" class="underline">review &amp; moderation policy</a>, with a separate reviewer for <a href="/appeals" class="underline">appeals</a>. Our <a href="/editorial-policy" class="underline">editorial policy</a> governs the guides we publish, and the <a href="/submission-policy" class="underline">submission policy</a> explains what we accept and what we remove.</p>
      <p>We re-verify badges periodically and retire listings we cannot keep current. Owners can claim their listing and update it anytime.</p>
    </div>

    <div class="card mt-10 p-6">
      <h2 class="text-lg font-extrabold">Contact us</h2>
      <ul class="mt-2 space-y-1 text-sm" style="color:var(--text-soft)">
        <li><a href="mailto:hello@crosslinkd.com" class="underline">hello@crosslinkd.com</a> — we reply within 1–2 business days</li>
        <li><a href="tel:+12145550100" class="underline">(214) 555-0100</a> — Mon–Fri, 9–5 CT</li>
        <li>CrossLinkd LLC · Dallas, Texas</li>
      </ul>
      <a href="/contact" class="btn btn-primary mt-4 !py-2 !text-sm">Send us a message</a>
    </div>
  </div>
</BaseLayout>
