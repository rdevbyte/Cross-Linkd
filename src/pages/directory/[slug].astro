---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import FavoriteButton from '@/components/FavoriteButton';
import StatusBadge from '@/components/StatusBadge.astro';
import TypeGlyph from '@/components/TypeGlyph.astro';
import QRShare from '@/components/QRShare';
import { type SampleListing, type SampleReview } from '@/data/listings';
import { getPublicListings, findPublicListing } from '@/lib/publicListings';
import { typeBySlug } from '@/data/listing-types';
import { denominationBySlug } from '@/data/denominations';
import { industryBySlug, categoryBySlug, professionBySlug } from '@/data/industries';
import { compact, timeAgo, fullDate } from '@/lib/format';
import { recentlyUpdatedState } from '@/lib/recentlyUpdated.mjs';
import { localBusinessSchema, breadcrumbSchema } from '@/lib/seo';
import { careersUrlError } from '@/lib/hiringUrl.mjs';
import { formatRegionForDisplay } from '@/lib/location';
import { REPORT_DISCLOSURE, SUBMISSION_SOURCES } from '@/lib/trustCopy';

const { slug } = Astro.params;
const listing: SampleListing | undefined = slug ? await findPublicListing(slug) : undefined;
if (!listing) return Astro.redirect('/search', 302);

const user = Astro.locals.user;
const sent = Astro.url.searchParams.get('sent') === '1';
const formError = Astro.url.searchParams.get('error') ?? '';
const canClaimListing = listing.claimable === true;
const type = typeBySlug(listing.typeSlug);
const cityName = listing.city?.trim() ?? '';
const regionName = listing.region?.trim() ?? '';
const hasPhysicalLocation = !listing.isOnlineOnly && Boolean(cityName || regionName);
const locationLabel = listing.isOnlineOnly
  ? 'Online-only'
  : [cityName, regionName ? formatRegionForDisplay(regionName) : ''].filter(Boolean).join(', ');
const locationSlug = hasPhysicalLocation
  ? [cityName, regionName].filter(Boolean).join('-').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
  : '';
const hasHours = Boolean(listing.hours && Object.keys(listing.hours).length > 0);
const hasAbout = Boolean(listing.description.trim() || listing.statementOfFaith || listing.hashtags.length > 0);
const hasServices = Boolean(listing.services.length > 0 || listing.serviceArea?.trim());
const siteUrl = Astro.url.origin;
const pageUrl = `${siteUrl}/directory/${listing.slug}`;
const profileUpdatedAtMs = listing.updatedAt ? Date.parse(listing.updatedAt) : Number.NaN;
const profileUpdatedAtLabel = Number.isFinite(profileUpdatedAtMs)
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(profileUpdatedAtMs))
  : undefined;
const meaningfulUpdateState = recentlyUpdatedState(listing.recentlyUpdatedAt);
const meaningfulUpdateMs = listing.recentlyUpdatedAt ? Date.parse(listing.recentlyUpdatedAt) : Number.NaN;
const meaningfulUpdateDate = Number.isFinite(meaningfulUpdateMs)
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(meaningfulUpdateMs))
  : undefined;
const analyticsListingId = /^db-[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(listing.id) ? listing.id.slice(3) : undefined;

const related = (await getPublicListings()).filter((l) =>
  l.slug !== listing?.slug && l.industries.some((i) => listing?.industries.includes(i)),
).slice(0, 3);

const badgeLabels: Record<string, [string, string]> = {
  claimed: ['Owner-managed', 'The listing is connected to an account that can manage or update it. This does not verify the business or its details.'],
  christian_owned: ['Self-identified Christian-owned', 'The submitter identifies the business as Christian-owned. CrossLinkd does not independently verify that claim.'],
};
const submissionSource = listing.submissionSource ? SUBMISSION_SOURCES[listing.submissionSource] : undefined;

const reviews: SampleReview[] = listing.reviews ?? [];
const socialLinks: [string, string][] = listing.social
  ? (Object.entries(listing.social).filter(([, v]) => Boolean(v)) as [string, string][])
  : [];
const faithNames = (listing.denominations ?? [])
  .filter((d) => d !== 'other')
  .map((d) => denominationBySlug(d)?.name ?? d);
if (listing.customDenomination) faithNames.push(listing.customDenomination);
if (!faithNames.length && listing.denominations?.includes('other')) faithNames.push('Other');
const faithLabel = faithNames.join(', ');
const hasFaithLabel = listing.showDenomination !== false && Boolean(faithLabel);
const hasAdditionalDetails = Boolean(
  hasFaithLabel || listing.languages.length > 0 || listing.accessibility.length > 0
  || Number.isFinite(listing.addedDaysAgo) || socialLinks.length > 0,
);
const socialHref = (network: string, value: string) => {
  if (/^https?:\/\//i.test(value)) return value;
  const domain = network === 'x' ? 'x.com' : network === 'linkedin' ? 'linkedin.com' : `${network}.com`;
  return `https://${domain}/${value.replace(/^@/, '')}`;
};

const socialIcons: Record<string, string> = { facebook: 'f', instagram: '◎', youtube: '▶', x: '𝕏', linkedin: 'in' };
const careersHref = listing.careersUrl && !careersUrlError(listing.careersUrl) ? listing.careersUrl : '';

const seo = {
  title: listing.isOnlineOnly
    ? `${listing.name} — Online listing | CrossLinkd`
    : hasPhysicalLocation ? `${listing.name} — ${locationLabel} | CrossLinkd` : `${listing.name} | CrossLinkd`,
  description: `${listing.name}${listing.tagline ? ` — ${listing.tagline}` : ''}. Listing details are not independently verified; inclusion is not an endorsement.`.slice(0, 160),
  path: `/directory/${listing.slug}`,
  schema: [
    localBusinessSchema({
      name: listing.name, description: listing.description || undefined, url: pageUrl,
      phone: listing.phone, email: listing.email, city: cityName || undefined, region: regionName || undefined,
      rating: listing.rating, reviewCount: listing.reviewCount, priceRange: listing.priceRange || undefined,
      lat: listing.lat, lng: listing.lng,
      sameAs: socialLinks.map(([k, v]) => socialHref(k, v)),
    }),
    breadcrumbSchema([
      { name: 'Home', url: siteUrl },
      { name: type.plural, url: `${siteUrl}/search?type=${type.slug}` },
      ...(hasPhysicalLocation ? [{ name: `Listings in ${locationLabel}`, url: `${siteUrl}/locations/${locationSlug}` }] : []),
      { name: listing.name, url: pageUrl },
    ]),
  ],
};

// Type-specific highlight blocks
const isChurch = listing.typeSlug === 'church';
const isPro = ['professional', 'counselor', 'contractor'].includes(listing.typeSlug);

const categoryMatch = listing.categorySlug ? categoryBySlug(listing.categorySlug) : undefined;
const industryMatch = listing.industrySlug ? industryBySlug(listing.industrySlug) : categoryMatch?.industry;
const displayCategory = listing.customCategory || categoryMatch?.category?.name;
const displayProfessions = listing.professions.map((slug) => professionBySlug(slug)?.name ?? slug.replace(/-/g, ' '));
---
<BaseLayout seo={seo} user={user}>
  <div class="mx-auto max-w-7xl px-4 py-6" data-listing-detail={analyticsListingId ? 'true' : undefined} data-listing-id={analyticsListingId}>
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href={`/search?type=${type.slug}`}>{type.plural}</a></li>
        {hasPhysicalLocation && <li><a href={`/locations/${locationSlug}`}>{locationLabel}</a></li>}
        <li aria-current="page">{listing.name}</li>
      </ol>
    </nav>

    <!-- Header: a short tinted band, then the identity block on the surface -->
    <div class="card mt-4 overflow-hidden" style={`--hue:${listing.imageHue}`}>
      <div class="listing-band relative h-24 sm:h-28">
        {listing.coverUrl && <img src={listing.coverUrl} alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover" />}
        <span class="absolute right-4 top-4 z-10 opacity-40" style="color:var(--navy)"><TypeGlyph name={type.icon} size={28} /></span>
      </div>
      <div class="flex flex-col gap-3 px-4 sm:flex-row sm:items-start sm:gap-5 sm:px-6">
        {listing.logoUrl ? <img src={listing.logoUrl} alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="listing-monogram -mt-8 sm:-mt-10 object-cover" /> : <span class="listing-monogram -mt-8 sm:-mt-10" aria-hidden="true">{listing.name.trim().charAt(0).toUpperCase()}</span>}
        <div class="min-w-0 flex-1 pb-1 sm:pt-3">
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-semibold uppercase tracking-[0.12em]" style="color:var(--teal)">
            <span>{type.label}</span>
            {listing.featured && <span class="chip chip-featured !py-0 !text-[11px] normal-case tracking-normal">Highlighted</span>}
            {listing.foundedYear && <span class="normal-case tracking-normal" style="color:var(--text-mute)">· Est. {listing.foundedYear}</span>}
          </p>
          <h1 class="mt-1 text-2xl font-bold leading-tight sm:text-3xl">{listing.name}</h1>
        </div>
      </div>
      <div class="flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="space-y-2">
          {(displayCategory || industryMatch) && (
            <div class="flex items-center gap-2 pt-0.5">
              <span class="chip !text-[12px] font-semibold" style="background:rgba(46,146,131,.12);color:var(--teal)">
                {industryMatch?.name ? `${industryMatch.name} › ` : ''}{displayCategory ?? industryMatch?.name}
              </span>
            </div>
          )}
          {locationLabel && <p class="text-sm" style="color:var(--text-soft)"><strong style="color:var(--text)">Location:</strong> {locationLabel}{listing.postalCode ? ` ${listing.postalCode}` : ''}</p>}
          {listing.tagline && <p class="font-medium">{listing.tagline}</p>}
          {displayProfessions.length > 0 && <div class="flex flex-wrap gap-1.5" aria-label="Professions">{displayProfessions.map((name) => <span class="chip !text-xs">{name}</span>)}</div>}
          <p class="text-sm" style="color:var(--text-soft)">
            {listing.reviewCount > 0 ? (
              <>★ <strong>{listing.rating.toFixed(1)}</strong> ({listing.reviewCount} reviews)</>
            ) : (
              <>No reviews yet</>
            )}
            {listing.recommendations > 0 ? ` · ${compact(listing.recommendations)} community notes` : ''}
            {listing.priceRange ? ` · ${listing.priceRange}` : ''}
          </p>
          {profileUpdatedAtLabel && <p class="text-xs" style="color:var(--text-mute)"><time datetime={listing.updatedAt}>Public listing record last updated {profileUpdatedAtLabel}</time>. This is not a verification.</p>}
          {meaningfulUpdateDate && <p class="text-xs" style="color:var(--text-mute)">{meaningfulUpdateState && <span class="recent-update-badge mr-1"><strong>Recently Updated</strong><time datetime={listing.recentlyUpdatedAt}>{meaningfulUpdateState.label}</time></span>}Owner-published profile update: <time datetime={listing.recentlyUpdatedAt}>{meaningfulUpdateDate}</time>. This timestamp does not imply verification or endorsement.</p>}
          <div class="flex flex-wrap gap-1.5">
            {submissionSource && <StatusBadge name={submissionSource.name} definition={submissionSource.definition} />}
            {listing.claimed && <StatusBadge name="Owner-managed" definition="An account can manage or update this profile. This does not verify the business or its details." />}
            {listing.badges.filter((b) => badgeLabels[b]).map((b) => (
              <StatusBadge name={badgeLabels[b][0]} definition={badgeLabels[b][1]} />
            ))}
            {canClaimListing && <a href={`/claim-listing?listing=${listing.slug}`} class="btn btn-secondary !min-h-11 !px-3 !py-1.5 !text-xs">Request access to manage</a>}
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          {listing.phone && <a href={`tel:${listing.phone}`} class="btn btn-primary" data-listing-event="phone_click">Call now</a>}
          {listing.email && <a href={`mailto:${listing.email}`} class="btn btn-secondary" data-listing-event="email_click">Email</a>}
          {listing.website && <a href={listing.website} target="_blank" rel="noopener" class="btn btn-secondary" data-listing-event="website_click">Website</a>}
          <FavoriteButton id={listing.id} label client:load />
          <QRShare client:load url={pageUrl} name={listing.name} />
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_340px]">
      <!-- Main -->
      <div class="space-y-6">
        {listing.photos && listing.photos.length > 0 && (
          <section aria-label="Photos">
            <div class="grid grid-cols-3 gap-2">
              {listing.photos.map((p) => (
                <figure class="photo-tile relative h-28 overflow-hidden rounded-2xl sm:h-36" style={`--hue:${p.hue}`} title="No photo uploaded yet">
                  {p.url ? <img src={p.url} alt={p.alt ?? p.caption} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover" /> : <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-40" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>}
                  <figcaption class="absolute bottom-2 left-2 right-2 truncate text-[11px] font-medium" style="color:var(--text-soft)">{p.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {hasAbout && <section class="card p-6" aria-label="About">
          <h2 class="text-lg font-semibold">About</h2>
          <p class="mt-1 text-xs" style="color:var(--text-mute)">Profile text, credentials, and faith statements below are provided by the submitter. CrossLinkd has not independently checked them.</p>
          {listing.description && <p class="mt-2 text-[15px] leading-relaxed" style="color:var(--text-soft)">{listing.description}</p>}
          {listing.statementOfFaith && (
            <blockquote class="mt-4 rounded-2xl p-4 pl-5 text-[15px] italic" style="background:var(--surface-2)">
              “{listing.statementOfFaith}”
              <footer class="mt-1 text-xs not-italic" style="color:var(--text-mute)">— Statement of faith, provided by the listing</footer>
            </blockquote>
          )}
          <div class="mt-4 flex flex-wrap gap-1.5">
            {listing.hashtags.map((t) => <a href={`/search?q=${encodeURIComponent('#' + t)}`} class="chip hover:border-[var(--accent)]">#{t}</a>)}
          </div>
        </section>}

        {hasServices && <section id="services" class="card p-6" aria-label="Services">
          <h2 class="text-lg font-semibold">{isChurch ? 'Ministries & gatherings' : isPro ? 'Services & expertise' : 'Products & services'}</h2>
          {listing.services.length > 0 && <div class="mt-3 flex flex-wrap gap-2">
            {listing.services.map((s) => <a href={`/search?q=${encodeURIComponent(s)}`} class="chip !px-3.5 !py-1.5 !text-[13px] hover:border-[var(--accent)]">{s}</a>)}
          </div>}
          {listing.serviceArea && (
            <p class="mt-4 text-sm" style="color:var(--text-soft)"><strong style="color:var(--text)">Service area:</strong> {listing.serviceArea}</p>
          )}
        </section>}

        {hasHours && (
          <section class="card p-6" aria-label="Hours">
            <h2 class="text-lg font-semibold">Hours</h2>
            <dl class="mt-3 grid max-w-md grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
              {Object.entries(listing.hours ?? {}).map(([d, h]) => (
                <><dt style="color:var(--text-mute)">{d}</dt><dd class="text-right font-medium">{h}</dd></>
              ))}
            </dl>
            {listing.openNow && <p class="mt-3 inline-block rounded-full px-3 py-1 text-xs font-bold" style="background:rgba(46,146,131,.14);color:var(--teal)">● Open now</p>}
          </section>
        )}

        <section class="card p-6" aria-label="Contact">
          <h2 class="text-lg font-semibold">Ask CrossLinkd about this listing</h2>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">This form sends a message to CrossLinkd, not the organization. Use the public contact options above to reach the organization directly.</p>
          {sent && <p class="mt-3 rounded-xl p-3 text-sm" style="background:rgba(46,146,131,.12)" role="status">Message saved in CrossLinkd’s inbox. The listing owner is not emailed automatically.</p>}
          {formError && <p class="mt-3 rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-700" role="alert">{formError}</p>}
          <form method="POST" action="/api/contact" class="mt-3 space-y-3" data-listing-contact-form>
            <input type="hidden" name="topic" value="Listing inquiry" />
            <input type="hidden" name="listing" value={listing.slug} />
            <input type="hidden" name="return" value={`/directory/${listing.slug}`} />
            <p class="hp-field" aria-hidden="true"><label>Leave this blank<input type="text" name="hp_company" tabindex="-1" autocomplete="off" /></label></p>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="text-sm font-medium">Your name<input name="name" required class="input mt-1" autocomplete="name" /></label>
              <label class="text-sm font-medium">Email or phone<input name="email" required class="input mt-1" autocomplete="email" /></label>
            </div>
            <label class="block text-sm font-medium">Message<textarea name="message" rows="3" required class="input mt-1" placeholder={`Hi — I found you on CrossLinkd and have a question about ${listing.services[0]?.toLowerCase() ?? 'your services'}.`}></textarea></label>
            <button class="btn btn-primary !py-2.5" type="submit">Send message to CrossLinkd</button>
            <p class="text-xs" style="color:var(--text-mute)">This message is saved in CrossLinkd’s contact inbox and is not forwarded to the listing owner.</p>
          </form>
        </section>

        <section class="card p-6" aria-label="Reviews" id="reviews">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold">Reviews & recommendations</h2>
            <a href="#write-review" class="btn btn-secondary !py-1.5 !text-sm">Write a review</a>
          </div>
          <div class="mt-4 space-y-4">
            {reviews.map((rev) => (
              <article class="border-b pb-4 last:border-0" style="border-color:var(--border)">
                <div class="flex items-center gap-2">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold" style="background:var(--surface-2)">{rev.name.charAt(0)}</span>
                  <div>
                    <p class="text-sm font-bold">{rev.name} <span class="badge-verify ml-1" style="background:var(--surface-2);color:var(--text-soft)">Community-submitted review</span></p>
                    <p class="text-xs" style="color:var(--text-mute)">★ {rev.rating}.0 • {timeAgo(rev.daysAgo)}</p>
                  </div>
                </div>
                <p class="mt-2 text-sm font-bold">{rev.title}</p>
                <p class="mt-0.5 text-sm" style="color:var(--text-soft)">{rev.body}</p>
                {rev.ownerResponse && (
                  <div class="mt-2.5 rounded-2xl p-3 pl-4 text-sm" style="background:var(--surface-2)">
                    <p class="text-xs font-bold" style="color:var(--teal)">Response from the owner</p>
                    <p class="mt-1" style="color:var(--text-soft)">{rev.ownerResponse}</p>
                  </div>
                )}
              </article>
            ))}
          </div>
          <form id="write-review" method="POST" action="/api/reviews" class="surface-soft mt-4 rounded-2xl p-4">
            <h3 class="font-semibold">Share your experience</h3>
            <p class="mt-1 text-[13px]" style="color:var(--text-soft)">Reviews are moderated. Please review your experience — not theology. <a href="/reviews-policy" class="underline">Review policy</a></p>
            <input type="hidden" name="listingId" value={listing.id} />
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="text-sm">Rating
                <select name="rating" class="input mt-1" required><option value="5">★★★★★ 5</option><option value="4">★★★★ 4</option><option value="3">★★★ 3</option><option value="2">★★ 2</option><option value="1">★ 1</option></select>
              </label>
              <label class="text-sm">Headline<input name="title" maxlength="160" class="input mt-1" placeholder="Sum it up" /></label>
            </div>
            <label class="mt-3 block text-sm">Your review<textarea name="body" rows="3" maxlength="3000" class="input mt-1" placeholder="What should others know?"></textarea></label>
            <button class="btn btn-primary mt-3 !py-2 !text-sm" type="submit">Submit review</button>
          </form>
        </section>

        {related.length > 0 && (
          <section aria-label="Related listings">
            <h2 class="text-lg font-semibold">Related listings</h2>
            <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((l) => <ListingCard listing={l} />)}
            </div>
          </section>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-4">
        {listing.isHiring && (
          <div class="card p-5">
            <h2 class="font-semibold">Hiring</h2>
            <p class="mt-2 text-sm" style="color:var(--text-soft)">This company says it is hiring. That statement was provided by the listing.</p>
            {careersHref && (
              <a href={careersHref} class="btn btn-secondary mt-3 !min-h-11" target="_blank" rel="noopener noreferrer">View open positions</a>
            )}
          </div>
        )}
        <div class="card p-5">
          <h2 class="font-semibold">Listing status</h2>
          <ul class="mt-3 space-y-2 text-sm" style="color:var(--text-soft)">
            <li><strong style="color:var(--text)">Submission source:</strong> {submissionSource?.name ?? 'Not recorded'}</li>
            <li class="flex flex-wrap items-center gap-2">
              {listing.claimed
                ? <><StatusBadge name="Owner-managed" /> An account can manage or update this profile. This does not verify the business or its details.</>
                : <>No owner-management account is linked. An owner may request access to update the profile; access does not verify the business or its claims.</>}
            </li>
            <li>Listing details are not independently verified. Inclusion is not an endorsement.</li>
          </ul>
          <a href="/how-it-works#statuses" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold underline" style="color:var(--teal)">What these labels mean</a>
        </div>
        {hasAdditionalDetails && <div class="card p-5">
          <h2 class="font-semibold">Additional details</h2>
          <dl class="mt-3 space-y-2 text-sm">
            {hasFaithLabel && <div><dt class="font-semibold" style="color:var(--text-mute)">Faith affiliation</dt><dd>{faithLabel}</dd></div>}
            {listing.languages.length > 0 && <div><dt class="font-semibold" style="color:var(--text-mute)">Languages</dt><dd>{listing.languages.join(', ')}</dd></div>}
            {listing.accessibility.length > 0 && <div><dt class="font-semibold" style="color:var(--text-mute)">Accessibility</dt><dd>{listing.accessibility.join(' • ')}</dd></div>}
            {Number.isFinite(listing.addedDaysAgo) && <div><dt class="font-semibold" style="color:var(--text-mute)">Added to directory</dt><dd>{fullDate(listing.addedDaysAgo!)}</dd></div>}
          </dl>
          {socialLinks.length > 0 && (
            <>
              <h3 class="mt-4 text-sm font-semibold">Follow</h3>
              <div class="mt-2 flex flex-wrap gap-2">
                {socialLinks.map(([k, v]) => (
                  <a
                    href={socialHref(k, v)}
                    target="_blank" rel="noopener"
                    class="flex h-9 items-center gap-1.5 rounded-xl border px-3 text-xs font-bold transition-colors hover:border-[var(--accent)]"
                    style="border-color:var(--border);color:var(--text-soft)"
                    aria-label={`${listing.name} on ${k}`}
                    data-listing-event="social_click"
                  >
                    {k === 'x' ? 'X' : k.charAt(0).toUpperCase() + k.slice(1)}
                  </a>
                ))}
              </div>
            </>
          )}
        </div>}
        <div class="card space-y-2 p-5">
          <p class="text-xs leading-relaxed" style="color:var(--text-mute)">{REPORT_DISCLOSURE}</p>
          <a href={`/contact?topic=inaccurate&listing=${listing.slug}`} class="btn btn-ghost w-full !justify-start !text-sm">Flag inaccurate or outdated information</a>
          <a href={`/contact?topic=spam&listing=${listing.slug}`} class="btn btn-ghost w-full !justify-start !text-sm">Report spam or inappropriate content</a>
          <a href={`/contact?topic=correction&listing=${listing.slug}`} class="btn btn-ghost w-full !justify-start !text-sm">Request a correction</a>
          {canClaimListing && <a href={`/claim-listing?listing=${listing.slug}`} class="btn btn-ghost w-full !justify-start !text-sm">Request access to manage</a>}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
