---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import ListingCard from '@/components/ListingCard.astro';
import SearchBar from '@/components/SearchBar';
import { getDbListings, getPublicListings } from '@/lib/publicListings';
import { ARTICLES } from '@/data/articles';
import { industryBySlug } from '@/data/industries';
import { LISTING_TYPES } from '@/data/listing-types';
import { slugify } from '@/lib/slug';
import { isUsRegion } from '@/lib/trustCopy';
import { calculateHomepageMetrics, formatMetricCount, metricNoun } from '@/lib/homeMetrics.mjs';

const user = Astro.locals.user;
const [corpus, publishedDatabaseListings] = await Promise.all([getPublicListings(), getDbListings()]);
const homepageMetrics = calculateHomepageMetrics(publishedDatabaseListings);
const metricCards = [
  {
    label: 'Location coverage',
    value: formatMetricCount(homepageMetrics.statesRepresented, 'state', 'states'),
    detail: `${formatMetricCount(homepageMetrics.citiesRepresented, 'city', 'cities')} across the U.S.`,
  },
  {
    label: 'Top location',
    value: homepageMetrics.topState?.name ?? '—',
    detail: homepageMetrics.topState && homepageMetrics.topCity
      ? `${homepageMetrics.topCity.city}, ${homepageMetrics.topCity.state} · ${formatMetricCount(homepageMetrics.topState.listingCount, 'listing', 'listings')} statewide · ${homepageMetrics.topCity.listingCount.toLocaleString()} in the city`
      : homepageMetrics.topState
        ? `${formatMetricCount(homepageMetrics.topState.listingCount, 'listing', 'listings')} statewide · No city data`
        : 'No U.S. location data yet',
  },
  {
    label: `Recent ${metricNoun(homepageMetrics.recentlyAdded, 'listing', 'listings')}`,
    value: homepageMetrics.recentlyAdded.toLocaleString(),
    detail: 'Added in the past 30 days',
  },
  {
    label: `Active ${metricNoun(homepageMetrics.activeListings, 'listing', 'listings')}`,
    value: homepageMetrics.activeListings.toLocaleString(),
    detail: 'Live in the directory now',
  },
];

interface ActiveLocation {
  city: string;
  region: string;
  slug: string;
  count: number;
}

const locationMap = new Map<string, ActiveLocation>();
for (const item of corpus) {
  if (!item.isOnlineOnly && item.city && item.region) {
    const key = `${item.city.trim().toLowerCase()}-${item.region.trim().toLowerCase()}`;
    const existing = locationMap.get(key);
    if (existing) existing.count += 1;
    else {
      locationMap.set(key, {
        city: item.city.trim(),
        region: item.region.trim().toUpperCase(),
        slug: slugify(`${item.city.trim()}-${item.region.trim()}`),
        count: 1,
      });
    }
  }
}
const activeLocations = Array.from(locationMap.values()).sort((a, b) => b.count - a.count);
const onlineOnlyCount = corpus.filter((l) => l.isOnlineOnly).length;
const hasInternational = activeLocations.some((loc) => !isUsRegion(loc.region));
const locationChoices = [
  ...(onlineOnlyCount > 0 ? [{ label: 'Online', value: 'Online', kind: 'online' }] : []),
  ...activeLocations.map((loc) => ({
    label: `${loc.city}, ${loc.region}`,
    value: `${loc.city}, ${loc.region}`,
    kind: isUsRegion(loc.region) ? 'city' : 'outside the U.S.',
  })),
];

const available = [...corpus].sort((a, b) => (a.addedDaysAgo ?? Number.POSITIVE_INFINITY) - (b.addedDaysAgo ?? Number.POSITIVE_INFINITY)).slice(0, 6);

const industryCounts = new Map<string, { label: string; count: number; href: string }>();
for (const listing of corpus) {
  const slug = listing.industrySlug || listing.industries[0];
  const industry = slug ? industryBySlug(slug) : undefined;
  if (industry) {
    const existing = industryCounts.get(industry.slug);
    if (existing) existing.count += 1;
    else industryCounts.set(industry.slug, {
      label: industry.name,
      count: 1,
      href: `/industries/${industry.slug}`,
    });
    continue;
  }
  const type = LISTING_TYPES.find((t) => t.slug === listing.typeSlug);
  if (!type) continue;
  const existing = industryCounts.get(`type:${type.slug}`);
  if (existing) existing.count += 1;
  else industryCounts.set(`type:${type.slug}`, {
    label: type.plural,
    count: 1,
    href: `/search?type=${encodeURIComponent(type.slug)}`,
  });
}
const populatedCategories = Array.from(industryCounts.values()).sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const preferredGuides = [
  'questions-before-trusting-christian-label',
  'vetting-a-contractor-who-shares-your-values',
  'how-crosslinkd-verifies-a-business',
];
const guides = preferredGuides
  .map((slug) => ARTICLES.find((article) => article.slug === slug))
  .filter((article): article is (typeof ARTICLES)[number] => Boolean(article))
  .map((article) => ({
    ...article,
    linkedListings: article.relatedListingSlugs
      .map((slug) => corpus.find((listing) => listing.slug === slug))
      .filter((listing): listing is (typeof corpus)[number] => Boolean(listing)),
  }));

const ownerSteps = [
  ['Submit a basic listing', 'Name, contact, and what you offer. The basic listing is free.'],
  ['Provide accurate information', 'You are responsible for what the profile says, including any faith or credential statement.'],
  ['Receive a completeness review', 'Missing fields may be flagged. This is not a check of licenses, beliefs, or service quality.'],
  ['Claim or confirm the listing', 'Show control of a contact channel, then confirm the profile when details change.'],
  ['Keep information current', 'Update hours, service area, and contact details when they change.'],
  ['Respond to corrections or reports', 'Readers can flag a problem. You can correct the profile or reply through the contact process.'],
];

const siteUrl = (Astro.site ?? Astro.url).toString().replace(/\/$/, '');
const seo = {
  title: 'CrossLinkd — Community-listed Christian businesses',
  description: 'Discover community-listed Christian businesses, churches, and ministries. Browse owner-submitted listings and decide for yourself. CrossLinkd does not independently verify faith, licenses, or service quality.',
  path: '/',
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'CrossLinkd',
      url: `${siteUrl}/`,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'CrossLinkd',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/favicon.svg`,
    },
  ],
};
---
<BaseLayout seo={seo} user={user}>
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="mx-auto max-w-4xl px-4 pb-6 pt-8 sm:pt-14">
      <p class="hero-eyebrow text-[12px] font-semibold uppercase tracking-[0.14em]" style="color:var(--accent)">Community directory</p>
      <h1 id="home-heading" class="mt-3 max-w-3xl text-[2rem] font-bold leading-[1.1] sm:text-5xl">
        Discover community-listed Christian businesses, churches, and ministries.
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg" style="color:var(--text-soft)">
        Browse owner-submitted listings, learn how each profile was added or updated, and make informed decisions for yourself.
      </p>

      <div class="card mt-7 p-4 sm:p-6">
        <SearchBar client:load labeled locationChoices={locationChoices} />
        <div class="mt-4 flex flex-col gap-3 border-t pt-4 sm:flex-row sm:items-center sm:justify-between" style="border-color:var(--border)">
          {populatedCategories.length > 0 ? (
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[12px] font-medium" style="color:var(--text-mute)">Popular:</span>
              {populatedCategories.slice(0, 4).map((category) => (
                <a href={category.href} class="chip">{category.label}</a>
              ))}
            </div>
          ) : <span />}
          <p class="text-[13px] sm:text-right" style="color:var(--text-mute)">Search covers published listings only.</p>
        </div>
      </div>

    </div>
  </section>

  <section class="mx-auto mt-6 max-w-7xl px-4" aria-labelledby="directory-metrics-heading" aria-label="Directory metrics">
    <h2 id="directory-metrics-heading" class="sr-only">Directory at a glance</h2>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {metricCards.map((metric) => (
        <article class="card min-w-0 p-4 sm:p-5">
          <p class="text-xs font-semibold" style="color:var(--text-mute)">{metric.label}</p>
          <p class="mt-2 truncate text-xl font-bold sm:text-2xl" title={metric.value}>{metric.value}</p>
          <p class="mt-1 text-xs leading-relaxed" style="color:var(--text-soft)">{metric.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <Section
    title="Available listings"
    sub={corpus.length > 0
      ? (available.length === corpus.length
        ? `Every published listing is shown. ${corpus.length} ${corpus.length === 1 ? 'listing is' : 'listings are'} in the directory right now.`
        : `Showing the ${available.length} newest of ${corpus.length} published listings.`)
      : 'No listings are published yet.'}
    href={corpus.length > available.length ? '/search?sort=newest' : undefined}
    linkLabel="See all listings"
  >
    {available.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {available.map((listing) => <ListingCard listing={listing} />)}
      </div>
    ) : (
      <div class="card p-6 text-center sm:p-10">
        <h3 class="text-xl font-semibold">Help grow the directory by adding a business or organization.</h3>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed" style="color:var(--text-soft)">
          There is nothing to browse yet. A free listing is owner-submitted. Publishing it does not verify the organization.
        </p>
        <a href="/add-listing" class="btn btn-primary mt-4 inline-flex">Submit a real listing</a>
      </div>
    )}
  </Section>

  <Section id="browse-published" title="Browse what is published" sub={hasInternational
    ? 'Categories and places appear only when a published listing uses them. Some places are outside the United States. This is not a coverage map or a verification.'
    : 'Categories and places appear only when a published listing uses them. This is not a national network or a verification.'}
  >
    {populatedCategories.length === 0 && activeLocations.length === 0 && onlineOnlyCount === 0 ? (
      <div class="card p-6 text-sm leading-relaxed" style="color:var(--text-soft)">
        No categories or places to browse yet. Help grow the directory by adding a business or organization.
      </div>
    ) : (
      <div class="space-y-8">
        {populatedCategories.length > 0 && (
          <div>
            <h3 class="text-base font-semibold">Categories with listings</h3>
            <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {populatedCategories.map((category) => (
                <a href={category.href} class="card card-hover flex items-center justify-between gap-3 p-4">
                  <span class="font-bold">{category.label}</span>
                  <span class="chip shrink-0">{category.count} {category.count === 1 ? 'listing' : 'listings'}</span>
                </a>
              ))}
            </div>
          </div>
        )}
        {(activeLocations.length > 0 || onlineOnlyCount > 0) && (
          <div>
            <h3 class="text-base font-semibold">Places with listings</h3>
            {hasInternational && (
              <p class="mt-1 text-sm" style="color:var(--text-soft)">Includes locations outside the United States. A city name is where the listing says it is based.</p>
            )}
            <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {activeLocations.map((loc) => (
                <a href={`/locations/${loc.slug}`} class="card card-hover p-4">
                  <span class="flex items-center justify-between gap-3">
                    <span class="font-bold">{loc.city}, {loc.region}</span>
                    <span class="chip shrink-0">{loc.count}</span>
                  </span>
                  <span class="mt-1 block text-sm" style="color:var(--text-soft)">{isUsRegion(loc.region) ? 'Owner-submitted' : 'Owner-submitted, outside the U.S.'}</span>
                </a>
              ))}
              {onlineOnlyCount > 0 && (
                <a href="/search?onlineOnly=1" class="card card-hover p-4">
                  <span class="flex items-center justify-between gap-3">
                    <span class="font-bold">Online</span>
                    <span class="chip shrink-0">{onlineOnlyCount}</span>
                  </span>
                  <span class="mt-1 block text-sm" style="color:var(--text-soft)">Listings that say they work without a storefront.</span>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    )}
  </Section>

  <Section title="For business owners" sub="Free forever for the basic listing. No credit card required.">
    <div class="card p-6 sm:p-8">
      <ol class="grid gap-4 sm:grid-cols-2">
        {ownerSteps.map(([title, body], index) => (
          <li class="flex gap-3">
            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold" style="background:var(--surface-2);border:1px solid var(--border-strong)" aria-hidden="true">{index + 1}</span>
            <span>
              <span class="block font-bold">{title}</span>
              <span class="mt-0.5 block text-sm leading-relaxed" style="color:var(--text-soft)">{body}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="mt-6">
        <a href="/submission-policy" class="text-sm font-semibold underline" style="color:var(--teal)">Read the submission policy</a>
      </p>
    </div>
  </Section>

  <Section title="Guides" sub="Practical questions to ask yourself. These articles are secondary to search, and they do not confirm that a business was verified." href="/articles" linkLabel="All guides">
    <div class="grid gap-3 md:grid-cols-3">
      {guides.map((article) => (
        <article class="card p-5">
          <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--text-mute)">{article.category}</p>
          <h3 class="mt-2 font-semibold leading-snug">
            <a href={`/articles/${article.slug}`} class="hover:underline">{article.title}</a>
          </h3>
          <p class="mt-2 text-sm leading-relaxed" style="color:var(--text-soft)">{article.excerpt}</p>
          {article.linkedListings.length > 0 && (
            <ul class="mt-3 space-y-1 text-sm">
              {article.linkedListings.map((listing) => (
                <li><a href={`/directory/${listing.slug}`} class="underline" style="color:var(--teal)">Published listing: {listing.name}</a></li>
              ))}
            </ul>
          )}
          {article.relatedCategory && (
            <a href={article.relatedCategory.href} class="mt-3 inline-block text-sm font-semibold underline" style="color:var(--teal)">Related: {article.relatedCategory.label}</a>
          )}
        </article>
      ))}
    </div>
  </Section>

  <section class="mx-auto mt-16 max-w-3xl px-4 pb-8 text-center" aria-labelledby="close-heading">
    <div class="card px-5 py-10 sm:px-10">
      <h2 id="close-heading" class="text-2xl font-semibold leading-snug sm:text-3xl">Help build a clearer, more transparent directory for your community.</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed" style="color:var(--text-soft)">
        Add an accurate listing, or browse what is already published. CrossLinkd does not independently verify the organizations you find here.
      </p>
    </div>
  </section>
</BaseLayout>
<style>
  /* Parchment surface: a soft brass wash in the corner plus a faint hairline
     grid, so the hero reads as a surface rather than an empty page. */
  .home-hero {
    position: relative;
    border-top: 2px solid color-mix(in srgb, var(--logo-gold) 65%, transparent);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(56rem 22rem at 12% -10%, var(--accent-soft), transparent 70%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 100% 3.5rem,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 3.5rem 100%,
      var(--bg-soft);
    background-blend-mode: normal, soft-light, soft-light, normal;
  }
  [data-theme='dark'] .home-hero {
    background:
      radial-gradient(56rem 22rem at 12% -10%, var(--accent-soft), transparent 70%),
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px) 0 0 / 100% 3.5rem,
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px) 0 0 / 3.5rem 100%,
      var(--bg-soft);
  }
  .min-h-11 { min-height: 44px; }
</style>
