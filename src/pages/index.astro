---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import ListingCard from '@/components/ListingCard.astro';
import SearchBar from '@/components/SearchBar';
import { includeSamples } from '@/lib/sampleGate';
import { getPublicListings } from '@/lib/publicListings';
import { getPublicTestimonials } from '@/lib/publicReviews';
import { ARTICLES } from '@/data/articles';
import { SAMPLE_EVENTS, eventDate } from '@/data/events';
import { slugify } from '@/lib/slug';

const user = Astro.locals.user;

// ---- Real metrics, computed from the public corpus (no inflated numbers) ----
const corpus = await getPublicListings();
const testimonials = await getPublicTestimonials();
const samplesOn = includeSamples();
const verified = corpus.filter((l) => l.verified).length;
const recent = corpus.filter((l) => l.addedDaysAgo <= 30).length;

// ---- Compute dynamic locations from published listings only (no empty or hardcoded cards) ----
interface ActiveLocation {
  city: string;
  region: string;
  slug: string;
  count: number;
}

const locationMap = new Map<string, ActiveLocation>();
for (const item of corpus) {
  if (!item.isOnlineOnly && item.city && item.region) {
    const key = `${item.city.trim().toLowerCase()}-${item.region.trim().toLowerCase()}`;
    const existing = locationMap.get(key);
    if (existing) {
      existing.count += 1;
    } else {
      locationMap.set(key, {
        city: item.city.trim(),
        region: item.region.trim().toUpperCase(),
        slug: slugify(`${item.city.trim()}-${item.region.trim()}`),
        count: 1,
      });
    }
  }
}
const activeLocations = Array.from(locationMap.values()).sort((a, b) => b.count - a.count);
const onlineOnlyCount = corpus.filter((l) => l.isOnlineOnly).length;
const hasLocations = activeLocations.length > 0 || onlineOnlyCount > 0;

// ---- Featured & verified first, then recent, then community picks ----
const featured = corpus.filter((l) => l.featured && l.verified).slice(0, 6);
const newest = [...corpus].sort((a, b) => a.addedDaysAgo - b.addedDaysAgo).slice(0, 4);
const upcoming = samplesOn ? [...SAMPLE_EVENTS].sort((a, b) => a.startsInDays - b.startsInDays).slice(0, 3) : [];

// ---- Popular categories with real counts ----
const categoryDefs: { label: string; q: string }[] = [
  { label: 'Plumbers & Electricians', q: 'plumber electrician' },
  { label: 'Contractors & Remodels', q: 'contractor remodeling' },
  { label: 'Auto Repair', q: 'auto repair' },
  { label: 'Accountants & Bookkeepers', q: 'accountant bookkeeping cpa' },
  { label: 'Counselors & Therapists', q: 'counselor therapy' },
  { label: 'Food, Bakeries & Coffee', q: 'bakery coffee catering restaurant' },
  { label: 'Real Estate & Insurance', q: 'realtor insurance' },
  { label: 'Photographers & Media', q: 'photographer media' },
  { label: 'Salons, Barbers & Fitness', q: 'salon barber fitness' },
  { label: 'Schools & Lessons', q: 'school lessons' },
  { label: 'Churches', q: 'church' },
  { label: 'Ministries & Nonprofits', q: 'ministry nonprofit' },
];
const categoryCount = (q: string) => {
  const terms = q.toLowerCase().split(' ');
  return corpus.filter((l) =>
    terms.some((t) =>
      l.professions.some((p) => p.includes(t)) ||
      l.services.some((s) => s.toLowerCase().includes(t)) ||
      l.typeSlug === t ||
      l.industries.some((i) => i.includes(t)),
    ),
  ).length;
};

const guides = ARTICLES.slice(0, 3);

const seo = {
  title: 'CrossLinkd — Find Christian-Owned Businesses You Can Trust',
  description: 'A hand-reviewed national directory of Christian-owned businesses, churches, and ministries across the United States. Verification dates on every profile.',
  path: '/',
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'CrossLinkd',
      url: 'https://crosslinkd.example.com/',
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://crosslinkd.example.com/search?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'CrossLinkd',
      url: 'https://crosslinkd.example.com/',
      logo: 'https://crosslinkd.example.com/favicon.svg',
    },
  ],
};
---
<BaseLayout seo={seo} user={user}>
  <!-- ============ HERO — search first ============ -->
  <div class="relative overflow-hidden">
    <div class="relative mx-auto max-w-5xl px-4 pb-10 pt-12 text-center sm:pt-16">
      <h1 data-animate="hero" class="mx-auto max-w-3xl text-4xl font-extrabold leading-[1.08] sm:text-6xl">
        Find Christian-owned businesses you can trust.
      </h1>
      <p data-animate="hero" class="mx-auto mt-4 max-w-2xl text-[15px] sm:text-lg" style="color:var(--text-soft)">
        CrossLinkd is a hand-reviewed national directory of Christian-owned businesses, churches, and
        ministries across the United States. Every listing is checked by a person, and every badge shows its verification date.
      </p>

      <div data-animate="hero" class="mx-auto mt-7 max-w-4xl text-left">
        <SearchBar client:load />
        <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-[13px]">
          <span style="color:var(--text-mute)">Popular:</span>
          {['plumber', 'counselor #Tricare', 'contractor', 'accountant'].map((s) => (
            <a href={`/search?q=${encodeURIComponent(s)}`} class="chip hover:border-[var(--accent)]">{s}</a>
          ))}
        </div>
      </div>

      <div data-animate="hero" class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
        <a href="/search" class="btn btn-primary" data-animate="cta">Search Businesses</a>
        <a href="/add-listing" class="btn btn-teal">List Your Business</a>
      </div>

      <!-- Real numbers from the current dataset -->
      <dl data-animate="hero" class="mx-auto mt-9 grid max-w-4xl grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {[
          [`${corpus.length}`, 'Businesses & churches listed'],
          [`${verified}`, 'Verified & credentialed'],
          ['National', 'Growing coverage across the United States'],
          [`+${recent}`, 'Added in the last 30 days'],
        ].map(([n, l]) => (
          <div class="card flex h-full flex-col items-center justify-center p-4 text-center sm:p-5">
            <dd class="text-xl font-extrabold sm:text-2xl">{n}</dd>
            <dt class="mt-1 text-xs leading-snug" style="color:var(--text-mute)">{l}</dt>
          </div>
        ))}
      </dl>
      <p class="mt-3 text-xs" style="color:var(--text-mute)">
        A hand-reviewed national directory connecting Christian-owned businesses and communities across the country.
      </p>
    </div>
  </div>

  <!-- ============ FEATURED & VERIFIED ============ -->
  <Section title="Featured & verified businesses" sub="Hand-picked by our team — every one individually checked, the same way as every other listing." href="/search?sort=featured" linkLabel="See all featured →">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
      {featured.map((l) => <ListingCard listing={l} />)}
    </div>
  </Section>

  <!-- ============ POPULAR CATEGORIES ============ -->
  <Section title="Popular categories" sub="Real counts from the directory — no empty pages." href="/browse/industries" linkLabel="All categories →">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4" data-animate="grid">
      {categoryDefs.map((c) => (
        <a href={`/search?q=${encodeURIComponent(c.q)}`} class="card card-hover flex items-center justify-between gap-3 p-4">
          <span class="text-sm font-bold leading-snug">{c.label}</span>
          <span class="chip shrink-0 !py-0.5 !text-[11px] font-bold">{categoryCount(c.q)}</span>
        </a>
      ))}
    </div>
  </Section>

  <!-- ============ WHERE WE SERVE (Dynamic, no 0-listing or hardcoded cards) ============ -->
  <Section
    title="Where we serve"
    sub={hasLocations ? "Featured locations and growing coverage across the United States." : "Nationwide coverage is growing as new listings are added."}
    href={activeLocations.length > 0 ? "/browse/locations" : undefined}
    linkLabel={activeLocations.length > 0 ? "Browse by state →" : undefined}
  >
    {hasLocations ? (
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
        {activeLocations.map((loc) => (
          <a href={`/locations/${loc.slug}`} class="card card-hover p-5">
            <div class="flex items-baseline justify-between">
              <p class="font-extrabold">{loc.city}, {loc.region}</p>
              <span class="chip !py-0.5 !text-[11px] font-bold">{loc.count} {loc.count === 1 ? 'listing' : 'listings'}</span>
            </div>
            <p class="mt-1 text-[13px]" style="color:var(--text-soft)">Verified Christian-owned businesses and organizations.</p>
          </a>
        ))}
        {onlineOnlyCount > 0 && (
          <a href="/search?onlineOnly=1" class="card card-hover p-5">
            <div class="flex items-baseline justify-between">
              <p class="font-extrabold">Online-only businesses</p>
              <span class="chip !py-0.5 !text-[11px] font-bold">{onlineOnlyCount} {onlineOnlyCount === 1 ? 'listing' : 'listings'}</span>
            </div>
            <p class="mt-1 text-[13px]" style="color:var(--text-soft)">Web, media, and services that work from anywhere.</p>
          </a>
        )}
      </div>
    ) : (
      <div class="card flex flex-col items-center justify-center p-8 text-center sm:p-12">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl" style="background:var(--surface-2);color:var(--teal)">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-bold">Locations coming soon</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed" style="color:var(--text-soft)">
          We’re building a nationwide directory. Browse back soon as businesses and organizations are added.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href="/add-listing" class="btn btn-primary !py-2 !text-sm">List Your Business</a>
          <a href="/search" class="btn btn-secondary !py-2 !text-sm">Search Directory</a>
        </div>
      </div>
    )}
  </Section>

  <!-- ============ RECENTLY ADDED ============ -->
  <Section title="Recently added" sub={`The newest reviewed listings — ${recent} joined in the last 30 days.`} href="/search?sort=newest" linkLabel="See all new →">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-animate="grid">
      {newest.map((l) => <ListingCard listing={l} />)}
    </div>
  </Section>

  <!-- ============ TESTIMONIALS (Dynamically populated from real reviews) ============ -->
  {testimonials.length > 0 && (
    <Section title="What people say" sub="From directory users and listed owners alike.">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-animate="grid">
        {testimonials.map((t) => (
          <figure class="card flex flex-col p-6">
            <blockquote class="flex-1 text-[15px] leading-relaxed" style="color:var(--text-soft)">“{t.quote}”</blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-extrabold text-white" style={`background:hsl(${t.hue},45%,55%)`} aria-hidden="true">{t.name.charAt(0)}</span>
              <div class="text-sm">
                <p class="font-bold">{t.name}</p>
                <p style="color:var(--text-mute)">{t.listingName ? `Review for ${t.listingName}` : t.role}</p>
                {t.listingSlug && <a href={`/directory/${t.listingSlug}`} class="text-xs text-[var(--teal)] hover:underline">View the listing →</a>}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </Section>
  )}

  <!-- ============ HOW IT WORKS ============ -->
  <Section title="How CrossLinkd works" id="how-it-works">
    <div class="grid gap-4 md:grid-cols-3" data-animate="grid">
      {[
        ['1. Businesses submit or are found', 'Owners submit a free listing, or we add a business after checking its public information. Nothing is published until a person reviews it.'],
        ['2. A person checks the claims', 'We confirm contact details, licenses where applicable, and — for the Christian-owned badge — a signed attestation plus evidence. Badges show the date.'],
        ['3. You search with confidence', 'Filter by category, city, and verification. Call with confidence, then leave a review — moderated under our published policy.'],
      ].map(([title, body]) => (
        <div class="card p-6">
          <h3 class="font-bold">{title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed" style="color:var(--text-soft)">{body}</p>
        </div>
      ))}
    </div>
    <p class="mt-3 text-center text-sm"><a href="/how-it-works" class="text-[var(--teal)] hover:underline">More detail — including how businesses qualify →</a></p>
  </Section>

  <!-- ============ OWNERS CTA ============ -->
  <Section>
    <div class="card flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center" style="background:var(--accent-soft)" data-animate="reveal">
      <div>
        <h3 class="text-lg font-extrabold">Own a Christian-owned business?</h3>
        <p class="mt-1 text-sm" style="color:var(--text-soft)">A free listing takes about 10 minutes. A person reviews every submission before it goes live.</p>
      </div>
      <div class="flex gap-2">
        <a href="/add-listing" class="btn btn-primary" data-animate="cta">List Your Business</a>
        <a href="/how-it-works" class="btn btn-secondary">How it works</a>
      </div>
    </div>
  </Section>

  <!-- ============ RESOURCE CENTER PREVIEW ============ -->
  <Section title="Guides & resources" sub="Practical help for finding and evaluating Christian-owned businesses — every guide links to real listings." href="/articles" linkLabel="Resource center →">
    <div class="grid gap-4 md:grid-cols-3" data-animate="grid">
      {guides.map((a) => (
        <a href={`/articles/${a.slug}`} class="card card-hover overflow-hidden">
          <div class="h-24" style={`background:hsl(${a.hue},26%,80%)`}></div>
          <div class="p-4">
            <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">{a.category}</p>
            <p class="mt-1 font-bold leading-snug">{a.title}</p>
            <p class="mt-1 line-clamp-2 text-sm" style="color:var(--text-soft)">{a.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <!-- ============ EVENTS (supporting content) ============ -->
  <Section title="Community events" sub="Worship nights, conferences, and serve days hosted by listed churches and ministries." href="/events">
    <div class="grid gap-4 md:grid-cols-3" data-animate="grid">
      {upcoming.map((e) => (
        <a href={`/events/${e.slug}`} class="card card-hover overflow-hidden">
          <div class="h-24" style={`background:hsl(${e.hue},26%,80%)`}></div>
          <div class="p-4">
            <p class="text-xs font-bold uppercase tracking-wide" style="color:var(--teal)">
              {eventDate(e.startsInDays).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })} • {e.city}{e.region ? `, ${e.region}` : ''}
            </p>
            <p class="mt-1 font-bold">{e.title}</p>
            <p class="mt-1 line-clamp-2 text-sm" style="color:var(--text-soft)">{e.description}</p>
          </div>
        </a>
      ))}
    </div>
  </Section>
</BaseLayout>
<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
