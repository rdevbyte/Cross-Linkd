---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;
const deleted = Astro.url.searchParams.get('deleted') === '1';
const error = Astro.url.searchParams.get('error') ?? '';
---
<BaseLayout user={user} seo={{ title: 'Account — CrossLinkd', description: 'Download a copy of your CrossLinkd account data, or mark the account deleted.', path: '/account', noindex: true }}>
  <div class="mx-auto max-w-xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Account</h1>
    <p class="section-sub">These are the account controls this site can actually perform. There is no separate audit log.</p>

    {error && <p class="mt-4 rounded-xl bg-red-500/10 p-3 text-sm font-medium text-red-700" role="alert">{error}</p>}
    {deleted && <p class="card mt-4 p-4 text-sm" style="border-left:4px solid var(--teal)" role="status">The account record was marked deleted and every signed-in session was ended. Published listings stay up until the owner removes them.</p>}

    {user ? (
      <div class="mt-6 space-y-4">
        <div class="card p-5 text-sm leading-relaxed" style="color:var(--text-soft)">
          <p class="font-bold" style="color:var(--text)">{user.displayName}</p>
          <p class="mt-1">{user.email}</p>
          <p class="mt-3">The download includes the profile fields and owned listings the database can return. It does not include your password.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href="/api/account/export" class="btn btn-primary !py-2 !text-sm">Download a copy</a>
            <a href="/dashboard/listings" class="btn btn-secondary !py-2 !text-sm">My listings</a>
          </div>
        </div>
        <form method="POST" action="/api/account/delete" class="card space-y-3 p-5">
          <h2 class="text-lg font-extrabold">Mark this account deleted</h2>
          <p class="text-sm leading-relaxed" style="color:var(--text-soft)">This sets a deleted date and ends every signed-in session. It does not automatically unpublish listings, and it does not erase a contact message you already sent.</p>
          <label class="flex items-start gap-2 text-sm">
            <input type="checkbox" name="confirm" value="delete" required class="mt-1 h-4 w-4 accent-[var(--accent)]" />
            <span>I understand this marks the account deleted and does not unpublish listings.</span>
          </label>
          <button class="btn btn-secondary !py-2 !text-sm" type="submit">Delete account</button>
        </form>
      </div>
    ) : (
      <div class="card mt-6 space-y-3 p-5 text-sm leading-relaxed" style="color:var(--text-soft)">
        <p>Sign in to download your account data or mark the account deleted. Without an account, use the contact form and say whether you want a copy or a deletion. That request is saved for a person to read. It is not an instant export.</p>
        <p><a href="/contact?topic=general" class="underline">Contact form</a></p>
      </div>
    )}
  </div>
</BaseLayout>
