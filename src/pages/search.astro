---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListingCard from '@/components/ListingCard.astro';
import SearchBar from '@/components/SearchBar';
import EmptyState from '@/components/EmptyState.astro';
import { withoutParams } from '@/lib/searchParams';
import { getPublicSearchLocations, searchPublishedListings } from '@/lib/dbSearch';
import type { SearchResult } from '@/lib/search';
import { LISTING_TYPES } from '@/data/listing-types';
import { DENOMINATIONS, TRADITIONS } from '@/data/denominations';
import { INDUSTRIES } from '@/data/industries';
import StructuredSelect from '@/components/StructuredSelect.astro';

const user = Astro.locals.user;
const params = Astro.url.searchParams;
const getAll = (k: string) => params.getAll(k).filter(Boolean);

// ---- Structured "Listing type" dropdown (ltype) ----
// Values: type:<listingType> | industry:<industry> | cat:<sub-industry>
const ltype = params.get('ltype') ?? '';
const ltypeSep = ltype.indexOf(':');
const ltypeKind = ltypeSep > -1 ? ltype.slice(0, ltypeSep) : '';
const ltypeVal = ltypeSep > -1 ? ltype.slice(ltypeSep + 1) : '';

// Alphabetical data for the two structured dropdowns.
const byName = (a: { name?: string; label?: string }, b: { name?: string; label?: string }) =>
  String(a?.name ?? a?.label ?? '').localeCompare(String(b?.name ?? b?.label ?? ''));
const typeOptions = [...LISTING_TYPES].sort(byName);
const industryGroups = [...INDUSTRIES]
  .sort(byName)
  .map((i) => ({ slug: i.slug, name: i.name, categories: [...i.categories].sort(byName) }));
const denomGroups = [...TRADITIONS]
  .sort(byName)
  .map((t) => ({ name: t.name, items: DENOMINATIONS.filter((d) => d.tradition === t.slug).sort(byName) }))
  .filter((g) => g.items.length > 0);

// Structured dropdown data (both filters share the same component + behavior).
const ltypeGroups = [
  { label: 'Listing types', items: typeOptions.map((t) => ({ value: `type:${t.slug}`, label: t.label })) },
  ...industryGroups.map((g) => ({
    label: g.name,
    items: [
      { value: `industry:${g.slug}`, label: `All in ${g.name}` },
      ...g.categories.map((c) => ({ value: `cat:${c.slug}`, label: c.name })),
    ],
  })),
];
const denomData = denomGroups.map((g) => ({ label: g.name, items: g.items.map((d) => ({ value: d.slug, label: d.name })) }));

// Human label for the active ltype selection (shown in the results header).
const ltypeLabel =
  ltypeKind === 'type' ? typeOptions.find((t) => t.slug === ltypeVal)?.label
  : ltypeKind === 'industry' ? industryGroups.find((g) => g.slug === ltypeVal)?.name
  : ltypeKind === 'cat' ? INDUSTRIES.flatMap((i) => i.categories).find((c) => c.slug === ltypeVal)?.name
  : undefined;

const filters = {
  q: params.get('q') ?? '',
  type: ltypeKind === 'type' ? [...getAll('type'), ltypeVal] : getAll('type'),
  denomination: getAll('denomination'),
  industry: ltypeKind === 'industry' ? [...getAll('industry'), ltypeVal] : getAll('industry'),
  category: ltypeKind === 'cat' ? [ltypeVal] : [],
  profession: getAll('profession'),
  service: getAll('service').flatMap((value) => value.split(',').map((item) => item.trim()).filter(Boolean)).slice(0, 12),
  city: params.get('city') ?? undefined,
  near: params.get('near') ?? undefined,
  region: params.get('region') ?? undefined,
  lat: params.get('lat') ? Number(params.get('lat')) : undefined,
  lng: params.get('lng') ? Number(params.get('lng')) : undefined,
  radiusMi: params.get('radiusMi') ? Number(params.get('radiusMi')) : 25,
  verifiedOnly: params.get('verifiedOnly') === '1',
  openNow: params.get('openNow') === '1',
  onlineOnly: params.get('onlineOnly') === '1',
  minRating: params.get('minRating') ? Number(params.get('minRating')) : 0,
  price: getAll('price'),
  languages: getAll('languages'),
  sort: (params.get('sort') as 'relevance' | 'distance' | 'rating' | 'newest' | 'recently-updated' | 'recommended' | 'popular') || 'relevance',
  page: params.get('page') ? Number(params.get('page')) : 1,
  perPage: 12,
};
const selectedDenom = filters.denomination[0] ?? '';
const selectedDenomLabel = denomData.flatMap((g) => g.items).find((d) => d.value === selectedDenom)?.label ?? '';
const clearSearchUrl = filters.q ? `/search?q=${encodeURIComponent(filters.q)}` : '/search';
const locationChoices = await getPublicSearchLocations();
let searchError = false;
let result: SearchResult;
try {
  result = await searchPublishedListings(filters, crypto.randomUUID());
} catch {
  // The search module logs a request-safe diagnostic. Do not fall back to
  // hydrating the full listing corpus if the indexed query is unavailable.
  searchError = true;
  result = {
    hits: [], total: 0, page: filters.page, perPage: filters.perPage, totalPages: 1,
    suggestions: [], appliedTags: [], altLinks: [],
  };
}
const pageUrl = (p: number) => {
  const sp = new URLSearchParams(params);
  sp.set('page', String(p));
  return `/search?${sp.toString()}`;
};
/** Same search minus one or more params — powers the removable "active filter" chips. */
const urlWithout = (...drop: Array<[key: string, value?: string]>) => {
  const qs = withoutParams(params, ...drop, ['page']).toString();
  return qs ? `/search?${qs}` : '/search';
};
const activeFilters: { label: string; href: string }[] = [
  ...(ltypeLabel ? [{ label: ltypeLabel, href: urlWithout(['ltype']) }] : []),
  ...(selectedDenomLabel ? [{ label: selectedDenomLabel, href: urlWithout(['denomination']) }] : []),
  ...(filters.service.length ? [{ label: `Service: ${filters.service.join(', ')}`, href: urlWithout(['service']) }] : []),
  ...(filters.city ? [{ label: `City: ${filters.city}`, href: urlWithout(['city']) }] : []),
  ...(filters.near && !filters.onlineOnly ? [{ label: `Near ${filters.near}`, href: urlWithout(['near']) }] : []),
  ...(filters.lat !== undefined && filters.lng !== undefined ? [{ label: `Within ${filters.radiusMi} mi of me`, href: urlWithout(['lat'], ['lng'], ['radiusMi']) }] : []),
  ...(filters.openNow ? [{ label: 'Open 24 hours', href: urlWithout(['openNow']) }] : []),
  ...(filters.onlineOnly ? [{ label: 'Online services', href: urlWithout(['onlineOnly'], ['near']) }] : []),
  ...(filters.minRating > 0 ? [{ label: `${filters.minRating}+ stars`, href: urlWithout(['minRating']) }] : []),
];
const sortOptions: [string, string][] = [
  ['relevance', 'Relevance'], ['distance', 'Distance'], ['rating', 'Rating'],
  ['newest', 'Newest'], ['recently-updated', 'Recently Updated'], ['recommended', 'Recommendation count'], ['popular', 'Most viewed'],
];

const seo = {
  title: filters.q ? `Results for “${filters.q}” — CrossLinkd` : 'Search — CrossLinkd',
  description: 'Search Christian businesses, churches, ministries, professionals, and events by keyword, hashtag, denomination, industry, and location.',
  path: `/search`,
};
---
<BaseLayout seo={seo} user={user}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <div class="max-w-3xl">
      <h1 class="text-2xl font-bold sm:text-3xl">Search the directory</h1>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Results are owner-submitted listings. A search result is not a verification or an endorsement.</p>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Try <code class="rounded bg-[var(--surface-2)] px-1.5 py-0.5 text-[13px]">bakery #Baptist</code>, <code class="rounded bg-[var(--surface-2)] px-1.5 py-0.5 text-[13px]">counselor near me</code>, or <code class="rounded bg-[var(--surface-2)] px-1.5 py-0.5 text-[13px]">churches with wheelchair access</code></p>
      <div class="mt-4"><SearchBar client:load initialQuery={filters.q} initialLocation={filters.onlineOnly ? 'Online' : (filters.near ?? '')} locationChoices={locationChoices} size="compact" /></div>
      {result.appliedTags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1.5" aria-label="Applied hashtag filters">
          {result.appliedTags.map((t) => <span class="chip chip-active">#{t}</span>)}
        </div>
      )}
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[260px_1fr]">
      <!-- Filters -->
      <aside class="card h-fit p-4 lg:sticky lg:top-20" aria-label="Search filters">
        <form method="GET" action="/search" class="space-y-4">
          <input type="hidden" name="q" value={filters.q} />
          <input type="hidden" name="sort" value={filters.sort} />
          <h2 class="text-[12px] font-semibold uppercase tracking-[0.08em]" style="color:var(--text-mute)">Filters</h2>
          <StructuredSelect
            name="ltype"
            label="Listing type"
            helper="Grouped by industry, A–Z"
            placeholder="All listing types"
            searchPlaceholder="Search industries…"
            groups={ltypeGroups}
            selected={ltype}
            selectedLabel={ltypeLabel ?? ''}
          />
          <StructuredSelect
            name="denomination"
            label="Denomination"
            helper="Grouped by tradition, A–Z"
            placeholder="Any tradition"
            searchPlaceholder="Search traditions…"
            groups={denomData}
            selected={selectedDenom}
            selectedLabel={selectedDenomLabel}
          />
          <div class="space-y-1">
            <label class="field-label" for="filter-service">Service</label>
            <input id="filter-service" name="service" value={filters.service.join(', ')} maxlength="200" placeholder="e.g. Termite treatment" class="input mt-1" />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="space-y-1">
              <label class="field-label" for="filter-city">City</label>
              <input id="filter-city" name="city" value={filters.city ?? ''} placeholder="Enter city" class="input mt-1" />
            </div>
            <div class="space-y-1">
              <label class="field-label" for="filter-radius">Radius</label>
              <select id="filter-radius" name="radiusMi" class="input mt-1">
                {[10, 25, 50, 100].map((r) => <option value={r} selected={filters.radiusMi === r}>{r} mi</option>)}
              </select>
            </div>
          </div>
          <div class="space-y-1">
            <label class="field-label" for="filter-rating">Minimum rating</label>
            <select id="filter-rating" name="minRating" class="input mt-1">
              {[0, 3, 4, 4.5].map((r) => <option value={r} selected={filters.minRating === r}>{r === 0 ? 'Any' : `${r}+ stars`}</option>)}
            </select>
          </div>
          <div class="space-y-2 border-t pt-3" style="border-color:var(--border)">
            <p class="text-xs" style="color:var(--text-mute)">Hours are owner-entered; this only matches listings that explicitly say they are open 24 hours.</p>
            <label class="flex items-center gap-2.5 text-sm font-medium"><input type="checkbox" name="openNow" value="1" checked={filters.openNow} class="h-4 w-4 rounded accent-[var(--accent)]" /> Hours say “open 24 hours”</label>
            <label class="flex items-center gap-2.5 text-sm font-medium"><input type="checkbox" name="onlineOnly" value="1" checked={filters.onlineOnly} class="h-4 w-4 rounded accent-[var(--accent)]" /> Online services</label>
          </div>
          <div class="flex gap-2">
            <button class="btn btn-primary flex-1 !py-2 !text-sm" type="submit">Apply</button>
            <a href="/search" class="btn btn-secondary !py-2 !text-sm">Reset</a>
          </div>
        </form>
        <button id="near-me" class="btn btn-ghost mt-2 w-full !text-sm" type="button">Near me</button>
      </aside>

      <!-- Results -->
      <div data-recent-filter-active={filters.sort === 'recently-updated' ? 'true' : undefined}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm" style="color:var(--text-soft)" role="status" aria-live="polite" aria-atomic="true">
            <strong style="color:var(--text)">{result.total}</strong> result{result.total === 1 ? '' : 's'}
            {filters.q && <> for <strong style="color:var(--text)">“{filters.q}”</strong></>}
            {ltypeLabel && <> in <strong style="color:var(--text)">{ltypeLabel}</strong></>}
            {filters.near && <> near <strong style="color:var(--text)">{filters.near}</strong></>}
          </p>
          <div class="flex items-center gap-2">
            <button id="layout-toggle" type="button" class="btn btn-secondary inline-flex items-center gap-1.5 !px-3 !py-1.5 !text-sm" aria-pressed="false" aria-label="List view. Switch to grid view">
              <svg id="icon-list" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 4.5h14v1.8H3V4.5Zm0 4.6h14v1.8H3V9.1Zm0 4.6h14v1.8H3v-1.8Z" /></svg>
              <svg id="icon-grid" class="hidden h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 3h6.2v6.2H3V3Zm7.8 0H17v6.2h-6.2V3ZM3 10.8h6.2V17H3v-6.2Zm7.8 0H17V17h-6.2v-6.2Z" /></svg>
              <span id="layout-toggle-label">List view</span>
            </button>
            <p id="layout-status" class="sr-only" role="status"></p>
            <label class="flex items-center gap-1.5 text-sm" style="color:var(--text-mute)">Sort
              <select id="sort" class="input !w-auto !py-1.5 !text-sm" aria-label="Sort results">
                {sortOptions.map(([v, l]) => <option value={v} selected={filters.sort === v}>{l}</option>)}
              </select>
            </label>
          </div>
        </div>
        {activeFilters.length > 0 && (
          <div class="mt-3 flex flex-wrap items-center gap-1.5" aria-label="Active filters">
            <span class="text-[12px] font-medium" style="color:var(--text-mute)">Filtering by</span>
            {activeFilters.map((f) => (
              <a href={f.href} class="chip chip-active !pr-2" title={`Remove filter: ${f.label}`}>
                {f.label}
                <span aria-hidden="true" class="ml-0.5 font-semibold">×</span>
                <span class="sr-only">(remove)</span>
              </a>
            ))}
            <a href={`/search${filters.q ? `?q=${encodeURIComponent(filters.q)}` : ''}`} class="text-[12px] font-medium underline" style="color:var(--text-soft)">Clear all</a>
          </div>
        )}

        {searchError ? (
          <div class="card mt-6 p-6 text-center" role="alert">
            <h2 class="text-lg font-semibold">Search results couldn’t load</h2>
            <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed" style="color:var(--text-soft)">The search service is temporarily unavailable. Please retry; the issue has been recorded for the site operator.</p>
            <a href={`${Astro.url.pathname}${Astro.url.search}`} class="btn btn-primary mt-4">Retry search</a>
          </div>
        ) : result.hits.length === 0 ? (
          <div class="mt-6">
            <EmptyState title="No published listings match" body="Nothing published matches these terms and filters. Try removing a filter, broadening your search, or browsing categories and places that have published listings. We don’t invent entries to fill empty results.">
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <a href={clearSearchUrl} class="chip hover:border-[var(--accent)]">Clear filters</a>
                <a href="/browse/industries" class="chip hover:border-[var(--accent)]">Browse industry categories</a>
                <a href="/add-listing" class="chip hover:border-[var(--accent)]">Submit a real listing</a>
                {filters.q && result.suggestions.map((suggestion) => (
                  <a href={`/search?q=${encodeURIComponent(suggestion)}`} class="chip hover:border-[var(--accent)]">Try: {suggestion}</a>
                ))}
              </div>
            </EmptyState>
          </div>
        ) : (
          <div id="results-grid" class="layout-container listings-grid mt-4">
            {result.hits.map((h) => <ListingCard listing={h} distanceMiles={h.distanceMiles} />)}
          </div>
        )}
        <script is:inline>
          try { if (localStorage.getItem('cl:listLayout') === 'grid') document.getElementById('results-grid')?.classList.add('as-grid'); } catch (e) {}
        </script>

        {result.totalPages > 1 && (
          <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Pagination">
            {result.page > 1 && <a href={pageUrl(result.page - 1)} aria-label={`Previous page, page ${result.page - 1}`} class="btn btn-secondary !px-4">← Prev</a>}
            <span class="text-sm" style="color:var(--text-soft)">Page {result.page} of {result.totalPages}</span>
            {result.page < result.totalPages && <a href={pageUrl(result.page + 1)} aria-label={`Next page, page ${result.page + 1}`} class="btn btn-secondary !px-4">Next →</a>}
          </nav>
        )}
      </div>
    </div>
  </div>

  <script define:vars={{ sortBase: `/search?${new URLSearchParams([...params].filter(([k]) => k !== 'sort' && k !== 'page')).toString()}` }}>
    const sort = document.getElementById('sort');
    sort?.addEventListener('change', (e) => {
      const v = e.target.value;
      const join = sortBase.includes('?') && !sortBase.endsWith('?') ? '&' : '';
      window.location.href = `${sortBase}${join}sort=${v}`;
    });
    document.getElementById('near-me')?.addEventListener('click', () => {
      if (!navigator.geolocation) return alert('Geolocation is not supported by your browser.');
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const sp = new URLSearchParams(window.location.search);
          sp.set('lat', pos.coords.latitude.toFixed(4));
          sp.set('lng', pos.coords.longitude.toFixed(4));
          sp.set('sort', 'distance');
          window.location.href = `/search?${sp.toString()}`;
        },
        () => alert('Location unavailable — try entering a city instead.'),
      );
    });
  </script>

  <script>
    // List/Grid layout toggle — FLIP with the Web Animations API (no library):
    // measure, toggle the class, measure again, then play the inverse transform.
    const initLayoutToggle = () => {
      const $root = document.querySelector<HTMLElement>('.layout-container');
      const $button = document.getElementById('layout-toggle');
      if (!$root || !$button) return;
      const $iconList = document.getElementById('icon-list');
      const $iconGrid = document.getElementById('icon-grid');
      const $label = document.getElementById('layout-toggle-label');
      const $status = document.getElementById('layout-status');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const STORAGE_KEY = 'cl:listLayout';
      const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

      const isGrid = () => $root.classList.contains('as-grid');
      const setLayout = (grid: boolean) => $root.classList.toggle('as-grid', grid);
      const persist = () => {
        try { window.localStorage.setItem(STORAGE_KEY, isGrid() ? 'grid' : 'list'); } catch (e) { /* storage unavailable */ }
      };
      // Button reflects the ACTIVE view: label + icon name it, aria-pressed marks grid mode.
      const syncControls = () => {
        const grid = isGrid();
        const current = grid ? 'Grid' : 'List';
        const other = grid ? 'list' : 'grid';
        if ($iconGrid) $iconGrid.classList.toggle('hidden', !grid);
        if ($iconList) $iconList.classList.toggle('hidden', grid);
        if ($label) $label.textContent = `${current} view`;
        $button.setAttribute('aria-pressed', String(grid));
        $button.setAttribute('aria-label', `${current} view. Switch to ${other} view`);
      };

      const applyToggle = () => {
        const grid = !isGrid();
        const cards = Array.from($root.querySelectorAll<HTMLElement>(':scope > article'));
        if (reducedMotion.matches || !('animate' in HTMLElement.prototype) || !cards.length) {
          setLayout(grid);
          return;
        }
        const before = new Map(cards.map((el) => [el, el.getBoundingClientRect()]));
        setLayout(grid);
        const ordered = grid ? cards : [...cards].reverse();
        ordered.forEach((el, i) => {
          const a = before.get(el)!;
          const b = el.getBoundingClientRect();
          const dx = a.left - b.left, dy = a.top - b.top;
          const sx = a.width / Math.max(b.width, 1), sy = a.height / Math.max(b.height, 1);
          if (!dx && !dy && Math.abs(sx - 1) < 0.01 && Math.abs(sy - 1) < 0.01) return;
          el.style.transformOrigin = 'top left';
          el.style.willChange = 'transform';
          const anim = el.animate(
            [{ transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` }, { transform: 'none' }],
            { duration: 420, delay: Math.min(i, 8) * 40, easing: EASE, fill: 'backwards' },
          );
          // Drop the compositing hints once done so the card is repainted at its final layout
          // (avoids a stale composited layer lingering over the resized card).
          anim.onfinish = anim.oncancel = () => { el.style.willChange = ''; el.style.transformOrigin = ''; };
        });
      };

      $button.addEventListener('click', () => {
        applyToggle();
        syncControls();
        persist();
        if ($status) $status.textContent = `${isGrid() ? 'Grid' : 'List'} view shown`;
      });

      syncControls();
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initLayoutToggle);
    else initLayoutToggle();
  </script>
</BaseLayout>
