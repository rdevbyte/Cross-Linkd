---
import BaseLayout from '@/layouts/BaseLayout.astro';
const user = Astro.locals.user;

const badges: [string, string, string][] = [
  ['Christian-Owned', 'What it means', 'Current ownership affirmatively identifies the business as Christian-owned. Confirmed by a signed attestation plus supporting evidence (business registration, public statement of faith, church membership, or a verification call). Re-attested yearly.'],
  ['Faith-based Organization', 'What it means', 'For ministries, nonprofits, and organizations: mission, leadership, and activities are consistent with a stated Christian identity. Confirmed by our review team against public information.'],
  ['Church-Recommended', 'What it means', 'A congregation publicly recommends this business — typically a member in good standing whose work the church has seen firsthand. It is a strong community reference, not a doctrine check.'],
  ['✓ Business Verified', 'What it means', 'The listing is real and reachable: address or service area confirmed, phone answered, website live, and owner identity confirmed. This is the baseline badge every listing can earn.'],
  ['Credential Verified', 'What it means', 'For regulated professions: license numbers checked against the issuing authority where records are public (plumbers, electricians, CPAs, attorneys, counselors, Realtors). Re-checked periodically.'],
];

const terms: [string, string][] = [
  ['Christian-owned', 'Christians own the company today. They set its direction and benefit from it. This is the primary term we use across the directory.'],
  ['Founded by a Christian', 'A Christian started the company — but may no longer own or run it. We never use "founded by a Christian" to imply current ownership.'],
  ['Faith-inspired', 'Values come from faith, but ownership or operation may be shared or secular. A descriptive label, not a verification claim.'],
  ['Christian-operated', 'The people running it day to day are Christians, even if ownership is broader. Matters for how employees and customers are treated.'],
  ['Church-recommended', 'A congregation endorses the business based on firsthand experience. Community reference, not a doctrinal seal.'],
  ['Serves Christian customers', 'Simply targets Christian customers — says nothing about ownership. We do not grant badges for this alone.'],
];

const seo = {
  title: 'Verification & Badges — How Businesses Qualify | CrossLinkd',
  description: 'Exactly what each CrossLinkd badge means, how businesses qualify, what evidence we check, and why paid placement never substitutes for verification.',
  path: '/verification',
};
---
<BaseLayout user={user} seo={seo}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Verification &amp; badges</h1>
    <p class="section-sub">Every badge has published requirements and a visible date. No badge is a doctrinal endorsement, and paying for promotion never substitutes for verification.</p>

    <div class="mt-8 space-y-3">
      {badges.map(([t, label, b]) => (
        <div class="card p-5">
          <p class="font-bold">{t}</p>
          <p class="mt-1 text-sm" style="color:var(--text-soft)"><strong style="color:var(--text)">{label}:</strong> {b}</p>
        </div>
      ))}
    </div>

    <h2 id="qualify" class="mt-12 text-2xl font-extrabold">How businesses qualify</h2>
    <p class="mt-2 text-[15px]" style="color:var(--text-soft)">Four steps, the same for everyone — including paying customers.</p>
    <ol class="mt-4 list-decimal space-y-3 pl-5 text-[15px]" style="color:var(--text-soft)">
      <li><strong style="color:var(--text)">Submit.</strong> The owner sends contact details, hours, service area, and — for the Christian-owned badge — a signed ownership attestation. Free, no card.</li>
      <li><strong style="color:var(--text)">Baseline check.</strong> A person confirms the business is real and reachable: address or service area, working phone, live website, no duplicates.</li>
      <li><strong style="color:var(--text)">Evidence check.</strong> Licenses go to the issuing authority where records are public. Ownership attestations are checked against evidence: registrations, public faith statements, church membership, or a short call.</li>
      <li><strong style="color:var(--text)">Badge with a date.</strong> Approved badges show when they were granted, for example "Verified Christian-owned · Aug 2026". Owners re-attest yearly; badges come off if ownership changes or a license lapses.</li>
    </ol>

    <h2 class="mt-12 text-2xl font-extrabold">What the words mean</h2>
    <p class="mt-2 text-[15px]" style="color:var(--text-soft)">"Christian-owned" is our primary term. Here is how it relates to the other phrases you will see.</p>
    <div class="mt-4 space-y-2">
      {terms.map(([t, b]) => (
        <div class="card p-4">
          <p class="text-sm font-bold">{t}</p>
          <p class="mt-1 text-sm" style="color:var(--text-soft)">{b}</p>
        </div>
      ))}
    </div>

    <div class="card mt-10 p-6" style="background:rgba(216,149,34,.08)">
      <h2 class="font-extrabold">Featured ≠ verified</h2>
      <p class="mt-2 text-sm" style="color:var(--text-soft)">
        "Featured" highlights listings our team wants to surface — it is not a trust level. Only badges, with their dates, indicate what we
        checked. Listing, claiming, and verification are free, and every listing goes through the same review.
      </p>
    </div>

    <div class="card mt-4 p-6">
      <h2 class="font-extrabold">Saw something wrong?</h2>
      <p class="mt-1 text-sm" style="color:var(--text-soft)">Expired badge, wrong information, or a business misusing a label — every report reaches a human moderator.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a href="/contact?topic=report" class="btn btn-primary !py-2 !text-sm">Report a listing</a>
        <a href="/appeals" class="btn btn-secondary !py-2 !text-sm">Appeals process</a>
      </div>
    </div>
  </div>
</BaseLayout>
